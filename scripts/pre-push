#!/usr/bin/env bash
set -euo pipefail

# Local reminder when pushing directly to the main branches.
# Install once with:
#   git config core.hooksPath scripts
#
# This hook never blocks the push and never stashes, cleans, resets, deletes,
# or edits local files.

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      cat <<'MSG'
Promemoria: stai eseguendo un push diretto verso il branch principale.

Per gli aggiornamenti Dependabot e per le modifiche ai file critici usa una
pull request e integra una modifica alla volta. Il push corrente prosegue e il
hook non modifica alcun file locale.

Per controllare il progetto prima del push:
  bin/ci_checks
MSG
      ;;
  esac
done

exit 0
