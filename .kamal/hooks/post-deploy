#!/bin/sh

# Crea e aggiorna prima i Node dichiarati nel repository: i Domain possono
# riferirsi a questi Node tramite node_slug.
bin/kamal app exec "bin/rails nodes:import" || exit 1

# Le Skill versionate possono riferirsi ai Node per slug. L'import aggiorna o
# crea le definizioni presenti nel catalogo, senza eliminare quelle operative
# assenti dal file.
bin/kamal app exec "bin/rails skills:import OWNER=markpostura" || exit 1

# I prodotti vengono importati dopo le definizioni delle Skill e possono
# leggere il Markdown dai percorsi versionati sotto config/data/.
if bin/kamal app exec "test -f config/data/rails4b/skill_products.yml"; then
  bin/kamal app exec "bin/rails skill_products:import OWNER=markpostura" || exit 1
fi

# Mantiene il routing dei domini di produzione allineato a config/domains.yml.
bin/kamal app exec "bin/rails domains:import" || exit 1

# Questo hook gira sulla macchina da cui lanci `kamal deploy`.
# Invia soltanto i JSON già messi in storage/data_commitment_exports/pending.
if [ -f .kamal/secrets ]; then
  set -a
  . .kamal/secrets
  set +a
fi

export DATA_COMMITMENT_SYNC_URL="${DATA_COMMITMENT_SYNC_URL:-https://flowpulse.net/sync/data_commitment_imports}"

if [ -n "$DATA_COMMITMENT_SYNC_TOKEN" ]; then
  RAILS_ENV="${RAILS_ENV:-development}" bin/rails data_commitments:push_pending_imports
else
  echo "DataCommitment sync: non configurata (manca DATA_COMMITMENT_SYNC_TOKEN in .kamal/secrets)."
fi
