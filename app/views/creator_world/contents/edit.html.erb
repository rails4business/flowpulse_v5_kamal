<% content_for :full_screen, true %>

<div class="min-h-screen bg-slate-50 p-4 sm:p-6 lg:p-8">
  <main class="mx-auto max-w-7xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <header class="border-b border-slate-200 px-5 py-5 sm:px-8">
      <nav class="mb-3 flex flex-wrap items-center gap-2 text-xs font-bold text-slate-500" aria-label="Percorso">
        <%= link_to @node.title, edit_creator_world_role_assignment_node_path(@role_assignment, @node), class: "text-blue-700 hover:underline" %>
        <span>/</span><span>Content #<%= @content.id %></span>
      </nav>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div><p class="text-xs font-black uppercase tracking-[.14em] text-blue-700">Editor Content</p><h1 class="mt-1 text-3xl font-black tracking-tight text-slate-950"><%= @content.title %></h1></div>
        <span class="rounded-full px-3 py-1 text-xs font-black <%= @content.sync_status == 'conflict' ? 'bg-red-100 text-red-800' : 'bg-emerald-100 text-emerald-800' %>"><%= @content.sync_status.humanize %></span>
      </div>
    </header>

    <% if @content.errors.any? %><div class="m-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"><%= @content.errors.full_messages.to_sentence %></div><% end %>

    <%= form_with model: @content, url: creator_world_role_assignment_node_content_path(@role_assignment, @node, @content), method: :patch do |form| %>
      <section class="grid gap-5 border-b border-slate-200 p-5 sm:grid-cols-2 lg:grid-cols-4 sm:p-8">
        <label class="text-xs font-bold text-slate-600 sm:col-span-2">Titolo<%= form.text_field :title, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
        <label class="text-xs font-bold text-slate-600">Ruolo<%= form.select :role, Content::ROLES.map { |value| [value.humanize, value] }, {}, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
        <label class="text-xs font-bold text-slate-600">Posizione<%= form.number_field :position, min: 0, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
        <label class="text-xs font-bold text-slate-600 sm:col-span-2">Descrizione<%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
        <label class="text-xs font-bold text-slate-600">Collocazione<%= form.select :placement, Content::PLACEMENTS.map { |value| [value.humanize, value] }, {}, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
        <label class="text-xs font-bold text-slate-600">Pubblicazione nello show<%= form.select :show_publication_id, @publication_choices.map { |item| ["#{item.platform} · #{item.title.presence || item.url.presence || item.key}", item.id] }, { include_blank: "Nessuna" }, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
        <label class="text-xs font-bold text-slate-600">Stato<%= form.select :publication_status, Content::PUBLICATION_STATUSES.map { |value| [value.humanize, value] }, {}, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
        <label class="text-xs font-bold text-slate-600">Visibilità<%= form.select :publication_visibility, Content::PUBLICATION_VISIBILITIES.map { |value| [value.humanize, value] }, {}, class: "mt-1 block w-full rounded-lg border-slate-300 text-sm" %></label>
      </section>

      <% if @content.sync_status == "conflict" %><div class="mx-5 mt-5 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 sm:mx-8"><strong>Conflitto:</strong> Markdown e Lexxy sono stati modificati dopo l’ultima sincronizzazione. Confrontali e scegli quale versione conservare oppure completa manualmente la fusione.</div><% end %>

      <section class="grid gap-0 lg:grid-cols-2">
        <div class="border-b border-slate-200 p-5 lg:border-b-0 lg:border-r sm:p-8">
          <div class="mb-3 flex items-center justify-between"><h2 class="font-black text-slate-950">Markdown</h2><span class="text-[11px] font-bold text-slate-400"><%= l(@content.markdown_updated_at, format: :short) if @content.markdown_updated_at %></span></div>
          <%= text_area_tag "content[body_md]", @content.body_md, rows: 24, class: "w-full rounded-xl border-slate-300 font-mono text-xs leading-5" %>
          <div class="mt-3 flex flex-wrap gap-2"><button name="sync_action" value="save_markdown" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white">Salva e aggiorna Lexxy</button><% if @content.sync_status == "conflict" %><button name="sync_action" value="resolve_markdown" class="rounded-lg border border-amber-400 bg-white px-4 py-2 text-xs font-bold text-amber-800">Usa Markdown</button><% end %></div>
        </div>
        <div class="p-5 sm:p-8">
          <div class="mb-3 flex items-center justify-between"><h2 class="font-black text-slate-950">Lexxy</h2><span class="text-[11px] font-bold text-slate-400"><%= l(@content.lexxy_updated_at, format: :short) if @content.lexxy_updated_at %></span></div>
          <%= rich_text_area_tag "content[body]", @content.body, class: "min-h-[28rem] rounded-xl border border-slate-300" %>
          <div class="mt-3 flex flex-wrap gap-2"><button name="sync_action" value="save_lexxy" class="rounded-lg bg-blue-700 px-4 py-2 text-xs font-bold text-white">Salva e aggiorna Markdown</button><% if @content.sync_status == "conflict" %><button name="sync_action" value="resolve_lexxy" class="rounded-lg border border-amber-400 bg-white px-4 py-2 text-xs font-bold text-amber-800">Usa Lexxy</button><% end %></div>
        </div>
      </section>
    <% end %>
  </main>
</div>
