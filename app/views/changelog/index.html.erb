<% content_for :title, "#{@changelog_brand.fetch("label")} — Changelog" %>
<% content_for :description, @changelog_brand.fetch("description") %>
<% changelog_index_path = @changelog_preview ? brand_changelog_path(@changelog_brand.fetch("key")) : changelog_path %>
<% kind_labels = { "platform" => "Piattaforma", "architecture" => "Architettura", "feature" => "Funzione", "fix" => "Correzione" } %>

<main class="min-h-screen bg-white text-slate-950">
  <%= render "navigation", changelog_brand: @changelog_brand, changelog_index_path: changelog_index_path %>

  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-12">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-blue-700"><%= @changelog_brand.fetch("label") %></p>
          <h1 class="mt-3 text-4xl font-black tracking-[-0.04em] sm:text-5xl">Changelog</h1>
          <p class="mt-3 max-w-3xl leading-7 text-slate-600"><%= @changelog_brand.fetch("description") %></p>
        </div>
        <% if @changelog_entries.any? %>
          <div class="shrink-0 border-l-2 border-blue-600 pl-4 text-sm">
            <strong class="block text-slate-950"><%= pluralize(@changelog_entries.size, "aggiornamento", "aggiornamenti") %></strong>
            <span class="mt-1 block text-slate-500">Dal <%= I18n.l(@changelog_entries.last.fetch("date_value"), format: :long) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </header>

  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-10 sm:px-8 sm:py-14 <%= @changelog_directory.present? ? 'lg:grid-cols-[minmax(0,1fr)_18rem]' : '' %>">
    <section aria-labelledby="timeline-title">
      <div class="mb-7 flex items-center justify-between gap-4">
        <h2 id="timeline-title" class="text-lg font-black">Aggiornamenti</h2>
        <% if @changelog_entries.any? %><span class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Più recenti prima</span><% end %>
      </div>

      <% if @changelog_entries.any? %>
        <ol class="relative space-y-3 before:absolute before:bottom-6 before:left-[5.45rem] before:top-6 before:w-px before:bg-slate-200 sm:before:left-[7.45rem]">
          <% @changelog_entries.each do |entry| %>
            <li class="relative grid grid-cols-[4.5rem_minmax(0,1fr)] gap-5 sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:gap-7">
              <time datetime="<%= entry.fetch("date") %>" class="pt-5 text-right">
                <span class="block text-sm font-black text-slate-900"><%= I18n.l(entry.fetch("date_value"), format: "%d %b") %></span>
                <span class="mt-0.5 block text-xs text-slate-400"><%= entry.fetch("date_value").year %></span>
              </time>
              <span class="absolute left-[5.14rem] top-6 size-2.5 rounded-full border-2 border-white bg-blue-600 ring-1 ring-blue-200 sm:left-[7.14rem]" aria-hidden="true"></span>

              <%= link_to entry.fetch("entry_url"), class: "group block rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-blue-300 hover:bg-blue-50/40 sm:p-6" do %>
                <article>
                  <div class="flex flex-wrap items-center gap-2 text-[11px] font-black uppercase tracking-[0.12em] text-slate-400">
                    <span><%= kind_labels.fetch(entry.fetch("kind"), entry.fetch("kind").humanize) %></span>
                    <% if entry.fetch("visibility", "public") == "internal" %><span class="rounded-full bg-amber-100 px-2 py-0.5 tracking-normal text-amber-800">Interno</span><% end %>
                  </div>
                  <h3 class="mt-2 text-xl font-black leading-tight group-hover:text-blue-700 sm:text-2xl"><%= entry.fetch("title") %></h3>
                  <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base sm:leading-7"><%= entry.fetch("summary") %></p>
                  <div class="mt-4 flex items-center justify-between gap-4">
                    <div class="flex min-w-0 flex-wrap gap-1.5">
                      <% entry.fetch("tags").first(3).each do |tag| %><span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-500"><%= tag.humanize %></span><% end %>
                    </div>
                    <span class="shrink-0 text-lg font-bold text-blue-700 transition group-hover:translate-x-1" aria-hidden="true">→</span>
                  </div>
                </article>
              <% end %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-slate-500">Non ci sono ancora aggiornamenti pubblicati.</p>
      <% end %>
    </section>

    <% if @changelog_directory.present? %>
      <aside class="lg:sticky lg:top-6 lg:self-start" aria-labelledby="directory-title">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-blue-700">Ecosistema</p>
          <h2 id="directory-title" class="mt-2 text-lg font-black">Altri changelog</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">Ogni dominio conserva la propria cronologia.</p>
          <ul class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
            <% @changelog_directory.each do |brand| %>
              <li>
                <%= link_to brand.fetch("url"), class: "group flex items-center justify-between gap-3 py-3 text-sm" do %>
                  <span class="font-bold text-slate-700 group-hover:text-blue-700"><%= brand.fetch("label") %></span>
                  <span class="rounded-full bg-white px-2 py-0.5 text-xs font-bold text-slate-400"><%= brand.fetch("entry_count") %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </aside>
    <% end %>
  </div>

  <footer class="border-t border-slate-200 bg-slate-50 px-5 py-6 text-center text-sm">
    <%= link_to "Torna a #{@changelog_brand.fetch("label")}", @changelog_brand.fetch("home_url"), class: "font-bold text-slate-600 hover:text-blue-700" %>
  </footer>
</main>
