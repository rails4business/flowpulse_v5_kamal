<% content_for :title, "#{@changelog_entry.fetch("title")} — Changelog" %>
<% content_for :description, @changelog_entry.fetch("summary") %>

<main class="min-h-screen bg-white text-slate-950">
  <% index_path = @changelog_preview ? brand_changelog_path(@changelog_brand.fetch("key")) : changelog_path %>
  <%= render "navigation", changelog_brand: @changelog_brand, changelog_index_path: index_path %>
  <article class="mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
    <%= link_to "← Changelog #{@changelog_brand.fetch("label")}", index_path, class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>
    <div class="mt-8 flex flex-wrap items-center gap-2 text-xs font-bold text-slate-500"><time datetime="<%= @changelog_entry.fetch("date") %>"><%= I18n.l(@changelog_entry.fetch("date_value"), format: :long) %></time><span>·</span><span><%= { "platform" => "Piattaforma", "architecture" => "Architettura", "feature" => "Funzione", "fix" => "Correzione" }.fetch(@changelog_entry.fetch("kind"), @changelog_entry.fetch("kind").humanize) %></span></div>
    <h1 class="mt-3 text-4xl font-black tracking-[-0.045em] sm:text-6xl"><%= @changelog_entry.fetch("title") %></h1>
    <p class="mt-5 text-xl leading-8 text-slate-600"><%= @changelog_entry.fetch("summary") %></p>
    <% if @changelog_entry.fetch("tags").any? %><div class="mt-5 flex flex-wrap gap-2"><% @changelog_entry.fetch("tags").each do |tag| %><span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600"><%= tag.humanize %></span><% end %></div><% end %>
    <div class="editorial-rich-text mt-10 border-t border-slate-200 pt-10 text-lg leading-8 text-slate-700"><%= markdown(@changelog_entry.fetch("body")) %></div>
    <% if Current.user&.superadmin_user? %><p class="mt-10 rounded-xl bg-amber-50 px-4 py-3 font-mono text-xs text-amber-900">Sorgente: <%= @changelog_entry.fetch("source_path") %></p><% end %>
  </article>
  <footer class="border-t border-slate-200 bg-slate-50 px-5 py-6 text-center text-sm"><%= link_to "Torna a #{@changelog_brand.fetch("label")}", @changelog_brand.fetch("home_url"), class: "font-bold text-slate-600 hover:text-blue-700" %></footer>
</main>
