<% content_for :title, "Eventi organizzati da Mark Postura" %>
<% content_for :description, "Eventi e iniziative organizzati da Mark Postura nei diversi progetti della piattaforma." %>

<div class="min-h-screen bg-white text-slate-900">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 sm:px-6">
      <%= link_to "Mark Postura", markpostura_path, class: "text-sm font-bold uppercase tracking-[0.2em] text-sky-700" %>
      <%= link_to "← Torna alla pagina personale", markpostura_path, class: "text-sm font-semibold text-slate-600 transition hover:text-sky-700" %>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 py-12 sm:px-6 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-700">Organizzatore · @markpostura</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Prossimi eventi</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">Gli eventi sono pubblicati dal progetto che li promuove. Qui vengono raccolti quelli organizzati da Mark Postura.</p>
    </div>

    <% if @markpostura_events.any? %>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% @markpostura_events.each do |event| %>
          <a href="<%= event.fetch("url") %>" class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-emerald-300 hover:shadow-lg">
            <div class="aspect-video overflow-hidden bg-slate-100">
              <img src="<%= event.fetch("image") %>" alt="<%= event.fetch("title") %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy">
            </div>
            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-emerald-700">
                <span><%= event["formattedDate"] || event["date"] %></span>
                <span aria-hidden="true">·</span>
                <span><%= event.fetch("canonical_domain_name") %></span>
              </div>
              <h2 class="mt-3 text-xl font-bold text-slate-950 group-hover:text-emerald-700"><%= event.fetch("title") %></h2>
              <p class="mt-3 text-sm leading-6 text-slate-600"><%= event["description"] %></p>
              <p class="mt-4 text-sm font-semibold text-slate-500"><%= event["location"] %></p>
              <% if event.fetch("projects").include?("giardino-del-corpo") %>
                <span class="mt-4 inline-flex rounded-full bg-violet-50 px-3 py-1 text-xs font-bold text-violet-700">Giardino del Corpo</span>
              <% end %>
            </div>
          </a>
        <% end %>
      </div>
    <% else %>
      <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-xl font-bold">Nessun evento in programma</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">I nuovi eventi organizzati da @markpostura compariranno qui automaticamente.</p>
      </div>
    <% end %>
  </main>
</div>
