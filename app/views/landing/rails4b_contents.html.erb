<% content_for :title, "Contenuti — Rails4Business" %>

<main class="min-h-screen bg-stone-50 text-slate-900">
  <%= render "landing/rails4b_nav", active: :contents %>

  <div class="mx-auto max-w-5xl px-5 py-6 sm:px-6 sm:py-10">
    <h1 class="sr-only">Contenuti Rails4Business</h1>
    <nav class="flex w-full max-w-sm rounded-xl border border-slate-200 bg-white p-1" aria-label="Periodo dei contenuti">
      <% { "prossimi" => "Futuri", "passati" => "Passati" }.each do |tab, label| %>
        <%= link_to label, rails4b_contents_path(tab:), class: "flex-1 rounded-lg px-3 py-2.5 text-center text-sm font-black #{@rails4b_contents_tab == tab ? "bg-blue-600 text-white" : "text-slate-600 hover:bg-slate-100 hover:text-blue-700"}" %>
      <% end %>
    </nav>

    <% if @rails4b_contents.any? %><ol class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
      <% @rails4b_contents.each do |content| %>
        <li>
          <% destination = content["track_slug"].present? ? rails4b_track_path(content.fetch("track_slug"), contenuto: content.fetch("slug")) : rails4b_content_path(content.fetch("slug")) %>
          <%= link_to destination, class: "group grid gap-3 py-6 transition sm:grid-cols-[9rem_minmax(0,1fr)_auto] sm:items-start sm:gap-6" do %>
            <p class="text-xs font-extrabold uppercase tracking-[0.13em] text-blue-700"><%= content.fetch("kind") %> · <%= Time.zone.parse(content.fetch("publication_at")).strftime("%d/%m/%Y · %H:%M") %></p>
            <div>
              <h2 class="text-xl font-black tracking-tight text-slate-950 group-hover:text-blue-700"><%= content.fetch("title") %></h2>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= content.fetch("description") %></p>
            </div>
            <span aria-hidden="true" class="hidden text-slate-400 transition group-hover:translate-x-1 group-hover:text-blue-700 sm:block">→</span>
          <% end %>
        </li>
      <% end %>
    </ol><% else %>
      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-7"><h2 class="text-xl font-black">Nessun contenuto in questa sezione</h2><p class="mt-2 text-sm leading-6 text-slate-600">Quando verrà programmato o pubblicato un contenuto datato, comparirà qui.</p></div>
    <% end %>
  </div>
</main>
