<% site = @markpostura.fetch("site") %>
<% hero = @markpostura.fetch("hero") %>
<% color_classes = { "blue" => "border-blue-500 text-blue-700", "rose" => "border-rose-500 text-rose-700", "amber" => "border-amber-500 text-amber-700" } %>
<% content_for :title, site.fetch("title") %>
<% content_for :description, site.fetch("description") %>

<main class="min-h-screen bg-white text-slate-950">
  <nav class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur" aria-label="Navigazione MarkPostura">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <%= link_to "Mark Postura", markpostura_path, class: "text-sm font-black uppercase tracking-[0.2em] text-amber-700" %>
      <div class="flex items-center gap-4 text-sm font-semibold text-slate-600">
        <a href="#progetti" class="hidden hover:text-slate-950 sm:inline">Progetti</a>
        <%= link_to "Contenuti", markpostura_contents_path, class: "hover:text-slate-950" %>
      </div>
    </div>
  </nav>

  <div class="mx-auto grid max-w-[90rem] lg:grid-cols-[13rem_minmax(0,1fr)]">
    <aside class="hidden border-r border-slate-200 px-5 py-10 lg:block" aria-label="Indice MarkPostura">
      <nav class="sticky top-24 space-y-1 text-sm">
        <p class="mb-4 text-xs font-black uppercase tracking-[0.18em] text-slate-400">Indice</p>
        <a href="#inizio" class="block rounded-lg px-3 py-2 font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950">Inizio</a>
        <a href="#progetti" class="block rounded-lg px-3 py-2 font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950">Progetti</a>
        <%= link_to "Week Plan", markpostura_weekplan_path, class: "block rounded-lg px-3 py-2 font-semibold text-amber-700 hover:bg-amber-50" %>
        <a href="#contenuti-eventi" class="block rounded-lg px-3 py-2 font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950">Contenuti ed eventi</a>
      </nav>
    </aside>

    <div class="min-w-0">

  <header id="inizio" class="mx-auto grid max-w-6xl scroll-mt-24 items-center gap-12 px-5 py-16 lg:grid-cols-[1fr_0.72fr] lg:py-24">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.22em] text-amber-700"><%= hero.fetch("eyebrow") %></p>
      <h1 class="mt-5 max-w-3xl text-5xl font-black leading-[0.95] tracking-[-0.05em] sm:text-7xl"><%= hero.fetch("title") %></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl"><%= hero.fetch("description") %></p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#progetti" class="rounded-full bg-slate-950 px-6 py-3 text-sm font-black text-white hover:bg-slate-800">Scegli un progetto</a>
      </div>
    </div>
    <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-50 p-2 shadow-xl">
      <%= image_tag hero.fetch("image"), alt: hero.fetch("image_alt"), class: "aspect-[4/5] h-full w-full rounded-[1.6rem] object-cover", fetchpriority: "high" %>
    </div>
  </header>

  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-14 lg:grid-cols-[0.6fr_1.4fr]">
      <h2 class="text-3xl font-black tracking-tight"><%= @markpostura.fetch("about").fetch("title") %></h2>
      <p class="text-lg leading-8 text-slate-600"><%= @markpostura.fetch("about").fetch("body") %></p>
    </div>
  </section>

  <section id="progetti" class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="text-3xl font-black tracking-tight sm:text-4xl">I tre progetti</h2>
    <p class="mt-3 text-slate-600">Tre identità distinte, collegate dallo stesso professionista.</p>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      <% @markpostura.fetch("projects").each do |project| %>
        <%= link_to project.fetch("path"), class: "group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg" do %>
          <div class="aspect-video overflow-hidden bg-slate-100"><%= image_tag project.fetch("image"), alt: project.fetch("image_alt"), class: "h-full w-full object-cover transition duration-500 group-hover:scale-105", loading: "lazy" %></div>
          <div class="border-t-2 p-6 <%= color_classes.fetch(project.fetch("color")) %>">
            <p class="text-xs font-black uppercase tracking-[0.18em]"><%= project.fetch("number") %> · <%= project.fetch("subtitle") %></p>
            <h3 class="mt-3 text-2xl font-black text-slate-950"><%= project.fetch("title") %></h3>
            <p class="mt-3 text-sm leading-6 text-slate-600"><%= project.fetch("description") %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-4xl px-5 py-20">
      <h2 class="text-3xl font-black tracking-tight">Come è organizzato</h2>
      <div class="mt-9 space-y-3">
        <% @markpostura.fetch("organization").each_with_index do |level, index| %>
          <article class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm"><p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700"><%= level.fetch("label") %></p><h3 class="mt-2 text-lg font-black"><%= level.fetch("title") %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= level.fetch("description") %></p></article>
          <% unless index == @markpostura.fetch("organization").size - 1 %><div class="text-center text-slate-300">↓</div><% end %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="text-3xl font-black tracking-tight">Come si entra</h2>
    <p class="mt-3 text-slate-600">Si parte da un’esperienza concreta e si cresce assumendosi una responsabilità alla volta.</p>
    <ol class="mt-9 flex snap-x snap-mandatory gap-0 overflow-x-auto pb-4" aria-label="Passi per entrare nei progetti">
      <% @markpostura.fetch("entry_steps").each_with_index do |step, index| %>
        <li class="flex min-w-64 snap-start items-stretch sm:min-w-0 sm:flex-1">
          <article class="min-w-56 flex-1 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><span class="flex size-8 items-center justify-center rounded-full border border-amber-300 bg-amber-50 text-xs font-black text-amber-800"><%= step.fetch("number") %></span><h3 class="mt-4 font-black"><%= step.fetch("title") %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= step.fetch("description") %></p></article>
          <% unless index == @markpostura.fetch("entry_steps").size - 1 %><span aria-hidden="true" class="mt-8 h-px w-7 shrink-0 bg-amber-400/30"></span><% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <% flowpulse = @markpostura.fetch("flowpulse") %>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-6 rounded-3xl border border-amber-200 bg-amber-50 p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center"><div><p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700">Flowpulse · creato da Rails4Business</p><h2 class="mt-3 text-3xl font-black tracking-tight"><%= flowpulse.fetch("title") %></h2><p class="mt-4 max-w-3xl leading-7 text-slate-600"><%= flowpulse.fetch("description") %></p></div><%= link_to "Scopri Flowpulse →", flowpulse.fetch("path"), class: "rounded-full bg-slate-950 px-6 py-3 text-center text-sm font-black text-white hover:bg-slate-800" %></div>
  </section>

  <section id="contenuti-eventi" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20">
    <div class="flex items-end justify-between gap-5"><div><h2 class="text-3xl font-black tracking-tight">Contenuti ed eventi</h2><p class="mt-3 text-slate-600">Un solo filo temporale, con il progetto di provenienza sempre visibile.</p></div><%= link_to "Tutti i contenuti →", markpostura_contents_path, class: "hidden text-sm font-black text-amber-700 hover:text-amber-900 sm:block" %></div>
    <% if @markpostura_timeline.any? %>
      <ol class="mt-8 divide-y divide-slate-200 border-y border-slate-200"><% @markpostura_timeline.each do |item| %><li><%= link_to item.fetch("url"), class: "group grid gap-3 py-6 sm:grid-cols-[9rem_1fr_auto] sm:items-start" do %><div><p class="text-xs font-black uppercase tracking-[0.16em] <%= item.fetch("timeline_type") == "event" ? "text-rose-700" : "text-sky-700" %>"><%= item.fetch("timeline_label") %></p><time class="mt-1 block text-sm text-slate-500"><%= item["timeline_date"]&.strftime("%d/%m/%Y") || "Data da definire" %></time></div><div><h3 class="text-lg font-black group-hover:text-amber-700"><%= item.fetch("title") %></h3><p class="mt-1 text-sm text-slate-500"><%= item["canonical_domain_name"] %></p></div><span class="hidden text-slate-300 group-hover:text-amber-700 sm:block">→</span><% end %></li><% end %></ol>
    <% else %><p class="mt-8 rounded-2xl border border-dashed border-slate-300 p-6 text-slate-600">I prossimi contenuti ed eventi compariranno qui.</p><% end %>
  </section>

  <section class="border-y border-slate-200 bg-slate-50"><% book = @markpostura.fetch("book") %><div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-20 lg:grid-cols-[0.55fr_1fr]"><%= image_tag book.fetch("image"), alt: book.fetch("image_alt"), class: "mx-auto aspect-[4/5] w-full max-w-xs rounded-3xl object-cover", loading: "lazy" %><div><p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700"><%= book.fetch("eyebrow") %></p><h2 class="mt-4 text-4xl font-black tracking-tight"><%= book.fetch("title") %></h2><p class="mt-5 text-lg leading-8 text-slate-600"><%= book.fetch("description") %></p></div></div></section>

  <section class="mx-auto max-w-4xl px-5 py-20 text-center"><% contact = @markpostura.fetch("contact") %><h2 class="text-4xl font-black tracking-tight"><%= contact.fetch("title") %></h2><p class="mx-auto mt-4 max-w-2xl leading-7 text-slate-600"><%= contact.fetch("description") %></p><div class="mt-8 flex flex-wrap justify-center gap-3"><%= link_to "Scrivi su WhatsApp", contact.fetch("whatsapp"), class: "rounded-full bg-slate-950 px-6 py-3 text-sm font-black text-white hover:bg-slate-800" %><%= mail_to contact.fetch("email"), "Invia una email", class: "rounded-full border border-slate-300 px-6 py-3 text-sm font-black hover:bg-slate-50" %></div></section>
    </div>
  </div>
  <footer class="border-t border-slate-200 px-5 py-8 text-center text-sm text-slate-500">Mark Postura · postura, natura e tecnologia</footer>
</main>
