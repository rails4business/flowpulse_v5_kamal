<% site = @rails4b.fetch("site") %>
<% content_for :title, site.fetch("title") %>
<% content_for :description, site.fetch("description") %>

<main class="min-h-screen bg-stone-50 text-slate-900">
  <%= render "landing/rails4b_nav", active: :home %>

  <header class="border-y border-blue-100 bg-blue-50/50 py-8 sm:py-10">
    <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
      <h1 class="mx-auto max-w-3xl text-3xl font-black tracking-[-0.045em] text-slate-950 sm:text-5xl"><%= site.fetch("hero_title") %></h1>
      <p class="mx-auto mt-3 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg"><%= site.fetch("hero_description") %></p>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14" aria-labelledby="scegli-percorso">
    <h2 id="scegli-percorso" class="sr-only">Scegli il percorso</h2>
    <nav class="mx-auto flex max-w-xl rounded-2xl border border-slate-200 bg-white p-1.5" aria-label="Scegli il percorso">
      <% @rails4b_path.fetch("tracks").each do |track| %>
        <%= link_to track.fetch("title"), rails4b_path(percorso: track.fetch("slug")), class: "flex-1 rounded-xl px-4 py-3 text-center text-sm font-black transition #{track == @rails4b_track ? "bg-blue-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100 hover:text-blue-700"}", aria: { current: (track == @rails4b_track ? "page" : nil) } %>
      <% end %>
    </nav>

    <p class="mt-7 text-center text-xs font-semibold text-slate-500 sm:hidden">Scorri orizzontalmente per vedere tutti i passi →</p>
    <ol class="mt-7 flex snap-x snap-mandatory gap-0 overflow-x-auto pb-4 pt-1" aria-label="Passi del percorso <%= @rails4b_track.fetch("title") %>">
      <% @rails4b_track_steps.each_with_index do |step, index| %>
        <li class="flex min-w-64 snap-start items-stretch sm:min-w-0 sm:flex-1">
          <%= link_to rails4b_track_path(@rails4b_track.fetch("slug"), contenuto: step.fetch("slug")), class: "group min-w-56 flex-1 rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-blue-300 hover:bg-blue-50/40 hover:shadow-sm" do %>
            <span class="flex size-8 items-center justify-center rounded-full border border-blue-200 bg-blue-50 text-xs font-black text-blue-700"><%= step.fetch("number") %></span>
            <h3 class="mt-4 text-base font-black text-slate-950 group-hover:text-blue-700"><%= step.fetch("title") %></h3>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= step.fetch("description") %></p>
            <span class="mt-4 inline-flex text-sm font-bold text-blue-700">Apri <span class="ml-2 transition group-hover:translate-x-1">→</span></span>
          <% end %>
          <% unless index == @rails4b_track_steps.size - 1 %>
            <span aria-hidden="true" class="mt-8 h-px w-7 shrink-0 bg-blue-200 sm:w-5 lg:w-8"></span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-16" aria-labelledby="rete">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-700">Una rete, non una scorciatoia</p>
        <h2 id="rete" class="mt-3 text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= @rails4b.fetch("ecosystem").fetch("title") %></h2>
        <p class="mt-4 text-lg leading-8 text-slate-600"><%= @rails4b.fetch("ecosystem").fetch("description") %></p>
      </div>
      <div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% @rails4b.fetch("ecosystem").fetch("entries").each do |entry| %>
          <%= link_to entry.fetch("path"), class: "rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300 hover:bg-blue-50/40" do %>
            <p class="text-sm font-black text-slate-950"><%= entry.fetch("title") %></p>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= entry.fetch("description") %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <footer class="bg-blue-50 py-12 text-center"><p class="mx-auto max-w-xl px-5 text-lg leading-8 text-slate-600"><%= site.fetch("footer") %></p><div class="mt-5 text-sm"><%= render "shared/changelog_footer_link", brand: "rails4business" %></div></footer>
</main>
