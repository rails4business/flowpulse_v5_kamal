<% site = @rails4b.fetch("site") %>
<% content_for :title, site.fetch("title") %>
<% content_for :description, site.fetch("description") %>

<main class="min-h-screen bg-stone-50 text-slate-900">
  <%= render "landing/rails4b_nav", active: :home %>

  <header class="border-y border-blue-100 bg-gradient-to-br from-blue-50 via-white to-amber-50/60">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-blue-700"><%= site.fetch("eyebrow") %></p>
        <h1 class="mt-5 max-w-4xl text-4xl font-black tracking-[-0.05em] text-slate-950 sm:text-6xl"><%= site.fetch("hero_title") %></h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl"><%= site.fetch("hero_description") %></p>
        <div class="mt-8 flex flex-wrap gap-3">
          <%= link_to site.dig("primary_action", "label"), site.dig("primary_action", "path"), class: "rounded-full bg-blue-600 px-6 py-3 text-sm font-black text-white transition hover:bg-blue-700" %>
          <%= link_to site.dig("secondary_action", "label"), site.dig("secondary_action", "path"), class: "rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-black text-slate-700 transition hover:border-blue-300 hover:text-blue-700" %>
        </div>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-950 p-7 text-white shadow-xl shadow-slate-200/60 sm:p-9" aria-label="Dalla persona al processo">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-blue-300">I collegamenti essenziali</p>
        <ol class="mt-6 space-y-4">
          <% ["Persona e Brand", "Impresa e Brand", "Brand e progetti", "Progetti e attività", "Attività e processo"].each_with_index do |label, index| %>
            <li class="flex items-center gap-4"><span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/10 text-xs font-black"><%= index + 1 %></span><span class="font-bold"><%= label %></span></li>
          <% end %>
        </ol>
      </div>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8" aria-labelledby="rails4b-audiences">
    <div class="max-w-3xl"><h2 id="rails4b-audiences" class="text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= @rails4b.dig("audiences", "title") %></h2><p class="mt-4 text-lg leading-8 text-slate-600"><%= @rails4b.dig("audiences", "description") %></p></div>
    <div class="mt-9 grid gap-4 md:grid-cols-3"><% @rails4b.dig("audiences", "entries").each do |entry| %><article class="rounded-2xl border border-slate-200 bg-white p-6"><h3 class="text-xl font-black"><%= entry.fetch("title") %></h3><p class="mt-3 leading-7 text-slate-600"><%= entry.fetch("description") %></p></article><% end %></div>
  </section>

  <section class="border-y border-slate-200 bg-white py-16" aria-labelledby="rails4b-pillars"><div class="mx-auto max-w-6xl px-5 sm:px-8"><h2 id="rails4b-pillars" class="text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= @rails4b.dig("pillars", "title") %></h2><ol class="mt-9 grid gap-5 lg:grid-cols-3"><% @rails4b.dig("pillars", "entries").each do |entry| %><li class="rounded-3xl bg-slate-950 p-7 text-white"><span class="text-sm font-black text-blue-300"><%= entry.fetch("number") %></span><h3 class="mt-4 text-2xl font-black"><%= entry.fetch("title") %></h3><p class="mt-3 leading-7 text-slate-300"><%= entry.fetch("description") %></p></li><% end %></ol></div></section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8" aria-labelledby="rails4b-tools">
    <div class="max-w-3xl"><h2 id="rails4b-tools" class="text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= @rails4b.dig("tools", "title") %></h2><p class="mt-4 text-lg leading-8 text-slate-600"><%= @rails4b.dig("tools", "description") %></p></div>
    <div class="mt-9 grid gap-4 sm:grid-cols-2"><% @rails4b.dig("tools", "entries").each do |entry| %><%= link_to entry.fetch("path"), class: "group rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-blue-300 hover:bg-blue-50/40" do %><p class="text-xs font-black uppercase tracking-[0.16em] text-blue-700"><%= entry.fetch("label") %></p><h3 class="mt-2 text-2xl font-black group-hover:text-blue-700"><%= entry.fetch("title") %></h3><p class="mt-3 leading-7 text-slate-600"><%= entry.fetch("description") %></p><span class="mt-5 inline-flex text-sm font-black text-blue-700">Apri →</span><% end %><% end %></div>
  </section>

  <section class="border-y border-slate-200 bg-blue-50/60 py-16" aria-labelledby="rails4b-structure"><div class="mx-auto max-w-6xl px-5 sm:px-8"><div class="max-w-4xl"><h2 id="rails4b-structure" class="text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= @rails4b.dig("structure", "title") %></h2><p class="mt-4 text-lg leading-8 text-slate-600"><%= @rails4b.dig("structure", "description") %></p></div><ol class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-5"><% @rails4b.dig("structure", "levels").each_with_index do |level, index| %><li class="rounded-2xl border border-blue-100 bg-white p-5"><span class="text-xs font-black text-blue-700"><%= index + 1 %></span><h3 class="mt-2 text-lg font-black"><%= level.fetch("title") %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= level.fetch("description") %></p></li><% end %></ol></div></section>

  <% brand_types = @rails4b.fetch("brand_types") %>
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8" aria-labelledby="rails4b-brand-types">
    <div class="max-w-4xl"><p class="text-xs font-black uppercase tracking-[0.18em] text-violet-700"><%= brand_types.fetch("eyebrow") %></p><h2 id="rails4b-brand-types" class="mt-3 text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= brand_types.fetch("title") %></h2><p class="mt-4 text-lg leading-8 text-slate-600"><%= brand_types.fetch("description") %></p></div>
    <div class="mt-9 grid gap-5 md:grid-cols-2">
      <% brand_types.fetch("entries").each do |entry| %>
        <%= link_to entry.fetch("path"), class: "group rounded-3xl border border-violet-200 bg-white p-7 transition hover:border-violet-400 hover:bg-violet-50/40" do %>
          <p class="text-xs font-black uppercase tracking-[0.16em] text-violet-700"><%= entry.fetch("example") %></p><h3 class="mt-3 text-2xl font-black group-hover:text-violet-800"><%= entry.fetch("title") %></h3><p class="mt-3 leading-7 text-slate-600"><%= entry.fetch("description") %></p><span class="mt-5 inline-flex text-sm font-black text-violet-700">Apri l'esempio →</span>
        <% end %>
      <% end %>
    </div>
  </section>

  <% brand_network = @rails4b.fetch("brand_network") %>
  <section class="border-y border-slate-200 bg-white py-16" aria-labelledby="rails4b-brand-network">
    <div class="mx-auto max-w-6xl px-5 sm:px-8"><div class="max-w-4xl"><p class="text-xs font-black uppercase tracking-[0.18em] text-emerald-700"><%= brand_network.fetch("eyebrow") %></p><h2 id="rails4b-brand-network" class="mt-3 text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= brand_network.fetch("title") %></h2><p class="mt-4 text-lg leading-8 text-slate-600"><%= brand_network.fetch("description") %></p></div><div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% brand_network.fetch("principles").each do |principle| %><article class="rounded-2xl border border-slate-200 p-5"><h3 class="font-black"><%= principle.fetch("title") %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= principle.fetch("description") %></p></article><% end %></div><p class="mt-7 rounded-2xl border border-emerald-200 bg-emerald-50 p-5 font-semibold leading-7 text-emerald-950"><%= brand_network.fetch("example") %></p></div>
  </section>

  <% case_study = @rails4b.fetch("case_study") %>
  <section class="mx-auto grid max-w-6xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start" aria-labelledby="rails4b-case-study"><div><p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700"><%= case_study.fetch("eyebrow") %></p><h2 id="rails4b-case-study" class="mt-3 text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= case_study.fetch("title") %></h2><p class="mt-4 text-lg leading-8 text-slate-600"><%= case_study.fetch("description") %></p><p class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm font-bold leading-6 text-amber-950"><%= case_study.fetch("note") %></p></div><ol class="space-y-3"><% case_study.fetch("steps").each_with_index do |step, index| %><li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5"><span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xs font-black text-amber-800"><%= index + 1 %></span><span class="font-bold leading-7"><%= step %></span></li><% end %></ol></section>

  <section class="border-y border-slate-200 bg-white py-16" aria-labelledby="rails4b-topics"><div class="mx-auto max-w-6xl px-5 sm:px-8"><div class="max-w-3xl"><h2 id="rails4b-topics" class="text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= @rails4b.dig("topics", "title") %></h2><p class="mt-4 text-lg leading-8 text-slate-600"><%= @rails4b.dig("topics", "description") %></p></div><div class="mt-9 grid gap-x-8 gap-y-7 md:grid-cols-2 lg:grid-cols-3"><% @rails4b.dig("topics", "entries").each do |entry| %><article class="border-t-2 border-blue-600 pt-4"><h3 class="text-lg font-black"><%= entry.fetch("title") %></h3><p class="mt-2 leading-7 text-slate-600"><%= entry.fetch("description") %></p></article><% end %></div><%= link_to "Tutti i contenuti Rails4Business →", rails4b_contents_path, class: "mt-10 inline-flex rounded-full bg-blue-600 px-6 py-3 text-sm font-black text-white hover:bg-blue-700" %></div></section>

  <% sources = @rails4b.fetch("sources") %>
  <section class="bg-slate-950 py-16 text-white" aria-labelledby="rails4b-sources">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="max-w-3xl"><h2 id="rails4b-sources" class="text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= sources.fetch("title") %></h2><p class="mt-4 text-lg leading-8 text-slate-300"><%= sources.fetch("description") %></p></div>
      <div class="mt-9 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% sources.fetch("entries").each do |entry| %>
          <%= link_to entry.fetch("url"), target: "_blank", rel: "noopener noreferrer", class: "group rounded-2xl border border-white/15 bg-white/5 p-6 transition hover:border-blue-300/60 hover:bg-white/10" do %>
            <p class="text-xs font-black uppercase tracking-[0.16em] text-blue-300"><%= entry.fetch("label") %></p><h3 class="mt-2 text-xl font-black"><%= entry.fetch("title") %></h3><p class="mt-3 text-sm leading-6 text-slate-300"><%= entry.fetch("description") %></p><span class="mt-5 inline-flex text-sm font-black text-blue-300">Apri la fonte ↗</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <% wellbeing = @rails4b.fetch("wellbeing") %>
  <section class="mx-auto max-w-5xl px-5 py-16 text-center sm:px-8" aria-labelledby="rails4b-wellbeing"><p class="text-xs font-black uppercase tracking-[0.18em] text-emerald-700"><%= wellbeing.fetch("eyebrow") %></p><h2 id="rails4b-wellbeing" class="mt-3 text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= wellbeing.fetch("title") %></h2><p class="mx-auto mt-5 max-w-4xl text-lg leading-8 text-slate-600"><%= wellbeing.fetch("description") %></p><div class="mt-7 flex flex-wrap justify-center gap-3"><% wellbeing.fetch("links").each do |link| %><%= link_to "#{link.fetch("label")} →", link.fetch("path"), class: "rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-black text-slate-700 hover:border-emerald-300 hover:text-emerald-700" %><% end %></div></section>

  <% collaboration = @rails4b.fetch("collaboration") %>
  <section class="bg-slate-950 py-16 text-white" aria-labelledby="rails4b-collaboration"><div class="mx-auto max-w-4xl px-5 text-center sm:px-8"><h2 id="rails4b-collaboration" class="text-3xl font-black tracking-[-0.04em] sm:text-4xl"><%= collaboration.fetch("title") %></h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-slate-300"><%= collaboration.fetch("description") %></p><div class="mt-8 flex flex-wrap justify-center gap-3"><%= link_to collaboration.dig("primary_action", "label"), collaboration.dig("primary_action", "path"), class: "rounded-full bg-blue-500 px-6 py-3 text-sm font-black text-white hover:bg-blue-400" %><%= link_to collaboration.dig("secondary_action", "label"), collaboration.dig("secondary_action", "path"), class: "rounded-full border border-white/20 px-6 py-3 text-sm font-black text-white hover:bg-white/10" %></div></div></section>

  <footer class="bg-blue-50 py-12 text-center"><p class="mx-auto max-w-xl px-5 text-lg leading-8 text-slate-600"><%= site.fetch("footer") %></p><div class="mt-5 text-sm"><%= render "shared/changelog_footer_link", brand: "rails4business" %></div></footer>
</main>
