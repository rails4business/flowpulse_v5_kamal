<% content_for :title, "Corso — Il tuo stato di salute" %>
<main class="min-h-screen bg-emerald-50/40 text-slate-950">
  <nav class="border-b border-emerald-100 bg-white"><div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8"><%= link_to "Stato di Salute", stato_di_salute_path, class: "text-sm font-black uppercase tracking-[.16em] text-emerald-800" %><%= link_to "Valutazioni", stato_di_salute_path(anchor: "ambiti"), class: "rounded-full bg-emerald-700 px-4 py-2 text-sm font-black text-white" %></div></nav>
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
    <header class="mb-8"><p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Corso online</p><h1 class="mt-2 text-4xl font-black tracking-tight">Il tuo stato di salute</h1></header>
    <div class="grid gap-8 lg:grid-cols-[20rem_minmax(0,1fr)]">
      <aside><ol class="space-y-2"><% @health_course_chapters.each_with_index do |chapter, index| %><li><%= link_to stato_di_salute_course_chapter_path(chapter.fetch("slug")), class: "block rounded-xl border #{chapter == @health_course_chapter ? 'border-emerald-300 bg-emerald-100' : 'border-slate-200 bg-white'} p-3" do %><span class="text-xs font-black text-emerald-700"><%= format("%02d", index + 1) %></span><strong class="ml-2 text-sm"><%= chapter.fetch("title") %></strong><% end %></li><% end %></ol></aside>
      <article class="rounded-3xl border border-emerald-100 bg-white p-7 shadow-sm sm:p-10">
        <% if @health_course_chapter %>
          <p class="text-xs font-black uppercase tracking-[.16em] text-emerald-700">Capitolo <%= format("%02d", @health_course_chapters.index(@health_course_chapter) + 1) %></p>
          <% if @health_course_chapter["generated"] %><h2 class="mt-3 text-3xl font-black"><%= @health_course_chapter.fetch("title") %></h2><p class="mt-5 text-lg leading-8 text-slate-600"><%= @health_course_chapter.fetch("description") %></p><%= link_to "Fai la valutazione di questo ambito →", stato_di_salute_path(anchor: "ambiti"), class: "mt-7 inline-flex rounded-xl bg-emerald-700 px-5 py-3 text-sm font-black text-white" %><% else %><div class="editorial-rich-text editorial-rich-text--emerald"><%= markdown(@health_course_markdown) %></div><% end %>
        <% else %>
          <h2 class="text-3xl font-black">Osserva il tuo punto di partenza</h2><p class="mt-4 leading-7 text-slate-600">Quattro capitoli introduttivi e sette ambiti distinti per leggere il tuo stato di salute senza sostituire diagnosi o valutazioni professionali.</p><%= link_to "Inizia dal primo capitolo", stato_di_salute_course_chapter_path(@health_course_chapters.first.fetch("slug")), class: "mt-7 inline-flex rounded-xl bg-emerald-700 px-5 py-3 text-sm font-black text-white" %>
        <% end %>
      </article>
    </div>
  </div>
</main>
