<%# app/views/landing/_accademia_curriculum.html.erb %>
<%# Richiamo nel template: render "landing/accademia_curriculum" %>
<%
  academy_modules = @academy_modules || []
  academy_path = @academy_path || {}
  academy_areas = @academy_areas || []
  academy_teachers = @academy_teachers || {}
  academy_locations = @academy_locations || {}
  academy_summary = (@academy_curriculum || {}).fetch("summary", {})
  academy_lesson_count = academy_modules.sum { |academy_module| academy_module.fetch("lessons").size }
  active_area_slug = academy_areas.first&.fetch("slug", nil)
  active_main_tab = params[:tab] == "guide" ? "guide" : "curriculum"
%>



<section id="academy-curriculum" aria-labelledby="academy-curriculum-title">
  <section id="top" class="bg-white px-5 pb-12 pt-16 md:pt-24">
    <div class="mx-auto w-full max-w-[1600px] lg:grid lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">Postura e fisiologia</p>
        <h1 id="academy-curriculum-title" class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-slate-950 md:text-5xl md:leading-[1.03]">
          Conosci il tuo corpo e <br class="hidden sm:block">
          riattiva i tuoi sistemi fisiologici.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600">
          Scopri le basi delle principali metodiche utilizzate in ambito terapeutico,
          comprendine possibilità e limiti e scegli con maggiore consapevolezza il tuo
          percorso di salute.
        </p>

         <div class="mt-12 grid grid-cols-3 divide-x divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/50 shadow-sm">
          <div class="px-3 py-4 text-center sm:px-6">
            <strong class="block text-2xl font-bold text-slate-900"><%= academy_summary.fetch("participants", academy_modules.sum { |academy_module| academy_module.fetch("participants").to_i }) %></strong>
            <span class="mt-1 block text-[10px] font-semibold uppercase tracking-widest text-slate-500">Partecipanti</span>
          </div>
          <div class="px-3 py-4 text-center sm:px-6">
            <strong class="block text-2xl font-bold text-slate-900"><%= academy_summary.fetch("teachers", academy_teachers.size) %></strong>
            <span class="mt-1 block text-[10px] font-semibold uppercase tracking-widest text-slate-500">Insegnanti</span>
          </div>
          <div class="px-3 py-4 text-center sm:px-6">
            <strong class="block text-2xl font-bold text-slate-900"><%= academy_summary.fetch("centers", academy_locations.size) %></strong>
            <span class="mt-1 block text-[10px] font-semibold uppercase tracking-widest text-slate-500">Centri</span>
          </div>
        </div>
        <!-- I bottoni tab primari sono stati spostati sotto -->

       
      </div>

      <div class="mt-16 lg:mt-0">
        <div class="pentagon-container mx-auto max-w-md">
  <svg
    viewBox="0 0 300 300"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto"
    style="filter: drop-shadow(0 10px 15px rgba(15, 23, 42, 0.08));"
  >
    <style>
      .postura-frame {
        fill: white;
        stroke: #64748b;
        stroke-width: 3;
      }

      .postura-label {
        font-family: Inter, sans-serif;
        font-size: 12px;
        font-weight: 800;
        text-anchor: middle;
        fill: #334155;
        letter-spacing: 1px;
      }

      .link {
        stroke: #94a3b8;
        stroke-width: 2.5;
        stroke-linecap: round;
      }

      .outer-link {
        fill: none;
        stroke: #64748b;
        stroke-width: 2.5;
        stroke-linejoin: round;
      }

      .node {
        stroke-width: 3;
      }

      .text {
        font-family: Inter, sans-serif;
        font-size: 8px;
        font-weight: 800;
        text-anchor: middle;
        dominant-baseline: middle;
        fill: #334155;
      }

      .center-text {
        font-size: 11px;
        fill: white;
      }

      .water {
        fill: #faf5ff;
        stroke: #7c3aed;
      }

      .fire {
        fill: #fff1f2;
        stroke: #e11d48;
      }

      .earth {
        fill: #fff7ed;
        stroke: #f97316;
      }

      .metal {
        fill: #eff6ff;
        stroke: #2563eb;
      }

      .wood {
        fill: #f0fdf4;
        stroke: #16a34a;
      }

      .center-node {
        fill: #334155;
        stroke: #1e293b;
      }

      /* Tinte Viola per Recupera */
      .side a.active { color: #6d28d9 !important; }
      .side a.active .side-num { background: #7c3aed !important; color: white !important; }
      
      #recupera .module.open { border-color: #c4b5fd !important; }
      #recupera .module-index { color: #7c3aed !important; background: #f3e8ff !important; }
      #recupera .module-tab.active { color: #7c3aed !important; border-bottom-color: #7c3aed !important; }
    </style>

    <!-- POSTURA: contenitore generale -->
    <rect
      x="2"
      y="2"
      width="296"
      height="296"
      rx="22"
      class="postura-frame"
    />

    <!-- Struttura pentagonale -->
    <polygon
      points="150,40 254,115 215,238 85,238 46,115"
      class="outer-link"
    />

    <!-- Collegamenti con la fisiologia -->
    <line x1="150" y1="150" x2="150" y2="40" class="link" />
    <line x1="150" y1="150" x2="254" y2="115" class="link" />
    <line x1="150" y1="150" x2="215" y2="238" class="link" />
    <line x1="150" y1="150" x2="85" y2="238" class="link" />
    <line x1="150" y1="150" x2="46" y2="115" class="link" />

    <!-- Ascolto (Rosso - Alto) -->
    <circle cx="150" cy="40" r="32" class="node fire" />
    <text x="150" y="30" class="text">
      <tspan x="150" dy="0">Ascolta</tspan>
      <tspan x="150" dy="10">gli aspetti</tspan>
      <tspan x="150" dy="10">vitali</tspan>
    </text>

    <!-- Nutrimento (Giallo - Destra) -->
    <circle cx="254" cy="115" r="32" class="node earth" />
    <text x="254" y="110" class="text">
      <tspan x="254" dy="0">Nutri</tspan>
      <tspan x="254" dy="10">il corpo</tspan>
    </text>

    <!-- Regolazione (Blu - Basso Destra) -->
    <circle cx="215" cy="238" r="32" class="node metal" />
    <text x="215" y="228" class="text">
      <tspan x="215" dy="0">Regola</tspan>
      <tspan x="215" dy="10">con le piante</tspan>
      <tspan x="215" dy="10">officinali</tspan>
    </text>

    <!-- Recupero (Viola - Basso Sinistra) -->
    <circle cx="85" cy="238" r="32" class="node water" />
    <text x="85" y="228" class="text">
      <tspan x="85" dy="0">Recupera</tspan>
      <tspan x="85" dy="10">con la terapia</tspan>
      <tspan x="85" dy="10">manuale</tspan>
    </text>

    <!-- Movimento (Verde - Sinistra) -->
    <circle cx="46" cy="115" r="32" class="node wood" />
    <text x="46" y="110" class="text">
      <tspan x="46" dy="0">Muoviti</tspan>
      <tspan x="46" dy="10">ed esplora</tspan>
    </text>

    <!-- Fisiologia -->
    <circle
      cx="150"
      cy="150"
      r="42"
      class="node center-node"
    />

    <text x="150" y="150" class="text center-text">
      Fisiologia
    </text>

    <!-- Etichetta del contenitore -->
    <text x="150" y="284" class="postura-label">
      POSTURA
    </text>
  </svg>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-slate-50/50 pt-16 pb-8 border-t border-slate-200">
    <div class="mx-auto max-w-[1600px] px-5 text-center">
      <div class="inline-flex rounded-xl border border-slate-200 bg-white p-1 shadow-sm">
        <button type="button" onclick="switchAcademyTab('curriculum')" id="btn-tab-curriculum" class="rounded-lg <%= active_main_tab == 'curriculum' ? 'bg-slate-100 text-slate-900 shadow-sm ring-1 ring-slate-900/5' : 'bg-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-50' %> px-6 py-2.5 text-sm font-semibold transition-all">
          🎓 Il Programma dell'Accademia
        </button>
        <button type="button" onclick="switchAcademyTab('guide')" id="btn-tab-guide" class="rounded-lg <%= active_main_tab == 'guide' ? 'bg-slate-100 text-slate-900 shadow-sm ring-1 ring-slate-900/5' : 'bg-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-50' %> px-6 py-2.5 text-sm font-medium transition-all">
          📖 Come funziona?
        </button>
      </div>
    </div>
  </div>

  <div class="bg-slate-100 pb-20">
    <div id="content-tab-curriculum" class="<%= 'hidden ' if active_main_tab == 'guide' %> pt-8">
      
      <!-- Area linguette su sfondo grigio -->
      <div class="mx-auto max-w-[1600px] px-2 sm:px-5">
        <div class="relative z-10 flex overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          <nav class="flex space-x-1 pl-4 lg:pl-8 items-end" aria-label="Aree Accademia">
            <button type="button" id="btn-area-recupera" data-active-color="text-violet-700" data-inactive-color="text-violet-600/70" onclick="switchAreaTab('recupera')" class="area-tab-btn relative z-10 rounded-t-xl border border-b-0 border-slate-200 bg-white px-6 py-3 pb-3.5 text-sm font-semibold text-violet-700 transition-colors">
              Recupera <span class="hidden sm:inline">con la terapia manuale</span>
            </button>
            <button type="button" id="btn-area-muoviti" data-active-color="text-green-600" data-inactive-color="text-green-600/70" onclick="switchAreaTab('muoviti')" class="area-tab-btn relative z-0 rounded-t-xl border border-transparent border-b-0 mb-px px-6 py-3 text-sm font-medium text-green-600/70 hover:bg-slate-200/50 hover:text-green-700 transition-colors">
              Muoviti <span class="hidden sm:inline">ed esplora</span>
            </button>
            <button type="button" id="btn-area-ascolta" data-active-color="text-rose-600" data-inactive-color="text-rose-600/70" onclick="switchAreaTab('ascolta')" class="area-tab-btn relative z-0 rounded-t-xl border border-transparent border-b-0 mb-px px-6 py-3 text-sm font-medium text-rose-600/70 hover:bg-slate-200/50 hover:text-rose-700 transition-colors">
              Ascolta <span class="hidden sm:inline">gli aspetti vitali</span>
            </button>
            <button type="button" id="btn-area-nutri" data-active-color="text-orange-500" data-inactive-color="text-orange-500/70" onclick="switchAreaTab('nutri')" class="area-tab-btn relative z-0 rounded-t-xl border border-transparent border-b-0 mb-px px-6 py-3 text-sm font-medium text-orange-500/70 hover:bg-slate-200/50 hover:text-orange-600 transition-colors">
              Nutri <span class="hidden sm:inline">il corpo</span>
            </button>
            <button type="button" id="btn-area-regola" data-active-color="text-blue-600" data-inactive-color="text-blue-600/70" onclick="switchAreaTab('regola')" class="area-tab-btn relative z-0 rounded-t-xl border border-transparent border-b-0 mb-px px-6 py-3 text-sm font-medium text-blue-600/70 hover:bg-slate-200/50 hover:text-blue-700 transition-colors">
              Regola <span class="hidden sm:inline">con le piante officinali</span>
            </button>
          </nav>
        </div>
      </div>
      
      <!-- Sfondo Bianco Principale: il border-t si infila di 1px sotto la tab attiva -->
      <div class="relative -mt-px border-t border-slate-200 bg-white shadow-[0_-2px_6px_rgba(0,0,0,0.02)]">
        <div class="mx-auto max-w-[1600px] px-2 sm:px-5">
          <main class="py-12 lg:py-16" data-initial-area="<%= active_area_slug %>">
    <section id="recupera" class="area-content scroll-mt-24">
      <div class="lg:grid lg:grid-cols-12 lg:gap-12">
        <%# -- BACKDROP SCURO (Mobile) -- %>
        <div id="mobileAsideBackdrop" class="fixed inset-0 z-40 hidden bg-slate-900/20 backdrop-blur-sm lg:hidden transition-opacity opacity-0 duration-300"></div>

        <nav id="mobileAsidePanel" class="side fixed inset-y-0 left-0 z-50 h-[100dvh] w-72 max-w-[85vw] transform -translate-x-full overflow-y-auto bg-white p-6 shadow-2xl transition-transform duration-300 ease-in-out lg:static lg:z-auto lg:block lg:col-span-3 lg:h-auto lg:sticky lg:top-24 lg:self-start lg:w-auto lg:max-w-none lg:translate-x-0 lg:overflow-visible lg:bg-transparent lg:p-0 lg:shadow-none" aria-label="Indice dell'Accademia">
          <!-- Mobile Close Button -->
          <div class="mb-6 flex items-center justify-between lg:hidden">
            <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-950">Indice Moduli</span>
            <button type="button" id="closeMobileAsideBtn" class="rounded-md p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
              <span class="sr-only">Chiudi menu</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>

          <p class="side-label">Inizia</p>
          <a href="#top" id="nav-top">
            <span>La Mappa dell'Accademia</span>
          </a>

          <p class="side-label" style="margin-top: 24px;">Percorsi</p>
          <% academy_modules.each_with_index do |academy_module, index| %>
            <a class="<%= "active" if index.zero? %>" href="#m<%= index %>" data-module-target="m<%= index %>">
              <span class="side-num"><%= academy_module.fetch("number") %></span>
              <span><%= academy_module.fetch("title") %></span>
              <span class="side-count"><%= academy_module.fetch("lessons").size %></span>
            </a>
          <% end %>
        </nav>

        <div class="lg:col-span-9">
        <div class="section-head" style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
          <div>
            <h2>Recupera con i principi delle terapie manuali</h2>
            <p>Apri un modulo per vedere lezioni, partecipanti, insegnanti e centri.</p>
          </div>
          <div class="legend" style="display: flex; align-items: center; gap: 8px;">
            <!-- Mobile Toggle -->
            <button class="button-utility inline-flex lg:hidden" id="openMobileAsideBtn" type="button" style="align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 8px; background: white; color: #475569; font-size: 11px; font-weight: 700; cursor: pointer;">
              ☰ <span>Indice</span>
            </button>
            <label class="relative flex items-center" style="margin: 0;">
              <span class="sr-only">Cerca modulo o lezione</span>
              <svg class="absolute left-3 h-4 w-4 text-slate-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
              </svg>
              <input id="search" type="text" placeholder="Cerca modulo o lezione…" style="width: 250px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 6px 12px 6px 34px; font-size: 13px; outline: none; transition: all 0.15s ease;" onfocus="this.style.borderColor='#3b82f6'; this.style.boxShadow='0 0 0 1px #3b82f6';" onblur="this.style.borderColor='#cbd5e1'; this.style.boxShadow='none';">
            </label>
            <button class="button-utility" id="academyOpenAll" type="button" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 8px; background: white; color: #475569; font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.15s ease;" onmouseover="this.style.borderColor='#94a3b8';this.style.background='#f8fafc';" onmouseout="this.style.borderColor='#cbd5e1';this.style.background='white';">
              📂 <span class="hidden sm:inline">Apri tutti i moduli</span><span class="sm:hidden">Apri moduli</span>
            </button>
            <button class="button-utility" type="button" data-modal-template="academy-roster" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 8px; background: white; color: #475569; font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.15s ease;" onmouseover="this.style.borderColor='#94a3b8';this.style.background='#f8fafc';" onmouseout="this.style.borderColor='#cbd5e1';this.style.background='white';">
              👥 <span class="hidden sm:inline">Tutti gli insegnanti</span><span class="sm:hidden">Insegnanti</span>
            </button>
          </div>
        </div>
        <div class="module-list" id="moduleList">
          <%= render partial: "landing/academy/module",
                     collection: academy_modules,
                     as: :academy_module,
                     locals: { academy_teachers: academy_teachers, academy_locations: academy_locations } %>
        </div>
        <div class="empty" id="empty">Nessun modulo corrisponde alla ricerca.</div>
        </div> <!-- end col-span-9 -->
      </div> <!-- end grid -->
      </section>

      <section id="muoviti" class="scroll-mt-24 area-content hidden max-w-4xl mx-auto">
        <div class="rounded-2xl border border-green-200 bg-green-50/50 p-8 text-center mb-8">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100 text-green-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-green-900">In arrivo</h2>
          <p class="mt-2 text-green-700 max-w-lg mx-auto">Stiamo lavorando per integrare questi moduli nell'Accademia. Presto potrai esplorare i percorsi dedicati al movimento.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <% ["Rinforzo muscolare", "Una sequenza dalla kinesiologia", "I cinque tibetani", "Gli 8 pezzi di brocato", "Una sequenza dello yoga", "Lo sviluppo del movimento dei bambini DNS", "Animal Flow", "Movimenti arcaici", "La capoeira", "Il tai chi"].each do |title| %>
            <div class="rounded-xl border border-slate-200 bg-white p-4 opacity-75 grayscale flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-400">🔒</span>
              <span class="font-medium text-slate-600"><%= title %></span>
            </div>
          <% end %>
        </div>
      </section>

      <section id="ascolta" class="scroll-mt-24 area-content hidden max-w-4xl mx-auto">
        <div class="rounded-2xl border border-rose-200 bg-rose-50/50 p-8 text-center mb-8">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-rose-100 text-rose-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-rose-900">In arrivo</h2>
          <p class="mt-2 text-rose-700 max-w-lg mx-auto">I percorsi dedicati all'ascolto degli aspetti emotivi e mentali sono in fase di sviluppo.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <% ["La morfopsicologia", "Human design", "Caisedo Sofrologia", "Corpo e coscienza", "Yoga nozioni avanzate", "Su wen medicina cinese fenomenologia", "Siamo fatti di parole", "Il potere delle storie", "Efficacia personale", "Il viaggio dell'eroe", "La medicina del Suono", "Il teatro", "Il giardino del corpo"].each do |title| %>
            <div class="rounded-xl border border-slate-200 bg-white p-4 opacity-75 grayscale flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-400">🔒</span>
              <span class="font-medium text-slate-600"><%= title %></span>
            </div>
          <% end %>
        </div>
      </section>

      <section id="nutri" class="scroll-mt-24 area-content hidden max-w-4xl mx-auto">
        <div class="rounded-2xl border border-orange-200 bg-orange-50/50 p-8 text-center mb-8">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-orange-100 text-orange-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-orange-900">In arrivo</h2>
          <p class="mt-2 text-orange-700 max-w-lg mx-auto">Stiamo preparando i moduli per comprendere a fondo l'alimentazione e la nutrizione.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <% ["Cosa stiamo mangiando?", "Cos'è il cibo?", "Il cibo viene dalla terra", "Cibo e industrializzazione", "Cibo un mezzo per trasmettere energia"].each do |title| %>
            <div class="rounded-xl border border-slate-200 bg-white p-4 opacity-75 grayscale flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-400">🔒</span>
              <span class="font-medium text-slate-600"><%= title %></span>
            </div>
          <% end %>
        </div>
      </section>

      <section id="regola" class="scroll-mt-24 area-content hidden max-w-4xl mx-auto">
        <div class="rounded-2xl border border-blue-200 bg-blue-50/50 p-8 text-center mb-8">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-blue-900">In arrivo</h2>
