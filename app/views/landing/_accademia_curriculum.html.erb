      `;
      openModal();
    }
    root.querySelectorAll('[data-modal-template]').forEach(btn => {
      if (btn.closest('#moduleList')) return;
      btn.addEventListener('click', () => openTemplate(btn.dataset.modalTemplate));
    });
    root.querySelector('#closeModal').addEventListener('click', closeModal);
    modal.addEventListener('click', e=>{ if(e.target===modal) closeModal(); });
    document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeModal(); });
  })();

  function switchAcademyTab(tabId) {
    const btnCurriculum = document.getElementById('btn-tab-curriculum');
    const btnGuide = document.getElementById('btn-tab-guide');
    const contentCurriculum = document.getElementById('content-tab-curriculum');
    const contentGuide = document.getElementById('content-tab-guide');

    const activeBtnClass = ['bg-slate-100', 'text-slate-900', 'shadow-sm', 'ring-1', 'ring-slate-900/5'];
    const inactiveBtnClass = ['bg-transparent', 'text-slate-500', 'hover:text-slate-700', 'hover:bg-slate-50'];

    if (tabId === 'curriculum') {
      contentCurriculum.classList.remove('hidden');
      contentGuide.classList.add('hidden');
      
      btnCurriculum.classList.add(...activeBtnClass);
      btnCurriculum.classList.remove(...inactiveBtnClass);
      
      btnGuide.classList.remove(...activeBtnClass);
      btnGuide.classList.add(...inactiveBtnClass);
    } else {
      contentCurriculum.classList.add('hidden');
      contentGuide.classList.remove('hidden');
      
      btnGuide.classList.add(...activeBtnClass);
      btnGuide.classList.remove(...inactiveBtnClass);
      
      btnCurriculum.classList.remove(...activeBtnClass);
      btnCurriculum.classList.add(...inactiveBtnClass);
    }
    
    const url = new URL(window.location);
    url.searchParams.set('tab', tabId);
    window.history.pushState({}, '', url);
  }

  function switchAreaTab(tabId) {
    // Nascondi tutti i contenuti
    document.querySelectorAll('.area-content').forEach(el => {
      el.classList.add('hidden');
    });
    // Mostra il contenuto scelto
    const target = document.getElementById(tabId);
    if (target) {
      target.classList.remove('hidden');
    }

    // Resetta stili dei bottoni
    document.querySelectorAll('.area-tab-btn').forEach(btn => {
      const inactiveColor = btn.dataset.inactiveColor || 'text-slate-500';
      btn.className = "area-tab-btn relative z-0 rounded-t-xl border border-transparent border-b-0 mb-px px-6 py-3 text-sm font-medium hover:bg-slate-200/50 transition-colors " + inactiveColor;
    });

    // Applica stile al bottone attivo
    const activeBtn = document.getElementById('btn-area-' + tabId);
    if (activeBtn) {
      const activeColor = activeBtn.dataset.activeColor || 'text-violet-700';
      activeBtn.className = "area-tab-btn relative z-10 rounded-t-xl border border-b-0 border-slate-200 bg-white px-6 py-3 pb-3.5 text-sm font-semibold transition-colors " + activeColor;
    }

    // Scroll verso le tab per garantire che l'utente veda l'inizio del blocco
    const tabsContainer = document.getElementById('content-tab-curriculum');
    if (tabsContainer) {
      tabsContainer.scrollIntoView({ behavior: 'smooth' });
    }
  }

  </script>
