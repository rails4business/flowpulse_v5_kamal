<script>
  // --- Mobile Sidebar Toggle per Accademia e Guida ---
  function initMobileAsides() {
    const openBtn = document.getElementById("openMobileAsideBtn");
    const closeBtn = document.getElementById("closeMobileAsideBtn");
    const backdrop = document.getElementById("mobileAsideBackdrop");
    const panel = document.getElementById("mobileAsidePanel");

    // Rimuove eventuali listener vecchi se richiamato più volte (evitiamo binding multipli)
    if (openBtn && panel && backdrop && !openBtn.dataset.bound) {
      openBtn.dataset.bound = true;
      function openMobileAside() {
        backdrop.classList.remove("hidden");
        void backdrop.offsetWidth;
        backdrop.classList.remove("opacity-0");
        backdrop.classList.add("opacity-100");
        
        panel.classList.remove("-translate-x-full");
        panel.classList.add("translate-x-0");
      }

      function closeMobileAside() {
        panel.classList.remove("translate-x-0");
        panel.classList.add("-translate-x-full");
        
        backdrop.classList.remove("opacity-100");
        backdrop.classList.add("opacity-0");
        
        setTimeout(() => {
          backdrop.classList.add("hidden");
        }, 300);
      }

      openBtn.addEventListener("click", openMobileAside);
      if(closeBtn) closeBtn.addEventListener("click", closeMobileAside);
      backdrop.addEventListener("click", closeMobileAside);
      
      const panelLinks = panel.querySelectorAll('a[data-module-target]');
      panelLinks.forEach(link => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 1024) closeMobileAside();
        });
      });
    }

    const openGuideBtn = document.getElementById("openMobileGuideAsideBtn");
    const closeGuideBtn = document.getElementById("closeMobileGuideAsideBtn");
    const backdropGuide = document.getElementById("mobileGuideAsideBackdrop");
    const panelGuide = document.getElementById("mobileGuideAsidePanel");

    if (openGuideBtn && panelGuide && backdropGuide && !openGuideBtn.dataset.bound) {
      openGuideBtn.dataset.bound = true;
      function openMobileGuideAside() {
        backdropGuide.classList.remove("hidden");
        void backdropGuide.offsetWidth;
        backdropGuide.classList.remove("opacity-0");
        backdropGuide.classList.add("opacity-100");
        
        panelGuide.classList.remove("-translate-x-full");
        panelGuide.classList.add("translate-x-0");
      }

      function closeMobileGuideAside() {
        panelGuide.classList.remove("translate-x-0");
        panelGuide.classList.add("-translate-x-full");
        
        backdropGuide.classList.remove("opacity-100");
        backdropGuide.classList.add("opacity-0");
        
        setTimeout(() => {
          backdropGuide.classList.add("hidden");
        }, 300);
      }

      openGuideBtn.addEventListener("click", openMobileGuideAside);
      if(closeGuideBtn) closeGuideBtn.addEventListener("click", closeMobileGuideAside);
      backdropGuide.addEventListener("click", closeMobileGuideAside);
      
      const guideLinks = panelGuide.querySelectorAll('a');
      guideLinks.forEach(link => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 1024) closeMobileGuideAside();
        });
      });
    }
  }

  // Esegue l'inizializzazione per coprire tutti i casi (Turbo, load classico e partial reloading)
  initMobileAsides();
  document.addEventListener("turbo:load", initMobileAsides);
</script>
