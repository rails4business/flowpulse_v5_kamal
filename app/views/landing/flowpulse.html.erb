<% content_for :title, "Flowpulse" %>

<main class="max-w-5xl mx-auto px-4 py-6">
      <!-- LANDING -->
      <section id="landing-tab" class="tab-content space-y-6">
        <!-- HERO PREMIUM HEADER -->
        <header class="bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-100 via-stone-50 to-stone-50 rounded-[2.5rem] py-16 text-center sm:py-24 shadow-sm border border-slate-100 mb-12">
          <div class="mx-auto w-full max-w-4xl px-5 sm:px-8 flex flex-col items-center text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 mb-8">
              <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
              <span class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-blue-700">Flowpulse Engine</span>
            </div>

            <h1 class="mx-auto text-5xl font-black leading-[0.94] tracking-[-0.055em] text-slate-900 sm:text-7xl max-w-4xl mb-6">
              Flowpulse
            </h1>

            <h2 class="text-2xl md:text-3xl font-bold text-slate-800 max-w-3xl leading-snug mb-6">
              Trasforma percorsi, interessi, competenze e passioni in un viaggio.
            </h2>

            <p class="mx-auto mt-2 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl mb-10">
              Una piattaforma per organizzare eventi, percorsi e collaborazioni tra professionisti della salute e del benessere, creator, centri, spazi e community locali.
            </p>

            <div class="flex flex-wrap justify-center gap-3">
              <%= verified_link_to "Trova eventi", esperienze_path, class: "rounded-xl bg-blue-600 px-6 py-4 font-bold text-white shadow-lg shadow-blue-900/15 transition hover:-translate-y-0.5 hover:bg-blue-700" %>
              <%= verified_link_to "Organizza un’esperienza", "#", class: "rounded-xl border border-slate-200 bg-white px-6 py-4 font-bold text-slate-700 shadow-sm transition hover:border-blue-300 hover:text-blue-700" %>
              <%= verified_link_to "Crea il tuo brand", "#", class: "rounded-xl bg-gradient-to-r from-blue-600 to-emerald-600 px-6 py-4 font-bold text-white shadow-lg shadow-blue-500/20 transition hover:-translate-y-0.5 hover:brightness-110" %>
            </div>
          </div>
        </header>

        <!-- SEZIONE MANIFESTO -->
    <!-- I 3 PILASTRI -->
    <section class="py-12 md:py-16">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-black leading-tight mb-4 text-slate-950">
          Tre giardini da coltivare.
        </h2>
        <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
          Scegli il punto di partenza del tuo viaggio: la base del corpo, gli strumenti per il tuo progetto, o lo studio della mappa.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- SALUTE -->
        <article class="relative flex flex-col rounded-3xl border border-blue-200 bg-white p-8 shadow-sm hover:border-blue-400 hover:shadow-md transition">
          <div class="mb-6 inline-flex size-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl text-blue-600">💙</div>
          <h3 class="text-2xl font-black mb-3 text-slate-900">Salute e Corpo</h3>
          <p class="text-slate-600 leading-relaxed flex-1 mb-8">
            Il punto di partenza. Ricerca su postura, fisiologia ed educazione alla salute. Ritrova l'equilibrio per costruire tutto il resto.
          </p>
          <div class="space-y-3 border-t border-slate-100 pt-6">
            <%= verified_link_to "PosturaCorretta", posturacorretta_path, class: "flex items-center justify-between font-bold text-slate-900 hover:text-blue-600 transition" %>
            <%= verified_link_to "Giardino del Corpo", "#", class: "flex items-center justify-between font-bold text-slate-900 hover:text-blue-600 transition" %>
          </div>
        </article>

        <!-- LAVORO -->
        <article class="relative flex flex-col rounded-3xl border border-orange-200 bg-white p-8 shadow-sm hover:border-orange-400 hover:shadow-md transition">
          <div class="mb-6 inline-flex size-14 items-center justify-center rounded-2xl bg-orange-50 text-2xl text-orange-600">🛠️</div>
          <h3 class="text-2xl font-black mb-3 text-slate-900">Lavoro e Ricchezza</h3>
          <p class="text-slate-600 leading-relaxed flex-1 mb-8">
            La Trilogia. Gli strumenti per organizzare il tuo tempo, validare i tuoi progetti e trasformarli in software utile e affidabile.
          </p>
          <div class="space-y-3 border-t border-slate-100 pt-6">
            <%= verified_link_to "1Impegno", impegno_path, class: "flex items-center justify-between font-bold text-slate-900 hover:text-orange-600 transition" %>
            <%= verified_link_to "GeneraImpresa", genera_impresa_path, class: "flex items-center justify-between font-bold text-slate-900 hover:text-orange-600 transition" %>
            <%= verified_link_to "Rails4Business", rails4b_path, class: "flex items-center justify-between font-bold text-slate-900 hover:text-orange-600 transition" %>
          </div>
        </article>

        <!-- FORMAZIONE -->
        <article class="relative flex flex-col rounded-3xl border border-purple-200 bg-white p-8 shadow-sm hover:border-purple-400 hover:shadow-md transition">
          <div class="mb-6 inline-flex size-14 items-center justify-center rounded-2xl bg-purple-50 text-2xl text-purple-600">📚</div>
          <h3 class="text-2xl font-black mb-3 text-slate-900">Apprendimento</h3>
          <p class="text-slate-600 leading-relaxed flex-1 mb-8">
            Lo studio della mappa. Formazione per insegnanti e tutor che vogliono comprendere le metodiche e guidare le persone.
          </p>
          <div class="space-y-3 border-t border-slate-100 pt-6">
            <%= verified_link_to "Accademia", posturacorretta_accademia_path, class: "flex items-center justify-between font-bold text-slate-900 hover:text-purple-600 transition" %>
            <%= verified_link_to "Insegnanti e Tutor", "#", class: "flex items-center justify-between font-bold text-slate-900 hover:text-purple-600 transition" %>
          </div>
        </article>
      </div>
    </section>
  </section>
</main>
