<% content_for :title, "Mondi e Brand — FlowPulse" %>
<% content_for :description, "Esplora tutti i Brand pubblici della rete FlowPulse oppure guarda i progetti collegati al mondo di MarkPostura." %>

<main class="min-h-screen bg-white text-slate-950">
  <%= render "landing/flowpulse_nav" %>

  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-blue-700">Una piattaforma, molti mondi</p>
      <h1 class="mt-3 text-4xl font-black tracking-[-0.04em] sm:text-5xl">Mondi e Brand</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">Qui puoi vedere l’intera rete pubblica oppure isolare il mondo costruito da una persona. I Brand mantengono identità e responsabilità proprie, anche quando condividono Node, persone o Skill.</p>

      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Scegli quali Brand visualizzare">
        <%= link_to "Tutti i Brand", flowpulse_projects_path, class: "rounded-full border px-5 py-3 text-sm font-black transition #{@flowpulse_projects_scope == 'all' ? 'border-blue-700 bg-blue-700 text-white' : 'border-slate-300 bg-white text-slate-700 hover:border-blue-300 hover:text-blue-700'}" %>
        <%= link_to "Mondo di MarkPostura", flowpulse_projects_path(mondo: "markpostura"), class: "rounded-full border px-5 py-3 text-sm font-black transition #{@flowpulse_projects_scope == 'markpostura' ? 'border-violet-700 bg-violet-700 text-white' : 'border-slate-300 bg-white text-slate-700 hover:border-violet-300 hover:text-violet-700'}" %>
      </nav>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14" aria-label="Elenco dei progetti">
    <div class="mb-8 max-w-3xl">
      <% if @flowpulse_projects_scope == "markpostura" %>
        <p class="text-xs font-black uppercase tracking-[0.18em] text-violet-700">Primo mondo in costruzione</p>
        <h2 class="mt-2 text-2xl font-black">Il mondo di MarkPostura</h2>
        <p class="mt-3 leading-7 text-slate-600">Raccoglie i Brand e gli strumenti che Mark sta collegando tra salute, lavoro, risorse ed esplorazione. È un esempio concreto di FlowPulse, non la struttura obbligatoria per tutti.</p>
      <% else %>
        <p class="text-xs font-black uppercase tracking-[0.18em] text-blue-700">Rete pubblica</p>
        <h2 class="mt-2 text-2xl font-black">Tutti i Brand visibili</h2>
        <p class="mt-3 leading-7 text-slate-600">Oggi gran parte del catalogo nasce dal mondo di MarkPostura. Questa vista è già pronta ad accogliere i mondi costruiti da altri creator e professionisti.</p>
      <% end %>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% @flowpulse_projects.each do |project| %>
        <%= link_to project.fetch("public_path", "#"), class: "group flex min-h-56 flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-blue-300 hover:bg-blue-50/40" do %>
          <div class="flex items-start justify-between gap-3">
            <span class="text-[11px] font-black uppercase tracking-[0.14em] text-blue-700"><%= project.fetch("kind", "progetto").to_s.humanize %></span>
            <% if project.fetch("status", nil) == "active_pilot" %><span class="rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-black uppercase text-emerald-700">Pilota attivo</span><% end %>
          </div>
          <h2 class="mt-4 text-2xl font-black tracking-tight group-hover:text-blue-700"><%= project.fetch("title") %></h2>
          <p class="mt-3 grow text-sm leading-6 text-slate-600"><%= project.fetch("summary") %></p>
          <span class="mt-5 text-sm font-black text-blue-700">Apri il progetto →</span>
        <% end %>
      <% end %>
    </div>
    <% if @flowpulse_projects.empty? %><p class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-slate-600">Non ci sono ancora Brand pubblici in questo mondo.</p><% end %>
  </section>

  <footer class="border-t border-slate-200 px-5 py-6 text-center text-sm"><%= link_to "Torna a Flowpulse", flowpulse_path, class: "font-bold text-slate-600 hover:text-blue-700" %></footer>
</main>
