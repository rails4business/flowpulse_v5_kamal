<% content_for :title, "#{@accordion_page.fetch("title")} — Fisarmonica — Canta che ti passa" %>
<% content_for :description, "Materiali essenziali per organizzare lo studio della fisarmonica." %>
<% content_for :landing_nav do %><%= render "landing/cantachetipassa_nav", home_url: cantachetipassa_path %><% end %>

<main class="accordion-study">
  <div class="accordion-study__inner">
    <p class="accordion-study__back"><%= link_to "← Musica", "#{cantachetipassa_path}#sessioni" %></p>
    <h1>Fisarmonica</h1>

    <div class="accordion-study__navigation">
      <p>Percorsi</p>
      <nav class="accordion-study__tabs accordion-study__tabs--paths" aria-label="Percorsi della fisarmonica">
        <% @accordion_study_paths.each do |path| %>
          <%= link_to path.fetch("tab_title", path.fetch("title")), cantachetipassa_accordion_path(page: path.fetch("page"), percorso: path.fetch("slug")), aria: ({ current: "page" } if path.fetch("slug") == @accordion_study_path_slug) %>
        <% end %>
      </nav>

      <p>Materiali di studio</p>
      <nav class="accordion-study__tabs" aria-label="Studio della fisarmonica">
        <% @accordion_pages.each do |page| %>
          <%= link_to page.fetch("title"), cantachetipassa_accordion_path(page: page.fetch("slug"), percorso: @accordion_study_path_slug), aria: ({ current: "page" } if page.fetch("slug") == @accordion_page_slug) %>
        <% end %>
      </nav>
    </div>

    <% if @accordion_study_path_slug == "classical" %><section class="accordion-study__path-intro" aria-labelledby="percorso-studio-title">
      <p class="accordion-study__eyebrow">Fisarmonica cromatica a bottoni · C-system</p>
      <h2 id="percorso-studio-title"><%= @accordion_study_path.fetch("title") %></h2>
      <p><%= @accordion_study_path.fetch("description") %></p>
      <% if @accordion_study_path["steps"].present? %>
        <ul>
          <% @accordion_study_path.fetch("steps").each do |step| %><li><%= step %></li><% end %>
        </ul>
      <% end %>
      <small><%= @accordion_study.dig("instrument", "source_note") %></small>
    </section><% end %>

    <section class="accordion-study__page">
      <h2><%= @accordion_page.fetch("title") %></h2>
      <% @accordion_chapters.each do |chapter| %>
        <% if @accordion_chapters.many? %><h3><%= chapter.fetch("title") %></h3><% end %>
        <div class="accordion-study__list"><%= markdown(chapter.fetch("content")) %></div>
      <% end %>

      <% if @accordion_page_slug == "canzoni" %>
        <section class="accordion-repertoire" aria-labelledby="repertorio-progressivo-title">
          <div class="accordion-repertoire__heading">
            <p class="accordion-study__eyebrow">Schede predisposte</p>
            <h2 id="repertorio-progressivo-title">Repertorio progressivo</h2>
            <p>Apri un brano per aggiungere tonalità, velocità, lavoro delle mani, fonti e note personali.</p>
          </div>
          <% [@accordion_study_path].reject { |path| path.fetch("slug") == "classical" }.each do |path| %>
            <section class="accordion-repertoire__path" id="percorso-<%= path.fetch("slug") %>">
              <h3><%= path.fetch("title") %></h3>
              <% path.fetch("groups").each do |group| %>
                <div class="accordion-repertoire__group">
                  <h4><%= group.fetch("title") %></h4>
                  <% if group.fetch("pieces").any? %>
                    <% group.fetch("pieces").each do |piece_slug| %>
                      <%= render "landing/accordion_piece", piece: @accordion_pieces.fetch(piece_slug), path_title: path.fetch("title") %>
                    <% end %>
                  <% else %>
                    <p class="accordion-repertoire__empty">Il primo brano verrà aggiunto qui.</p>
                  <% end %>
                </div>
              <% end %>
            </section>
          <% end %>
        </section>
      <% end %>
    </section>

    <p class="accordion-study__copyright">Solo collegamenti alle fonti. Non vengono ospitate scansioni, fotografie o PDF di libri e spartiti.</p>
  </div>
</main>
