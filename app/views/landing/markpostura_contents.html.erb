<% content_for :title, "Contenuti di Mark Postura" %>
<% content_for :description, "Articoli e approfondimenti pubblicati da Mark Postura nei diversi progetti della piattaforma." %>

<div class="min-h-screen bg-white text-slate-900">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-5 sm:px-6">
      <%= link_to "Mark Postura", markpostura_path, class: "text-sm font-bold uppercase tracking-[0.2em] text-sky-700" %>
      <%= link_to "← Torna alla pagina personale", markpostura_path, class: "text-sm font-semibold text-slate-600 transition hover:text-sky-700" %>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-6 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-sky-700">@<%= @content_author&.username || "markpostura" %></p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Contenuti</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">Articoli e approfondimenti pubblicati da Mark Postura nei diversi progetti della piattaforma.</p>
    </div>

    <% if @author_articles.any? %>
      <ol class="mt-12 divide-y divide-slate-200 border-y border-slate-200">
        <% @author_articles.each do |article| %>
          <li>
            <a href="<%= article.fetch("url") %>" class="group grid gap-3 py-7 transition sm:grid-cols-[10rem_minmax(0,1fr)_auto] sm:items-start sm:gap-6">
              <div class="text-sm text-slate-500">
                <time datetime="<%= article["publication_date"]&.iso8601 %>"><%= article["publication_label"] || "Data da definire" %></time>
                <p class="mt-1 font-semibold text-sky-700"><%= article.fetch("domain_name") %></p>
              </div>
              <div>
                <h2 class="text-xl font-bold tracking-tight text-slate-950 transition group-hover:text-sky-700"><%= article.fetch("title") %></h2>
                <% if article["excerpt"].present? %>
                  <p class="mt-2 text-sm leading-6 text-slate-600"><%= article["excerpt"] %></p>
                <% end %>
                <p class="mt-3 text-xs font-semibold text-slate-500">@<%= article.fetch("author") %><%= " · #{article['category_name']}" if article["category_name"].present? %></p>
              </div>
              <span aria-hidden="true" class="hidden pt-1 text-slate-400 transition group-hover:translate-x-1 group-hover:text-sky-700 sm:block">→</span>
            </a>
          </li>
        <% end %>
      </ol>

      <% if @contents_total_pages > 1 %>
        <nav class="mt-8 flex items-center justify-between border-t border-slate-200 pt-6" aria-label="Paginazione contenuti">
          <% if @contents_page > 1 %>
            <%= link_to "← Più recenti", markpostura_contents_path(page: @contents_page - 1), class: "text-sm font-bold text-sky-700 hover:text-sky-900" %>
          <% else %>
            <span></span>
          <% end %>
          <span class="text-sm font-semibold text-slate-500">Pagina <%= @contents_page %> di <%= @contents_total_pages %></span>
          <% if @contents_page < @contents_total_pages %>
            <%= link_to "Meno recenti →", markpostura_contents_path(page: @contents_page + 1), class: "text-sm font-bold text-sky-700 hover:text-sky-900" %>
          <% end %>
        </nav>
      <% end %>
    <% else %>
      <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-xl font-bold text-slate-900">Nessun contenuto pubblicato</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">I contenuti associati a @markpostura compariranno qui automaticamente.</p>
      </div>
    <% end %>
  </main>
</div>
