<% content_for :title, "Stato di Salute — Valuta i sette ambiti" %>
<% content_for :description, "Sette brevi valutazioni per osservare progressivamente salute, prevenzione, capacità, benessere e consapevolezza." %>

<main class="min-h-screen bg-white text-slate-950">
  <nav class="border-b border-slate-200 bg-white" aria-label="Navigazione Stato di Salute">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
      <%= link_to "Stato di Salute", stato_di_salute_path, class: "text-sm font-black uppercase tracking-[.16em] text-emerald-800" %>
      <div class="flex items-center justify-end gap-1 text-sm font-bold sm:gap-2">
        <%= link_to "Il progetto", stato_di_salute_about_path, class: "hidden rounded-full px-3 py-2 text-slate-600 hover:bg-slate-100 hover:text-slate-950 sm:inline-flex" %>
        <%= link_to "I sette ambiti", "#ambiti", class: "hidden rounded-full px-3 py-2 text-slate-600 hover:bg-emerald-50 hover:text-emerald-800 md:inline-flex" %>
        <%= link_to "Inizia", "#ambiti", class: "rounded-full bg-emerald-700 px-4 py-2 font-black text-white hover:bg-emerald-800" %>
      </div>
    </div>
  </nav>

  <header class="overflow-hidden bg-gradient-to-b from-emerald-50 via-white to-white">
    <div class="mx-auto max-w-5xl px-5 py-10 text-center sm:px-8 sm:py-14">
      <h1 class="mx-auto mt-3 max-w-4xl text-4xl font-black tracking-[-.04em] sm:text-5xl">Autovalutazione dello stato di salute.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-600">Rispondi alle domande e costruisci il tuo profilo per capire il tuo stato di salute.</p>
      <%= link_to "Scopri perché nasce il progetto →", stato_di_salute_about_path, class: "mt-4 inline-flex text-sm font-bold text-emerald-800 hover:underline" %>
    </div>
  </header>

  <%= render "landing/stato_salute_tests" %>

  <section class="border-t border-red-200 bg-red-50">
    <div class="mx-auto max-w-4xl px-5 py-10 text-center sm:px-8">
      <h2 class="text-xl font-black text-red-950">Se sono presenti segnali importanti, non aspettare il questionario.</h2>
      <p class="mx-auto mt-3 max-w-3xl leading-7 text-red-900">In presenza di sintomi acuti, peggioramento rapido o dubbi sulla propria sicurezza, è consigliato rivolgersi al medico o al professionista sanitario appropriato prima di iniziare un percorso educativo.</p>
    </div>
  </section>

  <footer class="border-t border-slate-200 px-5 py-7 text-center text-sm text-slate-500">Stato di Salute · Collegato a Percorso Integrato, PosturaCorretta e Il Giardino del Corpo</footer>
</main>
