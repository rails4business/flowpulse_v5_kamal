<% home_url = local_assigns.fetch(:home_url, cantachetipassa_path) %>
<% admin_brand = Node.find_by(slug: "cantachetipassa") %>
<header class="sticky top-0 z-50 border-b border-green-200 bg-white/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="Navigazione Canta che ti passa">
    <%= link_to home_url, class: "flex items-center gap-2 font-black tracking-tight text-slate-950" do %>
      <span class="flex size-9 items-center justify-center rounded-full bg-red-600 text-lg text-white ring-4 ring-green-100" aria-hidden="true">♫</span>
      <span>Canta che ti passa</span>
    <% end %>
    <div class="flex items-center gap-2">
      <% if admin_brand&.administered_by?(Current.user) %><%= link_to "Amministra Brand", brand_admin_nodes_path(admin_brand.slug), class: "hidden rounded-lg px-3 py-2 text-sm font-bold text-green-800 hover:bg-green-50 md:inline-flex" %><% end %>
      <%= link_to "Le quattro sessioni", "#{home_url}#sessioni", class: "hidden rounded-lg px-3 py-2 text-sm font-bold text-slate-600 hover:bg-green-50 hover:text-green-800 sm:inline-flex" %>
      <%= link_to "Partecipa", "#{home_url}#partecipa", class: "ctp-button ctp-button--primary rounded-lg px-3.5 py-2 text-sm font-bold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2" %>
    </div>
  </nav>
</header>
