<% home_url = local_assigns.fetch(:home_url, cantachetipassa_path) %>
<header class="sticky top-0 z-50 border-b border-amber-200 bg-white/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="Navigazione Canta che ti passa">
    <%= link_to home_url, class: "flex items-center gap-2 font-black tracking-tight text-slate-950" do %>
      <span class="flex size-9 items-center justify-center rounded-full bg-red-600 text-lg text-white" aria-hidden="true">♫</span>
      <span>Canta che ti passa</span>
    <% end %>
    <div class="flex items-center gap-2">
      <%= link_to "Attività", "#{home_url}#attivita", class: "hidden rounded-lg px-3 py-2 text-sm font-bold text-slate-600 hover:bg-amber-50 hover:text-red-700 sm:inline-flex" %>
      <%= link_to "Partecipa", "#{home_url}#partecipa", class: "rounded-lg bg-red-600 px-3.5 py-2 text-sm font-bold text-white hover:bg-red-700" %>
    </div>
  </nav>
</header>
