<% content_for :title, @article.fetch("title") %>
<% content_for :description, @article["excerpt"] %>

<div class="min-h-screen bg-white text-slate-900">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-5 sm:px-6">
      <%= link_to "Mark Postura", markpostura_path, class: "text-sm font-bold uppercase tracking-[0.2em] text-sky-700" %>
      <%= link_to "← Tutti i contenuti", markpostura_contents_path, class: "text-sm font-semibold text-slate-600 transition hover:text-sky-700" %>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-5 py-12 sm:px-6 sm:py-16">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-sky-700"><%= @article["category_name"] || "Contenuto" %></p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"><%= @article.fetch("title") %></h1>
    <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-slate-500">
      <span class="font-bold text-slate-700">@<%= @article.fetch("author") %></span>
      <% if @article["publication_label"].present? %>
        <span aria-hidden="true">·</span>
        <time datetime="<%= @article["publication_date"].iso8601 %>"><%= @article.fetch("publication_label") %></time>
      <% end %>
    </div>

    <% if @article["format"] == "video" %>
      <div class="mt-10 aspect-video overflow-hidden rounded-2xl bg-slate-100">
        <iframe src="https://www.youtube.com/embed/<%= @article.fetch("slug") %>" title="<%= @article.fetch("title") %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="h-full w-full"></iframe>
      </div>
    <% end %>

    <% if @content.present? %>
      <article class="editorial-rich-text editorial-rich-text--sky mt-10">
        <%= markdown(@content) %>
      </article>
    <% elsif @article["excerpt"].present? %>
      <p class="mt-10 text-lg leading-8 text-slate-600"><%= @article["excerpt"] %></p>
    <% end %>
  </main>
</div>
