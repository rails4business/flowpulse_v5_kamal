<% content_for :title, "Contenuti Flowpulse" %>
<% content_for :description, "Idee, analisi e strumenti dell'ecosistema Flowpulse." %>

<div class="min-h-screen bg-white text-slate-900">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-5 sm:px-6">
      <%= link_to "Flowpulse", flowpulse_path, class: "text-sm font-bold uppercase tracking-[0.2em] text-violet-700" %>
      <%= link_to "← Torna a Flowpulse", flowpulse_path, class: "text-sm font-semibold text-slate-600 transition hover:text-violet-700" %>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-6 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-violet-700">Idee · analisi · strumenti</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Contenuti Flowpulse</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">Riflessioni e approfondimenti pubblicati da Flowpulse, con l’indicazione dell’autore di ogni contributo.</p>
    </div>

    <% if @domain_articles.any? %>
      <ol class="mt-12 divide-y divide-slate-200 border-y border-slate-200">
        <% @domain_articles.each do |article| %>
          <li>
            <%= link_to article.fetch("path"), class: "group grid gap-3 py-7 transition sm:grid-cols-[10rem_minmax(0,1fr)_auto] sm:items-start sm:gap-6" do %>
              <div class="text-sm text-slate-500">
                <time datetime="<%= article["publication_date"]&.iso8601 %>"><%= article["publication_label"] || "Data da definire" %></time>
                <p class="mt-1 font-semibold text-violet-700"><%= article["category"].to_s.humanize.presence || "Approfondimento" %></p>
              </div>
              <div>
                <h2 class="text-xl font-bold tracking-tight text-slate-950 transition group-hover:text-violet-700"><%= article.fetch("title") %></h2>
                <% if article["excerpt"].present? %>
                  <p class="mt-2 text-sm leading-6 text-slate-600"><%= article["excerpt"] %></p>
                <% end %>
                <p class="mt-3 text-xs font-semibold text-slate-500">@<%= article.fetch("author") %></p>
              </div>
              <span aria-hidden="true" class="hidden pt-1 text-slate-400 transition group-hover:translate-x-1 group-hover:text-violet-700 sm:block">→</span>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-xl font-bold">Nessun contenuto pubblicato</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">I contenuti pubblicati da Flowpulse compariranno qui.</p>
      </div>
    <% end %>
  </main>
</div>
