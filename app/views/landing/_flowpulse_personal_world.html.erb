<figure class="mx-auto w-full max-w-xl" aria-labelledby="personal-flow-title personal-flow-caption">
  <svg viewBox="0 0 720 620" role="img" aria-labelledby="personal-flow-title personal-flow-description" class="h-auto w-full overflow-visible drop-shadow-xl">
    <title id="personal-flow-title">Costruisci il tuo mondo con FlowPulse</title>
    <desc id="personal-flow-description">Una persona collega idee, problemi, Brand, progetti e persone per creare un mondo che può crescere e incontrarne altri.</desc>

    <defs>
      <radialGradient id="flow-core" cx="35%" cy="28%">
        <stop offset="0%" stop-color="#60a5fa" />
        <stop offset="100%" stop-color="#1d4ed8" />
      </radialGradient>
      <linearGradient id="flow-orbit" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#dbeafe" />
        <stop offset="100%" stop-color="#ede9fe" />
      </linearGradient>
      <filter id="flow-shadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#1e3a8a" flood-opacity=".16" />
      </filter>
    </defs>

    <ellipse cx="360" cy="310" rx="300" ry="245" fill="url(#flow-orbit)" opacity=".55" />
    <ellipse cx="360" cy="310" rx="244" ry="194" fill="none" stroke="#93c5fd" stroke-width="2" stroke-dasharray="8 12" />

    <g stroke="#94a3b8" stroke-width="3" stroke-linecap="round" opacity=".72">
      <path d="M360 310 L205 165" />
      <path d="M360 310 L512 146" />
      <path d="M360 310 L585 315" />
      <path d="M360 310 L500 487" />
      <path d="M360 310 L205 485" />
      <path d="M360 310 L128 310" />
    </g>

    <g filter="url(#flow-shadow)">
      <circle cx="360" cy="310" r="104" fill="url(#flow-core)" />
      <circle cx="205" cy="165" r="67" fill="#ffffff" stroke="#bfdbfe" stroke-width="4" />
      <circle cx="512" cy="146" r="67" fill="#ffffff" stroke="#ddd6fe" stroke-width="4" />
      <circle cx="585" cy="315" r="67" fill="#ffffff" stroke="#bbf7d0" stroke-width="4" />
      <circle cx="500" cy="487" r="67" fill="#ffffff" stroke="#fde68a" stroke-width="4" />
      <circle cx="205" cy="485" r="67" fill="#ffffff" stroke="#fecdd3" stroke-width="4" />
      <circle cx="128" cy="310" r="67" fill="#ffffff" stroke="#bae6fd" stroke-width="4" />
    </g>

    <g text-anchor="middle" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif">
      <text x="360" y="296" fill="#dbeafe" font-size="17" font-weight="800" letter-spacing="3">FLOWPULSE</text>
      <text x="360" y="329" fill="#ffffff" font-size="27" font-weight="900">IL TUO MONDO</text>
      <text x="360" y="354" fill="#dbeafe" font-size="15" font-weight="700">cresce e si collega</text>

      <text x="205" y="159" fill="#1e3a8a" font-size="18" font-weight="900">PERSONA</text>
      <text x="205" y="183" fill="#64748b" font-size="14" font-weight="700">da dove parti</text>

      <text x="512" y="140" fill="#5b21b6" font-size="18" font-weight="900">IDEA</text>
      <text x="512" y="164" fill="#64748b" font-size="14" font-weight="700">cosa immagini</text>

      <text x="585" y="309" fill="#166534" font-size="18" font-weight="900">PROGETTI</text>
      <text x="585" y="333" fill="#64748b" font-size="14" font-weight="700">cosa costruisci</text>

      <text x="500" y="481" fill="#92400e" font-size="18" font-weight="900">PERSONE</text>
      <text x="500" y="505" fill="#64748b" font-size="14" font-weight="700">con chi collabori</text>

      <text x="205" y="479" fill="#9f1239" font-size="18" font-weight="900">BRAND</text>
      <text x="205" y="503" fill="#64748b" font-size="14" font-weight="700">il nome del mondo</text>

      <text x="128" y="304" fill="#075985" font-size="18" font-weight="900">PROBLEMI</text>
      <text x="128" y="328" fill="#64748b" font-size="14" font-weight="700">da affrontare</text>
    </g>

    <g transform="translate(642 522)">
      <circle r="31" fill="#ffffff" stroke="#93c5fd" stroke-width="3" stroke-dasharray="5 5" />
      <path d="M-10 0 H10 M0 -10 V10" stroke="#2563eb" stroke-width="4" stroke-linecap="round" />
    </g>
  </svg>
  <figcaption id="personal-flow-caption" class="mx-auto mt-2 max-w-md text-center text-sm leading-6 text-slate-600"><strong class="text-slate-900">La mappa non è già decisa.</strong> Parti da ciò che hai e aggiungi nuove sfere quando il tuo mondo cresce.</figcaption>
</figure>
