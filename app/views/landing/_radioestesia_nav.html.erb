<% active = local_assigns.fetch(:active, "home").to_s %>
<% radioestesia = local_assigns.fetch(:radioestesia) %>
<% navigation = radioestesia.fetch("navigation") + (Current.user&.superadmin_user? ? [{ "key" => "changelog", "label" => "Changelog" }] : []) %>
<header class="border-b border-[#d8dfd4] bg-[#f3f5ef]">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 py-4 sm:px-8">
    <%= link_to radioestesia_path, class: "flex items-center gap-3", aria: { label: "#{radioestesia.dig('site', 'name')}, home" } do %>
      <img src="<%= radioestesia.dig('site', 'logo_url') %>" alt="Logo <%= radioestesia.dig('site', 'name') %>" class="size-12 rounded-full object-cover" referrerpolicy="no-referrer">
      <span><span class="block font-serif text-2xl italic leading-none text-[#53654b]"><%= radioestesia.dig('site', 'name') %></span><span class="mt-1 block text-[10px] font-bold uppercase tracking-[.13em] text-[#738069]"><%= radioestesia.dig('site', 'tagline') %></span></span>
    <% end %>
    <nav class="hidden items-center gap-5 text-sm font-semibold text-[#4a594d] md:flex" aria-label="Navigazione Radioestesia">
      <% navigation.each do |item| %>
        <% target = case item.fetch("key"); when "home" then radioestesia_path; when "changelog" then radioestesia_changelog_path; else radioestesia_page_path(item.fetch("key")); end %>
        <%= link_to item.fetch("label"), target, class: "border-b-2 pb-1 #{active == item.fetch('key') ? 'border-[#7b946d]' : 'border-transparent hover:border-[#b8c7ad]'}", style: "color: #{active == item.fetch('key') ? '#2d412e' : '#4a594d'}" %>
      <% end %>
    </nav>
  </div>
  <nav class="flex gap-4 overflow-x-auto border-t border-[#dde3d9] px-5 py-3 text-sm font-semibold text-[#4a594d] md:hidden" aria-label="Navigazione mobile Radioestesia">
    <% navigation.each do |item| %>
      <% target = case item.fetch("key"); when "home" then radioestesia_path; when "changelog" then radioestesia_changelog_path; else radioestesia_page_path(item.fetch("key")); end %>
      <%= link_to item.fetch("label"), target, class: "shrink-0", style: "color: #{active == item.fetch('key') ? '#315035' : '#4a594d'}" %>
    <% end %>
  </nav>
</header>
