<nav class="flex gap-1 overflow-x-auto border-b border-slate-200" aria-label="Aree della dashboard condivisa">
  <% systems = [
    ["Flowpulse", nil, :flowpulse],
    ["GeneraImpresa", nil, :generaimpresa],
    ["Rails4Business", nil, :rails4business],
    ["1impegno", workspace_data_commitments_path, :impegno]
  ] %>
  <% systems.each do |label, path, key| %>
    <% classes = [
      "whitespace-nowrap border-b-2 px-4 py-3 text-sm font-extrabold transition",
      local_assigns[:active_system] == key ? "border-blue-600 text-blue-700" : "border-transparent text-slate-500",
      path.present? ? "hover:border-slate-300 hover:text-slate-900" : "cursor-not-allowed opacity-55"
    ].join(" ") %>
    <% if path.present? %>
      <%= link_to label, path, class: classes %>
    <% else %>
      <span class="<%= classes %>" aria-disabled="true" title="Sezione in costruzione"><%= label %></span>
    <% end %>
  <% end %>
</nav>
