<% versions = dashboard_version_links(function) %>
<footer class="mt-10 border-t border-slate-200 pt-5" aria-label="Versioni collegate">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-xs leading-5 text-slate-500">
      Questa funzione fa parte della costruzione progressiva della dashboard condivisa.
    </p>
    <% if versions.any? %>
      <details class="group relative sm:min-w-72 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-extrabold text-slate-700 shadow-sm hover:bg-slate-50">
          Versioni collegate
          <span class="text-slate-400 transition group-open:rotate-180" aria-hidden="true">⌄</span>
        </summary>
        <div class="mt-2 grid gap-1 rounded-xl border border-slate-200 bg-white p-2 shadow-lg sm:absolute sm:bottom-full sm:right-0 sm:z-20 sm:mb-2 sm:mt-0 sm:w-80">
          <% versions.each do |version| %>
            <%= link_to version.fetch(:path),
              target: ("_blank" if version[:external]),
              rel: ("noreferrer" if version[:external]),
              aria: { current: ("page" if version[:current]) },
              class: "flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-bold #{version[:current] ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}" do %>
              <span><%= version.fetch(:label) %></span>
              <span aria-hidden="true"><%= version[:external] ? "↗" : "→" %></span>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</footer>
