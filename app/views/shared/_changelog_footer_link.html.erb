<% brand_key = local_assigns[:brand].presence || local_assigns[:scope].presence %>
<% changelog_path_for_brand = if local_request? && brand_key == "posturacorretta"
  posturacorretta_changelog_path
elsif brand_key.present? && local_request?
  brand_changelog_path(brand_key)
else
  changelog_path
end %>
<%= link_to local_assigns.fetch(:label, "Changelog"), changelog_path_for_brand, class: local_assigns.fetch(:class_name, "font-bold text-blue-700 hover:text-blue-900") %>
