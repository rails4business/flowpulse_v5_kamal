<% access_context = dashboard_access_context %>
<% contextual_aside = DashboardAside::Builder.new(context: access_context).applicable? %>
<% aside_context = dashboard_aside_context(local_assigns[:current_section]) %>
<% contextual_role_controls = contextual_aside && (access_context.superadmin? || access_context.available_role_assignments.any?) %>
<% legacy_role_controls = !contextual_aside && Current.user && (Current.user.can_switch_roles? || Current.user.current_role_assignment.present?) %>

<% if contextual_role_controls || legacy_role_controls %>
<div class="flex-none border-t border-slate-100 p-4 space-y-2">
  <% if contextual_aside && access_context.superadmin? %>
    <div class="rounded-xl border border-violet-100 bg-violet-50 px-3 py-2">
      <span class="block text-[10px] font-extrabold uppercase tracking-[0.14em] text-violet-500">Access role</span>
      <strong class="mt-1 block text-xs text-violet-800">Superadmin</strong>
    </div>
  <% elsif access_context.brand_access.present? %>
    <% assignments = access_context.available_role_assignments %>
    <% if assignments.many? %>
      <%= form_with url: dashboard_brand_access_current_role_path(access_context.brand_access), method: :patch, class: "block", data: { turbo: false } do %>
        <%= label_tag :role_assignment_id, "Access role", class: "mb-1.5 block text-[10px] font-extrabold uppercase tracking-[0.14em] text-slate-400" %>
        <%= select_tag :role_assignment_id,
          options_for_select(
            [["Utente", ""]] + assignments.map { |assignment| [RoleDefinitions::Registry.find(assignment.role_operator)&.label || assignment.role_operator.to_s.humanize, assignment.id] },
            access_context.current_role_assignment&.id
          ),
          class: "w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
          onchange: "this.form.submit()" %>
      <% end %>
    <% elsif access_context.current_role_assignment.present? %>
      <% assignment = access_context.current_role_assignment %>
      <div class="rounded-xl border border-blue-100 bg-blue-50 px-3 py-2">
        <span class="block text-[10px] font-extrabold uppercase tracking-[0.14em] text-blue-500">Access role</span>
        <strong class="mt-1 block truncate text-xs text-blue-800"><%= RoleDefinitions::Registry.find(assignment.role_operator)&.label || assignment.role_operator.to_s.humanize %></strong>
      </div>
    <% end %>
  <% elsif !contextual_aside && Current.user&.can_switch_roles? %>
    <%= form_with url: dashboard_role_path, method: :patch, class: "block", data: { turbo: false } do %>
      <%= select_tag :role,
        options_for_select(Current.user.ruoli_attivabili.map { |role| [ruolo_label(role), role] }, Current.user.active_role),
        class: "w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
        onchange: "this.form.submit()" %>
    <% end %>
  <% end %>

  <% if Current.user && access_context.brand_access.blank? && !contextual_aside %>
    <%
      mapped_role = FlowRoles.active_role_for(Current.user)
      role_assignment_role = case mapped_role
      when "ideatore", "creator", "digital" then mapped_role.to_sym
      else mapped_role.to_sym
      end

      assignments = if Current.user.superadmin_user?
        RoleAssignment.where(role: role_assignment_role)
      else
        Current.user.role_assignments.where(role: role_assignment_role)
      end
    %>

    <% if assignments.size > 1 %>
      <%= form_with url: dashboard_channel_path, method: :patch, class: "block", data: { turbo: false } do %>
        <div class="relative">
          <%= select_tag :role_assignment_id,
            options_for_select(assignments.map { |ra| [ra.display_name, ra.id] }, Current.user.current_role_assignment_id),
            class: "w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
            onchange: "this.form.submit()" %>
        </div>
      <% end %>
    <% elsif assignments.size == 1 %>
      <div class="px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-500 truncate flex items-center gap-1.5" title="<%= assignments.first.display_name %>">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
        <%= assignments.first.display_name %>
      </div>
    <% end %>
  <% end %>
</div>
<% end %>
