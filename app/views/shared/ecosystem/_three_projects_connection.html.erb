<% current_project = local_assigns.fetch(:current_project, nil) %>
<% projects = [
     { id: :posturacorretta, eyebrow: "Educazione", title: "PosturaCorretta", description: "Parte dal corpo e dalla postura per sviluppare conoscenza, pratica e consapevolezza della salute.", href: posturacorretta_path, color: "blue" },
     { id: :percorso_integrato, eyebrow: "Accompagnamento", title: "Percorso Integrato", description: "Collega bisogni, programmi e competenze professionali in un percorso personale, leggibile e coordinato.", href: posturacorretta_percorso_path, color: "emerald" },
     { id: :giardino_del_corpo, eyebrow: "Filosofia ed esperienze", title: "Il Giardino del Corpo", description: "Allarga lo sguardo a natura, relazioni, cultura, espressione e sviluppo armonico dell’essere umano.", href: giardino_del_corpo_path, color: "violet" }
   ] %>
<% styles = {
     "blue" => { border: "border-blue-200", soft: "bg-blue-50", eyebrow: "text-blue-700", active: "ring-blue-500" },
     "emerald" => { border: "border-emerald-200", soft: "bg-emerald-50", eyebrow: "text-emerald-700", active: "ring-emerald-500" },
     "violet" => { border: "border-violet-200", soft: "bg-violet-50", eyebrow: "text-violet-700", active: "ring-violet-500" }
   } %>

<section class="border-y border-slate-200 bg-slate-50 px-5 py-16 sm:px-6 lg:px-8" aria-labelledby="three-projects-title">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-slate-500">La parte che ci unisce</p>
      <h2 id="three-projects-title" class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Tre progetti, una persona.</h2>
      <p class="mt-5 text-base leading-7 text-slate-600 sm:text-lg">PosturaCorretta, Percorso Integrato e Il Giardino del Corpo hanno funzioni differenti, ma condividono la stessa direzione: aiutare la persona a conoscere, curare e coltivare il proprio rapporto con il corpo, la salute e l’ambiente in cui vive.</p>
      <p class="mt-4 text-sm leading-6 text-slate-500">Puoi iniziare dall’educazione, da un bisogno che richiede professionisti oppure da un’esperienza. Le tre strade possono incontrarsi e sostenersi senza perdere la propria identità.</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <% projects.each do |project| %>
        <% project_style = styles.fetch(project.fetch(:color)) %>
        <% active = project.fetch(:id) == current_project %>
        <%= link_to project.fetch(:href), class: "group rounded-2xl border #{project_style[:border]} #{project_style[:soft]} p-6 transition hover:-translate-y-0.5 hover:shadow-md #{active ? "ring-2 #{project_style[:active]} ring-offset-2" : ""}", aria: (active ? { current: "page" } : {}) do %>
          <p class="text-xs font-black uppercase tracking-[0.14em] <%= project_style[:eyebrow] %>"><%= project.fetch(:eyebrow) %></p>
          <h3 class="mt-3 text-xl font-semibold text-slate-950"><%= project.fetch(:title) %></h3>
          <p class="mt-3 text-sm leading-6 text-slate-600"><%= project.fetch(:description) %></p>
          <span class="mt-5 inline-flex text-sm font-bold <%= project_style[:eyebrow] %>"><%= active ? "Sei qui" : "Scopri il progetto →" %></span>
        <% end %>
      <% end %>
    </div>

    <p class="mt-8 text-center text-sm text-slate-500">I tre progetti sono collegati dall’infrastruttura digitale di <%= link_to "Flowpulse", flowpulse_path, class: "font-bold text-violet-700 hover:text-violet-800" %>.</p>
  </div>
</section>
