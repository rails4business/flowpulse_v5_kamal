<% domain = authentication_context_domain %>
<% brand_name = domain&.site_title.presence || domain&.resolved_node&.title.presence || "FlowPulse" %>
<% brand_logo = domain&.logo_full_url.presence || domain&.logo_square_url.presence %>
<% home_path = local_request? ? authentication_context_default_return_to : root_path %>

<header class="border-b border-slate-200 bg-white/95 backdrop-blur">
  <nav class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6" aria-label="Navigazione principale <%= brand_name %>">
    <%= link_to home_path, class: "flex min-w-0 items-center gap-3 text-slate-950" do %>
      <% if brand_logo.present? %>
        <img src="<%= brand_logo %>" alt="<%= brand_name %>" class="h-9 w-auto max-w-44 object-contain">
      <% else %>
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-600 text-sm font-black text-white"><%= brand_name.first.upcase %></span>
      <% end %>
      <span class="truncate text-sm font-black sm:text-base"><%= brand_name %></span>
    <% end %>

    <%= link_to "Torna al sito", home_path, class: "shrink-0 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50" %>
  </nav>
</header>
