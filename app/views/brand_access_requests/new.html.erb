<% content_for :landing_nav do %><%= render "shared/authentication_nav" %><% end %>
<% content_for :title, "Richiedi accesso · #{@request_domain.authentication_sender_name}" %>

<section class="mx-auto w-full max-w-lg px-4 py-10 sm:py-16">
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <header class="border-b border-slate-100 bg-slate-50/70 px-6 py-6 sm:px-7">
      <p class="text-xs font-black uppercase tracking-[0.16em] text-blue-600"><%= @request_domain.authentication_sender_name %></p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Richiedi un invito</h1>
      <p class="mt-2 text-sm leading-6 text-slate-600">In questa fase l’accesso viene concesso personalmente dal responsabile del Brand. Lascia i tuoi recapiti: se la richiesta viene approvata riceverai un collegamento personale.</p>
    </header>

    <div class="px-6 py-7 sm:px-7">
      <%= form_with url: brand_access_request_path, scope: :access_request, class: "space-y-5" do |form| %>
        <% if local_request? && authentication_context_site.present? %><%= hidden_field_tag :site, authentication_context_site %><% end %>
        <div><%= form.label :name, "Nome", class: "block text-sm font-bold text-slate-800" %><%= form.text_field :name, required: true, autocomplete: "name", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2.5" %></div>
        <div><%= form.label :email, "Email", class: "block text-sm font-bold text-slate-800" %><%= form.email_field :email, required: true, autocomplete: "email", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2.5" %></div>
        <div><%= form.label :phone, "Telefono (facoltativo)", class: "block text-sm font-bold text-slate-800" %><%= form.telephone_field :phone, autocomplete: "tel", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2.5" %></div>
        <div><%= form.label :message, "Perché vuoi accedere? (facoltativo)", class: "block text-sm font-bold text-slate-800" %><%= form.text_area :message, rows: 4, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2.5" %></div>
        <label class="flex items-start gap-3 text-sm leading-6 text-slate-600"><%= form.check_box :privacy_consent, required: true, class: "mt-1" %><span>Confermo di aver letto l’informativa privacy del sito e autorizzo l’uso dei recapiti per rispondere alla richiesta.</span></label>
        <%= form.submit "Invia la richiesta", class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-3 text-sm font-bold text-white hover:bg-blue-700" %>
      <% end %>
      <p class="mt-5 text-center text-sm text-slate-600">Hai già ricevuto un invito o possiedi già un accesso? <%= link_to "Accedi", new_session_path(authentication_context_link_params), class: "font-bold text-blue-700 hover:underline" %></p>
    </div>
  </div>
</section>
