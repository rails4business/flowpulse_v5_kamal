<% content_for :title, "Accedi" %>

<section class="mx-auto w-full max-w-md px-4 py-10 sm:py-16">
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 bg-slate-50/70 px-6 py-6 sm:px-7">
      <p class="text-xs font-black uppercase tracking-[0.16em] text-blue-600">Il tuo spazio</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Bentornato</h1>
      <p class="mt-2 text-sm leading-6 text-slate-600">Accedi per ritrovare agenda, percorsi e le tue attività.</p>
    </div>

    <div class="px-6 py-7 sm:px-7">
      <% if @subscription_domain.present? %>
        <div class="mb-5 rounded-xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm leading-6 text-blue-900">
          Accedendo ti iscrivi gratuitamente a <strong><%= @subscription_domain.display_hostname %></strong>.
        </div>
      <% end %>

      <%= form_with url: session_url, class: "space-y-5" do |form| %>
        <% if @subscription_domain.present? %>
          <%= hidden_field_tag :subscription_domain_id, @subscription_domain.id %>
        <% end %>

        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-bold text-slate-800" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "nome@esempio.it", value: params[:email_address], class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-950 shadow-sm outline-none placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div>
          <div class="flex items-center justify-between gap-3">
            <%= form.label :password, "Password", class: "block text-sm font-bold text-slate-800" %>
            <%= verified_link_to "Password dimenticata?", new_password_path, class: "text-xs font-bold text-blue-700 hover:text-blue-800 hover:underline" %>
          </div>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Inserisci la password", maxlength: 72, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-950 shadow-sm outline-none placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
        </div>

        <%= form.submit "Accedi", class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
      <% end %>

      <div class="mt-6 border-t border-slate-100 pt-5 text-center text-sm text-slate-600">
        Non hai ancora un account?
        <%= verified_link_to "Crea un account", new_user_path(subscription_domain_id: @subscription_domain&.id), class: "font-bold text-blue-700 hover:text-blue-800 hover:underline" %>
      </div>
    </div>
  </div>
</section>
