<% content_for :title, "#{@note_title} · Appunti" %>

<section class="mx-auto max-w-5xl">
  <%= link_to "← Tutti gli appunti", admin_notes_path, class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
  <div class="mt-6 border-b border-slate-200 pb-6">
    <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Appunti · <%= @source == "docs" ? "Documentazione" : "Workspace" %></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @note_title %></h1>
    <p class="mt-2 font-mono text-xs text-slate-500"><%= @relative_path %></p>
  </div>

  <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-10">
    <%= render "posturacorretta/shared/rich_text", rendered_content: markdown(@note_content), class_name: "min-w-0" %>
  </div>
</section>
