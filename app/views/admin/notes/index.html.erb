<% content_for :title, "Appunti" %>

<section class="mx-auto max-w-6xl">
  <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Superadmin</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Appunti e documentazione</h1>
  <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">I file Markdown nelle cartelle documentali vengono elencati automaticamente. Apri un file per leggerlo renderizzato nell'app; non sono esposti al pubblico.</p>

  <% @notes_by_source.each do |source, notes| %>
    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4 border-b border-slate-200 pb-3">
        <h2 class="text-lg font-bold text-slate-950"><%= source == "docs" ? "Documentazione" : "Appunti del workspace" %></h2>
        <span class="text-sm text-slate-500"><%= notes.size %> file</span>
      </div>

      <% notes.group_by { |note| note[:folder] }.each do |folder, folder_notes| %>
        <div class="mt-6">
          <h3 class="text-xs font-extrabold uppercase tracking-[0.14em] text-slate-500"><%= folder %></h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <% folder_notes.each do |note| %>
              <%= link_to admin_note_path(source: source, path: note[:path]), class: "group rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-blue-300 hover:bg-blue-50/40 hover:shadow-md" do %>
                <h4 class="text-sm font-bold text-slate-900 group-hover:text-blue-700"><%= note[:title] %></h4>
                <p class="mt-2 truncate text-xs text-slate-500"><%= note[:path] %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>
</section>
