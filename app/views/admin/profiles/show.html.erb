<% content_for :title, "Profilo · #{@profile.display_name}" %>

<main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <nav class="mb-6 text-sm font-semibold text-slate-500"><%= link_to "Assigned roles", admin_assigned_role_map_path, class: "text-blue-700 hover:underline" %> <span class="mx-2">/</span> <%= @profile.display_name %></nav>
  <%= render "admin/profiles/header", profile: @profile, active_tab: "profile" %>

  <div class="mt-6 grid gap-6 md:grid-cols-3">
    <%= link_to domain_admin_path(admin_profile_brand_accesses_path(@profile), brand_slug: "flowpulse"), class: "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-blue-300" do %><p class="text-xs font-black uppercase tracking-wider text-slate-400">BrandAccess</p><strong class="mt-2 block text-3xl"><%= @profile.brand_accesses.count %></strong><span class="mt-2 block text-sm text-blue-700">Apri elenco →</span><% end %>
    <%= link_to domain_admin_path(admin_profile_nodes_path(@profile), brand_slug: "flowpulse"), class: "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-blue-300" do %><p class="text-xs font-black uppercase tracking-wider text-slate-400">Node responsabili</p><strong class="mt-2 block text-3xl"><%= @profile.responsible_nodes.count %></strong><span class="mt-2 block text-sm text-blue-700">Apri elenco →</span><% end %>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-black uppercase tracking-wider text-slate-400">Profilo professionale</p><strong class="mt-2 block text-lg"><%= @profile.primary_node&.title || "Non collegato" %></strong><p class="mt-2 text-xs text-slate-500"><%= @profile.primary_node ? (@profile.primary_node.visibility == "public" ? "Pubblico" : "Privato") : "Facoltativo" %></p></section>
  </div>

  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div><p class="text-[11px] font-black uppercase tracking-wider text-slate-400">Assigned role</p><h2 class="mt-1 text-xl font-black">Ruoli assegnati</h2></div>
      <% if @genera_impresa %>
        <div class="flex flex-wrap justify-end gap-2">
          <% unless @genera_impresa_assignments.key?("gestore_generaimpresa") %><%= button_to "Assegna Gestore GeneraImpresa", domain_admin_path(admin_profile_role_assignments_path(@profile), brand_slug: "flowpulse"), method: :post, params: { role_code: "gestore_generaimpresa" }, class: "rounded-xl bg-violet-700 px-4 py-2 text-sm font-black text-white hover:bg-violet-800" %><% end %>
          <% unless @genera_impresa_assignments.key?("imprenditore_generaimpresa") %><%= button_to "Assegna Imprenditore GeneraImpresa", domain_admin_path(admin_profile_role_assignments_path(@profile), brand_slug: "flowpulse"), method: :post, params: { role_code: "imprenditore_generaimpresa" }, class: "rounded-xl bg-orange-600 px-4 py-2 text-sm font-black text-white hover:bg-orange-700" %><% end %>
        </div>
      <% end %>
    </div>
    <% if @role_assignments.any? %><ul class="mt-5 divide-y divide-slate-100 border-y border-slate-200"><% @role_assignments.each do |assignment| %><% definition = RoleDefinitions::Registry.find(assignment.role_operator) if assignment.operator? %><li class="flex flex-wrap items-start justify-between gap-3 py-4" data-role-assignment-id="<%= assignment.id %>"><div><div class="flex items-center gap-2"><strong class="text-sm"><%= definition&.label || assignment.role_operator&.humanize || assignment.role.humanize %></strong><span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-black uppercase"><%= assignment.status %></span></div><p class="mt-1 text-xs text-slate-500"><%= assignment.context.try(:title) || "Globale" %><%= " · BrandAccess ##{assignment.brand_access_id}" if assignment.brand_access_id %></p></div><% if assignment.operator? && assignment.status == "active" %><%= button_to "Revoca", domain_admin_path(admin_profile_role_assignment_path(@profile, assignment), brand_slug: "flowpulse"), method: :delete, data: { turbo_confirm: "Revocare questo ruolo?" }, class: "text-xs font-black text-red-700 hover:underline" %><% else %><span class="text-xs font-bold text-slate-400"><%= assignment.operator? ? "Storico" : "Ruolo strutturale" %></span><% end %></li><% end %></ul><% else %><p class="mt-5 rounded-xl border border-dashed border-slate-300 p-5 text-sm text-slate-500">Nessun ruolo assegnato.</p><% end %>
  </section>
</main>
