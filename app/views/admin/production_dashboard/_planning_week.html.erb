<% color_classes = {
  "blue" => "border-blue-200 bg-blue-100 text-blue-950",
  "sky" => "border-sky-200 bg-sky-100 text-sky-950",
  "teal" => "border-teal-200 bg-teal-100 text-teal-950",
  "emerald" => "border-emerald-200 bg-emerald-100 text-emerald-950",
  "amber" => "border-amber-200 bg-amber-100 text-amber-950",
  "violet" => "border-violet-200 bg-violet-100 text-violet-950",
  "rose" => "border-rose-200 bg-rose-100 text-rose-950",
  "orange" => "border-orange-200 bg-orange-100 text-orange-950",
  "slate" => "border-slate-200 bg-slate-100 text-slate-900"
} %>
<% day_names = %w[Lunedì Martedì Mercoledì Giovedì Venerdì Sabato Domenica] %>

<div data-week-start="<%= week_days.first.iso8601 %>" data-week-end="<%= week_days.last.iso8601 %>" class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="min-w-[900px] p-3 sm:p-4">
    <div class="grid grid-cols-[4.5rem_repeat(7,minmax(7rem,1fr))] gap-1.5 border-b border-slate-200 pb-2">
      <div class="self-end px-2 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Ora</div>
      <% week_days.each do |day| %>
        <div class="rounded-xl px-2 py-2 text-center <%= day == Date.current ? 'bg-blue-600 text-white' : 'bg-slate-50 text-slate-700' %>">
          <p class="text-[10px] font-extrabold uppercase tracking-wide"><%= day_names.fetch(day.cwday - 1) %></p>
          <p class="mt-0.5 text-sm font-black"><%= day.strftime("%d/%m") %></p>
        </div>
      <% end %>
    </div>

    <div class="mt-1 grid gap-1.5">
      <% week_hours.each do |hour| %>
        <% hour_value = hour.to_i %>
        <% hour_label = format("%02d:00", hour_value) %>
        <div class="grid grid-cols-[4.5rem_repeat(7,minmax(7rem,1fr))] gap-1.5">
          <div class="px-2 pt-2 text-right font-mono text-[11px] font-bold text-slate-400"><%= hour_label %></div>
          <% week_days.each do |day| %>
            <% slot_entries = entries_by_slot.fetch([day, hour_value], []) %>
            <div class="min-h-14 rounded-lg border border-slate-100 bg-slate-50/60 p-1">
              <div class="grid gap-1">
                <% slot_entries.each do |entry| %>
                  <% starts_at = entry[:starts_at]&.in_time_zone %>
                  <% ends_at = entry[:ends_at]&.in_time_zone %>
                  <% entry_color = color_classes.fetch(entry[:color].to_s, color_classes.fetch("slate")) %>
                  <article class="rounded-md border p-1.5 shadow-sm <%= entry_color %>">
                    <h3 class="truncate text-[11px] font-black leading-tight"><%= entry[:title] %></h3>
                    <p class="mt-0.5 text-[9px] font-bold opacity-75"><%= starts_at&.strftime("%H:%M") || hour_label %><%= "–#{ends_at.strftime('%H:%M')}" if ends_at.present? %></p>
                    <% if entry[:context].present? %><p class="mt-0.5 truncate text-[9px] opacity-75"><%= entry[:context] %></p><% end %>
                  </article>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<p class="mt-3 text-xs leading-5 text-slate-500">La griglia mostra la settimana reale. Le ricorrenze diventeranno eventi datati quando verrà attivata la loro programmazione.</p>
