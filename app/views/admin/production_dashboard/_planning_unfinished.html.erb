<% status_labels = { "draft" => "Bozza", "requested" => "Richiesto", "planned" => "Da iniziare", "confirmed" => "Confermato", "in_progress" => "In corso" } %>

<% if commitments.any? %>
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50 px-4 py-3 sm:px-5">
      <p class="text-xs font-black uppercase tracking-[0.14em] text-slate-500">Impegni ancora aperti</p>
    </div>
    <div class="divide-y divide-slate-100">
      <% commitments.each do |commitment| %>
        <article class="grid gap-3 px-4 py-4 transition hover:bg-slate-50 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-5">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wide text-emerald-700"><%= commitment.kind.humanize %></span>
              <h3 class="font-black text-slate-950"><%= commitment.title %></h3>
            </div>
            <p class="mt-1 text-xs leading-5 text-slate-500">
              <%= [
                commitment.domain&.display_hostname,
                commitment.subject&.respond_to?(:title) ? commitment.subject.title : nil,
                commitment.skill_product&.title,
                commitment.responsible_profile&.display_name.presence || commitment.assignee_profile&.display_name.presence
              ].compact.join(" · ").presence || "Contesto da definire" %>
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 sm:justify-end">
            <% if commitment.starts_at.present? %>
              <span class="rounded-lg bg-amber-50 px-2.5 py-1.5 text-xs font-extrabold text-amber-800"><%= l(commitment.starts_at, format: "%a %d %b · %H:%M") %></span>
            <% else %>
              <span class="rounded-lg bg-slate-100 px-2.5 py-1.5 text-xs font-extrabold text-slate-500">Da programmare</span>
            <% end %>
            <span class="rounded-lg bg-blue-50 px-2.5 py-1.5 text-xs font-extrabold text-blue-700"><%= status_labels.fetch(commitment.status, commitment.status.humanize) %></span>
          </div>
        </article>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="rounded-2xl border border-dashed border-emerald-300 bg-emerald-50/50 px-5 py-12 text-center">
    <span class="mx-auto flex size-11 items-center justify-center rounded-full bg-emerald-100 text-lg text-emerald-700" aria-hidden="true">✓</span>
    <h3 class="mt-3 font-black text-slate-950">Nessun impegno aperto</h3>
    <p class="mt-1 text-sm text-slate-500">Quando collocherai un'attività da svolgere, comparirà qui.</p>
  </div>
<% end %>
