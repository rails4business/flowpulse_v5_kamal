<% content_for :title, "Gestione contenuti" %>

<section class="mx-auto max-w-6xl">
  <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Superadmin · contenuti</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Catalogo e tassonomia dei contenuti</h1>
  <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Qui si coordina l'archivio editoriale: ambiti, sottoambiti, aree, paradigmi, professionisti e luoghi. La modifica resta per ora nei file YAML, così la struttura viene verificata prima di aprire un editor nel database.</p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Contenuti catalogati</p><p class="mt-2 text-3xl font-black text-slate-950"><%= @article_count %></p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Ambiti</p><p class="mt-2 text-3xl font-black text-slate-950"><%= @taxonomy.fetch("ambiti", {}).size %></p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Aree e paradigmi</p><p class="mt-2 text-3xl font-black text-slate-950"><%= @taxonomy.fetch("aree", {}).size + @taxonomy.fetch("paradigmi", {}).size %></p></div>
  </div>

  <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-950">Struttura attuale</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <% @taxonomy.fetch("ambiti", {}).each do |_key, ambit| %>
        <article class="rounded-xl border border-slate-200 p-4"><h3 class="font-semibold text-slate-950"><%= ambit.fetch("label") %></h3><% if ambit["children"].present? %><ul class="mt-3 space-y-1 text-sm text-slate-600"><% ambit["children"].each_value do |child| %><li>• <%= child.fetch("label") %></li><% end %></ul><% end %></article>
      <% end %>
    </div>
  </section>

  <div class="mt-8 flex flex-wrap gap-3">
    <%= link_to "Apri il piano editoriale", admin_note_path(source: "docs", path: "posturacorretta_catalogo_contenuti.md"), class: "inline-flex rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" %>
    <%= link_to "Vedi la pagina pubblica", posturacorretta_contenuti_path, class: "inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>
</section>
