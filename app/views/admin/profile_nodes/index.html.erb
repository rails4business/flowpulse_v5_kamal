<% content_for :title, "Node · #{@profile.display_name}" %>
<main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <nav class="mb-6 text-sm font-semibold text-slate-500"><%= link_to "Assigned roles", admin_assigned_role_map_path, class: "text-blue-700 hover:underline" %><span class="mx-2">/</span><%= link_to @profile.display_name, admin_profile_path(@profile), class: "text-blue-700 hover:underline" %><span class="mx-2">/</span>Node</nav>
  <%= render "admin/profiles/header", profile: @profile, active_tab: "nodes" %>
  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-end justify-between"><div><p class="text-xs font-black uppercase tracking-wider text-slate-400">Index</p><h2 class="mt-1 text-xl font-black">Node associati</h2></div><span class="font-black text-slate-400"><%= @nodes.size %></span></div>
    <% if @nodes.any? %><ul class="mt-5 grid gap-3 sm:grid-cols-2"><% @nodes.each do |node| %><li class="rounded-xl border border-slate-200 p-4" data-profile-node-id="<%= node.id %>"><%= link_to node.title, admin_profile_node_path(@profile, node), class: "font-black text-blue-700 hover:underline" %><p class="mt-1 text-xs text-slate-500"><%= node.node_type %> · <%= node.slug %> · <%= node.visibility %></p><p class="mt-2 text-[11px] font-bold <%= node.responsible_profile == @profile ? 'text-emerald-700' : 'text-slate-400' %>"><%= node.responsible_profile == @profile ? "Responsabile principale" : "Associato tramite ruolo o profilo" %></p><% if node.responsible_profile == @profile %><%= button_to "Rimuovi responsabilità", admin_profile_node_responsibility_path(@profile, node), method: :delete, data: { turbo_confirm: "Rimuovere questa responsabilità?" }, class: "mt-3 text-xs font-black text-red-700 hover:underline" %><% end %></li><% end %></ul><% else %><p class="mt-5 rounded-xl border border-dashed border-slate-300 p-5 text-sm text-slate-500">Nessun Node associato.</p><% end %>
    <% if @responsibility_nodes.any? && @responsibility_role_options.any? %><%= form_with url: admin_profile_node_responsibilities_path(@profile), method: :post, class: "mt-6 grid gap-3 rounded-xl border border-blue-100 bg-blue-50 p-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |form| %><div><%= form.label :node_id, "Node", class: "block text-xs font-black" %><%= form.select :node_id, options_from_collection_for_select(@responsibility_nodes, :id, :title), { prompt: "Scegli il Node" }, required: true, class: "mt-1 w-full rounded-xl border-slate-300 bg-white text-sm" %></div><div><%= form.label :role_code, "Ruolo", class: "block text-xs font-black" %><%= form.select :role_code, options_for_select(@responsibility_role_options.map { |definition| [definition.label, definition.code] }), { prompt: "Scegli il ruolo" }, required: true, class: "mt-1 w-full rounded-xl border-slate-300 bg-white text-sm" %></div><%= form.submit "Affida o trasferisci", class: "rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-black text-white" %><% end %><% elsif @brand_accesses.empty? %><p class="mt-5 text-sm font-bold text-amber-700">Serve prima un BrandAccess attivo.</p><% end %>
  </section>
</main>
