<% content_for :title, "#{@node.title} · #{@profile.display_name}" %>
<main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <nav class="mb-6 text-sm font-semibold text-slate-500"><%= link_to @profile.display_name, admin_profile_path(@profile), class: "text-blue-700 hover:underline" %><span class="mx-2">/</span><%= link_to "Node", admin_profile_nodes_path(@profile), class: "text-blue-700 hover:underline" %><span class="mx-2">/</span><%= @node.title %></nav>
  <%= render "admin/profiles/header", profile: @profile, active_tab: "nodes" %>
  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-wider text-slate-400">Node #<%= @node.id %></p><div class="mt-2 flex flex-wrap items-start justify-between gap-4"><div><h2 class="text-2xl font-black"><%= @node.title %></h2><p class="mt-1 font-mono text-xs text-slate-500"><%= @node.slug %></p></div><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-black uppercase"><%= @node.status %></span></div><p class="mt-5 text-sm leading-6 text-slate-600"><%= @node.description.presence || "Nessuna descrizione." %></p><dl class="mt-6 grid gap-4 sm:grid-cols-3"><div><dt class="text-xs font-black text-slate-400">Tipo</dt><dd class="mt-1 text-sm"><%= @node.node_type %></dd></div><div><dt class="text-xs font-black text-slate-400">Visibilità</dt><dd class="mt-1 text-sm"><%= @node.visibility %></dd></div><div><dt class="text-xs font-black text-slate-400">Responsabile</dt><dd class="mt-1 text-sm"><%= @node.responsible_profile&.display_name || "—" %></dd></div></dl></section>
  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-black">Ruoli del Profile su questo Node</h2><% if @role_assignments.any? %><ul class="mt-4 divide-y divide-slate-100 border-y"><% @role_assignments.each do |assignment| %><li class="py-3"><strong class="text-sm"><%= RoleDefinitions::Registry.find(assignment.role_operator)&.label || assignment.role_operator || assignment.role %></strong><p class="mt-1 text-xs text-slate-500"><%= assignment.status %><%= " · BrandAccess ##{assignment.brand_access_id}" if assignment.brand_access_id %></p></li><% end %></ul><% else %><p class="mt-3 text-sm text-slate-500">Il collegamento deriva dal profilo professionale, dalla responsabilità o da un ruolo strutturale.</p><% end %></section>
</main>
