<%= link_to path, class: "group flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow" do %>
  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-xs font-black tracking-wide text-blue-700"><%= code %></span>
  <span>
    <span class="block font-extrabold text-slate-950 group-hover:text-blue-700"><%= title %></span>
    <span class="mt-1 block text-sm leading-5 text-slate-600"><%= description %></span>
  </span>
<% end %>
