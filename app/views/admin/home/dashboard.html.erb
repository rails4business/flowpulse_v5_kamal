<% content_for :title, "Regia tecnica · Flowpulse" %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <header class="border-b border-slate-200 pb-6">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-700">Superadmin</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Regia tecnica</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Configurazione dell'ecosistema e strumenti interni. Brand, domini e progetti si gestiscono dalla loro pagina dedicata.</p>
    </div>
  </header>

  <nav class="mt-5 flex gap-1 border-b border-slate-200" aria-label="Amministrazione struttura">
    <%= link_to "Dashboard", admin_dashboard_path, class: "border-b-2 border-blue-600 px-4 py-3 text-sm font-extrabold text-blue-700" %>
    <%= link_to "Brand", admin_brands_path, class: "border-b-2 border-transparent px-4 py-3 text-sm font-extrabold text-slate-500 hover:text-slate-800" %>
    <%= link_to "Domini", admin_brands_path(tab: "domains"), class: "border-b-2 border-transparent px-4 py-3 text-sm font-extrabold text-slate-500 hover:text-slate-800" %>
  </nav>

  <section class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Panoramica sistema">
    <%= link_to admin_brands_path, class: "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow" do %>
      <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500">Brand</p>
      <p class="mt-2 text-3xl font-black text-slate-950"><%= @brand_count %></p>
      <p class="mt-1 text-xs text-slate-500">con almeno un dominio</p>
    <% end %>
    <%= link_to admin_brands_path(tab: "domains"), class: "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow" do %>
      <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500">Domini</p>
      <p class="mt-2 text-3xl font-black text-slate-950"><%= @total_domains %></p>
      <p class="mt-1 text-xs text-slate-500">ingressi configurati</p>
    <% end %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500">Nodi</p>
      <p class="mt-2 text-3xl font-black text-slate-950"><%= @total_nodes %></p>
      <p class="mt-1 text-xs text-slate-500">brand, progetti e collegamenti</p>
    </div>
    <%= link_to admin_content_taxonomy_path, class: "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow" do %>
      <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500">Contenuti</p>
      <p class="mt-2 text-3xl font-black text-slate-950"><%= @total_contents %></p>
      <p class="mt-1 text-xs text-slate-500">nodi contenuto registrati</p>
    <% end %>
  </section>

  <section class="mt-10">
    <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Gestione</p>
    <h2 class="mt-1 text-xl font-black text-slate-950">Cosa vuoi gestire?</h2>
    <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      <%= render "admin/home/dashboard_link", path: admin_brands_path, title: "Brand e domini", description: "Albero dei brand, progetti collegati e configurazione dei domini.", code: "BRD" %>
      <%= render "admin/home/dashboard_link", path: admin_assigned_role_map_path, title: "Ruoli assegnati", description: "Ideatori, creator, digital e responsabili collegati agli utenti.", code: "ROL" %>
      <%= render "admin/home/dashboard_link", path: admin_risorse_index_path, title: "Risorse", description: "Consultazione delle risorse e dei dati interni.", code: "DAT" %>
      <%= render "admin/home/dashboard_link", path: admin_content_taxonomy_path, title: "Gestione contenuti", description: "Catalogo, tassonomia e filtri dei contenuti.", code: "CNT" %>
      <%= render "admin/home/dashboard_link", path: admin_password_reset_requests_path, title: "Accessi", description: "Richieste di recupero password e link temporanei.", code: "SEC" %>
      <%= render "admin/home/dashboard_link", path: admin_data_commitment_imports_path, title: "Importa impegni", description: "Anteprima ed esportazione dei DataCommitment.", code: "SYNC" %>
    </div>
  </section>

  <section class="mt-10 border-t border-slate-200 pt-8">
    <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-slate-500">Strumenti interni</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <%= link_to "Appunti", admin_notes_path, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:border-slate-400 hover:bg-slate-50" %>
      <%= link_to "Elenco pagine", admin_elenco_pagine_path, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:border-slate-400 hover:bg-slate-50" %>
      <%= link_to "Percorso didattico", admin_percorso_insegnanti_path, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:border-slate-400 hover:bg-slate-50" %>
      <%= link_to "Mappa ruoli", admin_role_map_path, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:border-slate-400 hover:bg-slate-50" %>
      <%= link_to "Weekplan", "/viste_html/6_weekplan.html", class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:border-slate-400 hover:bg-slate-50" %>
    </div>
  </section>

  <% if local_request? %>
    <section class="mt-10 rounded-2xl border border-dashed border-amber-300 bg-amber-50 p-5">
      <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-amber-800">Solo localhost</p>
      <h2 class="mt-1 text-lg font-black text-slate-950">Simulatore dominio</h2>
      <p class="mt-1 text-sm text-slate-600">Usalo per verificare l'ingresso su un dominio senza cambiare host.</p>
      <div class="mt-4 max-w-xl">
        <% if session[:override_domain_id].present? %>
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-white p-3 text-sm text-slate-700">
            <span>Simulazione attiva: <strong><%= current_domain&.hostname %></strong></span>
            <%= button_to "Resetta", admin_set_override_path(domain_id: nil), method: :post, class: "rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-extrabold text-slate-700 hover:bg-slate-50" %>
          </div>
        <% else %>
          <%= form_with(url: admin_set_override_path, method: :post, class: "flex flex-wrap gap-2") do |f| %>
            <%= f.select :domain_id, Domain.order(:hostname).map { |domain| [domain.hostname, domain.id] }, { include_blank: "Seleziona dominio…" }, class: "min-w-56 rounded-lg border-slate-300 text-sm" %>
            <%= f.submit "Simula", class: "rounded-lg bg-amber-700 px-3 py-2 text-sm font-extrabold text-white hover:bg-amber-800" %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
