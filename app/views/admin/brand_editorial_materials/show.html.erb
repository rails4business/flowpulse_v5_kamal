<% content_for :title, "#{@entry.fetch('label')} · #{@brand.title}" %>

<main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <%= link_to "← Materiale di #{@brand.title}", admin_brand_path(@brand, tab: "material"), class: "text-sm font-semibold text-blue-700 hover:text-blue-500" %>

  <header class="mt-6 border-b border-slate-200 pb-6">
    <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-700"><%= @entry.fetch("kind") %></span>
      <span class="rounded-full bg-blue-50 px-2.5 py-1 text-blue-700"><%= @entry.fetch("visibility") %></span>
      <span class="rounded-full bg-amber-50 px-2.5 py-1 text-amber-800"><%= @entry.fetch("status") %></span>
    </div>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950"><%= @entry.fetch("label") %></h1>
    <% if @entry["notes"].present? %><p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= @entry["notes"] %></p><% end %>
    <p class="mt-4 font-mono text-xs text-slate-500">config/data/<%= @entry.fetch("source") %></p>
  </header>

  <% if @source_content %>
    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 shadow-sm">
      <div class="border-b border-white/10 px-5 py-3 text-xs font-semibold text-slate-400">Sorgente · sola lettura</div>
      <pre class="overflow-x-auto p-5 text-sm leading-6 text-slate-100"><code><%= @source_content %></code></pre>
    </section>
  <% else %>
    <section class="mt-7 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-base font-extrabold text-slate-950">Raccolta di file</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Questa sorgente è una cartella. Il registro la mantiene come origine unica del materiale, senza esporre o modificare i file da questa pagina.</p>
    </section>
  <% end %>
</main>
