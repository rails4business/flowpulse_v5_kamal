<% content_for :title, "BrandAccess · #{@profile.display_name}" %>
<main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <nav class="mb-6 text-sm font-semibold text-slate-500"><%= link_to "Assigned roles", admin_assigned_role_map_path, class: "text-blue-700 hover:underline" %><span class="mx-2">/</span><%= link_to @profile.display_name, domain_admin_path(admin_profile_path(@profile), brand_slug: "flowpulse"), class: "text-blue-700 hover:underline" %><span class="mx-2">/</span>BrandAccess</nav>
  <%= render "admin/profiles/header", profile: @profile, active_tab: "brand_accesses" %>
  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-end justify-between"><div><p class="text-xs font-black uppercase tracking-wider text-slate-400">Index</p><h2 class="mt-1 text-xl font-black">BrandAccess</h2></div><span class="font-black text-slate-400"><%= @brand_accesses.size %></span></div>
    <% if @brand_accesses.any? %><ul class="mt-5 divide-y divide-slate-100 border-y border-slate-200"><% @brand_accesses.each do |access| %><li class="flex flex-wrap items-center justify-between gap-4 py-4" data-brand-access-id="<%= access.id %>"><div><%= link_to access.brand_node.title, domain_admin_path(admin_profile_brand_access_path(@profile, access), brand_slug: "flowpulse"), class: "font-black text-blue-700 hover:underline" %><p class="mt-1 text-xs text-slate-500"><%= access.source_domain.hostname %> · <%= access.status.humanize %> · dal <%= l access.joined_at, format: :short %></p></div><% if access.active? %><%= button_to "Revoca", domain_admin_path(admin_profile_brand_access_path(@profile, access), brand_slug: "flowpulse"), method: :delete, data: { turbo_confirm: "Revocare questo accesso?" }, class: "text-xs font-black text-red-700 hover:underline" %><% end %></li><% end %></ul><% else %><p class="mt-5 rounded-xl border border-dashed border-slate-300 p-5 text-sm text-slate-500">Nessun BrandAccess.</p><% end %>
    <%= form_with url: domain_admin_path(admin_profile_brand_accesses_path(@profile), brand_slug: "flowpulse"), method: :post, class: "mt-6 grid gap-3 rounded-xl border border-blue-100 bg-blue-50 p-4 sm:grid-cols-[1fr_auto] sm:items-end" do |form| %><div><%= form.label :domain_id, "Concedi o riattiva", class: "block text-xs font-black text-slate-700" %><%= form.select :domain_id, options_from_collection_for_select(@available_domains, :id, ->(domain) { "#{domain.node.title} · #{domain.hostname}" }), { prompt: "Scegli il Brand" }, required: true, class: "mt-1 w-full rounded-xl border-slate-300 bg-white text-sm" %></div><%= form.submit "Concedi accesso", class: "rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-black text-white" %><% end %>
  </section>
</main>
