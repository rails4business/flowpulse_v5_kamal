<% content_for :title, "Week Plan #{@week_key} · MarkPostura" %>

<section class="mx-auto max-w-5xl">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-amber-700">MarkPostura · sorgente YAML</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Week Plan <%= @week_key %></h1>
    </div>
    <%= link_to "Apri la settimana →", markpostura_weekplan_path(week: @week_key), class: "rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold text-white" %>
  </div>

  <p class="mt-6 break-all rounded-xl bg-slate-100 px-4 py-3 font-mono text-xs text-slate-600"><%= @week_path.relative_path_from(Rails.root) %></p>
  <pre class="mt-4 overflow-x-auto rounded-2xl bg-slate-950 p-6 text-sm leading-6 text-slate-100"><code><%= @week_content %></code></pre>
</section>
