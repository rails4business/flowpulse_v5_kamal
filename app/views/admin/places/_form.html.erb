<%= form_with model: place, url: (place.persisted? ? flowpulse_place_path(place) : flowpulse_places_path), class: "space-y-5 rounded-xl border border-slate-200 bg-white p-6" do |form| %>
  <% if place.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-bold">Controlla i campi:</p>
      <ul class="mt-2 list-disc pl-5">
        <% place.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :name, "Nome", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_field :name, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :slug, "Slug", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_field :slug, placeholder: "es. sede-posturacorretta", class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono" %>
    </div>
    <div class="md:col-span-2">
      <%= form.label :address, "Indirizzo", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_field :address, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :city, "Città", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_field :city, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :province, "Provincia", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_field :province, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :latitude, "Latitudine", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_field :latitude, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono" %>
    </div>
    <div>
      <%= form.label :longitude, "Longitudine", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_field :longitude, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono" %>
    </div>
    <div class="md:col-span-2">
      <%= form.label :directions_url, "Link indicazioni", class: "text-sm font-bold text-slate-700" %>
      <%= form.url_field :directions_url, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div class="md:col-span-2">
      <%= form.label :description, "Nota sul luogo", class: "text-sm font-bold text-slate-700" %>
      <%= form.text_area :description, rows: 3, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :status, "Stato", class: "text-sm font-bold text-slate-700" %>
      <%= form.select :status, [ [ "Aperto", "open" ], [ "Chiuso", "closed" ] ], {}, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :closed_on, "Chiuso dal", class: "text-sm font-bold text-slate-700" %>
      <%= form.date_field :closed_on, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-slate-500">Un luogo chiuso resta nella storia ma non compare tra i luoghi dei domini.</p>
    </div>
  </div>

  <fieldset class="grid gap-4 rounded-lg border border-slate-200 p-4 md:grid-cols-3">
    <legend class="px-1 text-sm font-extrabold text-slate-900">Pubblicazione</legend>
    <div>
      <%= form.label :publication_status, "Stato", class: "text-sm font-bold text-slate-700" %>
      <%= form.select :publication_status, [ [ "Bozza", "draft" ], [ "Pubblicato", "published" ], [ "Archiviato", "archived" ] ], {}, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :publication_visibility, "Visibilità", class: "text-sm font-bold text-slate-700" %>
      <%= form.select :publication_visibility, [ [ "Privato", "private" ], [ "Membri", "member" ], [ "Pubblico", "public" ] ], {}, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :published_at, "Pubblicato il", class: "text-sm font-bold text-slate-700" %>
      <%= form.datetime_field :published_at, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-slate-500">Se vuoto, alla pubblicazione si usa il momento attuale.</p>
    </div>
  </fieldset>

  <div class="flex gap-2">
    <%= form.submit (place.persisted? ? "Salva" : "Crea luogo"), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-500" %>
    <%= link_to "Tutti i luoghi", flowpulse_places_path, class: "rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50" %>
  </div>
<% end %>
