<%
  active_tab = local_assigns[:active_tab].to_s.presence_in(%w[corso metodiche percorsi]) || @consapevolezza_tab || "corso"
  show_navigation = local_assigns.fetch(:show_navigation, true)
  show_tabs = local_assigns.fetch(:show_tabs, true)
  embedded = local_assigns.fetch(:embedded, false)
  active_path_tab = params[:percorso].to_s.presence_in(%w[persone attivita problemi]) || @consapevolezza_path_tab || "persone"
  tabs = [
    ["corso", "Corso"],
    ["metodiche", "Metodiche posturali"],
    ["percorsi", "Percorsi mirati"]
  ]
%>

<section class="mx-auto w-full max-w-6xl pb-12 pt-2" aria-label="Consapevolezza">
  <% if show_navigation %>
    <%= render "nodes/posturacorretta_home/path_breadcrumb", current: "Consapevolezza" %>
    <header class="px-1 pb-8 text-center sm:px-6 sm:pb-10">
      <p class="text-xs font-black uppercase tracking-[.2em] text-indigo-700">Consapevolezza corporea</p>
      <h1 id="consapevolezza-title" class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Attività e percorsi</h1>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-7 text-slate-600 sm:text-lg">Scopri le metodiche posturali o trova un percorso mirato.</p>
    </header>

  <% end %>

  <% if show_tabs %>
    <nav class="relative z-10 grid grid-cols-3 items-end px-3 sm:px-8" aria-label="Sezioni di Consapevolezza">
      <% tabs.each_with_index do |tab, index| %>
        <% tab_key, label = tab %>
        <% selected = active_tab == tab_key %>
        <% destination = embedded ? posturacorretta_path(area: "consapevolezza", tab: tab_key) : posturacorretta_consapevolezza_path(tab: tab_key) %>
        <%= link_to destination,
            class: "flex min-h-16 items-center justify-center border px-3 py-3 text-center text-sm font-black leading-5 transition sm:text-base #{selected ? '-mb-px border-indigo-200 border-b-white bg-white text-indigo-800 shadow-[0_-8px_22px_rgba(79,70,229,.08)]' : 'border-slate-200 bg-slate-50 text-slate-600 hover:bg-white hover:text-indigo-700'} #{'rounded-tl-2xl' if index.zero?} #{'rounded-tr-2xl' if index == tabs.length - 1}",
            aria: { current: ("page" if selected) } do %>
          <%= label %>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <div class="relative rounded-[1.75rem] border border-indigo-200 bg-white px-5 py-8 shadow-[0_22px_60px_rgba(15,23,42,.08)] sm:px-9 sm:py-10 <%= 'pc-embedded-panel' if embedded %>">
    <% if active_tab == "corso" %>
      <% course = @consapevolezza_course || Posturacorretta::ContentRepository.new(include_scheduled: true).course_by_id("muoviti-ed-esplora") %>
      <section class="mx-auto max-w-3xl py-2 sm:py-5">
        <p class="text-xs font-black uppercase tracking-[.16em] text-indigo-600">Corso online</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950"><%= course.fetch("title") %></h2>
        <p class="mt-4 text-base leading-7 text-slate-600"><%= course.fetch("description") %></p>
        <% if course.fetch("status") == "published" %>
          <%= link_to posturacorretta_course_path(course.fetch("slug")), class: "mt-7 inline-flex items-center gap-2 rounded-xl bg-indigo-700 px-5 py-3 text-sm font-black text-white transition hover:bg-indigo-800" do %>
            Inizia il corso <span aria-hidden="true">→</span>
          <% end %>
        <% else %>
          <span class="mt-7 inline-flex rounded-xl bg-slate-100 px-5 py-3 text-sm font-black text-slate-600">In preparazione</span>
        <% end %>
      </section>
    <% elsif active_tab == "metodiche" %>
      <% methodologies = @consapevolezza_methodologies || PosturacorrettaMethodologies.load.fetch("methodologies") %>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% methodologies.to_a.each do |methodology| %>
          <%= link_to posturacorretta_metodica_path(methodology.fetch("slug")), class: "group flex min-h-44 flex-col rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-lg" do %>
            <p class="text-xs font-black uppercase tracking-[.14em] text-indigo-600"><%= methodology.fetch("founder") %></p>
            <h3 class="mt-2 text-xl font-black text-slate-950 group-hover:text-indigo-800"><%= methodology.fetch("title") %></h3>
            <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600"><%= methodology.fetch("short_description") %></p>
            <span class="mt-auto pt-4 text-sm font-black text-indigo-700">Apri la scheda <span aria-hidden="true">→</span></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <% path_groups = @consapevolezza_path_groups.presence || [
        { key: "persone", label: "Persone e fasi della vita", description: "Percorsi pensati per età, momenti di cambiamento e bisogni delle persone.", node: Node.find_by(slug: "eta") },
        { key: "attivita", label: "Attività e contesti", description: "Percorsi collegati al lavoro, alla vita quotidiana, allo sport e agli ambienti frequentati.", node: Node.find_by(slug: "attivita-e-contesti") },
        { key: "problemi", label: "Problemi ed esigenze", description: "Percorsi educativi per orientarsi tra condizioni, sintomi ed esigenze specifiche.", node: Node.find_by(slug: "condizioni-e-patologie") }
      ] %>
      <% active_path_group = path_groups.find { |group| group.fetch(:key) == active_path_tab } || path_groups.first %>

      <nav class="grid grid-cols-3 items-end" aria-label="Tipi di percorsi mirati" role="tablist">
        <% path_groups.each_with_index do |group, index| %>
          <% selected = group == active_path_group %>
          <% destination = embedded ? posturacorretta_path(area: "consapevolezza", tab: "percorsi", percorso: group.fetch(:key)) : posturacorretta_consapevolezza_path(tab: "percorsi", percorso: group.fetch(:key)) %>
          <%= link_to destination,
              class: "flex min-h-16 items-center justify-center border px-2 py-3 text-center text-xs font-black leading-4 transition sm:px-4 sm:text-sm sm:leading-5 #{selected ? '-mb-px border-indigo-200 border-b-white bg-white text-indigo-800' : 'border-slate-200 bg-slate-50 text-slate-600 hover:bg-white hover:text-indigo-700'} #{'rounded-tl-xl' if index.zero?} #{'rounded-tr-xl' if index == path_groups.length - 1}",
              role: "tab",
              aria: { selected: selected, controls: "percorso-#{group.fetch(:key)}" } do %>
            <%= group.fetch(:label) %>
          <% end %>
        <% end %>
      </nav>

      <% if active_path_group.present? %>
        <section id="percorso-<%= active_path_group.fetch(:key) %>" class="rounded-b-2xl border border-indigo-200 bg-white p-6 sm:p-8" role="tabpanel">
          <p class="max-w-3xl leading-7 text-slate-600"><%= active_path_group.fetch(:description) %></p>
          <% if active_path_group[:node].present? %>
            <%= link_to flowtree_public_node_path(active_path_group.fetch(:node)), class: "mt-6 inline-flex items-center gap-2 rounded-xl bg-indigo-700 px-5 py-3 text-sm font-black text-white transition hover:bg-indigo-800" do %>
              Esplora i percorsi <span aria-hidden="true">→</span>
            <% end %>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </div>
</section>
