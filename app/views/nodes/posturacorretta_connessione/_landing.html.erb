<%
  active_tab = local_assigns[:active_tab].to_s.presence_in(%w[corpo risorse]) || @connessione_tab || "corpo"
  show_navigation = local_assigns.fetch(:show_navigation, true)
  show_tabs = local_assigns.fetch(:show_tabs, true)
  embedded = local_assigns.fetch(:embedded, false)
  tabs = [
    ["corpo", "Il corpo"],
    ["risorse", "Le tue risorse"]
  ]
  courses = @connessione_courses || begin
    repository = Posturacorretta::ContentRepository.new(include_scheduled: true)
    { "corpo" => repository.course_by_id("corpo-come-un-giardino"), "risorse" => repository.course_by_id("ascolta-gli-aspetti-vitali") }
  end
  course = courses.fetch(active_tab)
%>

<section class="mx-auto w-full max-w-6xl pb-12 pt-2" aria-label="Connessione">
  <% if show_navigation %>
    <%= render "nodes/posturacorretta_home/path_breadcrumb", current: "Connessione" %>
    <header class="px-1 pb-8 text-center sm:px-6 sm:pb-10">
      <p class="text-xs font-black uppercase tracking-[.2em] text-violet-700">Connessione</p>
      <h1 id="connessione-title" class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Corpo e risorse</h1>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-7 text-slate-600 sm:text-lg">Conosci il corpo e scopri le risorse da portare nelle relazioni, nel lavoro e nei tuoi progetti.</p>
    </header>
  <% end %>

  <% if show_tabs %>
    <nav class="relative z-10 grid grid-cols-2 items-end px-3 sm:px-8" aria-label="Sezioni di Connessione">
      <% tabs.each_with_index do |tab, index| %>
        <% tab_key, label = tab %>
        <% selected = active_tab == tab_key %>
        <% destination = embedded ? posturacorretta_path(area: "connessione", tab: tab_key) : posturacorretta_connessione_path(tab: tab_key) %>
        <%= link_to destination,
            class: "flex min-h-16 items-center justify-center border px-3 py-3 text-center text-sm font-black leading-5 transition sm:text-base #{selected ? '-mb-px border-violet-200 border-b-white bg-white text-violet-800 shadow-[0_-8px_22px_rgba(124,58,237,.08)]' : 'border-slate-200 bg-slate-50 text-slate-600 hover:bg-white hover:text-violet-700'} #{'rounded-tl-2xl' if index.zero?} #{'rounded-tr-2xl' if index == tabs.length - 1}",
            aria: { current: ("page" if selected) } do %>
          <%= label %>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <div class="relative rounded-[1.75rem] border border-violet-200 bg-white px-5 py-8 shadow-[0_22px_60px_rgba(15,23,42,.08)] sm:px-9 sm:py-10 <%= 'pc-embedded-panel' if embedded %>">
    <section class="mx-auto max-w-3xl py-2 sm:py-5">
      <p class="text-xs font-black uppercase tracking-[.16em] text-violet-600">Corso online</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950"><%= course.fetch("title") %></h2>
      <p class="mt-4 text-base leading-7 text-slate-600"><%= course.fetch("description") %></p>
      <% if course.fetch("status") == "published" %>
        <%= link_to posturacorretta_course_path(course.fetch("slug")), class: "mt-7 inline-flex items-center gap-2 rounded-xl bg-violet-700 px-5 py-3 text-sm font-black text-white transition hover:bg-violet-800" do %>
          Inizia il corso <span aria-hidden="true">→</span>
        <% end %>
      <% else %>
        <span class="mt-7 inline-flex rounded-xl bg-slate-100 px-5 py-3 text-sm font-black text-slate-600">In preparazione</span>
      <% end %>

      <% if active_tab == "corpo" %>
        <div class="mt-8 border-t border-violet-100 pt-6">
          <p class="text-xs font-black uppercase tracking-[.16em] text-violet-600">Approfondisci</p>
          <%= link_to book_path("il-corpo-un-mondo-da-scoprire"), class: "mt-3 inline-flex items-center gap-2 text-base font-black text-slate-950 transition hover:text-violet-700" do %>
            Il corpo, un mondo da scoprire <span aria-hidden="true">→</span>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</section>
