<% Array(items).each do |item| %>
  <% if item[:children].any? %>
    <details class="group relative">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 lg:justify-start lg:text-slate-600">
        <%= item[:label] %><span class="text-[10px] transition group-open:rotate-180">▼</span>
      </summary>
      <div class="ml-3 border-l border-slate-200 pl-2 lg:absolute lg:left-0 lg:z-50 lg:ml-0 lg:mt-1 lg:min-w-64 lg:rounded-xl lg:border lg:bg-white lg:p-2 lg:shadow-xl">
        <%= link_to item[:label], flowtree_public_node_path(item[:node]), class: "block rounded-lg px-3 py-2 text-sm font-black text-slate-900 hover:bg-slate-100" %>
        <% item[:children].each do |child| %>
          <%= link_to child[:label], flowtree_public_node_path(child[:node]), class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950" %>
        <% end %>
      </div>
    </details>
  <% else %>
    <%= link_to item[:label], flowtree_public_node_path(item[:node]), class: "block max-w-64 truncate rounded-lg px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 hover:text-slate-950 lg:text-slate-600" %>
  <% end %>
<% end %>
