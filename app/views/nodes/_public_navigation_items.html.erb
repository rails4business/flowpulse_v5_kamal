<% nested = local_assigns.fetch(:nested, false) %>
<% Array(items).each do |item| %>
  <% destination = public_node_navigation_item_path(item) %>
  <% if item[:children].any? %>
    <details
      class="group/menu relative <%= 'ml-2 border-l border-slate-200 pl-2 lg:ml-0 lg:border-0 lg:pl-0' if nested %>"
      data-controller="details-menu"
      data-details-menu-group-value="<%= nested ? 'public-node-nested' : 'public-node-primary' %>"
      data-action="toggle->details-menu#closePeers click@window->details-menu#closeOutside keydown@window->details-menu#closeOnEscape"
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 <%= 'lg:justify-start lg:text-slate-600' unless nested %>">
        <%= item[:label] %><span class="text-[10px] transition group-open/menu:rotate-180">▼</span>
      </summary>
      <div class="ml-3 border-l border-slate-200 pl-2 <%= 'lg:absolute lg:left-0 lg:z-50 lg:ml-0 lg:mt-1 lg:min-w-72 lg:rounded-xl lg:border lg:bg-white lg:p-2 lg:shadow-xl' unless nested %>">
        <% if destination.present? && !item[:group] && !nested %>
          <%= link_to item[:label], destination, class: "block rounded-lg px-3 py-2 text-sm font-black text-slate-900 hover:bg-slate-100" %>
        <% end %>
        <%= render "nodes/public_navigation_items", items: item[:children], nested: true %>
      </div>
    </details>
  <% elsif destination.present? %>
    <%= link_to item[:label], destination, class: "block max-w-72 rounded-lg px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 hover:text-slate-950 lg:text-slate-600" %>
  <% else %>
    <span class="block rounded-lg px-3 py-2 text-sm font-bold text-slate-500"><%= item[:label] %></span>
  <% end %>
<% end %>
