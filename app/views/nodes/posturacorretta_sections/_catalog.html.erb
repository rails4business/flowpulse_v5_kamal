<section class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
  <header class="overflow-hidden rounded-[2rem] bg-gradient-to-br <%= gradient %> px-6 py-10 text-white shadow-xl sm:px-10 sm:py-14">
    <h1 class="max-w-4xl text-4xl font-black tracking-tight sm:text-6xl"><%= title %></h1>
    <p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-white/85"><%= description %></p>
  </header>

  <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    <% children.each_with_index do |child, index| %>
      <% target = child.bridge_node? ? child.resolve_target : child %>
      <%= link_to flowtree_public_node_path(target), class: "group flex min-h-56 flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl" do %>
        <span class="flex size-10 items-center justify-center rounded-2xl bg-slate-950 text-sm font-black text-white"><%= format("%02d", index + 1) %></span>
        <h2 class="mt-6 text-xl font-black tracking-tight text-slate-950 group-hover:text-blue-700"><%= child.title.sub(/\AAccesso\s+/i, "") %></h2>
        <% if child.description.present? %><p class="mt-3 text-sm leading-6 text-slate-600"><%= child.description %></p><% end %>
        <span class="mt-auto pt-6 text-sm font-black text-blue-700">Scopri di più <span aria-hidden="true">→</span></span>
      <% end %>
    <% end %>
  </div>
</section>
