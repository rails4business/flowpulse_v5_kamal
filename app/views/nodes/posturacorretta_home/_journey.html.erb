<section id="mappa" class="pc-home-journey" aria-label="Percorso PosturaCorretta">
  <header class="pc-home-journey__header">
    <nav class="pc-home-journey__breadcrumb" aria-label="Breadcrumb">
      <%= link_to "Home", posturacorretta_path %>
      <span aria-hidden="true">/</span>
      <span>Postura Recupero</span>
      <span aria-hidden="true">/</span>
      <strong aria-current="page"><%= journey.station.fetch("title") %></strong>
    </nav>
    <p class="pc-home-journey__context">Tappa <%= journey.station_number %> di <%= journey.stations.size %></p>
    <h1><%= journey.station.fetch("title") %></h1>
  </header>

  <div class="pc-home-journey__layout">
    <aside class="pc-home-journey__aside">
      <header class="pc-journey-aside__header"><p class="pc-home-journey__aside-title">Postura e recupero</p><strong>Il percorso</strong><span><%= journey.sheet_courses.size %> corsi · <%= journey.stations.size %> tappe</span></header>
      <%= render "nodes/posturacorretta_home/program_stepper", journey: journey %>
      <nav class="pc-journey-aside__pager" aria-label="Procedi nel percorso">
        <% if journey.previous_station %><%= link_to posturacorretta_postura_recupero_path(tappa: journey.previous_station.fetch("slug"), tab: "online"), class: "is-previous" do %><span aria-hidden="true">←</span><span><small>Indietro</small><strong><%= journey.previous_station.fetch("title") %></strong></span><% end %><% else %><span></span><% end %>
        <% if journey.next_station %><%= link_to posturacorretta_postura_recupero_path(tappa: journey.next_station.fetch("slug"), tab: "online"), class: "is-next" do %><span><small>Procedi</small><strong><%= journey.next_station.fetch("title") %></strong></span><span aria-hidden="true">→</span><% end %><% end %>
      </nav>
    </aside>

    <div class="pc-home-journey__content">
      <% if journey.tabs.size > 1 %>
        <nav class="pc-home-tabs" aria-label="Contenuti della tappa">
          <% journey.tabs.each do |tab, label| %>
            <%= link_to label,
              posturacorretta_postura_recupero_path(tappa: journey.station.fetch("slug"), tab: tab),
              class: "pc-home-tab pc-home-tab--#{tab} #{'is-selected' if tab == journey.tab}",
              aria: { current: ("page" if tab == journey.tab) } %>
          <% end %>
        </nav>
      <% end %>

      <div class="pc-home-panel pc-home-panel--<%= journey.tab %>">
        <% if journey.tab == "prenota" %>
          <div class="pc-home-resource-filter" aria-label="Filtra la disponibilità del percorso">
            <%= link_to "Tutti", posturacorretta_postura_recupero_path(tappa: journey.station.fetch("slug"), tab: journey.tab), class: "pc-home-resource-chip #{'is-selected' if journey.resource.blank?}" %>
            <% journey.resource_options.each do |resource| %>
              <%= link_to resource.fetch("name"), posturacorretta_postura_recupero_path(tappa: journey.station.fetch("slug"), tab: journey.tab, risorsa: resource.fetch("slug")), class: "pc-home-resource-chip #{'is-selected' if journey.resource == resource.fetch('slug')}" %>
            <% end %>
          </div>
        <% end %>
        <%= render "nodes/posturacorretta_home/#{journey.tab}", journey: journey, data: journey.course_data %>
      </div>
    </div>
  </div>
</section>
