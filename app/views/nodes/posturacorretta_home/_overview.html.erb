<%
  active_area = params[:area].to_s.presence_in(%w[intro espressione consapevolezza connessione]) || "intro"
  education_label = @posturacorretta_education_node&.public_navigation_label || "Percorso educativo"
  areas = [
    ["espressione", education_label, "Recupero, movimento, mente e fisiologia: le aree del programma."],
    ["consapevolezza", "Consapevolezza", "Consapevolezza del corpo grazie alla pratica delle metodiche posturali."],
    ["connessione", "Connessione", "Il corpo, un mondo da scoprire. Dalla PosturaCorretta al Giardino del Corpo, per l'evoluzione armonica dell'essere umano."]
  ]
  expression_parts = [
    ["recupero-massaggio", "Recupero e terapie manuali"],
    ["movimento-allenamento", "Movimento e allenamento"],
    ["mente", "Mente e aspetti emotivi e mentali"],
    ["fisiologia", "Fisiologia, mangiare e medicamenti"]
  ]
  active_expression_part = params[:parte].to_s.presence_in(expression_parts.map(&:first)) || "recupero-massaggio"
  active_awareness_tab = params[:tab].to_s.presence_in(%w[corso metodiche percorsi]) || "corso"
  active_connection_tab = params[:tab].to_s.presence_in(%w[corpo risorse]) || "corpo"
%>

<main class="pc-index-cabinet" aria-label="PosturaCorretta">
  <% unless active_area == "intro" %>
    <%= render "nodes/posturacorretta_home/path_breadcrumb", current: areas.to_h { |key, label, _| [key, label] }.fetch(active_area) %>
  <% end %>

  <div class="pc-index-cabinet__body">
    <% if active_area == "intro" %>
      <%= render "nodes/posturacorretta_home/landing", selected_part: "intro", show_navigation: false %>
      <section class="mx-auto mt-10 grid w-full max-w-[70rem] gap-5 md:grid-cols-3" aria-label="Aree del percorso PosturaCorretta">
        <% areas.each do |key, label, description| %>
          <article class="flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-black tracking-tight text-slate-950"><%= label %></h2>
            <p class="mt-3 text-sm leading-6 text-slate-600"><%= description %></p>
            <%= link_to posturacorretta_path(area: key), class: "mt-auto self-start pt-5 text-sm font-black text-blue-700 hover:text-blue-800" do %>Vai <span aria-hidden="true">→</span><% end %>
          </article>
        <% end %>
      </section>
    <% elsif active_area == "espressione" %>
      <section class="pc-index-cabinet__panel" aria-label="Percorso educativo">
        <nav class="relative z-10 mx-auto grid w-full max-w-[70rem] grid-cols-4 items-end px-3 sm:px-8" aria-label="Sezioni del percorso educativo">
          <% expression_parts.each_with_index do |(key, label), index| %>
            <% selected = key == active_expression_part %>
            <%= link_to posturacorretta_path(area: "espressione", parte: key),
                class: "flex min-h-16 items-center justify-center border px-2 py-3 text-center text-xs font-black leading-4 transition sm:px-3 sm:text-sm sm:leading-5 #{selected ? '-mb-px border-blue-200 border-b-white bg-white text-blue-800 shadow-[0_-8px_22px_rgba(37,99,235,.08)]' : 'border-slate-200 bg-slate-50 text-slate-600 hover:bg-white hover:text-blue-700'} #{'rounded-tl-2xl' if index.zero?} #{'rounded-tr-2xl' if index == expression_parts.length - 1}",
                aria: { current: ("page" if selected) } do %>
              <%= label %>
            <% end %>
          <% end %>
        </nav>
        <%= render "nodes/posturacorretta_home/landing", selected_part: active_expression_part, show_navigation: false %>
      </section>
    <% elsif active_area == "consapevolezza" %>
      <section class="pc-index-cabinet__panel" aria-label="Consapevolezza">
        <%= render "nodes/posturacorretta_consapevolezza/landing", active_tab: active_awareness_tab, show_navigation: false, show_tabs: true, embedded: true %>
        <%= render "nodes/posturacorretta_home/journey_footer",
          part_number: 6,
          previous_path: posturacorretta_path(area: "espressione", parte: "fisiologia"), previous_label: "Fisiologia",
          next_path: posturacorretta_path(area: "connessione", tab: "corpo"), next_label: "Connessione" %>
      </section>
    <% else %>
      <section class="pc-index-cabinet__panel" aria-label="Connessione">
        <%= render "nodes/posturacorretta_connessione/landing", active_tab: active_connection_tab, show_navigation: false, show_tabs: true, embedded: true %>
        <%= render "nodes/posturacorretta_home/journey_footer",
          part_number: 7,
          previous_path: posturacorretta_path(area: "consapevolezza", tab: "corso"), previous_label: "Consapevolezza",
          complete: true %>
      </section>
    <% end %>
  </div>
</main>
