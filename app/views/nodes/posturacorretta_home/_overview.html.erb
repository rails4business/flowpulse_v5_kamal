<section class="pc-path-overview" aria-labelledby="pc-path-overview-title">
  <div class="pc-path-overview__hero">
    <div class="pc-path-overview__intro">
      <p class="pc-path-overview__eyebrow">Educazione alla salute</p>
      <h1 id="pc-path-overview-title">Conosci il corpo.<br>Partecipa alla tua salute.</h1>
      <p>PosturaCorretta è un percorso educativo per osservare come si esprime il corpo, imparare a riattivare i sistemi fisiologici e orientarsi tra professionisti e metodiche.</p>
      <%= link_to posturacorretta_espressione_path, class: "pc-path-overview__primary-action" do %>
        Inizia dall’Espressione <span aria-hidden="true">→</span>
      <% end %>
    </div>

    <div class="pc-path-overview__map" aria-label="Le tre fasi del percorso">
      <span class="is-current"><i>1</i><strong>Espressione</strong><small>Osserva e riattiva</small></span>
      <span><i>2</i><strong>Consapevolezza</strong><small>Percepisci e comprendi</small></span>
      <span><i>3</i><strong>Connessione</strong><small>Collega</small></span>
    </div>
  </div>

  <div class="pc-path-overview__heading">
    <div>
      <p class="pc-path-overview__eyebrow">I tre momenti</p>
      <h2>Sono parti dello stesso percorso.</h2>
    </div>
    <p>Puoi esplorarle liberamente. Se è la prima volta, ti consigliamo di partire dall’Espressione.</p>
  </div>

  <ol class="pc-path-overview__steps">
    <li class="is-first">
      <%= link_to posturacorretta_espressione_path do %>
        <span class="pc-path-overview__number">01</span>
        <span class="pc-path-overview__status">Da qui si comincia</span>
        <h3>Espressione</h3>
        <strong>Educazione alla salute in tre passi.</strong>
        <ol class="pc-path-overview__mini-steps">
          <li><i>1</i><span>Osserva come si esprime il corpo.</span></li>
          <li><i>2</i><span>Impara a riattivare i sistemi fisiologici.</span></li>
          <li><i>3</i><span>Conosci professionisti e metodiche.</span></li>
        </ol>
        <span class="pc-path-overview__link">Inizia il percorso <i aria-hidden="true">→</i></span>
      <% end %>
    </li>
    <li>
      <%= link_to posturacorretta_consapevolezza_path do %>
        <span class="pc-path-overview__number">02</span>
        <h3>Consapevolezza</h3>
        <strong>Allena la percezione del corpo.</strong>
        <p>Fai pratica per integrare ciò che senti con ciò che comprendi, riconoscendo segnali, cambiamenti e possibilità con maggiore consapevolezza.</p>
        <span class="pc-path-overview__link">Esplora le metodiche <i aria-hidden="true">→</i></span>
      <% end %>
    </li>
    <li>
      <%= link_to posturacorretta_connessione_path do %>
        <span class="pc-path-overview__number">03</span>
        <h3>Connessione</h3>
        <strong>Collega ciò che hai scoperto.</strong>
        <p>Metti in relazione corpo, risorse e conoscenze per costruire una visione più integrata del tuo percorso di salute.</p>
        <span class="pc-path-overview__link">Scopri le connessioni <i aria-hidden="true">→</i></span>
      <% end %>
    </li>
  </ol>
</section>
