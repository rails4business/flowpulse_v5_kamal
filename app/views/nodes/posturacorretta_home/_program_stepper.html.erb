<%
  courses = local_assigns.fetch(:courses, journey.sheet_courses)
  limit = local_assigns[:limit]
  courses = courses.first(limit) if limit
  compact = local_assigns.fetch(:compact, false)
  fallback_sessions = local_assigns.fetch(:fallback_sessions, [])
  if courses.empty? && fallback_sessions.empty?
    fallback_sessions = journey.stations.map do |station|
      { station: station, course: nil, course_title: station.fetch("title"), lesson: nil, lesson_title: station.fetch("title") }
    end
  end
  fallback_sessions = fallback_sessions.first(limit) if limit
%>
<nav class="pc-program-stepper <%= 'pc-program-stepper--compact' if compact %>" aria-label="Tappe del percorso">
  <ol class="pc-program-stepper__list">
    <% if courses.empty? %>
      <% fallback_sessions.each_with_index do |session, index| %>
        <% station = session.fetch(:station) %>
        <li class="pc-program-stepper__group">
          <%= link_to posturacorretta_postura_recupero_path(tappa: station.fetch("slug"), tab: "online"), class: "pc-program-stepper__step pc-program-stepper__step--course" do %>
            <span class="pc-program-stepper__marker"><%= index + 1 %></span>
            <span><small>Corso online</small><strong><%= session.fetch(:course)&.title || session.fetch(:course_title) %></strong></span>
          <% end %>
          <%= link_to posturacorretta_postura_recupero_path(tappa: station.fetch("slug"), tab: "lezioni"), class: "pc-program-stepper__step pc-program-stepper__step--lesson" do %>
            <span class="pc-program-stepper__marker"></span>
            <span><small>Lezione · prenotazione</small><strong><%= (session.fetch(:lesson)&.title || session.fetch(:lesson_title)).delete_prefix("Lezione · ") %></strong></span>
          <% end %>
        </li>
      <% end %>
    <% end %>
    <% courses.each_with_index do |course, course_index| %>
      <% station = course.station %>
      <% course_selected = station == journey.station && journey.tab == "online" %>
      <li class="pc-program-stepper__group">
        <% if station %>
          <%= link_to posturacorretta_postura_recupero_path(tappa: station.fetch("slug"), tab: "online"), class: "pc-program-stepper__step pc-program-stepper__step--course #{'is-selected' if course_selected}", aria: { current: ("step" if course_selected) } do %>
            <span class="pc-program-stepper__marker"><%= course_index + 1 %></span>
            <span><small>Corso online</small><strong><%= course.node.title %></strong></span>
          <% end %>
        <% else %>
          <div class="pc-program-stepper__step pc-program-stepper__step--course is-unavailable">
            <span class="pc-program-stepper__marker"><%= course_index + 1 %></span>
            <span><small>Corso online</small><strong><%= course.node.title %></strong></span>
          </div>
        <% end %>

        <% course.lessons.each do |lesson| %>
          <% lesson_selected = station == journey.station && journey.tab == "lezioni" %>
          <% lesson_available = station && journey.station_data(station)&.fetch(:program_lessons, [])&.any? %>
          <% if lesson_available %>
            <%= link_to posturacorretta_postura_recupero_path(tappa: station.fetch("slug"), tab: "lezioni"), class: "pc-program-stepper__step pc-program-stepper__step--lesson #{'is-selected' if lesson_selected}", aria: { current: ("step" if lesson_selected) } do %>
              <span class="pc-program-stepper__marker"></span>
              <span><small>Lezione · prenotazione</small><strong><%= lesson.title.delete_prefix("Lezione · ") %></strong></span>
            <% end %>
          <% else %>
            <div class="pc-program-stepper__step pc-program-stepper__step--lesson is-unavailable">
              <span class="pc-program-stepper__marker"></span>
              <span><small>Lezione</small><strong><%= lesson.title.delete_prefix("Lezione · ") %></strong></span>
            </div>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
