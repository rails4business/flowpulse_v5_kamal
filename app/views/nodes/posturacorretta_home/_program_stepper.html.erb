<%
  courses = local_assigns.fetch(:courses, journey.sheet_courses)
  limit = local_assigns[:limit]
  courses = courses.first(limit) if limit
  compact = local_assigns.fetch(:compact, false)
  fallback_sessions = local_assigns.fetch(:fallback_sessions, [])
  if courses.empty? && fallback_sessions.empty?
    fallback_sessions = journey.stations.map do |station|
      { station: station, course: nil, course_title: station.fetch("title"), lesson: nil, lesson_title: station.fetch("title") }
    end
  end
  fallback_sessions = fallback_sessions.first(limit) if limit
%>
<nav class="pc-program-stepper <%= 'pc-program-stepper--compact' if compact %>" aria-label="Tappe del percorso">
  <ol class="pc-program-stepper__list">
    <% if courses.empty? %>
      <% fallback_sessions.each_with_index do |session, index| %>
        <% station = session.fetch(:station) %>
        <li class="pc-program-stepper__group">
          <%= link_to posturacorretta_postura_recupero_path(tappa: station.fetch("slug"), tab: "online"), class: "pc-program-stepper__step pc-program-stepper__step--course" do %>
            <span class="pc-program-stepper__marker"><%= index + 1 %></span>
            <span><small>Corso online</small><strong><%= session.fetch(:course)&.title || session.fetch(:course_title) %></strong></span>
          <% end %>
          <%= link_to posturacorretta_postura_recupero_path(tappa: station.fetch("slug"), tab: "lezioni"), class: "pc-program-stepper__step pc-program-stepper__step--lesson" do %>
            <span class="pc-program-stepper__marker"></span>
            <span><small>Lezione · prenotazione</small><strong><%= (session.fetch(:lesson)&.title || session.fetch(:lesson_title)).delete_prefix("Lezione · ") %></strong></span>
          <% end %>
        </li>
      <% end %>
    <% end %>
    <% courses.each_with_index do |course, course_index| %>
      <% lesson_stations = course.lessons.filter_map { |lesson| journey.station_for_node(lesson) } %>
      <% course_selected = course.station == journey.station || lesson_stations.include?(journey.station) %>
      <% course_content = course.node.show_content %>
      <li class="pc-program-stepper__group <%= 'is-current-group' if course_selected %>">
        <% course_path = course_content ? posturacorretta_course_path(corso: course_content.slug) : flowtree_public_node_path(course.node) %>
        <details class="pc-program-module" <%= "open" if course_selected %>>
          <summary class="pc-program-stepper__step pc-program-stepper__step--course <%= 'is-parent-selected' if course_selected %>">
            <span class="pc-program-stepper__marker"><%= course_index + 1 %></span>
            <%= link_to course_path,
              class: "pc-program-module__show-link",
              aria: { label: "Apri il corso #{course.node.title}" } do %>
              <small>Corso <%= format("%02d", course_index + 1) %></small>
              <strong><%= course.node.title %></strong>
            <% end %>
            <span class="pc-program-stepper__chevron" aria-hidden="true"></span>
          </summary>
          <div class="pc-program-module__body">
            <div class="pc-program-module__lessons">
              <% course.lessons.each_with_index do |lesson, lesson_index| %>
                <% lesson_station = journey.station_for_node(lesson) %>
                <% lesson_selected = lesson_station == journey.station %>
                <% if lesson_station %>
                  <%= link_to posturacorretta_postura_recupero_path(tappa: lesson_station.fetch("slug"), tab: "online"), class: "pc-program-stepper__step pc-program-stepper__step--lesson #{'is-selected' if lesson_selected}", aria: { current: ("step" if lesson_selected) } do %>
                    <span class="pc-program-stepper__lesson-status" aria-hidden="true"></span>
                    <span><small><%= course_index + 1 %>.<%= lesson_index + 1 %></small><strong><%= lesson.title.delete_prefix("Lezione · ") %></strong></span>
                    <span class="pc-program-stepper__badge">Lezione</span>
                  <% end %>
                <% else %>
                  <div class="pc-program-stepper__step pc-program-stepper__step--lesson is-unavailable">
                    <span class="pc-program-stepper__lesson-status" aria-hidden="true"></span>
                    <span><small><%= course_index + 1 %>.<%= lesson_index + 1 %></small><strong><%= lesson.title.delete_prefix("Lezione · ") %></strong></span>
                    <span class="pc-program-stepper__badge">In preparazione</span>
                  </div>
                <% end %>
              <% end %>
              <% if course.lessons.empty? %>
                <p class="pc-program-module__empty">Le lezioni saranno aggiunte prossimamente.</p>
              <% end %>
            </div>
          </div>
        </details>
      </li>
    <% end %>
  </ol>
</nav>
