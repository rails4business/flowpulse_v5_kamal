<%
  available_parts = [
    { slug: "intro", label: "Intro" },
    { slug: "recupero-massaggio", label: "Recupero e terapie manuali" },
    { slug: "movimento-allenamento", label: "Movimento e allenamento" },
    { slug: "mente", label: "Mente e aspetti emotivi e mentali" },
    { slug: "fisiologia", label: "Fisiologia, mangiare e medicamenti" }
  ]
  program_parts = available_parts.reject { |part| part.fetch(:slug) == "intro" }
  selected_part = local_assigns[:selected_part].to_s.presence_in(available_parts.map { |part| part.fetch(:slug) }) || params[:parte].presence_in(program_parts.map { |part| part.fetch(:slug) }) || "recupero-massaggio"
  show_navigation = local_assigns.fetch(:show_navigation, true)
  intro_sessions = [
    { course: Node.find_by(slug: "corso-introduzione-al-percorso-integrato"), course_title: "Introduzione al Percorso Integrato", lesson: Node.find_by(slug: "introduzione-al-percorso-integrato"), lesson_title: "Lezione · Introduzione al Percorso Integrato", station: Posturacorretta::HomeJourney::STATIONS.find { |item| item.fetch("slug") == "introduzione-al-percorso-integrato" } },
    { course: Node.find_by(slug: "corso-la-prima-settimana-con-posturacorretta"), course_title: "La prima settimana con PosturaCorretta", lesson: Node.find_by(slug: "la-prima-settimana-con-posturacorretta"), lesson_title: "Lezione · La prima settimana con PosturaCorretta", station: Posturacorretta::HomeJourney::STATIONS.find { |item| item.fetch("slug") == "la-prima-settimana-con-posturacorretta" } },
    { course: Node.find_by(slug: "postura-e-fisiologia"), course_title: "Postura e fisiologia", lesson: Node.find_by(slug: "introduzione-postura-e-fisiologia"), lesson_title: "Introduzione a Postura e fisiologia", station: Posturacorretta::HomeJourney::STATIONS.find { |item| item.fetch("slug") == "introduzione-postura-e-fisiologia" } }
  ]
%>

<div class="pc-landing-home">
  <% if show_navigation %>
    <%= render "nodes/posturacorretta_home/path_breadcrumb", current: "Espressione" %>
    <nav class="pc-expression-tabs" aria-label="Aree di Espressione">
      <% program_parts.each do |part| %>
        <% if part.fetch(:slug) == selected_part %>
          <span class="pc-expression-tab is-selected" aria-current="page"><%= part.fetch(:label) %></span>
        <% else %>
          <%= link_to part.fetch(:label), posturacorretta_path(area: "espressione", parte: part.fetch(:slug)), class: "pc-expression-tab" %>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <% if selected_part == "intro" %>
  <section class="pc-sheet pc-intro-sheet" aria-labelledby="pc-intro-title" data-controller="print-date">
    <div class="pc-intro-sheet__hero">
      <div>
        <h1 id="pc-intro-title">Non è solo stare ben dritti con la schiena.</h1>
        <p>Salute perfetta con PosturaCorretta</p>
        <p>Impara a leggere la tua fisiologia Scopri come il corpo si esprime.</p>
      </div>
      <img src="https://ik.imagekit.io/posturacorretta/posturacorretta_home.png?updatedAt=1749759675777" alt="Salute perfetta con PosturaCorretta">
    </div>

    <div class="pc-intro-sheet__path">
      <h2>Percorso PosturaCorretta</h2>
      <p>Conoscere i nostri sistemi fisiologici e imparare a riattivarli attraverso un percorso di educazione alla salute basato sui principi delle principali metodiche posturali.</p>

      <ol class="pc-intro-sheet__principles">
        <li><span>01</span><div><h3>Scopri</h3><p>Con il corso online, impara ad ascoltare il corpo, osserva come funziona e sperimenta come riattivare i suoi sistemi.</p></div></li>
        <li><span>02</span><div><h3>Pratica</h3><p>Affronta le lezioni con un insegnante PosturaCorretta, che ti accompagna nel percorso educativo, alla scoperta delle metodiche posturali.</p></div></li>
        <li><span>03</span><div><h3>Approfondisci</h3><p>Hai trovato una metodica che ti piace? Vuoi iniziare un percorso personalizzato? Ogni metodica ha una scuola. Trova un professionista formato che possa seguirti nel tuo percorso.</p></div></li>
      </ol>

      <div class="pc-intro-actions">
        <%= link_to "Inizia", posturacorretta_postura_recupero_path(tappa: "introduzione-al-percorso-integrato", tab: "online"), class: "pc-landing-primary-action" %>
        <%= link_to "Per saperne di più", posturacorretta_about_path, class: "pc-landing-secondary-action" %>
      </div>
    </div>

    <div class="pc-intro-sheet__program">
      <h2>Programma Intro</h2>
      <% unless authenticated? %>
        <p class="pc-sheet__login"><%= link_to "Accedi", new_session_path(return_to: request.fullpath) %> per vedere il tuo avanzamento.</p>
      <% end %>

      <div class="pc-intro-program-list" role="table" aria-label="Programma Intro">
        <div class="pc-intro-program-list__head" role="row">
          <span role="columnheader">Corso / lezione</span><span role="columnheader">Data e ora</span><span role="columnheader">Centro</span><span role="columnheader">Insegnante</span>
        </div>
        <% intro_sessions.each_with_index do |session, index| %>
          <% station_slug = session.fetch(:station).fetch("slug") %>
          <div class="pc-intro-program-list__row is-course" role="row">
            <span class="pc-intro-program-list__marker"><%= index + 1 %></span>
            <span role="cell"><small>Corso online</small><%= link_to session.fetch(:course)&.title || session.fetch(:course_title), posturacorretta_postura_recupero_path(tappa: station_slug, tab: "online") %></span>
            <span role="cell">Iscrizione</span><span role="cell"></span><span role="cell"></span>
          </div>
          <div class="pc-intro-program-list__row is-lesson" role="row">
            <span class="pc-intro-program-list__marker"></span>
            <span role="cell"><small>Lezione</small><%= link_to (session.fetch(:lesson)&.title || session.fetch(:lesson_title)).delete_prefix("Lezione · "), posturacorretta_postura_recupero_path(tappa: station_slug, tab: "lezioni") %></span>
            <span role="cell"></span><span role="cell"></span><span role="cell"></span>
          </div>
        <% end %>
      </div>
    </div>

    <%= render "nodes/posturacorretta_home/journey_footer",
      part_number: 1,
      sheet_label: "Intro",
      print_label: "Intro",
      next_path: posturacorretta_path(area: "espressione", parte: "recupero-massaggio"),
      next_label: "Recupero e terapie manuali" %>
  </section>
  <% elsif selected_part == "recupero-massaggio" %>
    <% recovery_courses = @posturacorretta_home.sheet_courses.drop(3) %>
    <section class="pc-sheet pc-intro-sheet" aria-labelledby="pc-recovery-title" data-controller="print-date">
      <header class="pc-program-sheet__intro">
        <p class="pc-sheet__eyebrow">PosturaCorretta · Il mio percorso</p>
        <h1 id="pc-recovery-title">Recupero e terapie manuali</h1>
        <p>La parte del programma dedicata alle terapie manuali, alle tecniche corporee e al recupero.</p>
      </header>

      <div class="pc-intro-sheet__program pc-program-sheet__table pc-sheet__scroll">
        <table class="pc-sheet__table pc-intro-sheet__table">
          <thead>
            <tr><th scope="col">Corso / lezione</th><th scope="col">Data e ora</th><th scope="col">Centro</th><th scope="col">Insegnante</th></tr>
          </thead>
          <% recovery_courses.each_with_index do |course, index| %>
            <% destination = course.station ? posturacorretta_postura_recupero_path(tappa: course.station.fetch("slug"), tab: "online") : flowtree_public_node_path(course.node) %>
            <tbody>
              <tr class="pc-sheet__course">
                <th scope="rowgroup"><%= index + 1 %> · <%= link_to course.node.title, destination %></th>
                <td></td><td></td><td></td>
              </tr>
              <% course.lessons.each do |lesson| %>
                <tr>
                  <td><%= link_to lesson.title, destination %></td>
                  <td class="pc-sheet__blank"></td><td class="pc-sheet__blank"></td><td class="pc-sheet__blank"></td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </table>
      </div>

      <%= render "nodes/posturacorretta_home/journey_footer",
        part_number: 2,
        sheet_label: "Recupero e terapie manuali",
        print_label: "Recupero e terapie manuali",
        previous_path: posturacorretta_path(area: "intro"), previous_label: "Intro",
        next_path: posturacorretta_path(area: "espressione", parte: "movimento-allenamento"), next_label: "Movimento e allenamento" %>
    </section>
  <% else %>
    <% current_part = program_parts.find { |part| part.fetch(:slug) == selected_part } %>
    <% current_index = program_parts.index(current_part) %>
    <% previous_part = program_parts[current_index - 1] if current_index.positive? %>
    <% next_part = program_parts[current_index + 1] %>
    <section class="pc-sheet pc-intro-sheet pc-program-placeholder">
      <p class="pc-sheet__eyebrow">PosturaCorretta · Il mio percorso</p>
      <h1><%= current_part.fetch(:label) %></h1>
      <p>Questa parte del programma è in preparazione.</p>
      <%= render "nodes/posturacorretta_home/journey_footer",
        part_number: current_index + 2,
        previous_path: posturacorretta_path(area: "espressione", parte: previous_part&.fetch(:slug) || "recupero-massaggio"),
        previous_label: previous_part&.fetch(:label) || "Recupero e terapie manuali",
        next_path: next_part.present? ? posturacorretta_path(area: "espressione", parte: next_part.fetch(:slug)) : posturacorretta_path(area: "consapevolezza", tab: "corso"),
        next_label: next_part.present? ? next_part.fetch(:label) : "Consapevolezza" %>
    </section>
  <% end %>
</div>
