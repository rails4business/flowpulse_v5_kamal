<% centres = journey.filtered_resources %>
<h2 class="text-2xl font-black text-slate-950">Centri</h2>
<p class="mt-2 text-sm text-slate-600">Luoghi fisici nei quali il corso può essere proposto.</p>
<div class="mt-6 grid gap-3 sm:grid-cols-2">
  <% centres.each do |centre| %><%= link_to centre.fetch("url"), class: "rounded-xl border border-orange-200 bg-orange-50/40 p-4 hover:bg-orange-50" do %><strong class="block text-slate-950"><%= centre.fetch("name") %></strong><span class="mt-1 block text-sm text-slate-600"><%= [centre["city"], centre["type"]].compact.join(" · ") %></span><% end %><% end %>
</div>
<% if centres.empty? %><p class="mt-6 rounded-xl bg-slate-50 p-5 text-sm text-slate-500">Non ci sono ancora centri fisici associati a questo corso.</p><% end %>
