<% if data.present? %>
  <% course = data.fetch(:course) %>
  <% chapters = data.fetch(:chapters) %>
  <article class="overflow-hidden bg-white">
    <details class="group/course" open>
      <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <div class="grid min-h-60 sm:grid-cols-[18rem_minmax(0,1fr)]">
          <div class="relative min-h-56 overflow-hidden bg-gradient-to-br from-blue-950 via-blue-700 to-cyan-400">
            <% if course["image"].present? %><%= image_tag course.fetch("image"), alt: "", class: "absolute inset-0 size-full object-cover" %><% end %>
            <span class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></span>
            <span class="absolute bottom-4 left-4 rounded-full bg-white/95 px-3 py-1 text-[11px] font-extrabold uppercase tracking-[.13em] text-slate-900 shadow-sm">Corso 1 di 7</span>
          </div>
          <div class="flex min-w-0 flex-col p-5 sm:p-7">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[11px] font-bold uppercase tracking-[.13em] text-blue-700">Corso 1 di 7</span>
              <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-700">Libero</span>
            </div>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950"><%= course.fetch("title") %></h2>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= course["description"] %></p>
            <div class="mt-auto flex items-end justify-between gap-4 pt-6">
              <span class="text-xs font-semibold text-slate-500"><%= chapters.size %> capitoli</span>
              <span class="text-xs font-bold text-blue-700">Capitoli <span class="inline-block transition group-open/course:rotate-180">⌄</span></span>
            </div>
          </div>
        </div>
      </summary>
      <div class="flex items-center justify-between gap-3 border-t border-slate-200 bg-slate-50 px-5 py-3 sm:px-7">
        <span class="text-xs font-semibold text-slate-500">Indice del corso</span>
        <% if chapters.first %><%= link_to "Inizia", chapters.first.fetch("url"), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700" %><% end %>
      </div>
      <ol class="divide-y divide-slate-200 border-t border-slate-200 bg-white px-5 sm:px-7">
        <% chapters.each_with_index do |chapter, index| %>
          <li><%= link_to chapter.fetch("url"), class: "flex items-center gap-4 py-4 text-sm text-slate-700 transition hover:text-blue-700" do %>
            <span class="grid size-8 shrink-0 place-items-center rounded-full border border-blue-200 bg-blue-50 font-black text-blue-700">▤</span>
            <span class="min-w-0 flex-1"><span class="block font-semibold"><%= chapter.fetch("title") %></span><span class="mt-0.5 block text-[10px] font-bold uppercase tracking-wide text-slate-500">Capitolo <%= format("%02d", index + 1) %></span></span>
          <% end %></li>
        <% end %>
      </ol>
    </details>
  </article>
<% else %>
  <%= render "nodes/posturacorretta_home/unavailable", journey: journey, label: "Il percorso online di questa tappa è in preparazione." %>
<% end %>
