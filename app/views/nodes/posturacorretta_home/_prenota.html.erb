<% teachers = journey.teachers %>
<% centres = journey.centres %>

<div class="pc-booking">
  <p class="text-xs font-bold uppercase tracking-[.12em] text-emerald-700"><%= journey.station.fetch("title") %> · Prenota</p>
  <h2 class="mt-2 text-2xl font-black text-slate-950">Trova dove e con chi partecipare</h2>
  <p class="mt-2 text-sm text-slate-600">Scegli un insegnante o un centro collegato a questa tappa. Date e disponibilità saranno indicate nella relativa scheda.</p>

  <% if teachers.any? %>
    <section class="mt-7" aria-labelledby="pc-booking-teachers">
      <h3 id="pc-booking-teachers" class="text-lg font-black text-slate-950">Insegnanti</h3>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <% teachers.each do |teacher| %>
          <%= link_to teacher.fetch("url"), class: "rounded-xl border border-emerald-200 bg-emerald-50/40 p-4 hover:bg-emerald-50" do %>
            <strong class="block text-slate-950"><%= teacher.fetch("name") %></strong>
            <span class="mt-1 block text-sm text-slate-600"><%= [teacher["role"] || teacher["profession"], teacher["city"]].compact.join(" · ") %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if centres.any? %>
    <section class="mt-7" aria-labelledby="pc-booking-centres">
      <h3 id="pc-booking-centres" class="text-lg font-black text-slate-950">Centri</h3>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <% centres.each do |centre| %>
          <%= link_to centre.fetch("url"), class: "rounded-xl border border-orange-200 bg-orange-50/40 p-4 hover:bg-orange-50" do %>
            <strong class="block text-slate-950"><%= centre.fetch("name") %></strong>
            <span class="mt-1 block text-sm text-slate-600"><%= [centre["city"], centre["type"]].compact.join(" · ") %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
