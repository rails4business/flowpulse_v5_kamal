<div class="pc-component pc-feature-grid mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  <% items.each do |key, item| %>
    <article class="block rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition hover:border-blue-300 hover:shadow-md">
      <span class="inline-block rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-blue-700">
        <%= inline_markdown(item['label']) %>
      </span>
      <p class="mt-4 text-sm leading-relaxed text-gray-600">
        <%= inline_markdown(item['description']) %>
      </p>
    </article>
  <% end %>
</div>
