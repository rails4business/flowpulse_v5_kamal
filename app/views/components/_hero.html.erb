<section class="pc-component pc-hero">
  <div class="mx-auto max-w-screen-xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16">
      <% if data['image'].present? %>
        <div class="relative h-64 overflow-hidden rounded-lg border border-gray-200 bg-white sm:h-80 lg:order-last lg:h-full">
          <img
            alt="<%= data['image']['alt'] %>"
            src="<%= data['image']['url'] %>"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      <% end %>

      <div class="lg:py-24">
        <% if data['kicker'].present? %>
          <p class="text-sm font-semibold uppercase tracking-widest text-blue-700">
            <%= data['kicker'] %>
          </p>
        <% end %>

        <h2 class="mt-4 text-3xl font-bold sm:text-4xl text-gray-900">
          <%= data['title'] %>
        </h2>

        <% if data['subtitle'].present? %>
          <p class="mt-4 text-gray-600 text-lg">
            <%= data['subtitle'] %>
          </p>
        <% end %>

        <% if data['cta'].present? %>
          <a
            href="<%= data['cta_url'] || '#' %>"
            class="mt-8 inline-block rounded-lg border border-blue-600 bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
          >
            <%= data['cta'] %>
          </a>
        <% end %>
      </div>
    </div>
  </div>
</section>
