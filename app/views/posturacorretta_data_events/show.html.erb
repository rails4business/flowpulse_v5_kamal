<% content_for :title, @data_event.title %>
<% content_for :description, @data_event.description.presence || "Data, programma e informazioni dell'appuntamento PosturaCorretta." %>

<main class="min-h-screen bg-[#F6F7F4]">
  <div class="mx-auto max-w-screen-xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <%= link_to posturacorretta_student_appointments_path, class: "inline-flex items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-900" do %>
      <span aria-hidden="true">←</span> Appuntamenti
    <% end %>

    <header class="mt-6 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-6 sm:px-8 sm:py-8">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700"><%= @data_event.classification.humanize %></span>
          <span class="rounded-full px-3 py-1 text-xs font-bold <%= @data_event.participant_capacity_full? ? 'bg-amber-50 text-amber-800' : 'bg-emerald-50 text-emerald-700' %>"><%= @data_event.participant_capacity_full? ? "Completo" : (@data_event.registration_status == "open" ? "Iscrizioni aperte" : @data_event.registration_status.humanize) %></span>
          <% if @data_event.status != "confirmed" %>
            <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800"><%= @data_event.status.humanize %></span>
          <% end %>
        </div>

        <h1 class="mt-4 max-w-4xl text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl"><%= @data_event.title %></h1>
        <% if @data_event.description.present? %>
          <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600"><%= @data_event.description %></p>
        <% end %>
      </div>

      <div class="grid gap-px bg-slate-100 sm:grid-cols-3">
        <div class="bg-white px-5 py-4 sm:px-8">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Quando</p>
          <p class="mt-1 text-sm font-semibold text-slate-900">
            <% if @data_event.starts_at %>
              <%= l(@data_event.starts_at, format: :long) %><%= "–#{@data_event.ends_at.strftime('%H:%M')}" if @data_event.ends_at %>
            <% else %>
              Consulta il programma
            <% end %>
          </p>
        </div>
        <div class="bg-white px-5 py-4 sm:px-8">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Luogo</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= @data_event.effective_place&.name || "Da definire" %></p>
        </div>
        <div class="bg-white px-5 py-4 sm:px-8">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Responsabile</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= @data_event.effective_responsible_profile&.display_name || "PosturaCorretta" %></p>
        </div>
      </div>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <section aria-labelledby="programma-evento-title" class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
        <p class="text-xs font-bold uppercase tracking-[.16em] text-blue-700">Struttura</p>
        <h2 id="programma-evento-title" class="mt-1 text-2xl font-bold text-slate-950">Programma e orari</h2>

        <div class="mt-6">
          <%= render "tree_node", event: @tree_event, selected_event: @data_event, depth: 0 %>
        </div>
      </section>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-3xl border border-blue-100 bg-blue-50 p-5 sm:p-6">
          <h2 class="text-lg font-bold text-slate-950"><%= @data_event.bookable? ? "Partecipa" : "Informazioni" %></h2>
          <p class="mt-2 text-sm leading-6 text-slate-600"><%= @data_event.booking_notes.presence || "Consulta il programma e scegli la data adatta." %></p>

          <div class="mt-4 rounded-xl border border-blue-100 bg-white px-4 py-3">
            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Condizioni</p>
            <% if @data_event.effective_price_cents == 0 %>
              <p class="mt-1 text-sm font-bold text-emerald-700">Gratuito</p>
            <% elsif @data_event.effective_price_cents.present? %>
              <p class="mt-1 text-sm font-bold text-slate-900"><%= number_to_currency(@data_event.effective_price_cents / 100.0, unit: @data_event.effective_currency || "EUR", format: "%n %u", separator: ",", delimiter: ".") %></p>
            <% else %>
              <p class="mt-1 text-sm font-bold text-amber-800">Condizioni da definire</p>
            <% end %>
          </div>

          <% if @data_event.node_kind == "session" && @data_event.effective_maximum_participants %>
            <dl class="mt-4 grid grid-cols-3 gap-2 rounded-xl border border-blue-100 bg-white p-3 text-center">
              <div><dt class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Capienza</dt><dd class="mt-1 text-lg font-black text-slate-900"><%= @data_event.effective_maximum_participants %></dd></div>
              <div><dt class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Confermati</dt><dd class="mt-1 text-lg font-black text-slate-900"><%= @data_event.confirmed_participants_count %></dd></div>
              <div><dt class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Disponibili</dt><dd class="mt-1 text-lg font-black <%= @data_event.participant_capacity_full? ? 'text-amber-700' : 'text-blue-700' %>"><%= @data_event.remaining_participant_places %></dd></div>
            </dl>
          <% end %>

          <% if @data_event.bookable? %>
            <% if @booking_request %>
              <% booking_state = {
                "requested" => ["Richiesta inviata", "In attesa di conferma", "border-blue-200", "text-blue-800"],
                "confirmed" => ["Partecipazione confermata", "Il posto è confermato", "border-emerald-200", "text-emerald-800"],
                "cancelled" => ["Richiesta annullata", "Questa richiesta non è più attiva", "border-slate-200", "text-slate-700"]
              }.fetch(@booking_request.status, ["Stato prenotazione", @booking_request.status.humanize, "border-slate-200", "text-slate-700"]) %>
              <div class="mt-5 rounded-xl border <%= booking_state[2] %> bg-white px-4 py-3">
                <p class="text-sm font-bold <%= booking_state[3] %>"><%= booking_state[0] %></p>
                <p class="mt-1 text-xs text-slate-500"><%= booking_state[1] %></p>
                <% if @booking_request.status == "requested" %>
                  <%= button_to "Ritira richiesta", withdraw_impegno_request_path(@booking_request), method: :patch, data: { turbo_confirm: "Ritirare questa richiesta di partecipazione?" }, class: "mt-3 rounded-lg px-3 py-2 text-xs font-bold text-red-600 hover:bg-red-50" %>
                <% end %>
              </div>
            <% end %>

            <% if @active_booking_request %>
            <% elsif @data_event.node_kind == "session" && @data_event.participant_capacity_full? %>
              <div class="mt-5 rounded-xl border border-amber-200 bg-white px-4 py-3">
                <p class="text-sm font-bold text-amber-800">Appuntamento completo</p>
                <p class="mt-1 text-xs text-slate-500">Per il pilota non è ancora attiva una lista d’attesa.</p>
              </div>
            <% elsif Current.user && @data_event.node_kind == "day" %>
              <% if @booking_time_proposals.any? %>
                <%= form_with url: book_posturacorretta_data_event_path(@data_event), class: "mt-5" do |form| %>
                  <fieldset>
                    <legend class="text-sm font-bold text-slate-800">Scegli un orario</legend>
                    <div class="mt-2 grid gap-2">
                      <% @booking_time_proposals.each_with_index do |interval, index| %>
                        <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-blue-200 bg-white px-3 py-2.5 text-sm font-bold text-slate-700 hover:border-blue-400">
                          <%= form.radio_button :requested_starts_at, interval.begin.iso8601, required: true, checked: index.zero?, class: "size-4 border-slate-300 text-blue-600 focus:ring-blue-500" %>
                          <span><%= l(interval.begin, format: "%A %d %B").capitalize %> · <%= interval.begin.strftime("%H:%M") %>–<%= interval.end.strftime("%H:%M") %></span>
                        </label>
                      <% end %>
                    </div>
                  </fieldset>
                  <%= form.submit "Invia richiesta", data: { turbo_confirm: "Vuoi inviare la richiesta per l’orario scelto?" }, class: "mt-3 flex w-full cursor-pointer items-center justify-center rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white hover:bg-blue-700" %>
                <% end %>
              <% else %>
                <div class="mt-5 rounded-xl border border-amber-200 bg-white px-4 py-3">
                  <p class="text-sm font-bold text-amber-800">Nessun orario disponibile</p>
                  <p class="mt-1 text-xs text-slate-500">Il superadmin può ampliare questa fascia o aggiungerne una nuova.</p>
                </div>
              <% end %>
            <% elsif Current.user %>
              <%= button_to "Richiedi di partecipare", book_posturacorretta_data_event_path(@data_event), class: "mt-5 flex w-full items-center justify-center rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white hover:bg-blue-700", form: { data: { turbo_confirm: "Vuoi inviare la richiesta di partecipazione?" } } %>
            <% else %>
              <%= link_to "Accedi per prenotare", new_session_path(return_to: posturacorretta_data_event_path(@data_event)), class: "mt-5 flex w-full items-center justify-center rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white hover:bg-blue-700" %>
            <% end %>
          <% end %>
        </div>
      </aside>
    </div>
  </div>
</main>
