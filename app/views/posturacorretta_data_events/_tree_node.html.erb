<% children = event.children.sort_by { |child| [child.position, child.starts_at || Time.zone.at(0), child.id] } %>
<% selected = event == selected_event %>

<div class="hs-accordion active py-0.5" role="treeitem" aria-expanded="true" id="node-<%= event.id %>">
  <div class="hs-accordion-heading flex items-center gap-x-1.5 w-full">
    <% if children.any? %>
      <button type="button" class="hs-accordion-toggle size-6 flex justify-center items-center hover:bg-slate-100 rounded-md transition-colors" aria-expanded="true" onclick="this.closest('.hs-accordion').classList.toggle('active'); this.querySelector('svg').classList.toggle('rotate-90'); this.nextElementSibling.nextElementSibling.classList.toggle('hidden');">
        <svg class="transition-transform duration-200 size-3 text-slate-400 rotate-90" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/>
        </svg>
      </button>
    <% else %>
      <span class="size-6 inline-block"></span>
    <% end %>

    <div class="grow px-2 py-1.5 rounded-lg cursor-pointer transition-colors <%= selected ? 'bg-blue-50 ring-1 ring-blue-200 text-blue-900 font-semibold' : 'hover:bg-slate-50 text-slate-800' %>">
      <div class="flex items-center gap-x-2.5">
        <% case event.node_kind %>
        <% when "root" %>
          <svg class="shrink-0 size-4 text-blue-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/>
          </svg>
        <% when "day" %>
          <svg class="shrink-0 size-4 text-emerald-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        <% when "session" %>
          <svg class="shrink-0 size-4 text-amber-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        <% when "task" %>
          <svg class="shrink-0 size-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        <% end %>

        <div class="grow flex flex-wrap items-center gap-x-2">
          <%= link_to event.title, posturacorretta_data_event_path(event), class: "text-sm font-semibold hover:underline" %>
          <% if event.starts_at && event.node_kind != "day" %>
            <span class="text-xs text-slate-500 font-normal"><%= event.starts_at.strftime("%H:%M") %><%= "–#{event.ends_at.strftime('%H:%M')}" if event.ends_at %></span>
          <% elsif event.node_kind == "day" && event.starts_at %>
            <span class="text-xs text-slate-500 font-normal"><%= l(event.starts_at.to_date, format: :long) %></span>
          <% end %>

          <% if event.node_kind == "session" && event.effective_maximum_participants %>
            <span class="ml-auto rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600">
              <%= event.confirmed_participants_count %>/<%= event.effective_maximum_participants %> iscritti
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if children.any? %>
    <div class="hs-accordion-content w-full overflow-hidden transition-all duration-300">
      <div class="ms-6 ps-5 my-1 space-y-1 relative before:absolute before:top-0 before:left-3 before:-ml-px before:h-full before:border-l-2 before:border-slate-200/80">
        <% children.each do |child| %>
          <div class="border-b border-slate-100/60 last:border-b-0 pb-1">
            <%= render "tree_node", event: child, selected_event: selected_event, depth: depth + 1 %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
