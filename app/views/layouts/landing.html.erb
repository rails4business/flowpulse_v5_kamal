<!DOCTYPE html>
<html>
  <head>
    <% page_domain = Current.domain || current_domain %>
    <% page_title = content_for(:title).presence || page_domain&.site_title.presence || "Flowpulse" %>
    <% page_description = content_for(:description).presence || page_domain&.site_description.presence || "Progetti, percorsi e strumenti digitali." %>
    <% fallback_favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='12' fill='%23dc2626'/%3E%3C/svg%3E" %>
    <% page_favicon = page_domain&.favicon_url.presence || page_domain&.logo_square_url.presence || fallback_favicon %>
    <% page_social_image = page_domain&.social_image_url.presence || page_domain&.logo_square_url.presence || page_domain&.favicon_url.presence %>
    <% page_url = request.original_url %>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= page_url %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= page_domain&.site_title.presence || page_title %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= page_url %>">
    <% if page_social_image.present? %>
      <meta property="og:image" content="<%= page_social_image %>">
      <meta property="og:image:secure_url" content="<%= page_social_image %>">
      <meta property="og:image:alt" content="<%= page_title %>">
    <% end %>

    <meta name="twitter:card" content="<%= page_social_image.present? ? "summary_large_image" : "summary" %>">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <% if page_social_image.present? %>
      <meta name="twitter:image" content="<%= page_social_image %>">
    <% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= page_domain&.site_title.presence || page_title %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" type="image/png" href="<%= page_favicon %>">
    <link rel="shortcut icon" type="image/png" href="<%= page_favicon %>">
    <link rel="apple-touch-icon" href="<%= page_favicon %>">

    <%= stylesheet_link_tag "normalize", "tailwind", "application", "posturacorretta", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white text-slate-950 <%= "posturacorretta-ui" if content_for?(:landing_nav) && (request.path.start_with?("/posturacorretta") || controller_name.in?(%w[domains landing])) %>">
    <%= yield :landing_nav if content_for?(:landing_nav) %>
    <%= render "shared/active_commitment", commitment: active_data_commitment if (content_for?(:landing_nav) || controller_path.start_with?("brands/impegno/")) && active_data_commitment %>

    <% revision_project_slug = posturacorretta_revision_project if respond_to?(:posturacorretta_revision_project) %>
    <% if revision_project_slug %>
      <%= render "posturacorretta/revision_banner", project_slug: revision_project_slug %>
    <% end %>

    <% if notice = flash[:notice] %>
      <div class="mx-auto mt-4 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700"><%= notice %></p>
      </div>
    <% end %>

    <% if alert = flash[:alert] %>
      <div class="mx-auto mt-4 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= alert %></p>
      </div>
    <% end %>

    <main class="<%#= full_width_layout? ? "w-full" : "mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8" %>">
      <%= yield %>
    </main>
  </body>
</html>
