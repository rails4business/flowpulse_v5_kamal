<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dashboard condivisa" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dashboard condivisa">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "normalize", "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: { extend: { colors: { brand: { blue: "#2563eb", dark: "#0f172a" } } } }
      }
    </script>
  </head>

  <body data-layout="workspace" class="bg-slate-50 text-slate-900">
    <div class="min-h-screen">
      <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur" aria-label="Testata dashboard condivisa">
        <div class="mx-auto flex h-16 max-w-screen-2xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
          <%= link_to workspace_data_commitments_path, class: "flex min-w-0 items-center gap-3" do %>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-xs font-black text-white">FP</span>
            <span class="min-w-0">
              <strong class="block truncate text-sm font-black text-slate-950">Dashboard condivisa</strong>
              <span class="block truncate text-xs text-slate-500">Flowpulse · GeneraImpresa · Rails4Business · 1impegno</span>
            </span>
          <% end %>

          <% if authenticated? %>
            <details class="relative">
              <summary class="flex cursor-pointer list-none items-center justify-center rounded-full border border-slate-200 bg-white" aria-label="Apri menu profilo">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white"><%= (Current.user.profile&.display_name || Current.user.email_address).first.upcase %></span>
              </summary>
              <div class="absolute right-0 z-50 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
                <div class="px-3 py-2"><p class="text-sm font-semibold text-slate-950"><%= Current.user.profile&.display_name.presence || "Profilo" %></p><p class="truncate text-xs text-slate-500"><%= Current.user.email_address %></p></div>
                <div class="my-1 border-t border-slate-100"></div>
                <%= link_to "Profilo", profile_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
                <%= render "shared/privacy_menu_button" %>
                <div class="my-1 border-t border-slate-100"></div>
                <%= button_to "Esci", session_path, method: :delete, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-red-600 hover:bg-red-50" %>
              </div>
            </details>
          <% end %>
        </div>
      </header>

      <% if notice = flash[:notice] %><div class="mx-auto max-w-screen-2xl px-4 pt-4 sm:px-6 lg:px-8"><p class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700"><%= notice %></p></div><% end %>
      <% if alert = flash[:alert] %><div class="mx-auto max-w-screen-2xl px-4 pt-4 sm:px-6 lg:px-8"><p class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= alert %></p></div><% end %>

      <main class="min-h-[calc(100vh-4rem)] min-w-0 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <%= yield %>
      </main>
    </div>

    <%= render "shared/privacy_center" %>
  </body>
</html>
