<% content_for :head do %>
  <meta name="robots" content="noindex,nofollow">
  <%= stylesheet_link_tag "brand_admin", "data-turbo-track": "reload" %>
<% end %>
<% content_for :body_class, "brand-admin-body" %>
<% content_for :dashboard_before_main do %>
    <header class="brand-admin-header">
      <div class="brand-admin-header__inner">
        <div class="min-w-0">
          <p class="brand-admin-eyebrow">Amministrazione Brand</p>
          <%= link_to @brand.title, brand_navigation_paths.dashboard, class: "brand-admin-name" %>
        </div>
        <div class="brand-admin-header__actions">
          <% if brand_support_access? %><span class="brand-admin-support">Assistenza superadmin</span><% end %>
          <%= link_to "Torna al sito", brand_public_path, class: "brand-admin-site-link" %>
        </div>
      </div>
      <nav class="brand-admin-nav" aria-label="Amministrazione del Brand">
        <%= link_to "Dashboard", brand_navigation_paths.dashboard, aria: { current: ("page" if controller_name == "dashboard") } %>
      </nav>
    </header>

    <% unless controller_name == "dashboard" %>
      <nav class="my-5 flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-500" aria-label="Breadcrumb">
        <%= link_to "Dashboard #{@brand.title}", brand_navigation_paths.dashboard, class: "text-blue-700 hover:underline" %>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= DashboardNavigation::Registry::BRAND_SECTIONS.find { |entry| entry.first == navigation_section }&.second || "Dettaglio" %></span>
      </nav>
    <% end %>
<% end %>
<%= render template: "layouts/application" %>
