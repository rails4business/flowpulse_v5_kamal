<!DOCTYPE html>
<html>
  <head>
    <% page_domain = @navigation_domain || Current.domain %>
    <% page_title = content_for(:title).presence || @node&.title.presence || page_domain&.site_title.presence || "Flowpulse" %>
    <% page_description = content_for(:description).presence || page_domain&.site_description.presence || "Contenuti e risorse pubbliche." %>
    <% page_social_image = page_domain&.social_image_url.presence || page_domain&.logo_square_url.presence || page_domain&.favicon_url.presence %>
    <% page_url = seo_canonical_url %>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= page_url %>">
    <% if seo_noindex? %>
      <meta name="robots" content="noindex, follow">
    <% end %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= page_domain&.site_title.presence || page_title %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= page_url %>">
    <% if page_social_image.present? %>
      <meta property="og:image" content="<%= page_social_image %>">
      <meta property="og:image:secure_url" content="<%= page_social_image %>">
      <meta property="og:image:alt" content="<%= page_title %>">
    <% end %>
    <meta name="twitter:card" content="<%= page_social_image.present? ? "summary_large_image" : "summary" %>">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <% if page_social_image.present? %>
      <meta name="twitter:image" content="<%= page_social_image %>">
    <% end %>
    <script type="application/ld+json"><%= raw json_escape(seo_json_ld(domain: page_domain, title: page_title, description: page_description, url: page_url, node: @node, resource: @public_resource, breadcrumbs: @breadcrumbs)) %></script>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <% fallback_favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='12' fill='%23dc2626'/%3E%3C/svg%3E" %>
    <% favicon_url = page_domain&.favicon_url.presence || page_domain&.logo_square_url.presence || fallback_favicon %>
    <link rel="icon" type="image/png" href="<%= favicon_url %>">
    <link rel="shortcut icon" type="image/png" href="<%= favicon_url %>">
    <link rel="apple-touch-icon" href="<%= favicon_url %>">

    <%= stylesheet_link_tag "normalize", "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                blue: '#2563eb',
                dark: '#0f172a'
              }
            }
          }
        }
      }
    </script>
  </head>

  <% landing_body_class = "pc-domain-landing" if @node&.slug == "posturacorretta" && @posturacorretta_landing %>
  <body class="min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans <%= landing_body_class %>">
    <% nav_brand = @navigation_domain&.site_title.presence || @navigation_domain&.display_hostname.presence || @navigation_root_node&.title.presence || "Flowpulse" %>
    <%
      nav_siblings = Array(@siblings)
      nav_has_real_siblings = nav_siblings.any? { |sibling| sibling != @node }
      nav_has_left_sidebar = @parent_node.present? || nav_has_real_siblings || @children.present?
    %>
    
    <div id="siblingSidebarOverlay" class="fixed inset-0 z-30 hidden bg-slate-950/40 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>

    <!-- Navigazione pubblica del Brand -->
    <header class="sticky top-0 z-30 w-full border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
      <nav class="mx-auto flex min-h-16 w-full max-w-8xl items-center gap-3 px-4 py-2 sm:px-6 lg:px-8" aria-label="Navigazione principale">
        <% if nav_has_left_sidebar %>
          <button id="siblingSidebarToggle" type="button" class="lg:hidden -ml-2 flex-shrink-0 rounded-xl p-2 text-slate-500 hover:bg-slate-100" aria-label="Apri navigazione del contenuto" title="Navigazione del contenuto">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5.5 w-5.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3.75h10.5v4.5H6.75zM4.5 15.75h6v4.5h-6zM13.5 15.75h6v4.5h-6zM12 8.25v3.75m0 0H7.5v3.75M12 12h4.5v3.75" />
            </svg>
          </button>
        <% end %>

        <%= link_to public_node_domain_home_path, class: "flex min-w-0 flex-shrink-0 items-center gap-2", aria: { label: "#{nav_brand} · Home" } do %>
          <% if @navigation_domain&.logo_full_url.present? %>
            <%= image_tag @navigation_domain.logo_full_url, alt: nav_brand, class: "block h-8 w-auto max-w-[138px] object-contain object-left sm:h-10 sm:max-w-[190px]" %>
          <% elsif @navigation_domain&.logo_square_url.present? %>
            <%= image_tag @navigation_domain.logo_square_url, alt: nav_brand, class: "block h-8 w-8 object-contain sm:h-10 sm:w-10" %>
          <% else %>
            <span class="max-w-36 truncate text-base font-black tracking-tight text-slate-950 sm:max-w-none sm:text-lg"><%= nav_brand %></span>
          <% end %>
        <% end %>

        <div class="ml-4 hidden min-w-0 flex-1 items-center gap-1 lg:flex" <%= "hidden" unless content_for?(:public_node_navigation) %>>
          <%= yield :public_node_navigation %>
        </div>

        <details
          class="group/nav relative ml-auto lg:hidden"
          data-controller="details-menu"
          data-details-menu-group-value="public-node-mobile-shell"
          data-action="toggle->details-menu#closePeers click@window->details-menu#closeOutside keydown@window->details-menu#closeOnEscape"
          <%= "hidden" unless content_for?(:public_node_navigation) %>
        >
          <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-100 lg:hidden" aria-label="Apri menu principale">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
          </summary>
          <div class="absolute right-0 z-50 mt-2 w-[min(20rem,calc(100vw-2rem))] rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
            <%= yield :public_node_navigation %>
          </div>
        </details>

        <div class="ml-auto flex flex-shrink-0 items-center gap-2">
          <%= render "layouts/public_node_brand_access" %>

        <button id="tocSidebarToggle" type="button" class="xl:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-100 flex-shrink-0 hidden" aria-label="Apri indice">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5.5 w-5.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5" />
          </svg>
        </button>

        <% if @can_manage_public_node %>
          <details
            class="relative"
            data-controller="details-menu"
            data-action="click@window->details-menu#closeOutside keydown@window->details-menu#closeOnEscape"
          >
            <summary class="node-public-creator-menu-toggle flex h-9 w-9 shrink-0 cursor-pointer list-none appearance-none items-center justify-center rounded-full border border-blue-200 bg-blue-50 p-0 text-blue-700 hover:bg-blue-100" aria-label="Apri strumenti creator" title="Strumenti Node">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:block; flex:none">
                <path stroke-linecap="round" d="M4 7h10M18 7h2M4 17h2M10 17h10M4 12h4M12 12h8" />
                <circle cx="16" cy="7" r="2" />
                <circle cx="8" cy="17" r="2" />
                <circle cx="10" cy="12" r="2" />
              </svg>
            </summary>
            <div class="absolute right-0 z-50 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
              <div class="px-3 py-2">
                <p class="text-sm font-bold text-slate-950">Creator</p>
                <p class="truncate text-xs text-slate-500"><%= @node.title %></p>
              </div>
              <div class="grid grid-cols-2 gap-2 px-3 py-2 text-xs">
                <div class="rounded-lg bg-slate-50 px-2.5 py-2">
                  <span class="block font-bold text-slate-400">Stato</span>
                  <strong class="mt-1 block text-slate-900"><%= @node.status %></strong>
                </div>
                <div class="rounded-lg bg-slate-50 px-2.5 py-2">
                  <span class="block font-bold text-slate-400">Visibilita</span>
                  <strong class="mt-1 block text-slate-900"><%= Node.visibility_label(@node.visibility) %></strong>
                </div>
              </div>
              <div class="my-1 border-t border-slate-100"></div>
              <%= link_to tree_creator_world_role_assignment_node_path(@node.role_assignment, @node), class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 text-blue-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25A2.25 2.25 0 0113.5 8.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                </svg>
                <span>Albero</span>
              <% end %>
              <%= link_to edit_creator_world_role_assignment_node_path(@node.role_assignment, @node, return_to: request.fullpath), class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 text-blue-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                </svg>
                <span>Modifica</span>
              <% end %>
            </div>
          </details>
        <% end %>

        <details class="relative">
          <summary class="flex cursor-pointer list-none items-center justify-center rounded-full border border-slate-200 bg-white p-0 text-slate-600 hover:bg-slate-100" aria-label="<%= Current.user.present? ? 'Apri menu profilo' : 'Apri menu accesso' %>">
            <% if Current.user.present? %>
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white">
                <%= (Current.user.profile&.display_name || Current.user.email_address).first.upcase %>
              </span>
            <% else %>
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-700">
                ?
              </span>
            <% end %>
          </summary>
          <div class="absolute right-0 z-50 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
            <% if Current.user.present? %>
              <div class="px-3 py-2">
                <p class="text-sm font-semibold text-slate-950"><%= Current.user.profile&.display_name.presence || "Profilo" %></p>
                <p class="truncate text-xs text-slate-500"><%= Current.user.email_address %></p>
              </div>
              <div class="my-1 border-t border-slate-100"></div>
              <%= link_to "Dashboard", dashboard_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
              <%= link_to "Profilo", profile_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
              <%= render "shared/privacy_menu_button" %>
              <%= button_to "Esci", session_path,
                method: :delete,
                class: "w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-red-600 hover:bg-red-50" %>
            <% else %>
              <% auth_context = @brand_access_domain.present? ? { return_to: request.fullpath } : {} %>
              <%= link_to "Accedi", new_session_path(auth_context), class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
              <%= link_to "Richiedi un invito", new_brand_access_request_path(local_request? && @brand_access_domain.present? ? { site: @brand_access_domain.auth_slug.presence || @brand_access_domain.node&.slug } : {}), class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
            <% end %>
          </div>
        </details>
        </div>
      </nav>

    </header>

    <!-- Main Container -->
    <div class="flex-1 flex flex-col w-full max-w-8xl mx-auto relative">
      <main class="flex-1 min-w-0 bg-white px-4 py-8 pb-20 sm:px-6 lg:px-12 xl:px-16">
        <% if notice = flash[:notice] %>
          <p class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700"><%= notice %></p>
        <% end %>
        <% if alert = flash[:alert] %>
          <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= alert %></p>
        <% end %>

        <%= yield %>
      </main>

      <% unless content_for?(:hide_node_reading_nav) %>
        <%= render "nodes/reading_nav",
          previous_sibling: @previous_sibling,
          parent_node: @parent_node,
          first_child: @children&.first,
          next_sibling: @next_sibling %>
      <% end %>
    </div>


    <script>
      (() => {
        const siblingToggleBtn = document.getElementById("siblingSidebarToggle");
        const tocToggleBtn = document.getElementById("tocSidebarToggle");
        const siblingSidebar = document.querySelector(".node-public-sidebar");
        const tocSidebar = document.querySelector(".node-public-toc-sidebar");
        const overlay = document.getElementById("siblingSidebarOverlay");
        const closeSiblingBtn = document.getElementById("closeSiblingSidebarButton");
        const closeTocBtn = document.getElementById("closeTocSidebarButton");

        const openSibling = () => {
          siblingSidebar?.classList.add("open");
          overlay?.classList.remove("hidden");
          document.body.classList.add("overflow-hidden");
        };

        const openToc = () => {
          tocSidebar?.classList.add("open");
          overlay?.classList.remove("hidden");
          document.body.classList.add("overflow-hidden");
        };

        const closeAll = () => {
          siblingSidebar?.classList.remove("open");
          tocSidebar?.classList.remove("open");
          overlay?.classList.add("hidden");
          document.body.classList.remove("overflow-hidden");
        };

        siblingToggleBtn?.addEventListener("click", openSibling);
        tocToggleBtn?.addEventListener("click", openToc);
        closeSiblingBtn?.addEventListener("click", closeAll);
        closeTocBtn?.addEventListener("click", closeAll);
        overlay?.addEventListener("click", closeAll);
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeAll();
        });
      })();
    </script>
    <%= render "shared/privacy_center" %>
  </body>
</html>
