<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Reimposta la password</h1>
  <% reset_account_lines = [] %>
  <% reset_account_lines << "Profilo: #{params[:profile_name]} (@#{params[:username]}) · ID profilo #{params[:profile_id]}" if params[:profile_name].present? || params[:username].present? || params[:profile_id].present? %>
  <% reset_account_lines << "Account: #{params[:email_address]} · ID utente #{params[:user_id]}" if params[:email_address].present? || params[:user_id].present? %>
  <% reset_message = ["Ciao, vorrei reimpostare la password del mio account.", *reset_account_lines].join("\n") %>

  <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4 text-sm leading-6 text-blue-950">
    <p class="font-bold">Prima contatta PosturaCorretta</p>
    <p class="mt-1">Scrivi su WhatsApp che desideri reimpostare la password. Dopo la verifica, il superadmin ti inoltrerà manualmente un link temporaneo.</p>
    <%= link_to "Scrivi a PosturaCorretta su WhatsApp", "https://wa.me/393792891488?text=#{ERB::Util.url_encode(reset_message)}", class: "mt-3 inline-flex rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white hover:bg-blue-700", target: "_blank", rel: "noopener" %>
  </div>
  <p class="mt-4 text-sm leading-6 text-slate-600">Dopo aver scritto, inserisci qui l’email dell’account per registrare la richiesta.</p>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address], class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= form.submit "Richiedi il link di reset", class: "w-full sm:w-auto text-center rounded-lg px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
