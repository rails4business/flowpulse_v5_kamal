<% participation_labels = { "autonomy" => "Autonomia", "group" => "Gruppo", "individual" => "Individuale" } %>
<main class="bg-[#F6F7F4]">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 lg:py-14">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-indigo-600">Area personale</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-.03em] text-slate-950">Dashboard studente</h1>
          <p class="mt-4 max-w-2xl leading-7 text-slate-600">Segui i corsi, scegli come partecipare e riprendi dall’ultima lezione.</p>
        </div>
        <%= link_to "Esplora il percorso", posturacorretta_path, class: "rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800" %>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 lg:py-14">
    <% if @selected_participation %>
      <div class="mb-7 flex flex-col justify-between gap-3 rounded-2xl border border-indigo-200 bg-indigo-50 p-5 sm:flex-row sm:items-center">
        <div><p class="text-xs font-bold uppercase tracking-wide text-indigo-600">Modalità selezionata</p><p class="mt-1 font-semibold text-indigo-950"><%= participation_labels.fetch(@selected_participation) %></p></div>
        <span class="text-sm text-indigo-700">Scelta non ancora salvata · frontend dimostrativo</span>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-3">
      <% [["Corsi disponibili", @courses.size], ["Lezioni", @lesson_count], ["Completate", 0]].each do |label, value| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500"><%= label %></p><strong class="mt-2 block text-3xl tracking-tight text-slate-950"><%= value %></strong></article>
      <% end %>
    </div>

    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div><p class="text-xs font-semibold uppercase tracking-[.15em] text-indigo-600">Inizia qui</p><h2 class="mt-2 text-2xl font-semibold text-slate-950">PosturaCorretta in un mese</h2></div>
        <span class="text-sm font-semibold text-slate-500">0 / <%= @base_stage.fetch("lessons").size %> lezioni</span>
      </div>
      <div class="mt-6 h-2 overflow-hidden rounded-full bg-slate-200" role="progressbar" aria-label="Avanzamento PosturaCorretta in un mese" aria-valuemin="0" aria-valuemax="<%= @base_stage.fetch("lessons").size %>" aria-valuenow="0"><span class="block h-full w-0 bg-indigo-600"></span></div>
      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to "Apri l’indice", posturacorretta_course_chapters_path(corso: "postura-corretta-in-un-mese"), class: "rounded-xl bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-800" %>
        <button type="button" disabled class="cursor-not-allowed rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-400">Calendario in arrivo</button>
      </div>
    </section>

    <section class="mt-8 grid gap-5 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold text-slate-950">Prossimi incontri</h2><p class="mt-5 rounded-2xl bg-slate-50 p-5 text-sm leading-6 text-slate-500">Non risultano ancora lezioni di gruppo o individuali programmate.</p></article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold text-slate-950">Le tue modalità</h2><div class="mt-5 flex flex-wrap gap-2"><span class="rounded-full bg-indigo-50 px-3 py-1.5 text-sm font-semibold text-indigo-700">Autonomia</span><span class="rounded-full bg-slate-100 px-3 py-1.5 text-sm font-semibold text-slate-500">Gruppo</span><span class="rounded-full bg-slate-100 px-3 py-1.5 text-sm font-semibold text-slate-500">Individuale</span></div></article>
    </section>
  </div>
</main>

<%= render "posturacorretta/footer" %>
