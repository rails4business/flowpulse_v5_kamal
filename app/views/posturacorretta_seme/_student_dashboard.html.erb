<% participation_labels = { "group" => "Gruppo", "individual" => "Individuale" } %>
<main class="bg-[#F6F7F4]">
  <div class="mx-auto max-w-[1280px] px-4 py-8 sm:px-6 lg:py-10">
    <% if @selected_participation %>
      <div class="mb-6 flex flex-col justify-between gap-3 rounded-2xl border border-indigo-200 bg-indigo-50 p-5 sm:flex-row sm:items-center">
        <div><p class="text-xs font-bold uppercase tracking-wide text-indigo-600">Modalità selezionata</p><p class="mt-1 font-semibold text-indigo-950"><%= participation_labels.fetch(@selected_participation) %></p></div>
        <span class="text-sm text-indigo-700">Scelta non ancora salvata · frontend dimostrativo</span>
      </div>
    <% end %>

    <% if @dashboard_view == "calendario" %>
      <% role_labels = { "student" => "Studente", "professional" => "Professionista", "teacher" => "Insegnante", "tutor" => "Tutor", "secretariat" => "Segreteria" } %>
      <% format_labels = { "group" => "Gruppo", "individual" => "Individuale" } %>
      <% delivery_labels = { "online" => "Online", "in_person" => "In presenza" } %>
      <% agenda_tab = params[:stato].presence_in(%w[prossimi passati]) || "prossimi" %>

      <section aria-labelledby="calendario-title">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="text-xs font-bold uppercase tracking-[.16em] text-blue-700">Date e agenda</p>
            <h2 id="calendario-title" class="mt-1 text-2xl font-semibold text-slate-950">I tuoi appuntamenti</h2>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <% if Current.user&.superadmin_user? %>
              <%= link_to "Apri 1Impegno", impegno_path(area: "user", view: "agenda"), class: "text-xs font-bold text-blue-700 hover:text-blue-900" %>
            <% end %>
            <!-- Nav Tab Prossimi / Passati -->
            <div class="inline-flex rounded-xl border border-slate-200 bg-white p-1 shadow-2xs">
              <%= link_to posturacorretta_student_appointments_path(stato: "prossimi"), role: "tab", aria: { selected: agenda_tab == "prossimi" }, class: "rounded-lg px-4 py-1.5 text-xs font-bold transition #{agenda_tab == 'prossimi' ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}" do %>
                Prossimi <span class="ml-1 text-[10px] font-extrabold opacity-80">(<%= @dashboard_agenda_upcoming.size %>)</span>
              <% end %>
              <%= link_to posturacorretta_student_appointments_path(stato: "passati"), role: "tab", aria: { selected: agenda_tab == "passati" }, class: "rounded-lg px-4 py-1.5 text-xs font-bold transition #{agenda_tab == 'passati' ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}" do %>
                Passati <span class="ml-1 text-[10px] font-extrabold opacity-80">(<%= @dashboard_agenda_past.size %>)</span>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Card Prossimi Appuntamenti -->
        <article id="appuntamenti-prossimi" class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs <%= 'hidden' if agenda_tab == 'passati' %>">
          <h3 class="text-lg font-bold text-slate-950">Prossimi</h3>
          <p class="mt-1 max-w-2xl text-sm leading-relaxed text-slate-600">Le date pubblicate dagli insegnanti e i tuoi incontri PosturaCorretta. Gli impegni di altri spazi restano visibili in modo più leggero.</p>
          <% if @dashboard_agenda_upcoming.any? %>
            <ol class="mt-6 divide-y divide-slate-100" aria-label="Prossimi appuntamenti">
              <% @dashboard_agenda_upcoming.each do |entry| %>
                <% external_context = entry[:external_context] %>
                <li class="flex gap-4 py-4 first:pt-0 <%= 'opacity-50' if external_context %>">
                  <div class="w-14 shrink-0 rounded-xl border p-2 text-center <%= external_context ? 'border-slate-200 bg-slate-100' : 'border-blue-100 bg-blue-50/80' %>">
                    <p class="text-[10px] font-black uppercase <%= external_context ? 'text-slate-500' : 'text-blue-700' %>"><%= entry.fetch(:starts_at).strftime("%b") %></p>
                    <p class="text-2xl font-black text-slate-900"><%= entry.fetch(:starts_at).strftime("%d") %></p>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="font-bold <%= external_context ? 'text-slate-600' : 'text-slate-950' %>"><%= entry.fetch(:title) %></h4>
                      <span class="rounded-full border px-2.5 py-0.5 text-[11px] font-bold <%= external_context ? 'border-slate-200 bg-slate-100 text-slate-600' : 'border-blue-100 bg-blue-50 text-blue-700' %>"><%= entry.fetch(:domain_label) %></span>
                      <% if entry[:role_label].present? %>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-bold text-slate-600"><%= role_labels.fetch(entry[:role_label], entry[:role_label]) %></span>
                      <% end %>
                    </div>
                    <p class="mt-1 text-sm <%= external_context ? 'text-slate-500' : 'text-slate-600' %>"><%= entry.fetch(:starts_at).strftime("%H:%M") %><%= "–#{entry[:ends_at].strftime("%H:%M")}" if entry[:ends_at] %><%= " · #{format_labels.fetch(entry[:format], entry[:format])}" if entry[:format].present? %><%= " · #{delivery_labels.fetch(entry[:delivery], entry[:delivery])}" if entry[:delivery].present? %><%= " · #{entry[:location_name]}" if entry[:location_name].present? %></p>
                  </div>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="mt-5 rounded-xl bg-slate-50 p-5 text-sm font-medium text-slate-500">Non ci sono appuntamenti in programma al momento.</p>
          <% end %>
        </article>

        <!-- Card Appuntamenti Passati -->
        <article id="appuntamenti-passati" class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs <%= 'hidden' if agenda_tab == 'prossimi' %>">
          <h3 class="text-lg font-bold text-slate-950">Passati</h3>
          <p class="mt-1 max-w-2xl text-sm leading-relaxed text-slate-600">Storico delle lezioni e degli incontri svolti sul percorso.</p>
          <% if @dashboard_agenda_past.any? %>
            <ol class="mt-6 divide-y divide-slate-100" aria-label="Appuntamenti passati">
              <% @dashboard_agenda_past.each do |entry| %>
                <% external_context = entry[:external_context] %>
                <li class="flex gap-4 py-4 first:pt-0 <%= external_context ? 'opacity-50' : 'opacity-80' %>">
                  <div class="w-14 shrink-0 rounded-xl bg-slate-100 p-2 text-center">
                    <p class="text-[10px] font-black uppercase text-slate-500"><%= entry.fetch(:starts_at).strftime("%b") %></p>
                    <p class="text-2xl font-black text-slate-800"><%= entry.fetch(:starts_at).strftime("%d") %></p>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="font-bold <%= external_context ? 'text-slate-600' : 'text-slate-900' %>"><%= entry.fetch(:title) %></h4>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600"><%= entry.fetch(:domain_label) %></span>
                      <% if entry[:role_label].present? %>
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600"><%= role_labels.fetch(entry[:role_label], entry[:role_label]) %></span>
                      <% end %>
                    </div>
                    <p class="mt-1 text-sm text-slate-600"><%= entry.fetch(:starts_at).strftime("%d/%m/%Y · %H:%M") %></p>
                  </div>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="mt-5 rounded-xl bg-slate-50 p-5 text-sm font-medium text-slate-500">Le lezioni e gli incontri conclusi compariranno qui nello storico.</p>
          <% end %>
        </article>
      </section>
    <% else %>
      <section aria-labelledby="programma-title">
        <h1 id="programma-title" class="sr-only">Moduli</h1>
        <div class="space-y-8">
          <% @dashboard_sections.each do |section| %>
            <section class="space-y-4" aria-labelledby="dashboard-section-<%= section["slug"] || "inizio" %>">
              <header class="border-b border-slate-200 pb-3">
                <div class="flex items-center gap-2">
                  <span class="text-[10px] font-black uppercase tracking-[0.18em] text-blue-700">
                    <%= section["slug"].present? ? "Sezione #{section["slug"].capitalize}" : "Percorso Didattico" %>
                  </span>
                </div>
                <h3 id="dashboard-section-<%= section["slug"] || "inizio" %>" class="mt-1 text-xl font-bold tracking-tight text-slate-950 md:text-2xl">
                  <%= section.fetch("title") %>
                </h3>
                <% if section["description"].present? %>
                  <p class="mt-1.5 max-w-3xl text-sm leading-relaxed text-slate-600">
                    <%= section["description"] %>
                  </p>
                <% end %>
              </header>

              <!-- Stepper Primario (Livello Corsi) -->
              <div class="relative space-y-8 pl-3 sm:pl-4 before:absolute before:left-7 sm:before:left-8 before:top-6 before:h-[calc(100%-3rem)] before:w-0.5 before:rounded-full before:bg-blue-200/80">
                <% section.fetch("courses").each do |course| %>
                  <article class="relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-xs">
                    <!-- Head Card del Corso con Nodo dello Stepper Principale -->
                    <div class="border-b border-slate-200/80 bg-slate-100/80 px-5 py-4 sm:px-6">
                      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-center gap-3.5">
                          <!-- Badge Quadrato del Corso (Nodo Macro dello Stepper) -->
                          <span class="relative z-10 inline-flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-xs font-black text-white shadow-sm ring-4 ring-white">
                            <%= course["number"] %>
                          </span>
                          <h4 class="text-lg font-bold tracking-tight text-slate-950">
                            <%= course.fetch("title") %>
                          </h4>
                        </div>
                      </div>

                      <% if course["description"].present? %>
                        <p class="mt-2 text-xs font-medium leading-relaxed text-slate-600 sm:pl-12">
                          <%= course["description"] %>
                        </p>
                      <% end %>
                    </div>

                    <!-- Stepper Secondario (Livello Moduli Didattici) -->
                    <% if course.fetch("program").any? %>
                      <div class="px-6 py-6 sm:pl-10">
                        <ol class="relative space-y-6 before:absolute before:left-3.5 before:top-3.5 before:h-[calc(100%-2rem)] before:w-0.5 before:rounded-full before:bg-slate-200" aria-label="Moduli di <%= course.fetch("title") %>">
                          <% course.fetch("program").each_with_index do |activity, index| %>
                            <% tutor_module = activity["type"] == "tutor_meeting" %>
                            <% is_available = activity.fetch("progress_state") == "available" %>
                            <% is_completed = activity.fetch("progress_state") == "completed" %>
                            <li class="relative flex flex-col gap-2 transition sm:flex-row sm:items-center sm:justify-between">
                              <div class="flex items-start gap-4">
                                <!-- Badge Circolare del Modulo (Nodo Micro dello Stepper) -->
                                <span class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-bold ring-4 ring-white <%= is_completed ? 'bg-emerald-600 text-white' : is_available ? 'bg-blue-600 text-white shadow-xs' : 'bg-slate-100 text-slate-400 border border-slate-200' %>">
                                  <%= is_completed ? "✓" : index + 1 %>
                                </span>
                                <div class="min-w-0 -mt-0.5">
                                  <h5 class="text-sm font-bold text-slate-900"><%= activity.fetch("title") %></h5>
                                  <p class="mt-0.5 text-xs text-slate-500">
                                    <%= is_completed ? "Svolto con successo" : is_available ? "Pronto da programmare" : "Disponibile dopo il passaggio precedente" %>
                                  </p>
                                </div>
                              </div>

                              <div class="flex items-center gap-2 pl-11 sm:pl-0">
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-bold <%= tutor_module ? 'bg-violet-100 text-violet-800 border border-violet-200' : 'bg-blue-100 text-blue-800 border border-blue-200' %>">
                                  <%= tutor_module ? "Con tutor" : "Con insegnante" %>
                                </span>
                              </div>
                            </li>
                          <% end %>
                        </ol>
                      </div>
                    <% else %>
                      <p class="p-5 text-xs font-medium text-slate-400 sm:pl-12">I moduli per questo corso saranno pubblicati a breve.</p>
                    <% end %>
                  </article>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</main>

<%= render "posturacorretta/footer" %>
