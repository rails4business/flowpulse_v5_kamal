<% participation_labels = { "group" => "Gruppo", "individual" => "Individuale" } %>
<main class="bg-white min-h-screen">
  <div class="mx-auto max-w-[1280px] px-4 py-8 sm:px-6 lg:py-10">
    
    <!-- Modalità selezionata -->
    <% if @selected_participation %>
      <div class="mb-8 flex flex-col justify-between gap-3 rounded-2xl border border-indigo-200 bg-gradient-to-r from-indigo-50 to-white p-5 sm:flex-row sm:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-indigo-600">Modalità selezionata</p>
          <p class="mt-1 font-bold text-lg text-indigo-950"><%= participation_labels.fetch(@selected_participation) %></p>
        </div>
        <span class="text-sm font-semibold text-indigo-700">Scelta non ancora salvata · frontend dimostrativo</span>
      </div>
    <% end %>

    <% if @dashboard_view == "calendario" %>
      <!-- VIEW CALENDARIO -->
      <% role_labels = { "student" => "Studente", "professional" => "Professionista", "teacher" => "Insegnante", "tutor" => "Tutor", "secretariat" => "Segreteria" } %>
      <% format_labels = { "group" => "Gruppo", "individual" => "Individuale" } %>
      <% delivery_labels = { "online" => "Online", "in_person" => "In presenza" } %>
      <% agenda_tab = params[:stato].presence_in(%w[prossimi passati]) || "prossimi" %>

      <section aria-labelledby="calendario-title">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="text-xs font-black uppercase tracking-[.18em] text-blue-700">Date e agenda</p>
            <h2 id="calendario-title" class="mt-1 text-3xl font-bold text-slate-950">I tuoi appuntamenti</h2>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <% if Current.user&.superadmin_user? %>
              <%= link_to "Apri 1Impegno", impegno_path(area: "user", view: "agenda"), class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>
            <% end %>
            <div class="inline-flex rounded-xl border border-slate-200 bg-white p-1 shadow-xs">
              <%= link_to posturacorretta_student_appointments_path(stato: "prossimi"), role: "tab", aria: { selected: agenda_tab == "prossimi" }, class: "rounded-lg px-4 py-2 text-sm font-bold transition #{agenda_tab == 'prossimi' ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}" do %>
                Prossimi <span class="ml-1 text-xs font-extrabold opacity-80">(<%= @dashboard_agenda_upcoming.size %>)</span>
              <% end %>
              <%= link_to posturacorretta_student_appointments_path(stato: "passati"), role: "tab", aria: { selected: agenda_tab == "passati" }, class: "rounded-lg px-4 py-2 text-sm font-bold transition #{agenda_tab == 'passati' ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}" do %>
                Passati <span class="ml-1 text-xs font-extrabold opacity-80">(<%= @dashboard_agenda_past.size %>)</span>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Card Prossimi Appuntamenti -->
        <article id="appuntamenti-prossimi" class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs <%= 'hidden' if agenda_tab == 'passati' %>">
          <h3 class="text-xl font-bold text-slate-950">Prossimi</h3>
          <p class="mt-1 max-w-2xl text-base leading-relaxed text-slate-600">Le date pubblicate dagli insegnanti e i tuoi incontri PosturaCorretta. Gli impegni di altri spazi restano visibili in modo più leggero.</p>
          <% if @dashboard_agenda_upcoming.any? %>
            <ol class="mt-6 divide-y divide-slate-100" aria-label="Prossimi appuntamenti">
              <% @dashboard_agenda_upcoming.each do |entry| %>
                <% external_context = entry[:external_context] %>
                <li class="flex gap-4 py-5 first:pt-0 <%= 'opacity-50' if external_context %>">
                  <div class="w-16 shrink-0 rounded-xl border p-2.5 text-center <%= external_context ? 'border-slate-200 bg-slate-100' : 'border-blue-100 bg-blue-50/80' %>">
                    <p class="text-xs font-black uppercase <%= external_context ? 'text-slate-500' : 'text-blue-700' %>"><%= entry.fetch(:starts_at).strftime("%b") %></p>
                    <p class="text-3xl font-black text-slate-900"><%= entry.fetch(:starts_at).strftime("%d") %></p>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="text-base font-bold <%= external_context ? 'text-slate-600' : 'text-slate-950' %>"><%= entry.fetch(:title) %></h4>
                      <span class="rounded-full border px-3 py-0.5 text-xs font-bold <%= external_context ? 'border-slate-200 bg-slate-100 text-slate-600' : 'border-blue-100 bg-blue-50 text-blue-700' %>"><%= entry.fetch(:domain_label) %></span>
                      <% if entry[:role_label].present? %>
                        <span class="rounded-full bg-slate-100 px-3 py-0.5 text-xs font-bold text-slate-600"><%= role_labels.fetch(entry[:role_label], entry[:role_label]) %></span>
                      <% end %>
                      <% if entry[:available_event] %>
                        <span class="rounded-full bg-emerald-50 px-3 py-0.5 text-xs font-bold text-emerald-700"><%= entry[:registration_status] == "open" ? "Iscrizioni aperte" : "Data pubblicata" %></span>
                      <% end %>
                    </div>
                    <p class="mt-1.5 text-base <%= external_context ? 'text-slate-500' : 'text-slate-600' %>"><%= entry.fetch(:starts_at).strftime("%H:%M") %><%= "–#{entry[:ends_at].strftime("%H:%M")}" if entry[:ends_at] %><%= " · #{format_labels.fetch(entry[:format], entry[:format])}" if entry[:format].present? %><%= " · #{delivery_labels.fetch(entry[:delivery], entry[:delivery])}" if entry[:delivery].present? %><%= " · #{entry[:location_name]}" if entry[:location_name].present? %></p>
                    <% if entry[:available_event] && entry[:bookable] %>
                      <div class="mt-2.5 flex flex-wrap items-center gap-3">
                        <%= link_to "Apri dettagli →", entry[:show_path], class: "text-sm font-bold text-blue-700 hover:text-blue-900 hover:underline" %>
                      </div>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="mt-5 rounded-xl bg-slate-50 p-5 text-base font-medium text-slate-500">Non ci sono appuntamenti in programma al momento.</p>
          <% end %>
        </article>

        <!-- Card Appuntamenti Passati -->
        <article id="appuntamenti-passati" class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs <%= 'hidden' if agenda_tab == 'prossimi' %>">
          <h3 class="text-xl font-bold text-slate-950">Passati</h3>
          <p class="mt-1 max-w-2xl text-base leading-relaxed text-slate-600">Storico delle lezioni e degli incontri svolti sul percorso.</p>
          <% if @dashboard_agenda_past.any? %>
            <ol class="mt-6 divide-y divide-slate-100" aria-label="Appuntamenti passati">
              <% @dashboard_agenda_past.each do |entry| %>
                <% external_context = entry[:external_context] %>
                <li class="flex gap-4 py-5 first:pt-0 <%= external_context ? 'opacity-50' : 'opacity-80' %>">
                  <div class="w-16 shrink-0 rounded-xl bg-slate-100 p-2.5 text-center">
                    <p class="text-xs font-black uppercase text-slate-500"><%= entry.fetch(:starts_at).strftime("%b") %></p>
                    <p class="text-3xl font-black text-slate-800"><%= entry.fetch(:starts_at).strftime("%d") %></p>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="text-base font-bold <%= external_context ? 'text-slate-600' : 'text-slate-900' %>"><%= entry.fetch(:title) %></h4>
                      <span class="rounded-full bg-slate-100 px-3 py-0.5 text-xs font-semibold text-slate-600"><%= entry.fetch(:domain_label) %></span>
                      <% if entry[:role_label].present? %>
                        <span class="rounded-full bg-slate-100 px-3 py-0.5 text-xs font-semibold text-slate-600"><%= role_labels.fetch(entry[:role_label], entry[:role_label]) %></span>
                      <% end %>
                    </div>
                    <p class="mt-1.5 text-base text-slate-600"><%= entry.fetch(:starts_at).strftime("%d/%m/%Y · %H:%M") %></p>
                  </div>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="mt-5 rounded-xl bg-slate-50 p-5 text-base font-medium text-slate-500">Le lezioni e gli incontri conclusi compariranno qui nello storico.</p>
          <% end %>
        </article>
      </section>
    <% else %>
      <%= render "posturacorretta_seme/student_lessons_program" %>
      <% if false %>
      <!-- VIEW PROGRAMMA - Stepper Verticale a Lista -->
      <section aria-labelledby="programma-title">
        <div class="mb-8">
          <p class="text-xs font-black uppercase tracking-[.18em] text-blue-700">Percorso formativo</p>
          <h1 id="programma-title" class="mt-1 text-3xl font-black text-slate-950 sm:text-4xl">Il tuo piano di studi</h1>
          <p class="mt-2 max-w-3xl text-base text-slate-600">Segui il percorso step by step. Ogni corso è composto da moduli da completare in sequenza.</p>
        </div>

        <div class="space-y-6">
          <% @dashboard_sections.each_with_index do |section, section_index| %>
            
            <!-- SEZIONE -->
            <section class="space-y-2" aria-labelledby="dashboard-section-<%= section["slug"] || "inizio" %>">
              
              <!-- Header Sezione - stile cartella -->
              <div class="flex items-center gap-4 rounded-2xl bg-slate-100/90 px-5 py-4 border border-slate-200">
                <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-sm font-black text-white shadow-sm">
                  <%= section_index + 1 %>
                </div>
                <div class="flex-1 min-w-0">
                  <span class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-700">
                    <%= section["slug"].present? ? "Sezione #{section["slug"].capitalize}" : "Percorso Didattico" %>
                  </span>
                  <h3 id="dashboard-section-<%= section["slug"] || "inizio" %>" class="text-lg font-extrabold tracking-tight text-slate-950">
                    <%= section.fetch("title") %>
                  </h3>
                  <% if section["description"].present? %>
                    <p class="mt-0.5 text-sm text-slate-600">
                      <%= section["description"] %>
                    </p>
                  <% end %>
                </div>
                <span class="text-sm font-bold text-slate-500">
                  <%= section.fetch("courses").size %> corsi
                </span>
              </div>

              <!-- LISTA CORSI - Stile cartelle annidate -->
              <div class="ml-6 space-y-3 border-l-2 border-blue-200 pl-6 sm:pl-8 py-2">
                <% section.fetch("courses").each_with_index do |course, course_index| %>
                  
                  <!-- CORSO -->
                  <div class="hs-accordion-group border-b border-slate-100 pb-3 last:border-b-0 last:pb-0" role="group" data-hs-accordion-always-open>
                    <div class="hs-accordion active" role="treeitem" aria-expanded="true">
                      
                      <!-- Heading Corso - stile cartella -->
                      <div class="hs-accordion-heading flex items-center gap-3 w-full hover:bg-slate-50/90 px-3 py-2.5 rounded-xl transition-colors">
                        <button class="hs-accordion-toggle size-8 flex justify-center items-center hover:bg-slate-200/60 rounded-lg transition-colors" aria-expanded="true" aria-controls="course-collapse-<%= section_index %>-<%= course_index %>">
                          <svg class="hs-accordion-active:rotate-90 transition-transform duration-200 size-4 text-slate-500" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/>
                          </svg>
                        </button>
                        
                        <div class="grow flex items-center gap-3 cursor-pointer rounded-lg">
                          <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-xs font-black text-blue-700">
                            <%= course["number"] %>
                          </span>
                          <span class="text-base font-bold text-slate-900"><%= course.fetch("title") %></span>
                          
                          <!-- Badge progresso -->
                          <% total_modules = course.fetch("program").size %>
                          <% completed_modules = course.fetch("program").count { |m| m.fetch("progress_state") == "completed" } %>
                          <% if total_modules > 0 %>
                            <span class="ml-auto text-xs font-bold text-slate-500">
                              <%= completed_modules %>/<%= total_modules %>
                              <% if completed_modules == total_modules %>
                                <span class="text-emerald-600">✅</span>
                              <% end %>
                            </span>
                          <% else %>
                            <span class="ml-auto text-xs font-medium text-slate-400">0 moduli</span>
                          <% end %>
                        </div>
                      </div>

                      <!-- Moduli del Corso -->
                      <div id="course-collapse-<%= section_index %>-<%= course_index %>" class="hs-accordion-content w-full overflow-hidden transition-[height] duration-200" role="group">
                        <div class="ml-8 space-y-1.5 border-l-2 border-slate-200 pl-6 sm:pl-8 py-3 my-2 divide-y divide-slate-100/80">
                          
                          <% if course.fetch("program").any? %>
                            <% course.fetch("program").each_with_index do |activity, activity_index| %>
                              <% tutor_module = activity["type"] == "tutor_meeting" %>
                              <% is_available = activity.fetch("progress_state") == "available" %>
                              <% is_completed = activity.fetch("progress_state") == "completed" %>
                              <% is_locked = !is_available && !is_completed %>
                              
                              <!-- MODULO - stile voce di lista -->
                              <div class="hs-accordion-selectable flex items-center gap-3.5 px-3 py-3 cursor-pointer rounded-xl hover:bg-slate-50/90 transition-colors group" role="treeitem">
                                <!-- Icona stato -->
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-black 
                                  <%= is_completed ? 'bg-emerald-500 text-white' : 
                                     is_available ? 'bg-blue-600 text-white' : 
                                     'bg-slate-200 text-slate-400 border border-slate-300' %>">
                                  <%= is_completed ? "✓" : activity_index + 1 %>
                                </span>
                                
                                <!-- Nome modulo -->
                                <span class="text-base font-semibold <%= is_locked ? 'text-slate-400' : 'text-slate-800' %>">
                                  <%= activity.fetch("title") %>
                                </span>
                                
                                <!-- Badge tipo -->
                                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold ml-auto
                                  <%= tutor_module ? 'bg-violet-100 text-violet-700 border border-violet-200' : 'bg-blue-100 text-blue-700 border border-blue-200' %>">
                                  <%= tutor_module ? "👤 Tutor" : "👨‍🏫 Insegnante" %>
                                </span>
                                
                                <!-- Badge stato -->
                                <span class="text-xs font-bold <%= is_completed ? 'text-emerald-600' : is_available ? 'text-blue-600' : 'text-slate-400' %>">
                                  <%= is_completed ? "✅" : is_available ? "📌" : "🔒" %>
                                </span>
                              </div>
                            <% end %>
                          <% else %>
                            <div class="px-3 py-3 text-sm text-slate-400 italic">
                              I moduli saranno pubblicati a breve
                            </div>
                          <% end %>
                          
                        </div>
                      </div>
                    </div>
                  </div>
                  
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</main>

<%= render "posturacorretta/footer" %>
