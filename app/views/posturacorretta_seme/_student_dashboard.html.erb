<% participation_labels = { "group" => "Gruppo", "individual" => "Individuale" } %>
<main class="bg-[#F6F7F4]">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 lg:py-14">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-indigo-600">Area personale</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-.03em] text-slate-950">Dashboard studente</h1>
          <p class="mt-4 max-w-2xl leading-7 text-slate-600">Trova il prossimo passo, consulta il corso online e tieni insieme incontri, lezioni e avanzamento.</p>
        </div>
        <%= link_to "Esplora i corsi", posturacorretta_path, class: "rounded-xl bg-blue-700 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-800" %>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 lg:py-14">
    <% if @selected_participation %>
      <div class="mb-7 flex flex-col justify-between gap-3 rounded-2xl border border-indigo-200 bg-indigo-50 p-5 sm:flex-row sm:items-center">
        <div><p class="text-xs font-bold uppercase tracking-wide text-indigo-600">Modalità selezionata</p><p class="mt-1 font-semibold text-indigo-950"><%= participation_labels.fetch(@selected_participation) %></p></div>
        <span class="text-sm text-indigo-700">Scelta non ancora salvata · frontend dimostrativo</span>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-3">
      <% [["Corsi", @dashboard_courses.size], ["Incontri e lezioni", @lesson_count], ["Capitoli online", @chapter_count]].each do |label, value| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500"><%= label %></p><strong class="mt-2 block text-3xl tracking-tight text-slate-950"><%= value %></strong></article>
      <% end %>
    </div>

    <section class="mt-8 overflow-hidden rounded-3xl border border-blue-200 bg-white">
      <div class="border-b border-blue-100 bg-blue-50 px-6 py-3 text-xs font-bold uppercase tracking-[.16em] text-blue-700">Da dove iniziare</div>
      <div class="p-6 sm:p-8">
      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div><h2 class="text-2xl font-semibold text-slate-950"><%= @starting_course.fetch("title") %></h2><p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600"><%= @starting_course.fetch("description", "Il primo corso del percorso educativo PosturaCorretta.") %></p></div>
        <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600"><%= @starting_course.fetch("program").size %> attività · <%= @starting_course.fetch("chapter_count") %> capitoli</span>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <% if (next_activity = @starting_course["next_activity"]) %><%= link_to "Inizia dal prossimo passo", posturacorretta_course_lesson_path(corso: @starting_course.fetch("slug"), attivita: next_activity.fetch("slug")), class: "rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-800" %><% end %>
        <%= link_to "Apri il corso online", posturacorretta_course_chapters_path(corso: @starting_course.fetch("slug")), class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:border-blue-300 hover:text-blue-700" %>
      </div>
      </div>
    </section>

    <section class="mt-8 grid gap-5 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold text-slate-950">I tuoi appuntamenti</h2><p class="mt-5 rounded-2xl bg-slate-50 p-5 text-sm leading-6 text-slate-500">Non risultano ancora incontri con il tutor o lezioni prenotate. Compariranno qui quando la prenotazione sarà collegata al calendario.</p></article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold text-slate-950">Come puoi partecipare</h2><div class="mt-5 flex flex-wrap gap-2"><span class="rounded-full bg-blue-50 px-3 py-1.5 text-sm font-semibold text-blue-700">In gruppo</span><span class="rounded-full bg-slate-100 px-3 py-1.5 text-sm font-semibold text-slate-600">Individuale</span></div><p class="mt-4 text-sm leading-6 text-slate-500">Il corso online resta consultabile; incontri e lezioni vengono programmati con tutor o insegnante.</p></article>
    </section>

    <section class="mt-8">
      <div class="mb-4"><p class="text-xs font-bold uppercase tracking-[.16em] text-blue-700">Percorso educativo</p><h2 class="mt-2 text-2xl font-semibold text-slate-950">Tutti i corsi</h2></div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% @dashboard_courses.each do |course| %>
          <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-slate-400"><%= course["section_slug"].present? ? "Corso della sezione" : "Corso" %></p>
            <h3 class="mt-2 text-lg font-semibold text-slate-950"><%= course.fetch("title") %></h3>
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-600"><%= course.fetch("description", "Materiali e attività del corso PosturaCorretta.") %></p>
            <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-xs font-semibold text-slate-500"><span><%= course.fetch("program").size %> attività</span><span><%= course.fetch("chapter_count") %> capitoli</span></div>
            <%= link_to "Apri il corso", posturacorretta_course_path(corso: course.fetch("slug")), class: "mt-4 inline-flex text-sm font-bold text-blue-700 hover:text-blue-900" %>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</main>

<%= render "posturacorretta/footer" %>
