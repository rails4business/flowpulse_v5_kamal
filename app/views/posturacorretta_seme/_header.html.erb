<% lesson_open = params[:lesson].present? %>
<% percorso_open = action_name == "percorso" || lesson_open || params[:stage].present? %>
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center px-4 sm:px-6">
    <%= link_to posturacorretta_seme_path, class: "flex shrink-0 items-center gap-3", aria: { label: "PosturaCorretta Seme home" } do %>
      <span class="grid size-9 place-items-center rounded-xl bg-slate-900 text-sm font-bold text-white">PC</span>
      <span class="hidden sm:block">
        <span class="block text-sm font-semibold leading-none text-slate-950">PosturaCorretta</span>
        <span class="mt-1 block text-[11px] text-slate-500">Educazione al corpo e alla postura</span>
      </span>
    <% end %>

    <nav class="ml-10 hidden items-center gap-1 text-sm lg:flex" aria-label="Navigazione PosturaCorretta Seme">
      <%= link_to "Home", posturacorretta_seme_path, class: "rounded-lg px-3 py-2 font-semibold #{percorso_open ? 'text-slate-600 hover:bg-slate-100' : 'bg-slate-100 text-slate-900'}", aria: (!percorso_open ? { current: "page" } : {}) %>
      <%= link_to "Percorso", posturacorretta_seme_percorso_path, class: "rounded-lg px-3 py-2 #{percorso_open ? 'bg-slate-100 font-semibold text-slate-900' : 'text-slate-600 hover:bg-slate-100'}", aria: (percorso_open ? { current: "page" } : {}) %>
      <%= link_to "Blog", posturacorretta_contenuti_path, class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100" %>
      <%= link_to "Metodiche", posturacorretta_metodiche_path, class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100" %>
      <%= link_to "Insegnanti", posturacorretta_collabora_path, class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100" %>
      <%= link_to "Centri", posturacorretta_percorsi_sul_territorio_path(tab: "places"), class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100" %>
      <%= link_to "Area corsi", posturacorretta_seme_student_dashboard_path, class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100" %>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <details class="group relative lg:hidden [&_summary::-webkit-details-marker]:hidden" data-close-on-outside>
        <summary class="flex cursor-pointer list-none items-center gap-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700" aria-label="Apri navigazione">
          Menu <span class="text-[10px] text-slate-400 transition group-open:rotate-180">⌄</span>
        </summary>
        <nav class="absolute right-0 z-[80] mt-2 w-64 overflow-hidden rounded-xl border border-slate-200 bg-white p-2 shadow-xl" aria-label="Navigazione mobile PosturaCorretta Seme">
          <%= link_to "Home", posturacorretta_seme_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <%= link_to "Percorso", posturacorretta_seme_percorso_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <%= link_to "Blog", posturacorretta_contenuti_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <%= link_to "Metodiche", posturacorretta_metodiche_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <%= link_to "Insegnanti", posturacorretta_collabora_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <%= link_to "Centri", posturacorretta_percorsi_sul_territorio_path(tab: "places"), class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <%= link_to "Dashboard studente", posturacorretta_seme_student_dashboard_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <% if Current.user&.teacher_user? || Current.user&.superadmin_user? %><%= link_to "Dashboard insegnante", posturacorretta_seme_teacher_dashboard_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-50" %><% end %>
        </nav>
      </details>
      <%= render "posturacorretta/account_nav" %>
    </div>
  </div>
</header>
