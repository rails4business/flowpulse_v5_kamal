<% cover_styles = [
     "from-blue-950 via-blue-700 to-cyan-400",
     "from-emerald-950 via-emerald-700 to-lime-400",
     "from-violet-950 via-violet-700 to-fuchsia-400",
     "from-slate-950 via-indigo-700 to-blue-400"
   ] %>

<% course_row = lambda do |course, course_number, inherited_level = nil| %>
  <% learning_available = course.fetch("chapters", []).any? { |chapter| chapter["content_ref"].present? } %>
  <% program_available = @program_course_slugs.include?(course.fetch("slug")) %>
  <% course_code = format("%02d", course_number) %>
  <% course_entry_path = posturacorretta_course_path(corso: course.fetch("slug"), vista: "capitoli") %>
  <article id="<%= course.fetch("slug") %>" class="group relative scroll-mt-24 overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:border-blue-300 hover:shadow-xl hover:shadow-slate-900/5">
    <% if course_entry_path %>
      <%= link_to course_entry_path, class: "absolute inset-0 z-10 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-inset", aria: { label: "Apri il corso #{course.fetch("title")}" } do %>
        <span class="sr-only">Apri il corso <%= course.fetch("title") %></span>
      <% end %>
    <% end %>
    <div class="grid min-h-52 sm:grid-cols-[14rem_minmax(0,1fr)]">
      <div class="relative min-h-44 overflow-hidden bg-gradient-to-br <%= cover_styles[(course_number - 1) % cover_styles.size] %>">
        <% if course["image"].present? %>
          <%= imagekit_image_tag(
                course.fetch("image"),
                alt: "",
                widths: [480, 768],
                sizes: "(min-width: 640px) 14rem, calc(100vw - 2rem)",
                class_name: "absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-[1.03]",
                loading: course_number == 1 ? "eager" : "lazy",
                fetchpriority: course_number == 1 ? "high" : "auto"
              ) %>
          <span class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></span>
        <% else %>
          <span class="absolute -right-8 -top-10 size-36 rounded-full border border-white/25"></span>
          <span class="absolute -bottom-16 -left-12 size-48 rounded-full border-[28px] border-white/10"></span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="absolute right-5 top-5 size-10 text-white/75">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15Z" />
          </svg>
        <% end %>
        <span class="absolute bottom-4 left-4 rounded-full bg-white/95 px-3 py-1 text-[11px] font-extrabold uppercase tracking-[.13em] text-slate-900 shadow-sm">Corso <%= course_code %></span>
      </div>

      <div class="flex min-w-0 flex-col p-5 sm:p-7">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-bold uppercase tracking-[.13em] text-blue-700">Corso <%= course_code %></span>
          <% if course["status"] == "draft" %><span class="rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-700">In preparazione</span><% end %>
        </div>
        <h3 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950 group-hover:text-blue-700"><%= course.fetch("title") %></h3>
        <% if course["description"].present? %><p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= course.fetch("description") %></p><% end %>
        <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-6">
          <span class="text-xs font-semibold text-slate-500"><%= course.fetch("chapters", []).size %> capitoli</span>
          <span class="flex w-full flex-wrap gap-2 sm:w-auto sm:justify-end">
            <% if course_entry_path %><span class="inline-flex w-full min-w-32 items-center justify-center rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-bold text-white transition group-hover:bg-blue-800 sm:w-auto">Apri il corso</span><% end %>
            <% unless program_available || learning_available %><span class="text-xs font-semibold text-amber-700">In preparazione</span><% end %>
          </span>
        </div>
      </div>
    </div>
  </article>
<% end %>

<main class="bg-white">
  <section class="mx-auto max-w-[1040px] px-4 py-12 sm:px-6 sm:py-16">
    <div>
      <% course_number = 0 %>
      <section id="primi-corsi" class="scroll-mt-24">
        <header class="mb-7 max-w-3xl border-b border-slate-200 pb-5">
          <% if @didactic_path["eyebrow"].present? %><p class="text-xs font-bold uppercase tracking-[.15em] text-blue-700"><%= @didactic_path.fetch("eyebrow") %></p><% end %>
          <h1 class="!m-0 !mt-1 text-3xl font-semibold tracking-tight text-slate-950"><%= @didactic_path.fetch("title") %></h1>
          <% if @didactic_path["description"].present? %><p class="mt-2 leading-7 text-slate-600"><%= @didactic_path.fetch("description") %></p><% end %>
        </header>
      <div class="space-y-6">
        <% @didactic_courses.each do |course| %>
          <% course_number += 1 %>
          <% course_row.call(course, course_number) %>
        <% end %>
      </div>
    </section>

      <% @didactic_sections.each do |section| %>
        <section id="<%= section.fetch("slug") %>" class="scroll-mt-24 pt-16">
          <header class="mb-7 max-w-3xl border-b border-slate-200 pb-5">
            <% if section["eyebrow"].present? %><p class="text-xs font-bold uppercase tracking-[.15em] text-blue-700"><%= section.fetch("eyebrow") %></p><% end %>
            <h2 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950"><%= section.fetch("title") %></h2>
            <p class="mt-2 leading-7 text-slate-600"><%= section.fetch("description") %></p>
          </header>
          <div class="space-y-6">
            <% section.fetch("courses").each do |course| %>
              <% course_number += 1 %>
              <% course_row.call(course, course_number, section.fetch("level", "base")) %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </section>
</main>

<%= render "posturacorretta/footer" %>
