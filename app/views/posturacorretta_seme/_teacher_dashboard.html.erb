<main class="bg-[#F6F7F4]">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 lg:py-14">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <div class="flex flex-wrap items-center gap-2"><p class="text-xs font-semibold uppercase tracking-[.18em] text-indigo-600">Area didattica</p><% unless @teacher_access %><span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-bold text-amber-800">ANTEPRIMA FRONTEND</span><% end %></div>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-.03em] text-slate-950">Dashboard insegnante</h1>
          <p class="mt-4 max-w-2xl leading-7 text-slate-600">Prepara le lezioni, organizza gruppi e gestisci le richieste individuali.</p>
        </div>
        <%= link_to "Vedi come studente", posturacorretta_seme_student_dashboard_path, class: "rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:border-indigo-200" %>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 lg:py-14">
    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      <% [["Corsi", @courses.size], ["Lezioni", @lesson_count], ["Gruppi attivi", 0], ["Richieste individuali", 0]].each do |label, value| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500"><%= label %></p><strong class="mt-2 block text-3xl tracking-tight text-slate-950"><%= value %></strong></article>
      <% end %>
    </div>

    <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1.35fr)_minmax(19rem,.65fr)]">
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
        <div class="flex items-center justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-[.15em] text-indigo-600">Programma</p><h2 class="mt-2 text-2xl font-semibold text-slate-950">Lezioni da preparare</h2></div><span class="text-sm text-slate-500"><%= @base_stage.fetch("lessons").size %> lezioni</span></div>
        <div class="mt-6 divide-y divide-slate-100">
          <% @base_stage.fetch("lessons").first(5).each_with_index do |lesson, index| %>
            <% chapter = @didactic_courses.first.fetch("chapters").find { |item| item["content_ref"] == lesson.fetch("slug") } %>
            <div class="flex items-center gap-4 py-4"><span class="grid size-9 shrink-0 place-items-center rounded-full bg-slate-100 text-xs font-bold text-slate-600"><%= format("%02d", index + 1) %></span><div class="min-w-0 flex-1"><p class="truncate text-sm font-semibold text-slate-900"><%= lesson.fetch("title") %></p><p class="mt-1 text-xs text-slate-500">Base pubblicata · avanzato da verificare</p></div><%= link_to "Apri", posturacorretta_course_chapter_path(corso: "postura-corretta-in-un-mese", capitolo: chapter&.fetch("slug", nil)), class: "text-sm font-semibold text-indigo-700" %></div>
          <% end %>
        </div>
        <%= link_to "Apri tutto l’indice", posturacorretta_course_chapters_path(corso: "postura-corretta-in-un-mese"), class: "mt-5 inline-flex text-sm font-semibold text-indigo-700" %>
      </section>

      <aside class="space-y-6">
        <section class="rounded-3xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold text-slate-950">Prossime lezioni</h2><p class="mt-4 text-sm leading-6 text-slate-500">Nessuna lezione di gruppo o individuale programmata.</p><button type="button" disabled class="mt-5 w-full cursor-not-allowed rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-400">Programmazione in arrivo</button></section>
        <section class="rounded-3xl border border-indigo-200 bg-indigo-50 p-6"><h2 class="text-xl font-semibold text-indigo-950">Formazione insegnante</h2><p class="mt-3 text-sm leading-6 text-indigo-800">Gli approfondimenti avanzati e le verifiche verranno raccolti qui.</p><%= link_to "Consulta il percorso", posturacorretta_path, class: "mt-5 inline-flex text-sm font-semibold text-indigo-800" %></section>
      </aside>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
