<% content_for :title, "Profilo · PosturaCorretta" %>
<% content_for :description, "Il tuo spazio personale PosturaCorretta." %>
<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<main class="min-h-screen bg-white">
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="border-b border-slate-200 pb-6">
      <p class="text-xs font-bold uppercase tracking-[.15em] text-blue-700">Spazio personale</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950"><%= @posturacorretta_profile.display_name.presence || "Il tuo profilo" %></h1>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= Current.user.email_address %></p>
    </header>

    <section class="mt-8 grid gap-4 sm:grid-cols-2" aria-label="Il tuo percorso">
      <%= link_to posturacorretta_student_dashboard_path, class: "rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-blue-300 hover:shadow-sm" do %>
        <p class="text-xs font-bold uppercase tracking-[.14em] text-blue-700">Percorso</p>
        <h2 class="mt-1 text-xl font-semibold text-slate-950">Lezioni</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Consulta il tuo programma e le schede pratiche.</p>
      <% end %>
      <%= link_to posturacorretta_student_appointments_path, class: "rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-blue-300 hover:shadow-sm" do %>
        <p class="text-xs font-bold uppercase tracking-[.14em] text-blue-700">Agenda personale</p>
        <h2 class="mt-1 text-xl font-semibold text-slate-950">Appuntamenti</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Vedi date, incontri e storico del tuo percorso.</p>
      <% end %>
    </section>
  </section>
</main>

<%= render "posturacorretta/footer" %>
