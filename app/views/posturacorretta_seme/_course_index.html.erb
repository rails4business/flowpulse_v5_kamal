<% course_position = @all_didactic_courses.index { |course| course.fetch("slug") == @reader_course_slug } %>
<% course_code = format("%02d", (course_position || 0) + 1) %>

<main class="bg-white" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
  <div class="mx-auto max-w-screen-xl px-4 py-6 sm:px-6 lg:grid lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-8 lg:px-8 lg:py-8">
    <aside id="course-index-aside" class="hidden overflow-y-auto border-r border-slate-200 bg-white p-5 shadow-2xl lg:sticky lg:top-24 lg:block lg:h-auto lg:max-h-[calc(100vh-7rem)] lg:w-auto lg:max-w-none lg:overscroll-contain lg:rounded-xl lg:border lg:shadow-sm [scrollbar-color:rgb(203_213_225)_transparent] [scrollbar-width:thin]">
      <div data-action="click->mobile-aside#closeFromNavigation">
        <%= render "posturacorretta_seme/curriculum_aside", active: :path, course: @selected_course %>
      </div>
    </aside>

    <div class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <section class="border-b border-slate-200 bg-[#F6F7F4]">
    <div class="px-5 py-10 sm:px-8 lg:px-12 lg:py-14">
      <p class="text-xs font-semibold uppercase tracking-[.18em] text-indigo-600">Corso <%= course_code %> · Indice</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-.03em] text-slate-950 sm:text-5xl"><%= @selected_course.fetch("title") %></h1>
      <% if @selected_course["description"].present? %><p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600"><%= @selected_course.fetch("description") %></p><% end %>
      <p class="mt-5 text-sm text-slate-500"><%= @course_lessons.size %> capitoli</p>
    </div>
  </section>

  <section class="px-5 py-10 sm:px-8 lg:px-12 lg:py-14">
    <div>
      <% @course_lessons.each_with_index do |lesson, index| %>
        <% href = posturacorretta_course_chapter_path(corso: @reader_course_slug, capitolo: lesson.fetch("slug")) %>
        <article class="relative grid gap-4 md:grid-cols-[72px_minmax(0,1fr)_auto] md:items-start">
          <div class="relative">
            <span class="grid min-h-11 min-w-14 place-items-center rounded-full <%= index.zero? ? "bg-slate-900 text-white" : "border-2 border-slate-300 bg-white text-slate-500" %> px-2 text-xs font-semibold"><%= format("%02d", index + 1) %></span>
            <% unless index == @course_lessons.size - 1 %><span class="absolute left-[27px] top-11 h-[calc(100%+2rem)] w-px bg-slate-200"></span><% end %>
          </div>
          <div class="pb-8">
            <h2 class="text-lg font-semibold leading-6 tracking-tight text-slate-950"><%= lesson.fetch("title") %></h2>
            <p class="mt-2 text-sm text-slate-500">Capitolo <%= index + 1 %> di <%= @course_lessons.size %></p>
          </div>
          <div class="pb-8 md:pt-0.5"><%= link_to(index.zero? ? "Inizia" : "Apri", href, class: "inline-flex rounded-xl #{index.zero? ? "bg-slate-900 text-white" : "border border-slate-200 bg-white text-slate-700"} px-4 py-2 text-sm font-semibold hover:shadow-sm") %></div>
        </article>
      <% end %>
    </div>
    <%= link_to "← Tutti i corsi", posturacorretta_path, class: "mt-4 inline-flex text-sm font-semibold text-indigo-700" %>
  </section>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
