<main data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
  <div class="mx-auto max-w-[1600px] lg:grid lg:grid-cols-[310px_minmax(0,1fr)]">
    <div class="border-b border-slate-200 bg-white p-4 lg:hidden">
      <button type="button" class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="seme-aside" aria-expanded="false"><span>Indice del corso</span><span aria-hidden="true">☰</span></button>
    </div>
    <div class="fixed inset-0 z-40 hidden bg-slate-950/30 opacity-0 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>
    <aside id="seme-aside" class="fixed inset-y-0 left-0 z-50 w-80 max-w-[88vw] -translate-x-full overflow-y-auto border-r border-slate-200 bg-white p-5 shadow-2xl transition-transform lg:sticky lg:top-16 lg:z-auto lg:h-[calc(100vh-4rem)] lg:w-auto lg:max-w-none lg:translate-x-0 lg:shadow-none" data-mobile-aside-target="panel" aria-hidden="true">
      <div class="mb-6 flex items-center justify-between">
        <div><p class="text-xs font-semibold uppercase tracking-[.14em] text-indigo-600"><%= @selected_stage.fetch("title") %></p><h1 class="mt-1 text-lg font-semibold"><%= @selected_course.fetch("title") %></h1></div>
        <button type="button" class="rounded-lg p-2 text-slate-500 lg:hidden" data-mobile-aside-target="close" data-action="mobile-aside#close" aria-label="Chiudi indice">✕</button>
      </div>
      <nav class="space-y-1" aria-label="Lezioni del corso" data-action="click->mobile-aside#closeFromNavigation">
        <% @course_lessons.each do |lesson| %>
          <% active = lesson.fetch("slug") == @lesson.fetch("slug") %>
          <% href = posturacorretta_seme_path(stage: @selected_stage.fetch("slug"), module: (@selected_stage.fetch("slug") == "accademia" ? @selected_course.fetch("slug") : nil), lesson: lesson.fetch("slug")) %>
          <%= link_to href, class: "flex items-start gap-3 rounded-lg px-3 py-2.5 #{active ? "bg-indigo-50 text-indigo-900" : "text-slate-600 hover:bg-slate-50"}", aria: (active ? { current: "page" } : {}) do %>
            <span class="mt-1 size-2.5 shrink-0 rounded-full <%= active ? "bg-indigo-500 ring-4 ring-indigo-100" : "border border-slate-300 bg-white" %>"></span>
            <span class="text-sm leading-5 <%= "font-semibold" if active %>"><%= lesson.fetch("title") %></span>
          <% end %>
        <% end %>
      </nav>
      <%= link_to "← Tutto il percorso", posturacorretta_seme_percorso_path, class: "mt-8 inline-flex text-sm font-semibold text-indigo-700" %>
    </aside>

    <article class="min-w-0 bg-white px-5 py-10 sm:px-8 lg:px-12 lg:py-14 xl:px-16">
      <div class="mx-auto max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-indigo-600">Lezione base</p>
        <%= render "posturacorretta/shared/rich_text", rendered_content: markdown(@base_content), class_name: "mt-4 min-w-0" %>

        <%= render "posturacorretta_seme/participation_tickets" %>

        <% if @advanced_access && @advanced_defined %>
          <section class="mt-12 border-t border-indigo-200 pt-10">
            <p class="text-xs font-semibold uppercase tracking-[.16em] text-indigo-600">Approfondimento avanzato · Anteprima superadmin</p>
            <%= render "posturacorretta/shared/rich_text", rendered_content: markdown(@advanced_content), class_name: "mt-4 min-w-0" %>
          </section>
        <% else %>
          <%= render "posturacorretta_seme/advanced_locked", advanced_defined: @advanced_defined %>
        <% end %>
      </div>
    </article>
  </div>
</main>
