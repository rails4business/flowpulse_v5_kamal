<main data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
  <div class="mx-auto max-w-screen-xl px-4 py-6 sm:px-6 lg:grid lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-8 lg:px-8 lg:py-8">
    <div class="border-b border-slate-200 bg-white p-4 lg:hidden">
      <button type="button" class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="seme-aside" aria-expanded="false"><span>Indice dei capitoli</span><span aria-hidden="true">☰</span></button>
    </div>
    <div class="fixed inset-0 z-40 hidden bg-slate-950/30 opacity-0 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>
    <aside id="seme-aside" class="pc-course-aside-enter fixed inset-y-0 left-0 z-50 w-80 max-w-[88vw] -translate-x-full overflow-y-auto border-r border-slate-200 bg-white p-5 shadow-2xl transition-transform lg:sticky lg:top-24 lg:z-auto lg:h-auto lg:max-h-[calc(100vh-7rem)] lg:w-auto lg:max-w-none lg:translate-x-0 lg:overscroll-contain lg:rounded-xl lg:border lg:border-slate-200 lg:shadow-sm [scrollbar-color:rgb(203_213_225)_transparent] [scrollbar-width:thin]" data-mobile-aside-target="panel" aria-hidden="true">
      <div class="mb-6 flex items-center justify-between lg:hidden">
        <div><p class="text-xs font-semibold uppercase tracking-[.14em] text-indigo-600"><%= @selected_stage.fetch("title") %></p><h1 class="mt-1 text-lg font-semibold"><%= @selected_course.fetch("title") %></h1></div>
        <button type="button" class="rounded-lg p-2 text-slate-500 lg:hidden" data-mobile-aside-target="close" data-action="mobile-aside#close" aria-label="Chiudi indice">✕</button>
      </div>
      <div data-action="click->mobile-aside#closeFromNavigation">
        <%= render "posturacorretta_seme/curriculum_aside", active: :path, course: @selected_course, lesson: @lesson %>
      </div>
    </aside>

    <article class="pc-course-main-enter min-w-0 rounded-xl border border-slate-200 bg-white px-5 py-10 shadow-sm sm:px-8 lg:px-12 lg:py-14 xl:px-16">
      <div class="mx-auto max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-indigo-600">Capitolo del corso</p>
        <%= render "posturacorretta/shared/rich_text", rendered_content: markdown(@base_content), class_name: "mt-4 min-w-0" %>

        <% if @advanced_access && @advanced_defined %>
          <section class="mt-12 border-t border-indigo-200 pt-10">
            <p class="text-xs font-semibold uppercase tracking-[.16em] text-indigo-600">Approfondimento avanzato · Anteprima superadmin</p>
            <%= render "posturacorretta/shared/rich_text", rendered_content: markdown(@advanced_content), class_name: "mt-4 min-w-0" %>
          </section>
        <% else %>
          <%= render "posturacorretta_seme/advanced_locked", advanced_defined: @advanced_defined %>
        <% end %>
      </div>
    </article>
  </div>
</main>
