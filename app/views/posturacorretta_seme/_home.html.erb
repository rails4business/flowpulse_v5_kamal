<% direct_course_slugs = @didactic_courses.map { |course| course.fetch("slug") } %>
<% grouped_courses = [{ "title" => "Inizia", "courses" => @all_didactic_courses.select { |course| direct_course_slugs.include?(course.fetch("slug")) } }] %>
<% @didactic_sections.each do |section| %>
  <% section_courses = @all_didactic_courses.select { |course| course["section_slug"] == section.fetch("slug") } %>
  <% grouped_courses << { "title" => section.fetch("title"), "courses" => section_courses } if section_courses.present? %>
<% end %>

<% selected_step = @selected_program_step %>
<% selected_program_item = selected_step&.fetch("source_type", nil) == "program_item" %>
<% selected_participations = selected_step&.fetch("participations", []) || [] %>
<% selected_last_date = selected_participations.filter_map { |participation| participation["date"].presence }.max %>
<% selected_chapter = @learning_course.fetch("chapters", []).find { |chapter| chapter["content_ref"] == selected_step["content_ref"] } if selected_step&.dig("content_ref").present? %>
<% selected_content_path = posturacorretta_course_chapter_path(corso: @learning_course.fetch("slug"), capitolo: selected_chapter.fetch("slug")) if selected_chapter %>
<% selected_level_details = selected_step&.fetch("levels", {})&.fetch(@selected_program_level, nil) if @selected_program_level %>

<main class="min-h-screen bg-slate-50" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
  <div class="border-b border-slate-200 bg-white p-4 lg:hidden">
    <button type="button" class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-800" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="programma-aside" aria-expanded="false">
      <span>Incontri e lezioni</span><span aria-hidden="true">☰</span>
    </button>
  </div>
  <div class="fixed inset-0 z-40 hidden bg-slate-950/30 opacity-0 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>
  <aside id="programma-aside" class="pc-course-aside-enter fixed inset-y-0 left-0 z-50 w-80 max-w-[88vw] -translate-x-full overflow-y-auto border-r border-slate-200 bg-white p-5 shadow-2xl transition-transform lg:hidden" data-mobile-aside-target="panel" aria-hidden="true">
    <div class="mb-5 flex items-center justify-between">
      <p class="text-sm font-bold text-slate-900">Incontri e lezioni</p>
      <button type="button" class="rounded-lg p-2 text-slate-500" data-mobile-aside-target="close" data-action="mobile-aside#close" aria-label="Chiudi indice">✕</button>
    </div>
    <div data-action="click->mobile-aside#closeFromNavigation">
      <%= render "posturacorretta_seme/curriculum_aside", active: :program, course: @learning_course %>
    </div>
  </aside>
  <div class="mx-auto max-w-screen-xl px-4 py-6 sm:px-6 lg:grid lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-8 lg:px-8 lg:py-8">
    <aside class="hidden lg:block">
      <div class="pc-course-aside-enter sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto overscroll-contain rounded-xl border border-slate-200 bg-white p-5 shadow-sm [scrollbar-color:rgb(203_213_225)_transparent] [scrollbar-width:thin]" data-controller="scroll-selected">
        <%= render "posturacorretta_seme/curriculum_aside", active: :program, course: @learning_course %>
      </div>
    </aside>

    <div class="pc-course-main-enter min-w-0">
      <% if selected_step %>
      <section id="scheda-attivita" class="scroll-mt-24 rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.13em] text-blue-700">Scheda dell’attività</p>
              <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-950"><%= selected_step.fetch("title") %></h2>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600"><%= selected_step.fetch("description") %></p>
            </div>
            <div class="shrink-0 sm:text-right">
              <p class="text-xs font-semibold text-slate-400"><%= selected_last_date ? "Ultima partecipazione" : "Stato" %></p>
              <p class="mt-1 font-bold <%= selected_last_date ? "text-emerald-700" : "text-slate-700" %>"><%= selected_last_date ? l(Date.iso8601(selected_last_date), format: :long) : "Da programmare" %></p>
            </div>
          </div>
        </header>

        <div class="p-5 sm:p-6">
          <% if selected_program_item && selected_step["lesson_plan"].present? %>
            <div class="grid gap-5 sm:grid-cols-2">
              <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Programma</p><p class="mt-1 font-semibold text-slate-900"><%= selected_step.dig("lesson_plan", "title") %></p></div>
              <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Durata indicativa</p><p class="mt-1 font-semibold text-slate-900"><%= selected_step.dig("lesson_plan", "duration_minutes") %> minuti</p></div>
            </div>
          <% elsif selected_program_item && selected_step["levels"].present? %>
            <nav aria-label="Livello della lezione" class="border-b border-slate-200">
              <div class="-mb-px flex gap-1 overflow-x-auto">
                <% selected_step.fetch("levels").each do |level, details| %>
                  <% active_level = level == @selected_program_level %>
              <%= link_to posturacorretta_course_lesson_path(corso: @learning_course.fetch("slug"), attivita: selected_step.fetch("slug"), livello: level, ruolo: @selected_participation_role, tirocinio: @selected_internship_mode), aria: { current: ("page" if active_level) }, class: "whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-bold transition #{active_level ? (level == "advanced" ? "border-violet-600 text-violet-800" : "border-emerald-600 text-emerald-800") : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-800"}" do %>
                    <%= details["label"].presence || (level == "advanced" ? "Avanzata" : "Base") %>
                  <% end %>
                <% end %>
              </div>
            </nav>

            <% if selected_level_details %>
              <article class="mt-5 rounded-xl border <%= @selected_program_level == "advanced" ? "border-violet-200 bg-violet-50/50" : "border-emerald-200 bg-emerald-50/50" %> p-5">
                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wide <%= @selected_program_level == "advanced" ? "text-violet-700" : "text-emerald-700" %>">Programma della lezione</p>
                    <p class="mt-2 font-semibold text-slate-900"><%= selected_level_details.dig("lesson_plan", "title") %></p>
                    <p class="mt-1 text-sm text-slate-600"><%= selected_level_details.dig("lesson_plan", "duration_minutes") %> minuti</p>
                  </div>
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Scheda pratica</p>
                    <p class="mt-2 text-sm font-semibold text-slate-800"><%= selected_level_details.dig("worksheet", "title") %></p>
                    <p class="mt-1 text-xs text-slate-500"><%= selected_level_details.dig("worksheet", "status").to_s.tr("_", " ").capitalize %></p>
                  </div>
                </div>
                <% if selected_level_details.dig("lesson_plan", "objectives").present? %>
                  <div class="mt-5 border-t border-slate-200/80 pt-4">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Obiettivi</p>
                    <ul class="mt-2 space-y-2 text-sm leading-6 text-slate-700">
                      <% selected_level_details.dig("lesson_plan", "objectives").each do |objective| %>
                        <li class="flex gap-2"><span aria-hidden="true" class="text-emerald-600">✓</span><span><%= objective %></span></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
              </article>
            <% end %>
          <% else %>
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Cosa fare</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">Consulta il capitolo prima dell’incontro e utilizzalo successivamente per ripassare i punti affrontati nella lezione.</p>
              <% if selected_content_path %><%= link_to "Apri il capitolo →", selected_content_path, class: "mt-3 inline-flex text-sm font-bold text-blue-700 hover:text-blue-800" %><% end %>
            </div>
          <% end %>

          <% if @selected_participation_role.present? %>
            <section class="mt-6 rounded-xl border border-blue-100 bg-blue-50/60 p-4" aria-labelledby="participation-role-title">
              <p id="participation-role-title" class="text-xs font-bold uppercase tracking-wide text-blue-700">Partecipi come</p>
              <% if @available_participation_roles.size > 1 %>
                <div class="mt-3 flex flex-wrap gap-2">
                  <% @available_participation_roles.each do |role, details| %>
                    <% active_role = role == @selected_participation_role %>
                    <%= link_to details.fetch("label"), posturacorretta_course_lesson_path(corso: @learning_course.fetch("slug"), attivita: selected_step.fetch("slug"), livello: @selected_program_level, ruolo: role), aria: { current: ("page" if active_role) }, class: "rounded-lg border px-3 py-2 text-sm font-bold transition #{active_role ? "border-blue-600 bg-blue-700 text-white" : "border-blue-200 bg-white text-blue-800 hover:border-blue-400"}" %>
                  <% end %>
                </div>
              <% else %>
                <p class="mt-1 font-bold text-slate-950"><%= @selected_participation_label %></p>
              <% end %>
            </section>
          <% end %>

          <% if @available_internship_modes.present? %>
            <section class="mt-4 rounded-xl border border-violet-200 bg-violet-50/60 p-4" aria-labelledby="internship-mode-title">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p id="internship-mode-title" class="text-xs font-bold uppercase tracking-wide text-violet-700">Modalità di tirocinio</p>
                  <p class="mt-1 text-sm text-slate-600">La modalità descrive il ruolo svolto nella singola lezione, non l’avanzamento nel tirocinio.</p>
                </div>
                <% if @internship_supervisor_required %>
                  <span class="mt-2 w-fit rounded-full border border-violet-200 bg-white px-2.5 py-1 text-xs font-bold text-violet-800 sm:mt-0">Maestro richiesto</span>
                <% end %>
              </div>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                <% @available_internship_modes.each do |mode, details| %>
                  <% active_mode = mode == @selected_internship_mode %>
                  <%= link_to posturacorretta_course_lesson_path(corso: @learning_course.fetch("slug"), attivita: selected_step.fetch("slug"), livello: @selected_program_level, ruolo: @selected_participation_role, tirocinio: mode), aria: { current: ("page" if active_mode) }, class: "rounded-lg border p-3 transition #{active_mode ? "border-violet-600 bg-violet-700 text-white" : "border-violet-200 bg-white text-slate-800 hover:border-violet-400"}" do %>
                    <span class="block text-sm font-bold"><%= details.fetch("label") %></span>
                    <span class="mt-1 block text-xs leading-5 <%= active_mode ? "text-violet-100" : "text-slate-500" %>"><%= details.fetch("description") %></span>
                  <% end %>
                <% end %>
              </div>
            </section>
          <% end %>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-5">
            <p class="text-xs leading-5 text-slate-500">Il ticket specificherà modalità, data e partecipazione: incontro con tutor, lezione con insegnante o tirocinio.</p>
            <% booking_path = posturacorretta_impegno_path(corso: @learning_course.fetch("slug"), attivita: selected_step.fetch("slug"), livello: @selected_program_level, ruolo: @selected_participation_role, tirocinio: @selected_internship_mode) %>
            <%= link_to(authenticated? ? (selected_last_date ? "Prenota di nuovo" : "Prenota") : "Accedi per prenotare", authenticated? ? booking_path : new_session_path(return_to: request.fullpath), class: "inline-flex rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-blue-800") %>
          </div>
        </div>
      </section>
      <% else %>
        <section id="scheda-attivita" class="rounded-xl border border-dashed border-amber-200 bg-white p-8 text-center shadow-sm sm:p-12">
          <span class="mx-auto grid size-12 place-items-center rounded-full bg-amber-100 text-xl text-amber-800" aria-hidden="true">○</span>
          <h2 class="mt-4 text-2xl font-bold text-slate-950">Lezioni in preparazione</h2>
          <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-600">Il corso è già presente nel percorso educativo. Gli incontri, le lezioni e le relative modalità di partecipazione verranno aggiunti qui.</p>
          <%= link_to "Consulta i capitoli", posturacorretta_course_chapters_path(corso: @learning_course.fetch("slug")), class: "mt-5 inline-flex rounded-lg border border-indigo-300 bg-indigo-50 px-4 py-2.5 text-sm font-bold !text-indigo-900 hover:bg-indigo-100" %>
        </section>
      <% end %>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
