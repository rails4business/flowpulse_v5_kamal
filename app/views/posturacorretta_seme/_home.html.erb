<% lesson_visuals = [
  { icon: "◎", color: "from-blue-50 to-sky-100", ink: "text-blue-700" },
  { icon: "↟", color: "from-emerald-50 to-teal-100", ink: "text-emerald-700" },
  { icon: "◇", color: "from-violet-50 to-indigo-100", ink: "text-violet-700" },
  { icon: "↻", color: "from-amber-50 to-orange-100", ink: "text-amber-700" },
  { icon: "!", color: "from-rose-50 to-red-100", ink: "text-rose-700" },
  { icon: "⌁", color: "from-cyan-50 to-blue-100", ink: "text-cyan-700" },
  { icon: "⇄", color: "from-lime-50 to-emerald-100", ink: "text-lime-700" },
  { icon: "◉", color: "from-fuchsia-50 to-violet-100", ink: "text-fuchsia-700" },
  { icon: "◌", color: "from-indigo-50 to-blue-100", ink: "text-indigo-700" },
  { icon: "→", color: "from-slate-50 to-slate-200", ink: "text-slate-700" }
] %>

<main class="bg-white">
  <section class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 lg:py-16">
    <div class="mb-10 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[.18em] text-indigo-600">Primo corso</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-.035em] text-slate-950 sm:text-5xl">PosturaCorretta in un mese</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600"><%= @base_stage.fetch("description") %> Apri un capitolo e segui il corso in ordine.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <% @base_stage.fetch("lessons").each_with_index do |lesson, index| %>
        <% visual = lesson_visuals.fetch(index % lesson_visuals.size) %>
        <%= link_to posturacorretta_seme_path(stage: "primo-mese", lesson: lesson.fetch("slug")), class: "group grid min-h-52 overflow-hidden rounded-3xl border border-slate-200 bg-white transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-xl hover:shadow-slate-900/5 sm:grid-cols-[9rem_minmax(0,1fr)]" do %>
          <div class="relative grid min-h-36 place-items-center overflow-hidden bg-gradient-to-br <%= visual.fetch(:color) %>">
            <span class="absolute -left-8 -top-8 size-28 rounded-full border border-white/70"></span>
            <span class="absolute -bottom-10 -right-7 size-32 rounded-full border border-white/80"></span>
            <span class="relative grid size-20 place-items-center rounded-full bg-white/75 text-5xl font-light shadow-sm backdrop-blur <%= visual.fetch(:ink) %>" aria-hidden="true"><%= visual.fetch(:icon) %></span>
          </div>
          <div class="flex min-w-0 flex-col p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="text-xs font-bold tracking-[.15em] text-indigo-600"><%= format("%02d", index + 1) %></span>
              <span class="text-xs font-semibold text-slate-400">LEZIONE</span>
            </div>
            <h2 class="mt-5 text-xl font-semibold leading-7 tracking-tight text-slate-950 group-hover:text-indigo-700"><%= lesson.fetch("title") %></h2>
            <span class="mt-auto pt-5 text-sm font-semibold text-slate-500 group-hover:text-indigo-700"><%= index.zero? ? "Inizia il corso" : "Apri il capitolo" %> →</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-7">
      <p class="text-sm text-slate-500"><%= @base_stage.fetch("lessons").size %> lezioni · consulta anche l’indice completo del corso.</p>
      <%= link_to "Apri l’indice del corso", posturacorretta_seme_path(stage: "primo-mese"), class: "rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-indigo-200 hover:text-indigo-700" %>
    </div>
  </section>
</main>

<%= render "posturacorretta/footer" %>
