<% reader_course = local_assigns.fetch(:course) %>
<% course_path = posturacorretta_course_path(corso: reader_course.fetch("slug")) %>

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 min-w-0 items-center gap-3 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-6">
      <%= link_to posturacorretta_path, class: "shrink-0 lg:justify-self-start", aria: { label: "PosturaCorretta home" } do %>
        <img src="https://ik.imagekit.io/posturacorretta/Sassi-icona-cerchio-bianco.png?updatedAt=1785386494945" alt="" class="size-9 rounded-full bg-blue-600 object-cover">
      <% end %>

      <%= link_to course_path, class: "group flex min-w-0 flex-1 items-center gap-2 text-slate-800 hover:text-blue-700 lg:justify-self-center", aria: { label: "Torna all'indice del corso #{reader_course.fetch("title")}" } do %>
        <span aria-hidden="true" class="shrink-0 text-lg transition group-hover:-translate-x-0.5">←</span>
        <span class="truncate text-sm font-bold"><%= reader_course.fetch("title") %></span>
      <% end %>

      <div class="shrink-0 lg:justify-self-end"><%= render "posturacorretta/account_nav" %></div>
    </div>
  </div>
</header>
