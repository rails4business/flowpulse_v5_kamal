<section class="mt-12 border-t border-slate-200 pt-10" aria-labelledby="participation-title">
  <p class="text-xs font-semibold uppercase tracking-[.16em] text-indigo-600">Come partecipare</p>
  <h2 id="participation-title" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950">Scegli come seguire questa lezione</h2>
  <p class="mt-3 max-w-2xl leading-7 text-slate-600">I ticket indicano la modalità di partecipazione. Iscrizione, calendario e pagamento verranno collegati in una fase successiva.</p>

  <% tickets = [
    { key: "autonomy", icon: "◎", title: "Autonomia", description: "Segui la lezione e il materiale disponibile con i tuoi tempi.", meta: "Accesso personale", featured: true },
    { key: "group", icon: "◌", title: "Gruppo", description: "Partecipa a una lezione programmata con un insegnante e altre persone.", meta: "Data da programmare" },
    { key: "individual", icon: "◇", title: "Individuale", description: "Approfondisci la lezione in un incontro personale con un insegnante.", meta: "Su appuntamento" }
  ] %>
  <div class="mt-7 grid gap-4 md:grid-cols-3">
    <% tickets.each do |ticket| %>
      <article class="flex flex-col rounded-2xl border <%= ticket[:featured] ? "border-indigo-200 bg-indigo-50/60" : "border-slate-200 bg-white" %> p-5">
        <div class="flex items-start justify-between gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-white text-xl text-indigo-700 shadow-sm" aria-hidden="true"><%= ticket.fetch(:icon) %></span>
          <span class="rounded-full bg-white px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500"><%= ticket.fetch(:meta) %></span>
        </div>
        <h3 class="mt-5 text-lg font-semibold text-slate-950"><%= ticket.fetch(:title) %></h3>
        <p class="mt-2 text-sm leading-6 text-slate-600"><%= ticket.fetch(:description) %></p>
        <%= link_to "Seleziona modalità", posturacorretta_seme_student_dashboard_path(participation: ticket.fetch(:key)), class: "mt-6 inline-flex justify-center rounded-xl #{ticket[:featured] ? "bg-indigo-700 text-white hover:bg-indigo-800" : "border border-slate-200 bg-white text-slate-700 hover:border-indigo-200 hover:text-indigo-700"} px-4 py-2.5 text-sm font-semibold" %>
      </article>
    <% end %>
  </div>
</section>
