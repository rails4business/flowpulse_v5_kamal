<% active_item = local_assigns.fetch(:active_item, @dashboard_view) %>
<% course_path = posturacorretta_course_path(corso: "postura-corretta-in-un-mese", vista: "capitoli") %>
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto grid h-16 max-w-screen-xl grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 px-4 sm:px-6 lg:px-8">
    <%= link_to posturacorretta_path, class: "flex shrink-0 items-center", aria: { label: "Torna alla home PosturaCorretta" } do %>
      <img src="https://ik.imagekit.io/posturacorretta/logo_pc_scontornato.png?updatedAt=1747975596766" alt="PosturaCorretta" class="hidden h-7 w-auto sm:block">
      <img src="https://ik.imagekit.io/posturacorretta/Sassi-icona-cerchio-bianco.png?updatedAt=1785386494945" alt="" class="size-9 rounded-full bg-blue-600 object-cover sm:hidden">
    <% end %>

    <nav class="flex min-w-0 items-center justify-center gap-1 sm:gap-4" aria-label="Navigazione dashboard PosturaCorretta">
      <%= link_to "Percorso", course_path, aria: { current: ("page" if active_item == :percorso) }, class: ["border-b-2 px-2 py-2 text-xs font-bold transition sm:px-1 sm:text-sm", active_item == :percorso ? "border-blue-600 text-slate-950" : "border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950"] %>
      <% { "programma" => ["Programma lezioni", posturacorretta_student_dashboard_path], "calendario" => ["Appuntamenti", posturacorretta_student_appointments_path] }.each do |view, (label, path)| %>
        <% active = active_item == view %>
        <%= link_to label, path,
          aria: { current: ("page" if active) },
          class: ["border-b-2 px-2 py-2 text-xs font-bold transition sm:px-1 sm:text-sm", active ? "border-blue-600 text-slate-950" : "border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950"] %>
      <% end %>
    </nav>

    <div class="shrink-0"><%= render "posturacorretta/account_nav" %></div>
  </div>
</header>
