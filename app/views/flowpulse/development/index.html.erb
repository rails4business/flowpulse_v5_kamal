<% content_for :title, "Sviluppo — Flowpulse" %>
<% status_labels = { "proposed" => "Proposta", "approved" => "Approvata", "in_progress" => "In sviluppo", "verified" => "Verificata", "deployed" => "Distribuita", "paused" => "In pausa" } %>

<main class="min-h-screen bg-white text-slate-950">
  <%= render "landing/flowpulse_nav" %>

  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-12">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-amber-700">Superadmin · registro interno</p>
      <h1 class="mt-3 text-4xl font-black tracking-[-0.04em] sm:text-5xl">Sviluppo</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Le schede descrivono ciò che intendiamo implementare. I changelog dei Brand raccontano invece soltanto ciò che è stato completato e verificato.</p>
      <a href="https://github.com/rails4business/flowpulse_v5_kamal" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm font-black text-blue-700 hover:text-blue-900">
        Repository Flowpulse su GitHub <span aria-hidden="true">↗</span>
      </a>

      <%= form_with url: flowpulse_development_path, method: :get, class: "mt-7 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |form| %>
        <div>
          <%= form.label :brand, "Brand responsabile", class: "text-xs font-black uppercase tracking-wide text-slate-500" %>
          <%= form.select :brand, options_for_select(@development_brands.map { |brand| [brand.fetch("label"), brand.fetch("key")] }, @selected_brand), { include_blank: "Tutti i Brand" }, class: "mt-1.5 w-full rounded-xl border-slate-300 bg-white text-sm" %>
        </div>
        <div>
          <%= form.label :status, "Stato", class: "text-xs font-black uppercase tracking-wide text-slate-500" %>
          <%= form.select :status, options_for_select(@development_statuses.map { |status| [status_labels.fetch(status), status] }, @selected_status), { include_blank: "Tutti gli stati" }, class: "mt-1.5 w-full rounded-xl border-slate-300 bg-white text-sm" %>
        </div>
        <div class="flex gap-2"><%= form.submit "Filtra", class: "cursor-pointer rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-black text-white" %><%= link_to "Azzera", flowpulse_development_path, class: "rounded-xl px-4 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100" %></div>
      <% end %>
    </div>
  </header>

  <div class="mx-auto max-w-6xl space-y-12 px-5 py-10 sm:px-8 sm:py-14">
    <% if @development_groups.any? %>
      <% @development_groups.each do |brand, entries| %>
        <section aria-labelledby="development-<%= brand.fetch("key") %>">
          <div class="mb-5 flex items-end justify-between gap-4 border-b border-slate-200 pb-3">
            <div><p class="text-xs font-black uppercase tracking-[0.16em] text-blue-700">Brand responsabile</p><h2 id="development-<%= brand.fetch("key") %>" class="mt-1 text-2xl font-black"><%= brand.fetch("label") %></h2></div>
            <span class="text-sm font-bold text-slate-400"><%= pluralize(entries.size, "scheda", "schede") %></span>
          </div>
          <div class="grid gap-4 lg:grid-cols-2">
            <% entries.each do |entry| %>
              <%= link_to flowpulse_development_entry_path(entry.fetch("slug")), class: "group rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300 hover:bg-blue-50/40 sm:p-6" do %>
                <article>
                  <div class="flex flex-wrap items-center justify-between gap-3"><span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-black text-amber-800"><%= status_labels.fetch(entry.fetch("status")) %></span><time datetime="<%= entry.fetch("updated_on") %>" class="text-xs font-bold text-slate-400">Aggiornata <%= I18n.l(entry.fetch("updated_on_value"), format: :long) %></time></div>
                  <h3 class="mt-4 text-xl font-black group-hover:text-blue-700"><%= entry.fetch("title") %></h3>
                  <p class="mt-3 text-sm leading-6 text-slate-600"><%= entry.fetch("summary") %></p>
                  <div class="mt-5 flex flex-wrap gap-1.5"><% entry.fetch("tags").first(4).each do |tag| %><span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-500"><%= tag.humanize %></span><% end %></div>
                </article>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    <% else %>
      <p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-500">Nessuna scheda corrisponde ai filtri selezionati.</p>
    <% end %>
  </div>
</main>
