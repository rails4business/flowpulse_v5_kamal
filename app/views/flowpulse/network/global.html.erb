<% content_for :title, "Rete globale dei Node — FlowPulse" %>
<% content_for :description, "Esplora i Node FlowPulse, i collegamenti gerarchici, i ponti e i domini associati." %>

<%
  nodes_by_id = @network_nodes.index_by(&:id)
  active_domains_by_node_id = @network_nodes.to_h { |node| [node.id, node.domains.select(&:active?)] }
  ancestry_for = lambda do |node|
    ancestry = []
    current = node
    while current && !ancestry.include?(current)
      ancestry << current
      current = nodes_by_id[current.parent_id]
    end
    ancestry
  end
  modes_for = lambda do |node|
    next %w[brand professional] if node.slug == "flowpulse"

    ancestry = ancestry_for.call(node)
    modes = []
    modes << "professional" if ancestry.any?(&:professional?)
    modes << "professional" if ancestry.any? { |ancestor| ancestor.professional_owner_node_id.present? }
    modes << "brand" if ancestry.any? do |ancestor|
      ancestor.project? && active_domains_by_node_id.fetch(ancestor.id, []).any?
    end
    modes << "brand" if modes.empty?
    modes.uniq
  end
  effective_map_color_for = lambda do |node|
    current = node
    visited = Set.new
    while current && !visited.include?(current.id)
      return current.map_color.upcase if current.map_color.present?

      visited << current.id
      current = nodes_by_id[current.parent_id]
    end
    nil
  end
  domain_context_for = lambda do |node|
    ancestry_for.call(node).each do |ancestor|
      domain = active_domains_by_node_id.fetch(ancestor.id, []).sort_by(&:display_hostname).first
      next if domain.blank?

      return {
        key: domain.display_hostname,
        label: domain.display_hostname,
        owner_slug: ancestor.slug,
        color: effective_map_color_for.call(ancestor) || "#64748B"
      }
    end
    nil
  end
  color_text_for = lambda do |hex|
    red, green, blue = hex.delete_prefix("#").scan(/../).map { |value| value.to_i(16) }
    ((red * 299 + green * 587 + blue * 114) / 1000) >= 150 ? "#172033" : "#FFFFFF"
  end
  light_background_for = lambda do |hex|
    channels = hex.delete_prefix("#").scan(/../).map { |value| value.to_i(16) }
    mixed = channels.map { |channel| (channel + (255 - channel) * 0.88).round }
    "##{mixed.map { |channel| channel.to_s(16).rjust(2, "0") }.join.upcase}"
  end

  hidden_bridge_view_types = %w[access_bridge backlink_bridge]
  selected_node = @network_nodes.find { |node| node.slug == params[:node] }
  selected_node = nil if selected_node&.slug == "flowpulse" || hidden_bridge_view_types.include?(selected_node&.view_type)
  automatic_center = @automatic_center == true
  selected_mode = if %w[brand professional].include?(params[:vista])
    params[:vista]
  elsif selected_node && !modes_for.call(selected_node).include?("brand")
    "professional"
  else
    "brand"
  end
  selected_node = nil if selected_node && !modes_for.call(selected_node).include?(selected_mode)
  if automatic_center
    selected_node ||= @network_nodes.find { |node| node.slug == "flowpulse" }
    selected_node ||= @network_nodes.find { |node| !hidden_bridge_view_types.include?(node.view_type) && modes_for.call(node).include?(selected_mode) }
  end

  display_network_nodes = @network_nodes.reject { |node| hidden_bridge_view_types.include?(node.view_type) }
  graph_nodes = display_network_nodes.map do |node|
    can_manage = @manageable_role_assignment_ids.include?(node.role_assignment_id)
    can_delete = can_manage && active_domains_by_node_id.fetch(node.id, []).empty? && node.children.empty?
    map_color = effective_map_color_for.call(node)
    map_background = map_color ? light_background_for.call(map_color) : nil
    domain_context = domain_context_for.call(node)
    {
      data: {
        id: "node-#{node.id}",
        slug: node.slug,
        label: node.title,
        kind: "node",
        nodeTypeLabel: if node.professional?
          active_domains_by_node_id.fetch(node.id, []).any? ? "Professional Brand" : "Professional"
        elsif active_domains_by_node_id.fetch(node.id, []).any?
          "Brand"
        else
          "Project Node"
        end,
        viewType: node.view_type,
        description: node.description.to_s,
        position: node.position,
        hasMapColor: map_color.present?,
        mapColor: map_color,
        mapBackground: map_background,
        mapTextColor: map_background ? color_text_for.call(map_background) : nil,
        mapSelectedTextColor: map_color ? color_text_for.call(map_color) : nil,
        url: node_path(node),
        canManage: can_manage,
        canDelete: can_delete,
        newChildUrl: can_manage && !node.bridge_node? ? new_creator_world_role_assignment_node_path(node.role_assignment_id, parent_id: node.id) : nil,
        deleteUrl: can_delete ? flowpulse_global_network_node_path(node, vista: selected_mode) : nil,
        modes: modes_for.call(node),
        domains: node.domains.select(&:active?).map(&:display_hostname).sort,
        hasDomain: node.domains.any?(&:active?),
        domainKey: domain_context&.fetch(:key),
        domainLabel: domain_context&.fetch(:label),
        domainOwnerSlug: domain_context&.fetch(:owner_slug),
        domainColor: domain_context&.fetch(:color)
      }
    }
  end

  visible_ids = display_network_nodes.map(&:id).to_set
  flowpulse_node = @network_nodes.find { |node| node.slug == "flowpulse" }
  graph_edges = display_network_nodes.filter_map do |node|
    # Nella mappa globale FlowPulse è il contenitore dell'ecosistema, non un
    # progetto figlio del professionista che ne cura l'implementazione.
    next if node == flowpulse_node
    next if node.parent_id.blank? || !visible_ids.include?(node.parent_id)
    { data: { id: "parent-#{node.parent_id}-#{node.id}", source: "node-#{node.parent_id}", target: "node-#{node.id}", kind: "hierarchy" } }
  end
  if flowpulse_node
    ecosystem_roots = @network_nodes.select { |node| node != flowpulse_node && node.parent_id.blank? }
    graph_edges.concat(ecosystem_roots.map do |node|
      { data: { id: "ecosystem-#{flowpulse_node.id}-#{node.id}", source: "node-#{flowpulse_node.id}", target: "node-#{node.id}", kind: "ecosystem" } }
    end)
  end
  graph_edges.concat(@network_nodes.filter_map do |node|
    next if node.link_node_id.blank? || !visible_ids.include?(node.link_node_id)
    source = hidden_bridge_view_types.include?(node.view_type) ? node.parent : node
    next if source.blank? || !visible_ids.include?(source.id)
    visibility = node.view_type == "backlink_bridge" ? "target" : "both"
    { data: { id: "bridge-#{node.id}-#{node.link_node_id}", source: "node-#{source.id}", target: "node-#{node.link_node_id}", kind: "bridge", bridgeVisibility: visibility } }
  end)
  graph_edges.concat(@network_nodes.filter_map do |node|
    owner = node.professional_owner_node
    next if owner.blank? || !visible_ids.include?(owner.id) || !visible_ids.include?(node.id) || owner == node.parent
    { data: { id: "professional-owner-#{owner.id}-#{node.id}", source: "node-#{owner.id}", target: "node-#{node.id}", kind: "professional-owner" } }
  end)

  graph = { elements: graph_nodes + graph_edges }

  directory_nodes = @network_nodes.select do |node|
    active_domains_by_node_id.fetch(node.id, []).any? &&
      (selected_mode == "professional" ? node.professional? : node.project?)
  end
  platform_brand_slugs = %w[flowpulse generaimpresa rails4business impegno]
  directory_groups = if selected_mode == "brand"
    platform_nodes = directory_nodes.select { |node| platform_brand_slugs.include?(node.slug) }
      .sort_by { |node| platform_brand_slugs.index(node.slug) }
    network_nodes = directory_nodes.reject { |node| platform_brand_slugs.include?(node.slug) }
      .sort_by { |node| [node.title.downcase, node.id] }
    [
      ["Strumenti FlowPulse", "Servizi trasversali per ideare, realizzare e organizzare i progetti.", platform_nodes, "bg-blue-50 text-blue-800"],
      ["Brand della rete", "Progetti e mondi dotati di un proprio dominio.", network_nodes, "bg-slate-50 text-slate-700"]
    ].reject { |group| group[2].empty? }
  else
    [["Professional Brand", "Identità professionali dotate di un proprio dominio.", directory_nodes.sort_by { |node| [node.title.downcase, node.id] }, "bg-violet-50 text-violet-800"]]
  end
%>

<main class="min-h-screen bg-slate-50 text-slate-950">
  <%= render "landing/flowpulse_nav" if selected_node.blank? %>

  <% if selected_node.blank? %>
    <section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-5 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[.16em] text-blue-700">Rete FlowPulse</p>
          <h1 class="mt-2 text-3xl font-black tracking-tight"><%= selected_mode == "professional" ? "Professional Brand" : "Brand" %></h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Seleziona un Node per esplorarne la rete, i progetti collegati e i ponti.</p>
        </div>
        <div class="flex rounded-xl bg-slate-200 p-1" aria-label="Tipo di rete">
          <%= link_to "Brand", flowpulse_global_network_path(vista: "brand"), class: "rounded-lg px-4 py-2 text-sm font-black #{selected_mode == "brand" ? "bg-blue-600 text-white shadow-sm" : "text-slate-600 hover:bg-white"}" %>
          <%= link_to "Professional Brand", flowpulse_global_network_path(vista: "professional"), class: "rounded-lg px-4 py-2 text-sm font-black #{selected_mode == "professional" ? "bg-blue-600 text-white shadow-sm" : "text-slate-600 hover:bg-white"}" %>
        </div>
      </div>

      <% if directory_nodes.any? %>
        <div class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-left">
              <thead class="bg-slate-100 text-[11px] font-black uppercase tracking-[.12em] text-slate-500">
                <tr>
                  <th scope="col" class="px-5 py-3.5">Node</th>
                  <th scope="col" class="px-5 py-3.5">Domini associati</th>
                  <th scope="col" class="w-32 px-5 py-3.5 text-right"><span class="sr-only">Azioni</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% directory_groups.each do |label, description, nodes, group_class| %>
                  <tr class="<%= group_class %>">
                    <th colspan="3" scope="rowgroup" class="px-5 py-3 text-left">
                      <span class="text-xs font-black uppercase tracking-[.12em]"><%= label %></span>
                      <span class="ml-2 text-xs font-medium normal-case tracking-normal opacity-75"><%= description %></span>
                    </th>
                  </tr>
                  <% nodes.each do |node| %>
                    <% domains = active_domains_by_node_id.fetch(node.id, []).sort_by(&:display_hostname) %>
                    <tr class="transition hover:bg-blue-50/60">
                      <th scope="row" class="px-5 py-4">
                        <%= link_to node.title, flowpulse_global_network_path(vista: selected_mode, node: node.slug), class: "font-black text-slate-950 hover:text-blue-700" %>
                      </th>
                      <td class="px-5 py-4">
                        <ul class="space-y-1">
                          <% domains.each do |domain| %>
                            <li class="text-sm font-semibold text-slate-600"><%= domain.display_hostname %></li>
                          <% end %>
                        </ul>
                      </td>
                      <td class="px-5 py-4 text-right">
                        <%= link_to "Apri rete →", flowpulse_global_network_path(vista: selected_mode, node: node.slug), class: "inline-flex whitespace-nowrap rounded-lg px-3 py-2 text-xs font-black text-blue-700 hover:bg-blue-100", aria: { label: "Apri la rete di #{node.title}" } %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <div class="mt-7 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center text-sm text-slate-500">Nessun <%= selected_mode == "professional" ? "Professional Brand" : "Brand" %> pubblicato.</div>
      <% end %>
    </section>
  <% else %>
  <div
    class="w-full"
    data-controller="node-network"
    data-node-network-graph-value="<%= json_escape(graph.to_json) %>"
    data-node-network-selected-value="node-<%= selected_node.id %>"
    data-node-network-mode-value="<%= selected_mode %>"
    data-node-network-automatic-center-value="<%= automatic_center %>"
    data-node-network-fixed-center-value="<%= automatic_center && params[:node].present? %>"
  >
    <section data-node-network-target="stage" class="relative w-full overflow-hidden bg-slate-50" style="height: 100vh; min-height: 620px;" aria-label="Mappa dei Node">
      <div data-node-network-target="canvas" class="absolute inset-0 z-[2] h-full w-full" aria-label="Grafo interattivo dei Node"></div>
      <svg data-node-network-target="orbitOverlay" class="pointer-events-none absolute inset-0 z-[1] size-full overflow-visible" aria-hidden="true"></svg>

      <button type="button" data-node-network-target="panelButton" data-action="node-network#togglePanel" class="absolute left-3 top-3 z-10 grid size-11 place-items-center rounded-xl border border-slate-200 bg-white text-lg font-black text-slate-700 shadow-lg shadow-slate-900/10 hover:bg-slate-50 sm:left-5 sm:top-5" aria-label="Apri pannello della rete" aria-expanded="true" title="Pannello della rete">☰</button>

      <nav data-node-network-target="breadcrumb" class="pointer-events-auto absolute left-16 right-3 top-3 z-10 ml-auto flex max-w-max items-start overflow-x-auto rounded-2xl border border-slate-200 bg-white/95 px-3 py-2 shadow-lg shadow-slate-900/10 backdrop-blur sm:right-5 sm:top-5" aria-label="Percorso del Node"></nav>

      <aside data-node-network-target="drawer" class="absolute inset-y-0 left-0 z-20 h-full w-[calc(100%-3.5rem)] overflow-y-auto rounded-r-2xl border-y-0 border-l-0 border-r border-slate-200 bg-white p-4 shadow-2xl shadow-slate-900/20 transition-transform duration-200 sm:w-[390px] sm:p-5">
        <div class="sticky top-0 z-30 flex h-0 justify-end">
          <button type="button" data-action="node-network#closeDetails" class="grid size-9 shrink-0 place-items-center rounded-full border border-slate-200 bg-white text-lg text-slate-600 shadow-sm hover:bg-slate-100" aria-label="Chiudi pannello">×</button>
        </div>

        <div class="flex items-start gap-3 border-b border-slate-100 pb-4 pr-11">
          <%= render "landing/flowpulse_nav", vertical: true %>
        </div>

        <div class="mt-4 flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
          <label class="sr-only" for="node-network-search">Cerca un Node</label>
          <svg class="size-4 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
          <input id="node-network-search" data-node-network-target="search" data-action="keydown->node-network#search change->node-network#search" list="node-network-options" type="search" placeholder="Cerca un Node…" class="min-w-0 flex-1 border-0 bg-transparent px-1 py-1.5 text-sm outline-none">
          <datalist id="node-network-options"><% display_network_nodes.each do |node| %><option value="<%= node.title %>"></option><% end %></datalist>
          <%= link_to "← Elenco", flowpulse_global_network_path(vista: selected_mode), class: "shrink-0 rounded-lg bg-slate-100 px-3 py-2 text-[11px] font-black text-slate-700 hover:bg-slate-200" %>
        </div>

        <% if Current.user&.superadmin_user? %>
          <a href="http://www.posturacorretta.org/posturacorretta-flusso-ingresso-percorsi.html" target="_blank" rel="noopener noreferrer" class="mt-2 flex items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-[10px] font-black text-amber-800 hover:bg-amber-100">
            <span>Appunto · Schema completo PosturaCorretta</span><span aria-hidden="true">↗</span>
          </a>
        <% end %>

        <div class="mt-3 flex flex-wrap items-center gap-1 rounded-xl bg-slate-100 p-1.5">
          <button type="button" data-action="node-network#zoomIn" class="grid size-8 shrink-0 place-items-center rounded-lg text-lg font-bold text-slate-700 hover:bg-slate-100" aria-label="Ingrandisci" title="Ingrandisci">+</button>
          <button type="button" data-action="node-network#zoomOut" class="grid size-8 shrink-0 place-items-center rounded-lg text-lg font-bold text-slate-700 hover:bg-slate-100" aria-label="Riduci" title="Riduci">−</button>
          <button type="button" data-action="node-network#recenter" class="grid size-8 shrink-0 place-items-center rounded-lg text-lg font-black text-blue-700 hover:bg-blue-50" aria-label="Centra la vista sul Node selezionato" title="Centra la vista">⌖</button>
          <button type="button" data-node-network-target="fullscreenButton" data-action="node-network#toggleFullscreen" class="grid size-8 shrink-0 place-items-center rounded-lg text-lg font-black text-slate-700 hover:bg-slate-100" aria-label="Visualizza a schermo intero" title="Schermo intero">⛶</button>
          <span class="mx-1 h-6 w-px shrink-0 bg-slate-300" aria-hidden="true"></span>
          <div class="relative flex h-14 w-7 shrink-0 items-center justify-center px-1" title="Livelli visibili">
            <input type="range" min="1" max="6" step="1" value="<%= automatic_center ? 2 : 3 %>" data-node-network-target="depthRange" data-action="input->node-network#setDepthFromRange" class="h-12 w-4 cursor-pointer accent-violet-700" style="writing-mode: vertical-lr; direction: rtl;" aria-label="Numero di livelli visibili; ultima posizione tutti">
            <output data-node-network-target="depthLabel" class="pointer-events-none absolute left-full top-1/2 z-10 ml-1 min-w-7 -translate-y-1/2 rounded-md bg-violet-800 px-1.5 py-1 text-center text-[9px] font-black text-white opacity-0 shadow-lg transition-opacity"><%= automatic_center ? "2" : "3" %></output>
          </div>
          <span class="mx-1 h-6 w-px shrink-0 bg-slate-300" aria-hidden="true"></span>
          <% if automatic_center %>
            <%= link_to flowpulse_global_network_path(vista: selected_mode, node: params[:node]), data: { node_network_target: "centerModeLink" }, class: "ml-auto flex shrink-0 items-center gap-2 rounded-lg bg-violet-50 px-2.5 py-1.5 text-[11px] font-black text-violet-800 hover:bg-violet-100", aria: { label: "Mostra tutta la rete" }, title: "Passa alla vista All" do %>
              <span>Vista</span><span class="rounded-full bg-violet-700 px-2 py-0.5 text-[9px] text-white">ONLY NODE</span>
            <% end %>
          <% else %>
            <%= link_to flowpulse_automatic_network_path(vista: selected_mode, node: selected_node.slug), data: { node_network_target: "centerModeLink" }, class: "ml-auto flex shrink-0 items-center gap-2 rounded-lg px-2.5 py-1.5 text-[11px] font-black text-slate-600 hover:bg-violet-50 hover:text-violet-800", aria: { label: "Mostra soltanto la rete del Node" }, title: "Passa alla vista Only node" do %>
              <span>Vista</span><span class="rounded-full bg-slate-200 px-2 py-0.5 text-[9px] text-slate-600">ALL</span>
            <% end %>
          <% end %>
        </div>

        <div class="mt-2 flex items-center justify-between gap-3 px-1">
            <p data-node-network-target="nodeLimitNotice" hidden class="text-xs font-bold text-amber-700"></p>
            <button type="button" data-node-network-target="expandNodesButton" data-action="node-network#expandNodeLimit" hidden class="ml-auto rounded-lg bg-amber-50 px-2.5 py-1.5 text-[10px] font-black text-amber-800 hover:bg-amber-100">Mostra altri 20</button>
        </div>

        <div class="mt-5 flex items-start justify-between gap-4 border-t border-slate-100 pt-5">
          <div>
            <p data-node-network-target="type" class="text-xs font-black uppercase tracking-[.16em] text-blue-700">FlowPulse</p>
            <h1 data-node-network-target="title" class="mt-2 text-2xl font-black tracking-tight">Tutta la rete</h1>
          </div>
        </div>

        <p data-node-network-target="description" class="mt-4 text-sm leading-6 text-slate-600">Seleziona un Node per vedere domini e collegamenti diretti.</p>
        <p data-node-network-target="relation" class="mt-4 text-xs font-black text-emerald-700"></p>

        <div class="mt-6 border-t border-slate-100 pt-5">
          <h2 class="text-[10px] font-black uppercase tracking-[.14em] text-slate-400">Domini associati</h2>
          <ul data-node-network-target="domains" class="mt-2 space-y-1 text-sm font-bold text-slate-700"></ul>
          <p data-node-network-target="empty" class="mt-2 text-sm text-slate-400">Nessun Node selezionato</p>
        </div>

        <div class="mt-7 flex items-center gap-2">
          <a data-node-network-target="openLink" href="#" class="min-w-0 flex-1 rounded-xl px-4 py-3 text-center text-sm font-black text-white hover:opacity-90" style="background-color: #2563eb; color: #ffffff;">Apri il Node →</a>
          <a data-node-network-target="addLink" href="#" hidden class="grid size-11 shrink-0 place-items-center rounded-xl border border-emerald-200 bg-emerald-50 text-xl font-black text-emerald-700 hover:bg-emerald-100" title="Aggiungi un Project Node figlio" aria-label="Aggiungi un Project Node figlio">＋</a>
          <a data-node-network-target="deleteLink" href="#" hidden data-turbo-method="delete" class="grid size-11 shrink-0 place-items-center rounded-xl border border-red-200 bg-red-50 text-xl font-black text-red-700 hover:bg-red-100" title="Elimina Node" aria-label="Elimina Node">−</a>
        </div>
      </aside>

      <div class="pointer-events-none absolute bottom-4 left-4 z-10 hidden items-center gap-4 rounded-xl border border-slate-200 bg-white/90 px-4 py-2 text-[10px] font-black uppercase tracking-[.1em] text-slate-500 shadow-lg backdrop-blur sm:flex" aria-label="Legenda delle relazioni">
        <span class="flex items-center gap-1.5"><span class="h-1 w-5 rounded-full bg-blue-600"></span>Gerarchia</span>
        <% if automatic_center %><span class="flex items-center gap-1.5"><span class="h-1 w-5 rounded-full bg-violet-600"></span>Ponte</span><% end %>
        <% if selected_mode == "professional" %><span class="flex items-center gap-1.5"><span class="h-1 w-5 rounded-full bg-emerald-600"></span>Professional</span><% end %>
      </div>

    </section>
  </div>
  <% end %>
</main>
