<% content_for :title, "La mia rete — Flowpulse" %>
<% content_for :description, "Brand professionali, Brand progetto e collaborazioni collegate al tuo profilo." %>

<main class="min-h-screen bg-slate-50 text-slate-950">
  <%= render "landing/flowpulse_nav" %>
  <header class="border-b border-blue-100 bg-gradient-to-br from-blue-50 via-white to-violet-50">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8 sm:py-14"><p class="text-xs font-black uppercase tracking-[.2em] text-blue-700">FlowPulse personale</p><h1 class="mt-3 text-4xl font-black tracking-[-.045em] sm:text-5xl">La mia rete</h1><p class="mt-4 max-w-2xl leading-7 text-slate-600">I tuoi Brand con dominio. Apri un Brand progetto per vedere il suo albero interno.</p></div>
  </header>

  <div class="mx-auto max-w-5xl space-y-10 px-5 py-10 sm:px-8">
    <section class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-7" aria-labelledby="professional-brands-title">
      <div class="flex items-end justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-[.16em] text-violet-700">La mia struttura</p><h2 id="professional-brands-title" class="mt-1 text-2xl font-black">Brand professionali e Brand progetto</h2></div><span class="text-sm font-bold text-slate-400"><%= @professional_brands.size + @owned_brands.size %></span></div>
      <ul class="mt-6 space-y-5" aria-label="Albero dei Brand personali">
        <% @professional_brands.each do |professional| %>
          <% projects = @owned_brands_by_professional_id.fetch(professional.id, []) %>
          <li>
            <div class="flex min-w-0 items-center gap-3 rounded-xl px-2 py-2 hover:bg-violet-50"><span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-violet-100 text-xs font-black text-violet-700">P</span><%= link_to brand_admin_nodes_path(professional.slug), class: "min-w-0 flex-1" do %><strong class="block truncate text-base text-slate-950"><%= professional.title %></strong><span class="block truncate text-xs text-slate-500"><%= professional.domains.map(&:hostname).to_sentence %></span><% end %></div>
            <% if projects.any? %><ul class="ml-5 border-l border-slate-200 pl-5" aria-label="Brand progetto di <%= professional.title %>"><% projects.each do |brand| %><li class="relative"><span class="absolute -left-5 top-5 w-4 border-t border-slate-200" aria-hidden="true"></span><%= link_to brand_admin_nodes_path(brand.slug), class: "block rounded-xl px-3 py-3 hover:bg-blue-50" do %><strong class="block text-sm text-slate-900"><%= brand.title %></strong><span class="mt-0.5 block text-xs text-slate-500"><%= brand.domains.map(&:hostname).to_sentence %></span><% end %></li><% end %></ul><% end %>
          </li>
        <% end %>
        <% if @professional_brands.empty? %><li class="rounded-xl border border-dashed border-slate-300 p-5 text-sm text-slate-500">Non hai ancora un Brand professionale con dominio.</li><% end %>
      </ul>
      <% if @unassigned_owned_brands.any? %><div class="mt-7 border-t border-slate-200 pt-6"><h3 class="text-sm font-black text-slate-700">Altri Brand posseduti</h3><ul class="mt-3 divide-y divide-slate-100"><% @unassigned_owned_brands.each do |brand| %><li><%= link_to brand_admin_nodes_path(brand.slug), class: "flex items-center gap-3 rounded-lg px-2 py-3 hover:bg-blue-50" do %><span class="text-slate-300">└</span><span class="min-w-0"><strong class="block text-sm"><%= brand.title %></strong><span class="block truncate text-xs text-slate-500"><%= brand.domains.map(&:hostname).to_sentence %></span></span><% end %></li><% end %></ul></div><% end %>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-7" aria-labelledby="administered-brands-title"><div class="flex items-end justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-[.16em] text-emerald-700">Gestione delegata</p><h2 id="administered-brands-title" class="mt-1 text-xl font-black">Brand amministrati</h2></div><span class="text-sm font-bold text-slate-400"><%= @administered_brands.size %></span></div><ul class="mt-4 divide-y divide-slate-100"><% @administered_brands.each do |brand| %><li><%= link_to brand_admin_nodes_path(brand.slug), class: "flex items-center justify-between gap-4 rounded-lg px-2 py-3 hover:bg-emerald-50" do %><span class="min-w-0"><strong class="block text-sm"><%= brand.title %></strong><span class="block truncate text-xs text-slate-500"><%= brand.domains.map(&:hostname).to_sentence %></span></span><span class="shrink-0 text-xs font-black text-emerald-700">Amministratore</span><% end %></li><% end %><% if @administered_brands.empty? %><li class="py-3 text-sm text-slate-400">Nessun altro Brand amministrato.</li><% end %></ul></section>

    <section class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-7" aria-labelledby="collaborations-title"><div class="flex items-end justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-[.16em] text-amber-700">Ruoli operativi</p><h2 id="collaborations-title" class="mt-1 text-xl font-black">Collaborazioni</h2></div><span class="text-sm font-bold text-slate-400"><%= @collaboration_assignments.size %></span></div><ul class="mt-4 divide-y divide-slate-100"><% @collaboration_assignments.each do |assignment| %><li><%= link_to node_path(assignment.context), class: "flex items-center justify-between gap-4 rounded-lg px-2 py-3 hover:bg-amber-50" do %><span class="min-w-0"><strong class="block text-sm"><%= assignment.context.title %></strong><span class="block truncate text-xs text-slate-500"><%= assignment.context.domains.map(&:hostname).to_sentence %></span></span><span class="shrink-0 text-xs font-black text-amber-700"><%= assignment.role_operator.to_s.humanize.presence || "Operatore" %></span><% end %></li><% end %><% if @collaboration_assignments.empty? %><li class="py-3 text-sm text-slate-400">Nessuna collaborazione collegata al profilo.</li><% end %></ul></section>

    <% if Current.user.superadmin_user? %><aside class="flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-slate-950 p-5 text-white"><div><h2 class="font-black">Vista superadmin</h2><p class="mt-1 text-sm text-slate-300">Il registro completo rimane separato dalla rete personale.</p></div><%= link_to "Mappa globale →", flowpulse_admin_brands_path, class: "rounded-full bg-blue-500 px-4 py-2 text-sm font-black text-white hover:bg-blue-400" %></aside><% end %>
  </div>
</main>
