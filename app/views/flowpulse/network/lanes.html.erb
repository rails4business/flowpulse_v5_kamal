<% content_for :title, "Rete a corsie — FlowPulse" %>
<% content_for :description, "Esplora domini, Node e collegamenti FlowPulse attraverso colonne progressive." %>
<% content_for :head do %>
  <style>
    .node-lanes-map { height: calc(100vh - 45px); }
    .node-lanes-column { min-height: calc(100vh - 45px); }
    .node-lanes-card--vertical::before {
      content: "";
      position: absolute;
      bottom: 100%;
      left: 50%;
      height: 1.5rem;
      border-left: 1px solid #cbd5e1;
    }
    @media (max-width: 640px) {
      .node-lanes-map { height: calc(100vh - 82px); }
      .node-lanes-column { min-height: calc(100vh - 82px); }
    }
  </style>
<% end %>

<main
  class="h-screen overflow-hidden bg-white text-slate-800"
  data-controller="node-lanes"
  data-node-lanes-nodes-value="<%= json_escape(@lane_nodes.to_json) %>"
  data-node-lanes-relations-value="<%= json_escape(@lane_relations.to_json) %>"
  data-node-lanes-selected-value="<%= @lane_selected&.slug %>"
  data-node-lanes-open-value="<%= @lane_open_slugs.join(',') %>"
>
  <h1 class="sr-only">Vista a corsie della rete FlowPulse</h1>

  <header class="flex min-h-11 flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-white px-2 py-1.5 sm:px-3">
    <div class="flex min-w-0 flex-1 items-center gap-2">
      <span class="hidden text-[10px] font-black uppercase tracking-[.12em] text-slate-400 sm:inline">Corsie</span>
      <label class="min-w-0 max-w-md flex-1">
        <span class="sr-only">Dominio iniziale</span>
        <select data-node-lanes-target="domainSelect" data-action="change->node-lanes#changeDomain" class="h-8 w-full truncate border border-slate-300 bg-white px-2 text-xs font-semibold text-slate-700 outline-none focus:border-blue-500">
          <% @lane_domains.each do |node| %>
            <option value="<%= node.slug %>" <%= "selected" if node == @lane_selected %>><%= node.title %> · <%= node.domains.select(&:active?).map(&:display_hostname).sort.join(", ") %></option>
          <% end %>
        </select>
      </label>
      <p data-node-lanes-target="status" class="hidden whitespace-nowrap text-[10px] text-slate-400 lg:block"></p>
    </div>

    <nav class="flex shrink-0 items-center gap-1 text-[11px] font-bold" aria-label="Viste della rete">
      <%= link_to "Centralità", flowpulse_automatic_network_node_path("all", @lane_selected&.slug || "flowpulse", vista: @lane_mode), class: "border border-slate-300 px-2.5 py-1.5 text-slate-600 hover:bg-slate-50" %>
      <%= link_to "Elenco", flowpulse_global_network_path(vista: @lane_mode), class: "border border-slate-700 bg-slate-800 px-2.5 py-1.5 text-white hover:bg-slate-700" %>
    </nav>
  </header>

  <section class="node-lanes-map relative overflow-hidden" aria-label="Esploratore della rete a corsie">
    <div data-node-lanes-target="viewport" data-action="scroll->node-lanes#drawConnections" class="size-full overflow-auto bg-white">
      <div data-node-lanes-target="canvas" class="flex min-h-full min-w-max items-stretch"></div>
    </div>
    <svg data-node-lanes-target="connections" class="pointer-events-none absolute inset-0 z-20 size-full overflow-hidden" aria-hidden="true"></svg>

    <div class="pointer-events-none absolute bottom-2 left-2 flex gap-3 bg-white/90 px-2 py-1 text-[9px] font-semibold text-slate-400" aria-label="Legenda">
      <span>Linea continua · gerarchia</span>
      <span class="text-violet-500">Viola · ponte</span>
      <span>Tratteggio · altro dominio</span>
    </div>
  </section>
</main>
