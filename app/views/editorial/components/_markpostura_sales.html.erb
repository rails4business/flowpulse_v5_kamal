  .mp-sales__problem{padding-block:6rem;background:#fff}.mp-sales__problem-list{margin-top:3rem;border-top:1px solid #dce2ea}.mp-sales__problem-list article{display:grid;grid-template-columns:4rem 1fr;gap:1.25rem;padding:1.7rem 0;border-bottom:1px solid #dce2ea}.mp-sales__problem-list article>span{color:#a0aabc;font-size:.8rem;font-weight:900}.mp-sales__problem-list h3{margin-bottom:.45rem;font-size:1.25rem}.mp-sales__problem-list p{margin-bottom:0;color:var(--muted);line-height:1.65}
  .mp-sales__movements{padding-block:6rem;background:#101828;color:#fff}.mp-sales__section-heading--light>p:last-child{color:#b9c3d1}.mp-sales__section-heading--light .mp-sales__eyebrow{color:#f4bf73}.mp-sales__movement-track{position:relative;display:grid;gap:0;margin:3.5rem 0 0;padding:0;list-style:none}.mp-sales__movement{position:relative;display:grid;grid-template-columns:5rem 1fr;gap:1.2rem;padding:1.7rem 0;border-top:1px solid #344054}.mp-sales__movement:last-child{border-bottom:1px solid #344054}.mp-sales__movement-number{font-weight:900}.mp-sales__movement h3{margin-bottom:.5rem;font-size:1.65rem}.mp-sales__movement p{margin:0;color:#c5ceda;line-height:1.65}.mp-sales__movement--blue .mp-sales__movement-number,.mp-sales__movement--blue h3{color:#72a7ff}.mp-sales__movement--green .mp-sales__movement-number,.mp-sales__movement--green h3{color:#71d6ac}.mp-sales__movement--red .mp-sales__movement-number,.mp-sales__movement--red h3{color:#ff8b83}
  .mp-sales__world{padding-block:7rem;background:#f7f4ed}.mp-sales__world-intro{display:grid;gap:2rem}.mp-sales__world-note{align-self:end;display:flex;gap:1rem;border-left:3px solid #7c3aed;padding-left:1rem;color:#5d526b}.mp-sales__world-note>span{font-size:1.5rem}.mp-sales__world-note p{margin:0;line-height:1.55}.mp-sales__world-map{max-width:740px;margin:4rem auto 0;text-align:center}.mp-sales__world-map a{display:block;overflow:hidden;border-radius:2.5rem;background:#fff;padding:.7rem;box-shadow:0 24px 70px rgb(64 45 89 / 16%)}.mp-sales__world-map img{display:block;width:100%;max-height:820px;border-radius:2rem;object-fit:contain}.mp-sales__world-map figcaption{margin-top:1rem;color:#746d7b;font-size:.78rem;line-height:1.55}.mp-sales__entrances{display:grid;gap:1rem;margin-top:4rem}.mp-sales__entrance{display:flex;flex-direction:column;min-height:270px;border:1px solid #d8d2c8;border-radius:1.6rem;background:#fff;padding:1.55rem;color:var(--ink)!important;text-decoration:none!important;transition:transform .18s ease,box-shadow .18s ease}.mp-sales__entrance:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgb(30 41 59 / 10%)}.mp-sales__entrance>span{font-size:.7rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.mp-sales__entrance h3{margin:.75rem 0;font-size:1.55rem}.mp-sales__entrance p{flex:1;color:var(--muted);line-height:1.6}.mp-sales__entrance strong{font-size:.85rem}.mp-sales__entrance--blue>span,.mp-sales__entrance--blue strong{color:var(--blue)}.mp-sales__entrance--green>span,.mp-sales__entrance--green strong{color:var(--green)}.mp-sales__entrance--red>span,.mp-sales__entrance--red strong{color:var(--red)}.mp-sales__inline-actions{display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:2rem;justify-content:center}.mp-sales__inline-actions--start{justify-content:flex-start}.mp-sales__inline-actions a,.mp-sales__text-link{color:#4338ca!important;font-weight:900;text-decoration:none!important}.mp-sales__inline-actions a:hover,.mp-sales__text-link:hover{text-decoration:underline!important;text-underline-offset:.3rem}
