<%
  hero = data.fetch("hero")
  problem = data.fetch("problem")
  movements = data.fetch("movements")
  world = data.fetch("world")
  paths = data.fetch("paths")
  offer = data.fetch("offer")
  about = data.fetch("about")
  contents = data.fetch("contents")
  faqs = data.fetch("faqs")
  contact = data.fetch("contact")
%>

<div class="mp-sales">
  <header id="inizia" class="mp-sales__hero scroll-mt-24">
    <div class="mp-sales__shell mp-sales__hero-grid">
      <div class="mp-sales__hero-copy">
        <p class="mp-sales__eyebrow"><%= hero.fetch("eyebrow") %></p>
        <h1><%= hero.fetch("title") %></h1>
        <div class="mp-sales__lead <%= editorial_markdown_classes %>"><%= editorial_markdown(hero.fetch("description")) %></div>
        <div class="mp-sales__actions">
          <a class="mp-sales__button mp-sales__button--primary" href="<%= hero.dig("primary_action", "href") %>"><%= hero.dig("primary_action", "label") %><span aria-hidden="true">↓</span></a>
          <a class="mp-sales__button mp-sales__button--secondary" href="<%= hero.dig("secondary_action", "href") %>"><%= hero.dig("secondary_action", "label") %><span aria-hidden="true">→</span></a>
        </div>
        <p class="mp-sales__microcopy">Puoi esplorare senza registrarti e senza scegliere subito un progetto.</p>
      </div>

      <figure class="mp-sales__hero-world">
        <span class="mp-sales__orbit mp-sales__orbit--one" aria-hidden="true"></span>
        <span class="mp-sales__orbit mp-sales__orbit--two" aria-hidden="true"></span>
        <% if hero.dig("image", "full_url").present? %><a href="<%= hero.dig("image", "full_url") %>" target="_blank" rel="noopener noreferrer"><% end %>
          <%= image_tag hero.dig("image", "url"), alt: hero.dig("image", "alt"), width: 760, height: 1110, fetchpriority: "high" %>
        <% if hero.dig("image", "full_url").present? %></a><% end %>
        <figcaption><%= hero.dig("image", "caption") || "MarkPostura" %></figcaption>
      </figure>
    </div>
  </header>

  <section id="funzione" class="mp-sales__problem scroll-mt-24">
    <div class="mp-sales__shell">
      <div class="mp-sales__section-heading">
        <p class="mp-sales__eyebrow"><%= problem.fetch("eyebrow") %></p>
        <h2><%= problem.fetch("title") %></h2>
        <p><%= problem.fetch("description") %></p>
      </div>
      <div class="mp-sales__problem-list">
        <% problem.fetch("items").each_with_index do |item, index| %>
          <article>
            <span><%= format("%02d", index + 1) %></span>
            <div><h3><%= item.fetch("title") %></h3><p><%= item.fetch("description") %></p></div>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="percorsi" class="mp-sales__movements scroll-mt-24">
    <div class="mp-sales__shell">
      <div class="mp-sales__section-heading mp-sales__section-heading--light">
        <p class="mp-sales__eyebrow"><%= movements.fetch("eyebrow") %></p>
        <h2><%= movements.fetch("title") %></h2>
        <p><%= movements.fetch("description") %></p>
      </div>
      <ol class="mp-sales__movement-track">
        <% movements.fetch("items").each do |item| %>
          <li class="mp-sales__movement mp-sales__movement--<%= item.fetch("color") %>">
            <span class="mp-sales__movement-number"><%= item.fetch("number") %></span>
            <div><h3><%= item.fetch("title") %></h3><p><%= item.fetch("description") %></p></div>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <section id="mondo-markpostura" class="mp-sales__world scroll-mt-24">
    <div class="mp-sales__shell">
      <div class="mp-sales__world-intro">
        <div class="mp-sales__section-heading">
          <p class="mp-sales__eyebrow"><%= world.fetch("eyebrow") %></p>
          <h2><%= world.fetch("title") %></h2>
          <div class="<%= editorial_markdown_classes %>"><%= editorial_markdown(world.fetch("description")) %></div>
        </div>
        <div class="mp-sales__world-note"><span aria-hidden="true">↗</span><p><strong>Una mappa viva.</strong><br>Può ampliarsi, cambiare e collegarsi ai mondi costruiti dagli altri.</p></div>
      </div>

      <figure class="mp-sales__world-map">
        <a href="<%= world.dig("image", "full_url") %>" target="_blank" rel="noopener noreferrer">
          <%= image_tag world.dig("image", "url"), alt: world.dig("image", "alt"), width: 1100, height: 1608, loading: "lazy" %>
        </a>
        <figcaption>Il mondo di MarkPostura, fotografato nel suo stato attuale. Tocca l’immagine per ingrandirla.</figcaption>
      </figure>

      <div class="mp-sales__entrances">
        <% world.fetch("entrances").each do |entrance| %>
          <a class="mp-sales__entrance mp-sales__entrance--<%= entrance.fetch("color") %>" href="<%= entrance.fetch("href") %>">
            <span><%= entrance.fetch("eyebrow") %></span>
            <h3><%= entrance.fetch("title") %></h3>
            <p><%= entrance.fetch("description") %></p>
            <strong>Entra da qui <span aria-hidden="true">→</span></strong>
          </a>
        <% end %>
      </div>

      <div class="mp-sales__inline-actions">
        <% world.fetch("actions").each do |action| %><a href="<%= action.fetch("href") %>"><%= action.fetch("label") %> <span aria-hidden="true">→</span></a><% end %>
      </div>
    </div>
  </section>

  <section class="mp-sales__paths">
    <div class="mp-sales__shell">
      <div class="mp-sales__section-heading mp-sales__section-heading--center">
        <p class="mp-sales__eyebrow"><%= paths.fetch("eyebrow") %></p>
        <h2><%= paths.fetch("title") %></h2>
        <p><%= paths.fetch("description") %></p>
      </div>
      <div class="mp-sales__path-grid">
        <% paths.fetch("items").each do |item| %>
          <article>
            <span class="mp-sales__path-icon" aria-hidden="true"><%= { "compass" => "⌖", "people" => "◎", "spark" => "✦" }.fetch(item.fetch("icon"), "•") %></span>
            <h3><%= item.fetch("title") %></h3>
            <p><%= item.fetch("description") %></p>
            <a href="<%= item.dig("action", "href") %>"><%= item.dig("action", "label") %> <span aria-hidden="true">→</span></a>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="presentazione" class="mp-sales__offer scroll-mt-24">
    <div class="mp-sales__shell mp-sales__offer-shell">
      <div class="mp-sales__offer-main">
        <p class="mp-sales__eyebrow"><%= offer.fetch("eyebrow") %></p>
        <h2><%= offer.fetch("title") %></h2>
        <div class="mp-sales__offer-description <%= editorial_markdown_classes %>"><%= editorial_markdown(offer.fetch("description")) %></div>
        <p class="mp-sales__format"><span aria-hidden="true">●</span><%= offer.fetch("format") %></p>
        <h3><%= offer.fetch("takeaways_title") %></h3>
        <ul class="mp-sales__check-list">
          <% offer.fetch("takeaways").each do |takeaway| %><li><span aria-hidden="true">✓</span><%= takeaway %></li><% end %>
        </ul>
        <div class="mp-sales__actions">
          <a class="mp-sales__button mp-sales__button--light" href="<%= offer.dig("primary_action", "href") %>"><%= offer.dig("primary_action", "label") %><span aria-hidden="true">→</span></a>
          <a class="mp-sales__button mp-sales__button--ghost" href="<%= offer.dig("secondary_action", "href") %>"><%= offer.dig("secondary_action", "label") %></a>
        </div>
      </div>
      <aside class="mp-sales__program" aria-labelledby="mp-program-title">
        <p>Circa 60 minuti</p>
        <h3 id="mp-program-title"><%= offer.fetch("program_title") %></h3>
        <ol>
          <% offer.fetch("program").each_with_index do |step, index| %>
            <li><span><%= index + 1 %></span><div><strong><%= step.fetch("title") %></strong><p><%= step.fetch("description") %></p></div></li>
          <% end %>
        </ol>
      </aside>
    </div>
  </section>

  <section class="mp-sales__about">
    <div class="mp-sales__shell mp-sales__about-grid">
      <div class="mp-sales__portrait"><%= image_tag about.dig("image", "url"), alt: about.dig("image", "alt"), width: 480, height: 600, loading: "lazy" %></div>
      <div>
        <p class="mp-sales__eyebrow"><%= about.fetch("eyebrow") %></p>
        <h2><%= about.fetch("title") %></h2>
        <div class="mp-sales__about-copy <%= editorial_markdown_classes %>"><%= editorial_markdown(about.fetch("description")) %></div>
        <div class="mp-sales__traits">
          <% about.fetch("traits").each do |trait| %><article><strong><%= trait.fetch("title") %></strong><p><%= trait.fetch("description") %></p></article><% end %>
        </div>
        <div class="mp-sales__inline-actions mp-sales__inline-actions--start">
          <% (about["actions"].presence || [about.fetch("action")]).each do |action| %><a class="mp-sales__text-link" href="<%= action.fetch("href") %>"><%= action.fetch("label") %> <span aria-hidden="true">→</span></a><% end %>
        </div>
      </div>
    </div>
  </section>

  <section id="contenuti" class="mp-sales__contents scroll-mt-24">
    <div class="mp-sales__shell">
      <div class="mp-sales__section-heading">
        <p class="mp-sales__eyebrow"><%= contents.fetch("eyebrow") %></p>
        <h2><%= contents.fetch("title") %></h2>
        <p><%= contents.fetch("description") %></p>
      </div>
      <div class="mp-sales__content-list">
        <% contents.fetch("items").each_with_index do |item, index| %>
          <a href="<%= item.fetch("href") %>"><span><%= format("%02d", index + 1) %></span><div><small><%= item.fetch("label") %></small><h3><%= item.fetch("title") %></h3><p><%= item.fetch("description") %></p></div><strong aria-hidden="true">↗</strong></a>
        <% end %>
      </div>
      <a class="mp-sales__text-link" href="<%= contents.dig("action", "href") %>"><%= contents.dig("action", "label") %> <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="mp-sales__faqs">
    <div class="mp-sales__shell mp-sales__faq-grid">
      <div class="mp-sales__section-heading">
        <p class="mp-sales__eyebrow"><%= faqs.fetch("eyebrow") %></p>
        <h2><%= faqs.fetch("title") %></h2>
      </div>
      <div class="mp-sales__faq-list">
        <% faqs.fetch("items").each_with_index do |faq, index| %>
          <details <%= "open" if index.zero? %>><summary><%= faq.fetch("question") %><span aria-hidden="true"></span></summary><p><%= faq.fetch("answer") %></p></details>
        <% end %>
      </div>
    </div>
  </section>

  <section id="lista-attesa" class="mp-sales__contact scroll-mt-24">
    <div class="mp-sales__shell">
      <div class="mp-sales__contact-card">
        <p class="mp-sales__eyebrow"><%= contact.fetch("eyebrow") %></p>
        <h2><%= contact.fetch("title") %></h2>
        <p><%= contact.fetch("description") %></p>
        <%= form_with url: public_brand_requests_path, scope: :brand_request, class: "mp-sales__waitlist" do |form| %>
          <%= form.hidden_field :brand_slug, value: "markpostura" %>
          <%= form.hidden_field :kind, value: "waitlist" %>
          <%= form.hidden_field :title, value: "Lista d’attesa · Presentazione MarkPostura" %>
          <%= form.hidden_field :return_to, value: "/markpostura#lista-attesa" %>
          <div class="mp-sales__waitlist-grid">
            <label><span>Come ti chiami?</span><%= form.text_field :name, required: true, autocomplete: "name", placeholder: "Nome" %></label>
            <label><span>La tua email</span><%= form.email_field :email, required: true, autocomplete: "email", placeholder: "nome@email.it" %></label>
          </div>
          <label><span>Che cosa vorresti far crescere? <small>Facoltativo</small></span><%= form.text_area :message, rows: 3, placeholder: "Un problema, un progetto o una curiosità…" %></label>
          <label class="mp-sales__consent"><%= form.check_box :privacy_consent, required: true %><span>Puoi usare questi dati per ricontattarmi riguardo alla presentazione. <button type="button" data-privacy-open>Informativa privacy</button></span></label>
          <div class="mp-sales__waitlist-actions">
            <%= form.submit "Entra nella lista d’attesa", class: "mp-sales__button mp-sales__button--primary" %>
            <% contact.fetch("actions").each do |action| %><a class="mp-sales__text-link" href="<%= action.fetch("href") %>"><%= action.fetch("label") %> <span aria-hidden="true">→</span></a><% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <a class="mp-sales__mobile-cta" href="#lista-attesa"><span>Presentazione MarkPostura</span><strong>Lista d’attesa →</strong></a>
</div>

<style>
  .mp-sales{--ink:#101828;--muted:#526177;--paper:#fff;--soft:#f5f7fa;--blue:#1d64d8;--green:#16845b;--red:#c7443e;overflow:hidden;color:var(--ink);background:var(--paper)}
  .mp-sales *{box-sizing:border-box}.mp-sales__shell{width:min(1160px,calc(100% - 2.5rem));margin-inline:auto}.mp-sales__eyebrow{margin:0;color:#8a4c08;font-size:.73rem;font-weight:900;letter-spacing:.17em;text-transform:uppercase}.mp-sales h1,.mp-sales h2,.mp-sales h3,.mp-sales p{margin-top:0}.mp-sales h2{font-size:clamp(2rem,4.8vw,4.15rem);line-height:1.02;letter-spacing:-.052em}.mp-sales__section-heading{max-width:760px}.mp-sales__section-heading>p:last-child,.mp-sales__section-heading>div{color:var(--muted);font-size:1.08rem;line-height:1.8}.mp-sales__section-heading--center{text-align:center;margin-inline:auto}.mp-sales__hero{position:relative;background:radial-gradient(circle at 78% 30%,#dbeafe 0,transparent 34%),linear-gradient(145deg,#fff 20%,#f7f5ef 100%)}.mp-sales__hero-grid{display:grid;min-height:min(820px,90vh);align-items:center;gap:4rem;padding-block:5.5rem}.mp-sales__hero-copy{position:relative;z-index:2}.mp-sales__hero h1{max-width:780px;margin:1.15rem 0 1.7rem;font-size:clamp(3rem,7vw,6.6rem);line-height:.92;letter-spacing:-.068em}.mp-sales__lead{max-width:680px;color:var(--muted);font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.75}.mp-sales__lead strong{color:var(--ink)}.mp-sales__actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.mp-sales__button{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;min-height:3.2rem;border:1px solid transparent;border-radius:999px;padding:.75rem 1.3rem;font-size:.9rem;font-weight:900;text-decoration:none!important;transition:transform .18s ease,box-shadow .18s ease,background .18s ease}.mp-sales__button:hover{transform:translateY(-2px)}.mp-sales__button--primary{background:#162238!important;color:#fff!important;box-shadow:0 12px 26px rgb(16 24 40 / 18%)}.mp-sales__button--secondary{border-color:#cad3df;background:#fff!important;color:#1f2b3d!important}.mp-sales__microcopy{margin-top:1rem;color:#6b7789;font-size:.78rem}.mp-sales__hero-world{position:relative;margin:0 auto;width:min