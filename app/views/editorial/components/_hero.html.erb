<% compact = variant == "compact" %>
<section id="<%= component.fetch("id") %>" class="editorial-hero mx-auto grid max-w-6xl scroll-mt-24 items-center gap-8 px-5 <%= compact ? 'py-12 sm:py-16 lg:grid-cols-[0.55fr_1fr]' : 'py-12 sm:py-16 lg:grid-cols-[1fr_0.72fr] lg:gap-10 lg:py-24' %>">
  <div class="<%= compact ? 'lg:order-2' : '' %>">
    <% if data["eyebrow"].present? %><p class="text-xs font-black uppercase tracking-[0.22em] text-amber-700"><%= data["eyebrow"] %></p><% end %>
    <% heading_class = "mt-5 font-black tracking-[-0.04em] #{compact ? 'text-3xl sm:text-4xl' : 'max-w-3xl text-4xl leading-[0.98] sm:text-7xl sm:leading-[0.95]'}" %>
    <% if compact %><h2 class="<%= heading_class %>"><%= editorial_inline_markdown(data.fetch("title")) %></h2><% else %><h1 class="<%= heading_class %>"><%= editorial_inline_markdown(data.fetch("title")) %></h1><% end %>
    <div class="mt-6 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg sm:leading-8 <%= editorial_markdown_classes %>"><%= editorial_markdown(data.fetch("description")) %></div>
    <% if data["action"].present? %>
      <a href="<%= data.dig("action", "href") %>" class="editorial-action-button mt-8 rounded-full px-6 py-3 text-sm font-black focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 focus-visible:ring-offset-2"><%= data.dig("action", "label") %></a>
    <% end %>
  </div>
  <% if data["image"].present? %>
    <% image = data.fetch("image") %>
    <% srcset = Array(image["srcset"]).filter_map { |source| "#{asset_path(source.fetch("url"))} #{source.fetch("width")}w" }.join(", ") %>
    <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-50 p-2 shadow-lg <%= compact ? 'lg:order-1' : '' %>">
      <%= image_tag image.fetch("url"), alt: image["alt"], class: "aspect-[4/5] h-full w-full rounded-[1.6rem] object-cover", loading: compact ? "lazy" : "eager", srcset: srcset.presence, sizes: image["sizes"] %>
    </div>
  <% end %>
</section>
