<article id="<%= component.fetch("id") %>" class="rounded-3xl border border-slate-200 bg-white <%= variant == 'compact' ? 'p-5' : 'p-7' %> shadow-sm">
  <% if data["eyebrow"].present? %><p class="text-xs font-black uppercase tracking-[0.18em] text-amber-700"><%= data["eyebrow"] %></p><% end %>
  <h2 class="mt-3 text-2xl font-black"><%= editorial_inline_markdown(data.fetch("title")) %></h2>
  <% if data["description"].present? %><div class="mt-3 leading-7 text-slate-600 <%= editorial_markdown_classes %>"><%= editorial_markdown(data["description"]) %></div><% end %>
</article>
