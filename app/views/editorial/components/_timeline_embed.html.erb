<% spreadsheet_id = data.fetch("source").to_s %>
<% height = data.fetch("height", 650).to_i.clamp(360, 1_200) %>
<% timeline_url = "https://cdn.knightlab.com/libs/timeline3/latest/embed/index.html?source=#{ERB::Util.url_encode(spreadsheet_id)}&lang=it&initial_zoom=2&height=#{height}" %>
<% deferred = data["deferred"] == true %>

<section id="<%= component.fetch("id") %>" class="mx-auto max-w-6xl px-5 pb-16">
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <% if deferred %>
      <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center" data-timeline-deferred data-timeline-src="<%= timeline_url %>" data-timeline-height="<%= height %>">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-slate-600">Percorso di Mark Postura</p>
        <p class="mt-3 max-w-xl text-slate-700" data-timeline-status>La timeline si prepara mentre arrivi a questa sezione.</p>
        <button type="button" class="mt-6 rounded-full bg-slate-950 px-6 py-3 text-sm font-black text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2" data-timeline-trigger>Carica ora</button>
      </div>
    <% else %>
      <iframe src="<%= timeline_url %>" title="Timeline del percorso di Mark Postura" width="100%" height="<%= height %>" loading="lazy" allowfullscreen frameborder="0" class="block w-full"></iframe>
    <% end %>
  </div>
</section>

<% if deferred %>
  <script>
    (() => {
      if (window.__editorialTimelineDeferred) return;
      window.__editorialTimelineDeferred = true;
      const loadTimeline = (container) => {
        if (!container || container.dataset.timelineLoaded) return;
        container.dataset.timelineLoaded = "true";
        const iframe = document.createElement("iframe");
        iframe.src = container.dataset.timelineSrc;
        iframe.title = "Timeline del percorso di Mark Postura";
        iframe.width = "100%";
        iframe.height = container.dataset.timelineHeight;
        iframe.loading = "lazy";
        iframe.allowFullscreen = true;
        iframe.frameBorder = "0";
        iframe.className = "block w-full";
        container.closest(".overflow-hidden").replaceChildren(iframe);
      };
      const observeTimelines = () => document.querySelectorAll("[data-timeline-deferred]").forEach((container) => {
        if (container.dataset.timelineObserved) return;
        container.dataset.timelineObserved = "true";
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(container);
          loadTimeline(container);
        }), { rootMargin: "700px 0px" });
        observer.observe(container);
      });
      document.addEventListener("click", (event) => {
        const trigger = event.target.closest("[data-timeline-trigger]");
        if (trigger) loadTimeline(trigger.closest("[data-timeline-deferred]"));
      });
      document.addEventListener("turbo:load", observeTimelines);
      document.addEventListener("DOMContentLoaded", observeTimelines);
      observeTimelines();
    })();
  </script>
<% end %>
