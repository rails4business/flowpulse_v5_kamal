<section id="<%= component.fetch("id") %>" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20">
  <% if data["title"].present? %><h2 class="text-3xl font-black tracking-tight"><%= editorial_inline_markdown(data["title"]) %></h2><% end %>
  <% if data["description"].present? %><div class="mt-3 text-slate-600 <%= editorial_markdown_classes %>"><%= editorial_markdown(data["description"]) %></div><% end %>
  <ol class="mt-9 <%= variant == 'horizontal' ? 'flex snap-x snap-mandatory overflow-x-auto pb-4' : 'space-y-4' %>" aria-label="<%= data["title"] %>">
    <% items.each_with_index do |item, index| %>
      <li class="<%= variant == 'horizontal' ? 'flex min-w-64 snap-start items-stretch sm:min-w-0 sm:flex-1' : '' %>">
        <article class="min-w-56 flex-1 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <span class="flex size-8 items-center justify-center rounded-full border border-amber-300 bg-amber-50 text-xs font-black text-amber-800"><%= index + 1 %></span>
          <h3 class="mt-4 font-black"><%= editorial_inline_markdown(item.fetch("title")) %></h3>
          <div class="mt-2 text-sm leading-6 text-slate-600 <%= editorial_markdown_classes %>"><%= editorial_markdown(item.fetch("description")) %></div>
        </article>
        <% if variant == "horizontal" && index < items.length - 1 %><span aria-hidden="true" class="mt-8 h-px w-7 shrink-0 bg-amber-400/30"></span><% end %>
      </li>
    <% end %>
  </ol>
</section>
