        <article class="item" data-category="luce" data-search="lampada ceramica casa navigli"><div class="item-photo"><img src="https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=900&q=85" alt="Lampada in ceramica"><button class="heart">♡</button><span class="days">18 giorni</span></div><div class="item-body"><small>Casa sui Navigli</small><h3>Lampada in ceramica</h3><div class="item-foot"><strong>€ 45</strong><button class="request">Richiedi</button></div></div></article>
