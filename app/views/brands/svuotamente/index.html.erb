  <script>
    // Navigation: replace showPage() with normal Rails links when converting to ERB.
    const pages = [...document.querySelectorAll(".page")];
    const navButtons = [...document.querySelectorAll("[data-page]")];
    function showPage(id) {
      pages.forEach(page => page.classList.toggle("active", page.id === id));
      document.querySelectorAll(".nav [data-page]").forEach(button => button.classList.toggle("active", button.dataset.page === id));
      window.scrollTo({ top:0, behavior:"smooth" });
    }
    navButtons.forEach(button => button.addEventListener("click", () => showPage(button.dataset.page)));
    document.querySelector("[data-scroll]").addEventListener("click", () => {
      showPage("market");
      setTimeout(() => document.getElementById("workflow").scrollIntoView(), 50);
    });

    // Public market filters.
    let activeCategory = "all";
    const marketSearch = document.getElementById("market-search");
    const marketItems = [...document.querySelectorAll("#market-grid .item")];
    function filterMarket() {
      const query = marketSearch.value.toLowerCase();
      marketItems.forEach(item => {
        const categoryMatch = activeCategory === "all" || item.dataset.category === activeCategory;
        const queryMatch = item.dataset.search.includes(query);
        item.classList.toggle("hidden", !(categoryMatch && queryMatch));
      });
    }
    marketSearch.addEventListener("input", filterMarket);
    document.querySelectorAll("#market-filters button").forEach(button => button.addEventListener("click", () => {
      activeCategory = button.dataset.filter;
      document.querySelectorAll("#market-filters button").forEach(item => item.classList.toggle("active", item === button));
      filterMarket();
    }));
    document.querySelectorAll(".heart").forEach(button => button.addEventListener("click", () => {
      button.classList.toggle("on");
      button.textContent = button.classList.contains("on") ? "♥" : "♡";
    }));
    document.querySelectorAll(".request").forEach(button => button.addEventListener("click", () => {
      const card = button.closest(".item");
      const title = card.querySelector("h3").textContent;
      const isOffer = card.dataset.priceMode === "offer";
      const amount = window.prompt(isOffer ? `Quanto vuoi offrire per “${title}”?` : `Invia una richiesta per “${title}”. Puoi proporre un prezzo:`, "");
      if (amount === null) return;
      const original = button.textContent;
      button.textContent = isOffer ? `Offerta € ${amount || "—"} inviata` : "Richiesta inviata";
      button.disabled = true;
      setTimeout(() => { button.textContent = original; button.disabled = false }, 2200);
    }));

    // Inventory filters and inline status changes.
    const inventorySearch = document.getElementById("inventory-search");
    const statusFilter = document.getElementById("status-filter");
    function filterInventory() {
      const query = inventorySearch.value.toLowerCase();
      const status = statusFilter.value;
      document.querySelectorAll("#inventory-rows .row").forEach(row => {
        const matchesName = row.dataset.name.toLowerCase().includes(query);
        const matchesStatus = status === "all" || row.dataset.status === status;
        row.classList.toggle("hidden", !(matchesName && matchesStatus));
      });
    }
    inventorySearch.addEventListener("input", filterInventory);
    statusFilter.addEventListener("change", filterInventory);
    document.querySelectorAll(".status-select").forEach(select => {
      if (![...select.options].some(option => option.value === "Venduto")) {
        select.add(new Option("Venduto", "Venduto"));
      }
    });
    document.addEventListener("change", event => {
      if (!event.target.classList.contains("status-select")) return;
      const row = event.target.closest(".row");
      row.dataset.status = event.target.value;
      if (event.target.value === "Venduto") {
        row.children[2].textContent = "Acquirente privato";
        document.getElementById("sold-count").textContent = document.querySelectorAll('#inventory-rows .row[data-status="Venduto"]').length;
      }
      filterInventory();
    });

    // CSV: scarica, modifica e ricarica lo stesso inventario.
    document.getElementById("export-csv").addEventListener("click", () => {
      const rows = [...document.querySelectorAll("#inventory-rows .row")].map(row => {
        const title = row.querySelector(".object strong").textContent;
        const category = row.querySelector(".object span").textContent.split(" · ")[0];
        return [title, category, row.dataset.price, row.dataset.status];
      });
      const csv = [["titolo","categoria","prezzo","stato"], ...rows]
        .map(row => row.map(value => `"${String(value).replaceAll('"','""')}"`).join(","))
        .join("\n");
      const link = document.createElement("a");
      link.href = URL.createObjectURL(new Blob([csv], {type:"text/csv;charset=utf-8"}));
      link.download = "inventario-svuotamente.csv";
      link.click();
      URL.revokeObjectURL(link.href);
    });
    document.getElementById("import-csv").addEventListener("click", () => document.getElementById("csv-file").click());
    document.getElementById("csv-file").addEventListener("change", event => {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const lines = String(reader.result).split(/\r?\n/).filter(Boolean).slice(1);
        lines.forEach((line, index) => {
          const values = line.match(/(".*?"|[^",]+)(?=\s*,|\s*$)/g)?.map(v => v.replace(/^"|"$/g,"").replaceAll('""','"')) || [];
          const [title=`Oggetto ${index+1}`, category="Oggetti", price="0", status="In vendita"] = values;
          const row = document.createElement("div");
          row.className = "row"; row.dataset.name = title; row.dataset.status = status; row.dataset.price = price;
          row.innerHTML = `<div class="object"><img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=200&q=80" alt=""><div><strong>${title}</strong><span>${category} · Import CSV</span></div></div><strong>€ ${price}</strong><span>${status === "Venduto" ? "Acquirente privato" : "Privati"}</span><select class="status-select"><option>In vendita</option><option>Prenotato</option><option>Mercatino</option><option>Da donare</option><option>Venduto</option></select><button class="dots">•••</button>`;
          row.querySelector("select").value = status;
          document.getElementById("inventory-rows").prepend(row);
        });
        document.getElementById("item-count").textContent = document.querySelectorAll("#inventory-rows .row").length;
        document.getElementById("sold-count").textContent = document.querySelectorAll('#inventory-rows .row[data-status="Venduto"]').length;
        document.getElementById("notice").firstChild.textContent = `✓ ${lines.length} oggetti importati dal CSV.`;
        document.getElementById("notice").classList.add("show");
        event.target.value = "";
      };
      reader.readAsText(file);
    });

    // Add-item prototype. In Rails this form can become form_with(model: @item).
    const modal = document.getElementById("modal");
    document.querySelectorAll(".open-modal").forEach(button => button.addEventListener("click", () => modal.classList.remove("hidden")));
    document.querySelectorAll("[data-close]").forEach(button => button.addEventListener("click", () => modal.classList.add("hidden")));
    modal.addEventListener("click", event => { if (event.target === modal) modal.classList.add("hidden") });
    document.getElementById("add-form").addEventListener("submit", event => {
      event.preventDefault();
      const data = new FormData(event.target);
      const title = data.get("title");
      const price = Number(data.get("price"));
      const priceMode = data.get("priceMode");
      const category = data.get("category");
      const row = document.createElement("div");
      row.className = "row";
      row.dataset.name = title;
      row.dataset.status = "In vendita";
      row.dataset.price = price;
      row.innerHTML = `<div class="object"><img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=200&q=80" alt=""><div><strong>${title}</strong><span>${category} · Casa sui Navigli</span></div></div><strong>${priceMode === "offer" ? "Offerta libera" : `€ ${price}`}</strong><span>Privati</span><select class="status-select"><option>In vendita</option><option>Prenotato</option><option>Mercatino</option><option>Da donare</option><option>Venduto</option></select><button class="dots">•••</button>`;
      document.getElementById("inventory-rows").prepend(row);
      document.getElementById("item-count").textContent = document.querySelectorAll("#inventory-rows .row").length;
      const total = [...document.querySelectorAll("#inventory-rows .row")].reduce((sum, item) => sum + Number(item.dataset.price), 0);
      document.getElementById("total-value").textContent = `€ ${total.toLocaleString("it-IT")}`;
      event.target.reset();
      modal.classList.add("hidden");
      showPage("inventory");
      document.getElementById("notice").classList.add("show");
    });
  </script>
</body>
</html>
