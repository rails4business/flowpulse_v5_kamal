<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SvuotaMente — Prototipo HTML</title>
  <meta name="description" content="Prototipo statico di SvuotaMente: mercato, luoghi, dashboard e inventario.">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='12' fill='%23dc2626'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream:#f7f1e7; --paper:#fffdf8; --ink:#26322c; --muted:#687168;
      --terra:#c95f38; --terra-dark:#a94d2d; --sage:#8fa083;
      --sage-light:#dce4d8; --sand:#e9dccb; --amber:#c9933d;
    }
    * { box-sizing:border-box }
    html { scroll-behavior:smooth }
    body { margin:0; color:var(--ink); background:var(--cream); font-family:"Manrope",sans-serif }
    button,input,select { font:inherit; color:inherit }
    button { cursor:pointer }
    img { display:block; width:100%; object-fit:cover }
    h1,h2,h3,.brand { font-family:"Cormorant Garamond",serif }
    .hidden { display:none!important }

    /* Shared shell — maps cleanly to app/views/layouts/application.html.erb */
    .header {
      position:sticky; top:0; z-index:30; min-height:82px; display:grid;
      grid-template-columns:1fr auto 1fr; align-items:center; gap:28px;
      padding:12px clamp(22px,4.5vw,72px); border-bottom:1px solid var(--sand);
      background:rgba(255,253,248,.95); backdrop-filter:blur(16px)
    }
    .brand { border:0; padding:0; background:none; width:max-content; font-size:42px; font-weight:700; letter-spacing:-.05em }
    .brand i { color:var(--terra); font-style:normal }
    .nav,.header-actions,.actions,.filters,.modal-actions { display:flex; align-items:center }
    .nav { gap:42px }
    .nav button { padding:10px 2px; border:0; border-bottom:2px solid transparent; background:none; font-size:14px; font-weight:700 }
    .nav button:hover,.nav button.active { color:var(--terra); border-color:var(--terra) }
    .header-actions { justify-content:flex-end; gap:10px }
    .btn { min-height:46px; display:inline-flex; align-items:center; justify-content:center; padding:0 20px; border:1px solid transparent; border-radius:11px; font-weight:700; transition:.18s ease }
    .btn:hover { transform:translateY(-2px) }
    .btn-primary { color:#fff; background:var(--terra); box-shadow:0 12px 26px rgba(169,77,45,.18) }
    .btn-primary:hover { background:var(--terra-dark) }
    .btn-outline { border-color:var(--sage); background:rgba(255,253,248,.65) }
    .btn-quiet { border-color:var(--sand); background:rgba(255,255,255,.5) }
    .eyebrow { margin:0 0 11px; color:var(--terra); font-size:11px; font-weight:700; letter-spacing:.16em; text-transform:uppercase }
    .page { display:none }
    .page.active { display:block }

    /* PUBLIC MARKET INDEX — app/views/market/index.html.erb */
    .hero { min-height:590px; display:grid; grid-template-columns:.92fr 1.08fr; border-bottom:1px solid var(--sand) }
    .hero-copy { position:relative; align-self:center; padding:72px 50px 72px clamp(24px,5.2vw,84px); overflow:hidden }
    .hero-copy:before { content:""; position:absolute; z-index:-1; width:650px; height:650px; left:-220px; top:-150px; border-radius:50%; background:rgba(255,253,248,.75) }
    .hero h1 { margin:0; max-width:650px; font-size:clamp(56px,5.8vw,88px); line-height:.88; letter-spacing:-.055em }
    .hero h1 i { color:var(--terra); font-style:normal }
    .hero-copy>p:not(.eyebrow) { max-width:530px; margin:28px 0 0; font-size:20px; line-height:1.55 }
    .actions { gap:14px; margin-top:28px }
    .actions .btn { min-height:56px; padding-inline:28px }
    .proof { display:flex; align-items:center; gap:12px; margin-top:34px; color:var(--muted); font-size:12px }
    .faces { display:flex }.faces span { width:32px; height:32px; display:grid; place-items:center; margin-left:-6px; border:2px solid var(--cream); border-radius:50%; color:#fff; background:var(--sage); font-size:8px; font-weight:700 }.faces span:first-child { margin-left:0; background:var(--terra) }.faces span:last-child { background:#b28b62 }
    .hero-image { position:relative; min-height:590px; overflow:hidden; border-bottom-left-radius:58px }
    .hero-image>img { height:100%; min-height:590px }
    .deadline { position:absolute; top:48px; right:48px; width:270px; display:grid; grid-template-columns:auto 1fr; gap:10px 14px; padding:19px; border-radius:17px; background:rgba(255,253,248,.95); box-shadow:0 18px 44px rgba(38,50,44,.17) }
    .cal { width:42px; height:44px; display:grid; place-items:center; align-self:center; border:2px solid var(--terra); border-radius:8px; color:var(--terra); font-weight:700 }
    .deadline p { margin:0; font-size:12px; font-weight:700 }.deadline strong { color:var(--terra); font:700 38px/1 "Cormorant Garamond",serif }.deadline small { color:var(--ink); font:600 13px "Manrope",sans-serif }
    .progress { height:7px; overflow:hidden; border-radius:99px; background:#e7e1d7 }.progress span { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,var(--terra),#d98864) }.deadline .progress { grid-column:1/-1 }
    .section { padding:76px clamp(22px,5vw,80px) }
    .market { background:var(--paper) }
    .section-head { display:flex; align-items:end; justify-content:space-between; gap:20px }
    .section-head h2,.workflow h2,.panel h2 { margin:0; font-size:clamp(36px,3.3vw,52px); line-height:.98 }
    .link { padding:8px 0; border:0; border-bottom:1px solid var(--terra); color:var(--terra); background:none; font-weight:700 }
    .toolbar { display:flex; align-items:center; justify-content:space-between; gap:18px; margin:30px 0 24px }
    .search { min-width:280px; height:47px; display:flex; align-items:center; gap:9px; padding:0 14px; border:1px solid var(--sand); border-radius:11px; background:#fff }
    .search input { width:100%; border:0; outline:0; background:none }
    .filters { gap:7px; flex-wrap:wrap; justify-content:flex-end }
    .filters button { padding:8px 14px; border:1px solid var(--sand); border-radius:99px; background:none; font-size:12px; font-weight:700 }
    .filters button.active { border-color:var(--sage); background:var(--sage-light) }
    .item-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px }
    .item { overflow:hidden; border:1px solid var(--sand); border-radius:17px; background:var(--paper); transition:.18s ease }
    .item:hover { transform:translateY(-4px); box-shadow:0 18px 42px rgba(38,50,44,.09) }
    .item-photo { position:relative; aspect-ratio:4/3; overflow:hidden; background:var(--sand) }
    .item-photo img { height:100%; transition:.25s ease }.item:hover img { transform:scale(1.025) }
    .heart { position:absolute; top:12px; right:12px; width:38px; height:38px; border:0; border-radius:50%; background:rgba(255,253,248,.92); font-size:20px }.heart.on { color:var(--terra) }
    .days { position:absolute; left:12px; bottom:12px; padding:6px 9px; border-radius:7px; background:rgba(255,253,248,.92); font-size:10px; font-weight:700 }
    .item-body { padding:16px 17px 17px }.item-body>small { color:var(--muted); font-size:9px; font-weight:700; text-transform:uppercase }
    .item-body h3 { min-height:45px; margin:5px 0 0; font-size:24px; line-height:1 }
    .item-foot { display:flex; align-items:center; justify-content:space-between; margin-top:13px }.item-foot strong { color:var(--terra); font-size:20px }.item-foot button { padding:7px 10px; border:1px solid var(--sage); border-radius:7px; background:none; font-size:10px; font-weight:700 }
    .workflow { display:grid; grid-template-columns:.85fr 1.15fr; gap:60px; background:#efe5d8 }
    .workflow-copy p:last-child { color:var(--muted); line-height:1.7 }
    .steps { display:grid; grid-template-columns:1fr 1fr; gap:13px }.step { padding:22px; border:1px solid rgba(143,160,131,.38); border-radius:15px; background:rgba(255,253,248,.65) }.step>span { color:var(--terra); font-size:11px; font-weight:700 }.step h3 { margin:18px 0 6px; font-size:25px }.step p { margin:0; color:var(--muted); font-size:12px; line-height:1.6 }

    /* PUBLIC PLACES INDEX — app/views/places/index.html.erb */
    .page-hero { display:grid; grid-template-columns:1fr 390px; align-items:end; gap:60px; margin-bottom:42px }
    .page-hero h1 { max-width:820px; margin:0; font-size:clamp(52px,5vw,76px); line-height:.93; letter-spacing:-.045em }
    .page-hero p:last-child { max-width:660px; color:var(--muted); line-height:1.65 }
    .place-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px }
    .place { overflow:hidden; border:1px solid var(--sand); border-radius:19px; background:var(--paper) }
    .place-photo { position:relative; height:235px }.place-photo img { height:100% }.place-photo span { position:absolute; left:14px; bottom:14px; padding:7px 10px; border-radius:8px; background:rgba(255,253,248,.93); font-size:10px; font-weight:700 }
    .place-body { padding:20px }.place-body>small { color:var(--terra); font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase }.place h2 { margin:4px 0 0; font-size:33px }.place-body>p { margin:2px 0 17px; color:var(--muted); font-size:11px }
    .place-stats { display:grid; grid-template-columns:.7fr 1.3fr; border-block:1px solid var(--sand) }.place-stats div { padding:14px 0 }.place-stats div+div { padding-left:16px; border-left:1px solid var(--sand) }.place-stats strong,.place-stats span { display:block }.place-stats span { color:var(--muted); font-size:8px }
    .place-progress { margin:16px 0 }.place-progress div:first-child { display:flex; justify-content:space-between; margin-bottom:7px; color:var(--muted); font-size:9px }.place .btn { width:100% }

    /* PRIVATE DASHBOARD — app/views/dashboard/index.html.erb */
    .private { min-height:calc(100vh - 82px); display:grid!important; grid-template-columns:250px 1fr; background:#f3eee5 }
    .sidebar { position:sticky; top:82px; height:calc(100vh - 82px); display:flex; flex-direction:column; justify-content:space-between; padding:30px 18px 22px; border-right:1px solid var(--sand); background:var(--paper) }
    .sidebar small { color:var(--muted); font-size:9px; font-weight:700; letter-spacing:.12em; text-transform:uppercase }.sidebar h2 { margin:3px 0 10px; font-size:27px }.pill { display:inline-block; padding:6px 9px; border-radius:99px; color:#52604e; background:var(--sage-light); font-size:9px; font-weight:700 }
    .side-nav { display:grid; gap:4px; margin-top:28px }.side-nav button { min-height:44px; display:grid; grid-template-columns:24px 1fr auto; align-items:center; padding:0 12px; border:0; border-radius:9px; background:none; text-align:left; font-size:12px; font-weight:700 }.side-nav button.active,.side-nav button:hover { color:var(--terra-dark); background:#f4e4d9 }.side-nav b { width:20px; height:20px; display:grid; place-items:center; border-radius:50%; color:#fff; background:var(--terra); font-size:8px }
    .tip { padding:14px; border-radius:12px; background:#efe5d8 }.tip strong { font-size:10px }.tip p { margin:5px 0 10px; color:var(--muted); font-size:10px; line-height:1.5 }.tip button { padding:0; border:0; color:var(--terra); background:none; font-size:9px; font-weight:700 }
    .dash-main { width:100%; max-width:1500px; padding:38px clamp(22px,4vw,56px) 65px }.dash-head { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:27px }.dash-head h1 { margin:0; font-size:clamp(42px,4vw,60px); line-height:.95 }
    .metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:13px }.metric,.panel { border:1px solid var(--sand); border-radius:15px; background:var(--paper) }.metric { padding:18px }.metric span,.metric strong,.metric small { display:block }.metric span { color:var(--muted); font-size:9px; font-weight:700; text-transform:uppercase }.metric strong { margin:11px 0 6px; font:700 32px/1 "Cormorant Garamond",serif }.metric small { color:var(--sage); font-size:9px; font-weight:700 }
    .dash-grid { display:grid; grid-template-columns:1.35fr .65fr; gap:15px; margin-top:15px }.panel { padding:22px }.panel-head { display:flex; align-items:start; justify-content:space-between; gap:20px; margin-bottom:19px }.panel-head h2 { font-size:32px }.panel-head>strong { color:var(--terra); font:700 34px "Cormorant Garamond",serif }
    .phase { min-height:60px; display:grid; grid-template-columns:26px 1fr auto; align-items:center; gap:11px; border-top:1px solid var(--sand) }.dot { width:21px; height:21px; display:grid; place-items:center; border:2px solid #cfc8bb; border-radius:50%; font-size:9px }.phase.done .dot { color:#fff; border-color:var(--sage); background:var(--sage) }.phase.now .dot { border-color:var(--terra); box-shadow:inset 0 0 0 5px var(--paper); background:var(--terra) }.phase strong,.phase span { display:block }.phase strong { font-size:11px }.phase span,.phase>b { color:var(--muted); font-size:9px }
    .countdown { text-align:center }.countdown h2 { font-size:33px }.huge { margin-top:17px; color:var(--terra); font:700 96px/.8 "Cormorant Garamond",serif }.countdown>p:not(.eyebrow) { margin:7px 0 22px; color:var(--muted); font-size:10px }.count-foot { display:flex; justify-content:space-between; margin-top:9px; color:var(--muted); font-size:8px }
    .recent { margin-top:15px }.recent-row { min-height:65px; display:grid; grid-template-columns:48px 1fr auto 70px; align-items:center; gap:12px; border-top:1px solid var(--sand) }.recent-row img { width:42px; height:42px; border-radius:8px }.recent-row strong,.recent-row span { display:block }.recent-row>div span { color:var(--muted); font-size:8px }.recent-row>b { text-align:right; font-size:11px }
    .status { display:inline-flex; justify-content:center; padding:5px 8px; border-radius:99px; font-size:8px; font-weight:700 }.selling { color:#4e6248; background:var(--sage-light) }.reserved { color:#855c22; background:#f5e7c9 }.dealer { color:#76513b; background:#f1ddd0 }.donate { color:#53616a; background:#e4e9ec }.sold { color:#fff; background:var(--ink) }

    /* INVENTORY INDEX — app/views/inventory/index.html.erb */
    .inventory { padding:0; overflow:hidden }.inventory-tools { display:grid; grid-template-columns:minmax(250px,1fr) 170px auto auto; gap:11px; padding:18px; border-bottom:1px solid var(--sand) }.inventory-tools select,.row select,.modal input,.modal select { min-height:45px; padding:0 12px; border:1px solid var(--sand); border-radius:9px; background:#fff; outline:0 }
    .summary { display:flex; gap:28px; padding:13px 18px; border-bottom:1px solid var(--sand); color:var(--muted); background:#faf5ec; font-size:9px }.summary strong { color:var(--ink) }
    .table-head,.row { display:grid; grid-template-columns:minmax(240px,1.4fr) 90px minmax(130px,.8fr) 145px 30px; align-items:center; gap:14px; padding:0 18px }.table-head { min-height:42px; color:var(--muted); font-size:8px; font-weight:700; letter-spacing:.08em; text-transform:uppercase }.row { min-height:73px; border-top:1px solid var(--sand); font-size:10px }.row:hover { background:#fffaf1 }
    .object { display:flex; align-items:center; gap:11px }.object img { width:48px; height:48px; border-radius:8px }.object strong,.object span { display:block }.object span { color:var(--muted); font-size:8px }.row select { min-height:34px; width:100%; font-size:9px }.dots { border:0; background:none; font-weight:700 }
    .notice { display:none; align-items:center; gap:9px; margin-bottom:14px; padding:11px 14px; border:1px solid #bdcbb7; border-radius:10px; color:#4e6248; background:#edf3e9; font-size:11px }.notice.show { display:flex }.notice button { margin-left:auto; border:0; background:none }

    /* Interactive modal */
    .backdrop { position:fixed; z-index:60; inset:0; display:grid; place-items:center; padding:20px; background:rgba(38,50,44,.44); backdrop-filter:blur(4px) }
    .modal { width:min(540px,100%); padding:26px; border-radius:19px; background:var(--paper); box-shadow:0 26px 90px rgba(20,28,24,.3) }.modal-top { display:flex; align-items:start; justify-content:space-between; margin-bottom:21px }.modal h2 { margin:0; font-size:37px }.close { width:36px; height:36px; border:1px solid var(--sand); border-radius:50%; background:none; font-size:20px }.modal label { display:grid; gap:7px; margin-bottom:15px; font-size:10px; font-weight:700 }.form-row { display:grid; grid-template-columns:1fr 1fr; gap:11px }.drop { min-height:110px; place-items:center; align-content:center; border:1px dashed var(--sage); border-radius:12px; color:var(--muted); background:#f7f8f3 }.drop b { color:var(--ink) }.drop input { display:none }.modal-actions { justify-content:flex-end; gap:9px; margin-top:20px }.file-input{position:fixed;width:1px;height:1px;overflow:hidden;opacity:0}.price-free{font-size:14px!important}

    @media(max-width:1050px) {
      .header { grid-template-columns:1fr auto }.nav { display:none }.hero { grid-template-columns:1fr }.hero-image { min-height:500px; border-radius:0 }.hero-copy { padding-block:65px }
      .item-grid,.place-grid { grid-template-columns:1fr 1fr }.workflow,.page-hero { grid-template-columns:1fr }.metrics { grid-template-columns:1fr 1fr }.dash-grid { grid-template-columns:1fr }
    }
    @media(max-width:720px) {
      .header { min-height:68px; padding:9px 14px }.brand { font-size:31px }.header-actions .btn-quiet { display:none }.header-actions .btn { min-height:40px; padding:0 12px; font-size:10px }
      .hero-copy { padding:52px 20px }.hero h1 { font-size:51px }.actions { align-items:stretch; flex-direction:column }.hero-image,.hero-image>img { min-height:400px }.deadline { top:16px; right:16px; width:240px }
      .section { padding:54px 16px }.section-head,.toolbar,.dash-head { align-items:flex-start; flex-direction:column }.filters { justify-content:flex-start }.item-grid,.place-grid,.steps { grid-template-columns:1fr }
      .private { display:block!important }.sidebar { position:static; width:100%; height:auto; padding:16px }.side-nav { grid-template-columns:1fr 1fr; margin-top:15px }.side-nav button:nth-child(n+3),.tip { display:none }.dash-main { padding:28px 14px 55px }.dash-head h1 { font-size:42px }
      .metrics { grid-template-columns:1fr 1fr }.metric { padding:14px }.metric strong { font-size:26px }.inventory-tools { grid-template-columns:1fr }.summary { flex-wrap:wrap; gap:10px 18px }.table-scroll { overflow-x:auto }.table-head,.row { min-width:790px }.form-row { grid-template-columns:1fr }
    }
  </style>
</head>
<body>
  <header class="header">
    <button class="brand" data-page="market">Svuota<i>Mente</i></button>
    <nav class="nav" aria-label="Navigazione">
      <button class="active" data-page="market">Mercato</button>
      <button data-page="places">Luoghi</button>
      <button data-scroll="workflow">Come funziona</button>
    </nav>
    <div class="header-actions">
      <button class="btn btn-quiet" data-page="dashboard">Dashboard</button>
      <button class="btn btn-primary" data-page="dashboard">Inizia a svuotare</button>
    </div>
  </header>

  <!-- PUBLIC MARKET INDEX -->
  <main id="market" class="page active">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Ogni cosa può trovare il suo posto</p>
        <h1>Libera lo spazio.<br>Recupera il valore<i>.</i></h1>
        <p>Vendi ciò che vale, dona ciò che può servire e libera tutto entro la tua data.</p>
        <div class="actions">
          <button class="btn btn-primary" data-page="dashboard">Inizia a svuotare</button>
          <button class="btn btn-outline" data-page="places">Esplora i luoghi</button>
        </div>
        <div class="proof"><div class="faces"><span>AM</span><span>GC</span><span>LB</span></div><b>142 spazi</b> liberati questo mese</div>
      </div>
      <div class="hero-image">
        <img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1500&q=88" alt="Casa luminosa pronta al cambiamento">
        <div class="deadline"><span class="cal">30</span><div><p>Casa libera entro</p><strong>28 <small>giorni</small></strong></div><div class="progress"><span style="width:64%"></span></div></div>
      </div>
    </section>

    <section class="section market">
      <div class="section-head"><div><p class="eyebrow">Occasioni vicine a te</p><h2>Oggetti con una nuova storia</h2></div><button class="link" data-page="places">Vedi tutti i luoghi →</button></div>
      <div class="toolbar">
        <label class="search">⌕ <input id="market-search" placeholder="Cerca oggetti o luoghi"></label>
        <div class="filters" id="market-filters"><button class="active" data-filter="all">Tutto</button><button data-filter="arredi">Arredi</button><button data-filter="luce">Illuminazione</button><button data-filter="libri">Libri</button><button data-filter="oggetti">Oggetti</button></div>
      </div>
      <div class="item-grid" id="market-grid">
