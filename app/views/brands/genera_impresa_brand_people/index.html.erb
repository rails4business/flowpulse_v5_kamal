<% content_for :title, "GeneraImpresa · Persone" %>

<main class="mx-auto max-w-6xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-500" aria-label="Breadcrumb">
    <%= link_to "Dashboard GeneraImpresa", dashboard_entry_path, class: "text-orange-700 hover:underline" %>
    <span aria-hidden="true">/</span><span>Persone</span>
  </nav>

  <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-[11px] font-black uppercase tracking-[0.16em] text-orange-600">Gestione del Brand</p>
    <h1 class="mt-2 text-3xl font-black text-slate-950">Persone GeneraImpresa</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Profile che possiedono o hanno posseduto un BrandAccess GeneraImpresa. Questa vista non espone gli account degli altri Brand di FlowPulse.</p>
  </header>

  <% if flash[:verification_url].present? %>
    <% access = @brand_accesses.find { |item| item.brand_credential&.email_address == flash[:verification_email] } %>
    <% credential = access&.brand_credential %>
    <% email_subject = "Attiva il tuo accesso a GeneraImpresa" %>
    <% email_body = "Ciao,\n\nusa questo collegamento personale per confermare la tua email e attivare l’accesso a GeneraImpresa:\n#{flash[:verification_url]}\n\nIl collegamento è utilizzabile una sola volta e scade tra 30 minuti." %>
    <section class="mt-6 rounded-2xl border border-orange-200 bg-orange-50 p-5">
      <h2 class="font-black text-orange-950">Nuovo collegamento di verifica</h2>
      <p class="mt-1 text-sm text-orange-800">Copia il collegamento oppure apri l’email precompilata. Il link è personale e valido per 30 minuti.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <input type="text" readonly value="<%= flash[:verification_url] %>" class="min-w-0 flex-1 rounded-xl border border-orange-200 bg-white px-3 py-2 font-mono text-xs">
        <button type="button" data-controller="clipboard" data-clipboard-text-value="<%= flash[:verification_url] %>" data-action="clipboard#copy" class="rounded-xl bg-orange-700 px-4 py-2 text-sm font-black text-white">Copia link</button>
        <% if credential %><%= mail_to credential.email_address, "Apri email", subject: email_subject, body: email_body, class: "rounded-xl border border-orange-300 bg-white px-4 py-2 text-sm font-black text-orange-800" %><% end %>
      </div>
    </section>
  <% end %>

  <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <% if @brand_accesses.any? %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr><th class="px-5 py-3">Profile</th><th class="px-5 py-3">Contatto</th><th class="px-5 py-3">Accesso</th><th class="px-5 py-3">Opera come</th><th class="px-5 py-3 text-right">Azioni</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @brand_accesses.each do |access| %>
              <% assignment = access.current_role_assignment %>
              <tr data-brand-access-id="<%= access.id %>">
                <td class="px-5 py-4"><strong class="block text-slate-950"><%= access.profile.display_name %></strong><span class="text-xs text-slate-500"><%= access.profile.username.present? ? "@#{access.profile.username}" : "Profile ##{access.profile_id}" %></span></td>
                <td class="px-5 py-4 text-slate-600"><%= access.profile.user.email_address %></td>
                <td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-black <%= access.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= access.status.humanize %></span><span class="mt-1 block text-xs text-slate-400"><%= l access.joined_at, format: :short %></span></td>
                <td class="px-5 py-4 text-slate-700"><%= assignment ? (RoleDefinitions::Registry.find(assignment.role_operator)&.label || assignment.role_operator.humanize) : "Utente" %></td>
                <td class="px-5 py-4 text-right">
                  <% if Current.user.superadmin_user? %><%= link_to "Scheda globale", domain_admin_path(admin_profile_path(access.profile), brand_slug: "flowpulse"), class: "mr-3 text-xs font-black text-blue-700 hover:underline" %><% end %>
                  <% if access.brand_credential&.status == "pending_verification" %><%= button_to "Genera nuovo link", resend_genera_impresa_person_verification_path(access), method: :post, class: "mr-3 inline text-xs font-black text-orange-700 hover:underline" %><% end %>
                  <% if access.active? %><%= button_to "Revoca accesso", genera_impresa_person_path(access), method: :delete, data: { turbo_confirm: "Revocare l’accesso GeneraImpresa di #{access.profile.display_name}?" }, class: "inline text-xs font-black text-red-700 hover:underline" %><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="p-8 text-sm text-slate-500">Nessuna persona collegata a GeneraImpresa.</p>
    <% end %>
  </section>
</main>
