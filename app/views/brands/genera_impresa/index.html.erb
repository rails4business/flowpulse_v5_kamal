<% content_for :title, "GeneraImpresa — Brand e progetti" %>
<% content_for :description, @site["description"] %>
<% content_for :landing_nav do %><%= render "brands/genera_impresa/header" %><% end %>

<div class="bg-slate-50 text-slate-950">
  <header class="bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-orange-100 via-stone-50 to-stone-50 py-16 text-center sm:py-24 border-b border-slate-200">
    <div class="mx-auto max-w-4xl px-5 sm:px-8 flex flex-col items-center">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-orange-700">Progetti trasparenti</p>
      <h1 class="mx-auto mt-4 max-w-4xl text-5xl font-black leading-[0.94] tracking-[-0.055em] text-slate-900 sm:text-6xl"><%= @site["tagline"] %></h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl"><%= @site["description"] %></p>
    </div>
  </header>

  <% if Current.user %>
    <section id="i-miei-brand" class="border-b border-slate-200 bg-slate-900 text-white scroll-mt-20">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <p class="text-xs font-black uppercase tracking-[.16em] text-orange-300">Cabina di regia</p>
        <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl font-black">I tuoi Brand e domini</h2>
            <p class="mt-3 max-w-3xl leading-7 text-slate-300">GeneraImpresa raccoglie le realtà che governi. Domini e nodi restano nella struttura FlowPulse; da qui puoi raggiungere il pannello corretto senza duplicare dati.</p>
          </div>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-bold text-slate-200"><%= @managed_brands.size %> <%= @managed_brands.one? ? "Brand" : "Brand" %></span>
        </div>

        <% if @managed_brands.any? %>
          <div class="mt-7 grid gap-5 lg:grid-cols-2">
            <% @managed_brands.each do |brand| %>
              <% primary_domain = brand.domains.find(&:primary?) || brand.domains.first %>
              <article class="rounded-2xl border border-white/15 bg-white/[.07] p-5 shadow-lg shadow-black/10">
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <p class="text-[11px] font-black uppercase tracking-[.14em] text-orange-300">Brand · FlowPulse Node</p>
                    <h3 class="mt-1 truncate text-xl font-black"><%= brand.title %></h3>
                    <p class="mt-1 font-mono text-xs text-slate-400"><%= brand.slug %></p>
                  </div>
                  <span class="rounded-full bg-white/10 px-2.5 py-1 text-xs font-bold text-slate-300"><%= brand.status.humanize %></span>
                </div>

                <div class="mt-5">
                  <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">Domini</p>
                  <% if brand.domains.any? %>
                    <ul class="mt-2 flex list-none flex-wrap gap-2 p-0">
                      <% brand.domains.sort_by(&:hostname).each do |domain| %>
                        <li><%= link_to domain.display_hostname, "https://#{domain.hostname}", target: "_blank", rel: "noopener", class: "inline-flex rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-bold text-white hover:bg-white/20" %></li>
                      <% end %>
                    </ul>
                  <% else %>
                    <p class="mt-2 text-sm text-slate-400">Nessun dominio collegato.</p>
                  <% end %>
                </div>

                <nav class="mt-5 flex flex-wrap gap-2 border-t border-white/10 pt-4" aria-label="Gestione di <%= brand.title %>">
                  <%= link_to "Nodi", brand_admin_nodes_path(brand.slug), class: "rounded-lg bg-white px-3 py-2 text-xs font-black text-slate-900 hover:bg-orange-50" %>
                  <%= link_to "Richieste", brand_admin_data_commitments_path(brand.slug), class: "rounded-lg border border-white/20 px-3 py-2 text-xs font-black text-white hover:bg-white/10" %>
                  <%= link_to "Privacy", brand_admin_privacy_path(brand.slug), class: "rounded-lg border border-white/20 px-3 py-2 text-xs font-black text-white hover:bg-white/10" %>
                  <% if primary_domain %><%= link_to "Apri il sito ↗", "https://#{primary_domain.hostname}", target: "_blank", rel: "noopener", class: "ml-auto rounded-lg px-3 py-2 text-xs font-black text-orange-300 hover:bg-white/10" %><% end %>
                </nav>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="mt-7 rounded-2xl border border-dashed border-white/20 p-6 text-slate-300">Non amministri ancora alcun Brand. Quando creerai o riceverai la responsabilità di un Brand, comparirà qui con i suoi domini.</div>
        <% end %>
      </div>
    </section>
  <% end %>

  <div id="brand">
    <% if Current.user&.superadmin_user? %><div class="border-b border-amber-200 bg-amber-50 px-5 py-3 text-center text-xs font-bold text-amber-900">Vista superadmin: sono visibili anche i Brand in progettazione e senza dominio.</div><% end %>
    <%= render "brands/genera_impresa/brand_catalog_section", brands: @personal_brands, eyebrow: "Persone e competenze", title: "Brand personali", description: "Rappresentano il lavoro, l'identità e i servizi di un professionista. Possono collegarsi a più Brand progetto assumendo ruoli diversi.", section_class: "bg-slate-50" %>
    <%= render "brands/genera_impresa/brand_catalog_section", brands: @project_brands, eyebrow: "Imprese e iniziative", title: "Brand progetto", description: "Raccolgono più progetti sotto una direzione comune. Ogni progetto ha un responsabile e può coinvolgere più ruoli e operatori.", section_class: "border-t border-slate-200 bg-white" %>
  </div>

  <section id="progetti" class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-black uppercase tracking-wider text-red-600">Dal progetto al risultato</p>
      <h2 class="mt-2 text-3xl font-black">Progetti</h2>
      <div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% @catalog.projects.each do |project| %><%= render "brands/genera_impresa/project_card", project: project %><% end %>
      </div>
    </div>
  </section>
  <footer class="border-t border-slate-200 bg-white px-5 py-6 text-center text-sm"><%= render "shared/changelog_footer_link", brand: "generaimpresa", class_name: "font-bold text-red-700 hover:text-red-900" %></footer>
</div>
