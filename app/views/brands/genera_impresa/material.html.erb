<% content_for :title, "#{@material['title']} — #{@brand['name']}" %>
<% content_for :description, @material["description"] %>
<% percorso_integrato_context = @material_context == :percorso_integrato %>
<% profile_path = percorso_integrato_context ? percorso_integrato_professional_path(@brand["slug"]) : genera_impresa_brand_path(@brand["slug"]) %>
<% exercise_path = ->(position) { percorso_integrato_context ? percorso_integrato_professional_exercise_path(@brand["slug"], @material["slug"], position) : genera_impresa_brand_material_exercise_path(@brand["slug"], @material["slug"], position) } %>
<% image_path = ->(position) { percorso_integrato_context ? percorso_integrato_professional_material_image_path(@brand["slug"], @material["slug"], position) : genera_impresa_brand_material_image_path(@brand["slug"], @material["slug"], position) } %>
<% content_for :landing_nav do %><%= render(percorso_integrato_context ? "brands/percorso_integrato/header" : "brands/genera_impresa/header") %><% end %>

<main class="gym-sheet min-h-screen bg-slate-200 text-slate-950">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8"><div class="flex items-center justify-between gap-4"><%= link_to "← #{@brand['name']}", profile_path, class: "text-sm font-black text-sky-800 hover:text-sky-950" %><button type="button" onclick="window.print()" class="gym-sheet__print">Stampa scheda</button></div><div class="mt-6 flex flex-wrap items-center gap-2"><span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-black uppercase tracking-wider text-sky-800">Preparazione al nuoto</span><span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black uppercase tracking-wider text-amber-800"><%= @material["status"] %></span></div><h1 class="mt-4 text-3xl font-black tracking-tight sm:text-4xl"><%= @material["title"] %></h1><p class="mt-3 max-w-3xl leading-7 text-slate-600"><%= @material["description"] %></p><div class="mt-5 flex flex-wrap gap-2 text-xs font-black text-sky-900"><span class="rounded-full bg-sky-100 px-3 py-1.5">10 esercizi</span><span class="rounded-full bg-sky-100 px-3 py-1.5">Obiettivo</span><span class="rounded-full bg-sky-100 px-3 py-1.5">Esecuzione</span><span class="rounded-full bg-sky-100 px-3 py-1.5">Dose</span></div></div>
  </header>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="rounded-2xl border-2 border-slate-900 bg-white p-4">
      <div class="grid gap-3 text-sm sm:grid-cols-3"><div><strong>Atleta:</strong> ____________________</div><div><strong>Data:</strong> ____ / ____ / ______</div><div><strong>Istruttore:</strong> Davide Cattaneo</div></div>
      <div class="gym-sheet__desktop mt-4 hidden overflow-x-auto md:block">
        <table class="w-full min-w-[760px] border-collapse text-left text-sm">
          <thead><tr class="border-y-2 border-slate-900 bg-slate-100"><th class="w-14 p-2">N.</th><th class="w-24 p-2">Figura</th><th class="p-2">Esercizio ed esecuzione</th><th class="w-48 p-2">Dose</th><th class="w-28 p-2 text-center">Completato</th></tr></thead>
          <tbody>
    <% @material.fetch("exercises").each do |exercise| %>
              <tr class="border-b border-slate-300"><td class="p-2 text-lg font-black"><%= format("%02d", exercise["position"]) %></td><td class="p-2"><%= link_to exercise_path.call(exercise["position"]), aria: { label: "Apri #{exercise['title']}" } do %><%= image_tag image_path.call(exercise["position"]), alt: exercise["title"], class: "size-20 rounded-lg border border-slate-200 bg-slate-100 object-cover" %><% end %></td><td class="p-2"><h2 class="font-black"><%= link_to exercise["title"], exercise_path.call(exercise["position"]), class: "hover:text-sky-800" %></h2><p class="mt-1 text-xs leading-5 text-slate-600"><strong>Obiettivo:</strong> <%= exercise["objective"] %></p><p class="text-xs leading-5 text-slate-600"><strong>Esecuzione:</strong> <%= exercise["execution"] %></p><%= link_to "Apri esercizio →", exercise_path.call(exercise["position"]), class: "gym-sheet__exercise-link" %></td><td class="p-2 font-bold"><%= exercise["dose"] %></td><td class="p-2 text-center text-2xl tracking-widest">□ □</td></tr>
    <% end %>
          </tbody>
        </table>
      </div>
      <div class="gym-sheet__mobile mt-4 space-y-4 md:hidden">
        <% @material.fetch("exercises").each do |exercise| %>
          <article class="overflow-hidden rounded-2xl border border-slate-300"><%= link_to exercise_path.call(exercise["position"]), class: "grid grid-cols-[6rem_1fr] gap-4 bg-slate-50 p-3" do %><%= image_tag image_path.call(exercise["position"]), alt: exercise["title"], class: "size-24 rounded-xl border border-slate-200 bg-white object-cover" %><div><span class="text-xs font-black text-sky-700"><%= format("%02d", exercise["position"]) %></span><h2 class="mt-1 font-black"><%= exercise["title"] %></h2><p class="mt-2 text-xs font-black text-slate-700"><%= exercise["dose"] %></p></div><% end %><div class="space-y-3 p-4 text-sm leading-6"><p><strong>Obiettivo:</strong> <span class="text-slate-600"><%= exercise["objective"] %></span></p><p><strong>Come si esegue:</strong> <span class="text-slate-600"><%= exercise["execution"] %></span></p><%= link_to "Apri esercizio →", exercise_path.call(exercise["position"]), class: "gym-sheet__exercise-link" %><p class="border-t border-slate-200 pt-3 font-black">Completato: <span class="float-right text-xl tracking-widest">□ □</span></p></div></article>
        <% end %>
      </div>
      <div class="mt-4 grid gap-3 text-sm sm:grid-cols-[1fr_2fr]"><div><strong>Durata:</strong> __________</div><div><strong>Note:</strong> ____________________________________________________________</div></div>
    </div>
    <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><strong>Nota:</strong> dosaggi, spiegazioni e selezione degli esercizi devono essere rivisti da Davide prima dell'uso didattico pubblico.</div>
  </section>
</main>

<style>
  .gym-sheet__print{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:999px;background:#0f172a!important;color:#fff!important;padding:.65rem 1rem;font-size:.75rem;font-weight:900}.gym-sheet__print:hover{background:#334155!important}
  .gym-sheet__exercise-link{display:inline-flex;margin-top:.35rem;color:#0369a1!important;text-decoration:none;font-size:.72rem;font-weight:900}.gym-sheet__exercise-link:hover{text-decoration:underline}
  @media print{.gym-sheet{background:#fff!important}.gym-sheet__print,.gym-sheet__mobile,.gym-sheet~footer,body>header{display:none!important}.gym-sheet__desktop{display:block!important}.gym-sheet header{border:0!important}.gym-sheet section{padding-top:.5rem!important}.gym-sheet table{font-size:10px}.gym-sheet table img{width:48px;height:48px}.gym-sheet tr{break-inside:avoid}.gym-sheet .rounded-2xl{border-radius:0!important}}
</style>
