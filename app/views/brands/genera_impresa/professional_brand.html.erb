<% content_for :title, "#{@brand['name']} — Brand personale in costruzione" %>
<% content_for :description, @brand["description"] %>
<% content_for :landing_nav do %><%= render "brands/genera_impresa/header" %><% end %>

<main class="min-h-screen bg-slate-50 text-slate-950">
  <nav class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur" aria-label="Pagina di Davide Cattaneo">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
      <%= link_to @brand["name"], genera_impresa_brand_path(@brand["slug"]), class: "font-black" %>
      <div class="flex items-center gap-1 overflow-x-auto text-xs font-bold text-slate-600"><a href="#bio" class="rounded-full px-3 py-2 hover:bg-slate-100">Bio</a><a href="#attivita" class="rounded-full px-3 py-2 hover:bg-slate-100">Servizi</a><a href="#scheda" class="rounded-full px-3 py-2 hover:bg-slate-100">Scheda nuoto</a><a href="#contatti" class="davide-nav-contact">Contatta</a></div>
    </div>
  </nav>

  <header class="border-b border-sky-100 bg-gradient-to-br from-sky-950 via-sky-900 to-cyan-800 text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8">
      <div class="self-center">
        <div class="flex flex-wrap gap-2"><span class="rounded-full bg-white/10 px-3 py-1 text-xs font-black uppercase tracking-wider">Brand personale</span><span class="rounded-full bg-amber-300 px-3 py-1 text-xs font-black uppercase tracking-wider text-slate-950"><%= @brand["status_label"] %></span></div>
        <h1 class="mt-6 text-5xl font-black tracking-tight sm:text-6xl"><%= @brand["name"] %></h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-sky-100"><%= @brand["tagline"] %></p>
        <div class="mt-8 flex flex-wrap gap-3"><a href="#contatti" class="davide-action davide-action--light">Contatta per concordare</a><%= link_to "Apri la scheda · 10 esercizi", genera_impresa_brand_material_path(@brand["slug"], "scheda-nuoto"), class: "davide-action davide-action--outline" %></div>
      </div>
      <aside class="mx-auto flex max-w-xs items-center gap-4 rounded-3xl border border-white/15 bg-white/10 p-4 backdrop-blur lg:block lg:w-52"><%= image_tag @brand["profile_image_url"], alt: "Davide Cattaneo", class: "size-24 shrink-0 rounded-full border-2 border-white/30 bg-white/10 object-cover object-top lg:mx-auto lg:size-36" %><div class="lg:mt-4 lg:text-center"><p class="text-xs font-black uppercase tracking-wider text-cyan-200">Davide Cattaneo</p><p class="mt-2 text-xs leading-5 text-sky-100">Nuoto · benessere · postura</p></div></aside>
    </div>
  </header>

  <% biography = @brand.fetch("biography") %>
  <section id="bio" class="scroll-mt-28 border-b border-slate-200 bg-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-[.7fr_1.3fr] lg:px-8"><div><p class="text-xs font-black uppercase tracking-wider text-sky-700">Bio</p><h2 class="mt-2 text-3xl font-black"><%= biography["title"] %></h2></div><div class="space-y-4 text-base leading-7 text-slate-600"><% biography.fetch("paragraphs").each do |paragraph| %><p><%= paragraph %></p><% end %></div></div>
    <% if @brand["video"].present? %><div class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 lg:px-8"><a href="<%= @brand.dig("video", "url") %>" target="_blank" rel="noopener noreferrer" class="davide-video-link"><span class="davide-video-link__play" aria-hidden="true">▶</span><span><small>Davide in video</small><strong><%= @brand.dig("video", "label") %></strong><em>Si apre su YouTube</em></span><span class="davide-video-link__arrow" aria-hidden="true">→</span></a></div><% end %>
  </section>

  <section id="attivita" class="scroll-mt-28 mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <% qualifications = @brand.fetch("qualifications", []) %>
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div><p class="text-xs font-black uppercase tracking-wider text-sky-700">Servizi distinti</p><h2 class="mt-2 text-3xl font-black">Come posso aiutarti?</h2><p class="mt-3 max-w-3xl leading-7 text-slate-600">Nuoto, trattamento, educazione posturale ed eventi rispondono a bisogni diversi. Per questo vengono presentati separatamente.</p></div>
      <% if qualifications.any? %><button type="button" data-controller="modal" data-modal-dialog-id-value="davide-qualifications" data-action="click->modal#open" onclick="document.getElementById('davide-qualifications')?.showModal()" class="davide-qualifications-button">Formazione e attestati · <%= qualifications.size %></button><% end %>
    </div>
    <% service_styles = ["border-sky-200 bg-sky-50", "border-emerald-200 bg-emerald-50", "border-amber-200 bg-amber-50", "border-violet-200 bg-violet-50"] %>
    <% service_tags = [["In acqua", "Individuale o gruppo"], ["Individuale", "Benessere"], ["Educativo", "PosturaCorretta"], ["Società e aziende", "Su progetto"]] %>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <% @brand.fetch("roles", []).each_with_index do |role, index| %>
        <% role_qualifications = qualifications.select { |qualification| qualification["role"] == role["title"] } %>
        <% dialog_id = "davide-service-#{index + 1}" %>
        <article class="davide-service-card rounded-3xl border p-7 <%= service_styles[index] %>">
          <div class="flex items-center justify-between gap-3"><span class="text-xs font-black uppercase tracking-wider text-slate-500"><%= role["label"] %></span><span class="text-xs font-black text-slate-400"><%= format("%02d", index + 1) %></span></div>
          <h3 class="mt-4 text-3xl font-black tracking-tight text-slate-950"><%= role["title"] %></h3>
          <p class="mt-3 text-sm font-bold leading-6 text-slate-700"><%= role["audience"] %></p>
          <div class="mt-5 flex flex-wrap gap-2"><% service_tags.fetch(index, []).each do |tag| %><span class="davide-service-tag"><%= tag %></span><% end %><% if role_qualifications.any? %><span class="davide-service-tag davide-service-tag--verified">Attestato presente</span><% end %></div>
          <div class="mt-auto flex flex-wrap gap-2 pt-7"><button type="button" data-controller="modal" data-modal-dialog-id-value="<%= dialog_id %>" data-action="click->modal#open" onclick="document.getElementById('<%= dialog_id %>')?.showModal()" class="davide-service-button davide-service-button--detail">Scopri il servizio</button><a href="#contatti" class="davide-service-button davide-service-button--contact">Contatta</a></div>
        </article>
        <dialog id="<%= dialog_id %>" data-controller="modal" data-action="click->modal#backdropClose" onclick="if (event.target === this) this.close()" class="davide-dialog">
          <div class="davide-dialog__header"><div><p><%= role["label"] %></p><h2><%= role["title"] %></h2></div><button type="button" onclick="this.closest('dialog')?.close()" aria-label="Chiudi">✕</button></div>
          <div class="davide-dialog__body"><h3>Per chi</h3><p><%= role["audience"] %></p><h3>Che cosa propone</h3><p><%= role["description"] %></p><div class="davide-dialog__note"><strong>Confini del servizio</strong><span><%= role["boundary"] %></span></div><% if role["href"].present? %><a href="<%= role["href"] %>" target="_blank" rel="noopener" class="davide-role-link">Apri PosturaCorretta.org →</a><% end %><div class="mt-6 flex flex-wrap gap-3"><a href="#contatti" onclick="this.closest('dialog')?.close()" class="davide-service-button davide-service-button--contact">Contatta per concordare</a><button type="button" onclick="this.closest('dialog')?.close()" class="davide-service-button davide-service-button--detail">Chiudi</button></div></div>
        </dialog>
      <% end %>
    </div>
    <% if qualifications.any? %><dialog id="davide-qualifications" data-controller="modal" data-action="click->modal#backdropClose" onclick="if (event.target === this) this.close()" class="davide-dialog davide-dialog--wide"><div class="davide-dialog__header"><div><p>Formazione</p><h2>Attestati di Davide Cattaneo</h2></div><button type="button" onclick="this.closest('dialog')?.close()" aria-label="Chiudi">✕</button></div><div class="davide-dialog__body"><div class="grid gap-4"><% qualifications.each do |qualification| %><article class="grid gap-5 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:grid-cols-[9rem_1fr] sm:items-center"><%= image_tag qualification["image_url"], alt: "Attestato #{qualification['title']} di Davide Cattaneo", class: "h-28 w-full rounded-xl border border-slate-200 bg-white object-contain" %><div><p class="text-xs font-black uppercase tracking-wider text-sky-700"><%= qualification["issuer"] %></p><h3 class="mt-1 text-lg font-black text-slate-950"><%= qualification["title"] %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= qualification["status"] %></p><a href="<%= qualification["image_url"] %>" target="_blank" rel="noopener" class="mt-3 inline-flex text-sm font-black text-sky-800">Apri l’attestato originale →</a></div></article><% end %></div></div></dialog><% end %>
  </section>

  <% material = @brand.fetch("materials").first %>
  <section id="scheda" class="scroll-mt-28 border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <%= link_to genera_impresa_brand_material_path(@brand["slug"], material["slug"]), class: "davide-workout-link group grid gap-7 rounded-3xl border-2 border-sky-200 bg-sky-50 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center" do %>
        <div><p class="text-xs font-black uppercase tracking-wider text-sky-700">Scheda di preparazione al nuoto</p><h2 class="mt-2 text-3xl font-black text-slate-950"><%= material["title"] %></h2><p class="mt-4 max-w-3xl leading-7 text-slate-600"><%= material["description"] %></p><div class="mt-5 flex flex-wrap gap-2"><span>10 esercizi</span><span>Immagini</span><span>Descrizione</span><span>Dose indicativa</span></div></div>
        <div class="davide-workout-link__action">Apri la scheda <span aria-hidden="true">→</span></div>
      <% end %>
    </div>
  </section>

  <% contact = @brand.fetch("contact") %>
  <section id="contatti" class="scroll-mt-28 border-b border-slate-200 bg-sky-950 text-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_.9fr] lg:px-8">
      <div><p class="text-xs font-black uppercase tracking-wider text-cyan-300">Primo contatto</p><h2 class="mt-3 text-3xl font-black">Parliamone e definiamo la proposta</h2><p class="mt-4 max-w-2xl leading-7 text-sky-100">Le attività non sono prenotate automaticamente: prima bisogna capire che cosa serve e concordare insieme la proposta più adatta.</p><a href="mailto:<%= contact["email"] %>?subject=<%= ERB::Util.url_encode(contact["subject"]) %>" class="davide-contact-action">Contatta per concordare</a><p class="mt-4 max-w-xl text-xs leading-5 text-sky-300"><%= contact["note"] %></p></div>
      <div class="rounded-3xl border border-white/15 bg-white/10 p-6"><h3 class="font-black">Che cosa concordiamo</h3><ul class="mt-4 space-y-3"><% contact.fetch("agreements").each do |agreement| %><li class="flex gap-3 text-sm leading-6 text-sky-100"><span class="text-cyan-300" aria-hidden="true">✓</span><span><%= agreement %></span></li><% end %></ul></div>
    </div>
  </section>

  <section id="sviluppo" class="scroll-mt-28 mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-7 text-white sm:p-10"><p class="text-xs font-black uppercase tracking-wider text-amber-300">Demo GeneraImpresa</p><h2 class="mt-3 text-3xl font-black">Questo Brand è ancora in costruzione</h2><p class="mt-4 max-w-3xl leading-7 text-slate-300">La pagina mostra come potrebbe presentarsi Davide. Nome definitivo, offerte, confini professionali, luoghi e modalità di contatto devono essere verificati prima della pubblicazione autonoma.</p><ol class="mt-7 grid gap-3 md:grid-cols-2"><% @brand.fetch("next_steps", []).each_with_index do |step, index| %><li class="flex gap-3 rounded-2xl bg-white/10 p-4"><span class="font-black text-amber-300"><%= index + 1 %>.</span><span class="text-sm leading-6 text-slate-200"><%= step %></span></li><% end %></ol><%= link_to "Torna ai Brand di GeneraImpresa", "#{genera_impresa_path}#brand", class: "mt-7 inline-flex rounded-full bg-white px-5 py-3 text-sm font-black text-slate-950 hover:bg-slate-100" %></div>
  </section>
</main>

<style>
  .davide-action{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:.78rem 1.2rem;text-decoration:none;font-size:.875rem;font-weight:900;transition:.15s ease}.davide-action--light{background:#fff!important;color:#0c4a6e!important}.davide-action--light:hover{background:#e0f2fe!important}.davide-action--outline{border:1px solid rgb(255 255 255 / 45%);background:rgb(255 255 255 / 12%)!important;color:#fff!important}.davide-action--outline:hover{background:rgb(255 255 255 / 22%)!important}.davide-nav-contact{flex:none;border-radius:999px;background:#0c4a6e!important;color:#fff!important;padding:.5rem .8rem;text-decoration:none}.davide-nav-contact:hover{background:#0369a1!important}.davide-service-contact{display:inline-flex;margin-top:1.25rem;color:#075985!important;text-decoration:none;font-size:.78rem;font-weight:900}.davide-service-contact:hover{text-decoration:underline}.davide-contact-action{display:inline-flex;margin-top:1.5rem;border-radius:999px;background:#fff!important;color:#0c4a6e!important;padding:.8rem 1.1rem;text-decoration:none;font-size:.875rem;font-weight:900}.davide-contact-action:hover{background:#e0f2fe!important}.davide-workout-link{text-decoration:none!important}.davide-workout-link>div>div span{border-radius:999px;background:#fff;padding:.4rem .7rem;color:#075985;font-size:.7rem;font-weight:900}.davide-workout-link__action{display:inline-flex;min-height:3rem;align-items:center;justify-content:center;gap:.6rem;border-radius:999px;background:#0c4a6e!important;color:#fff!important;padding:.8rem 1.1rem;font-size:.875rem;font-weight:900;white-space:nowrap}.davide-workout-link:hover .davide-workout-link__action{background:#0369a1!important}
  .davide-service-card{display:flex;min-height:20rem;flex-direction:column}.davide-service-tag{display:inline-flex;border:1px solid rgb(15 23 42 / 12%);border-radius:999px;background:#fff!important;padding:.38rem .65rem;color:#475569;font-size:.68rem;font-weight:900}.davide-service-tag--verified{border-color:#86efac;color:#166534;background:#f0fdf4!important}.davide-service-button,.davide-qualifications-button{display:inline-flex;min-height:2.65rem;align-items:center;justify-content:center;border:1px solid transparent;border-radius:999px;padding:.65rem 1rem;text-decoration:none;font-size:.76rem;font-weight:900;cursor:pointer}.davide-service-button--detail,.davide-qualifications-button{border-color:#bae6fd!important;color:#075985!important;background:#fff!important}.davide-service-button--detail:hover,.davide-qualifications-button:hover{background:#e0f2fe!important}.davide-service-button--contact{border-color:#0c4a6e!important;color:#fff!important;background:#0c4a6e!important}.davide-service-button--contact:hover{background:#0369a1!important}.davide-dialog{margin:auto;width:calc(100% - 2rem);max-width:38rem;overflow:hidden;border:0;border-radius:1.5rem;background:#fff;padding:0;color:#0f172a;box-shadow:0 24px 70px rgb(15 23 42 / 30%)}.davide-dialog--wide{max-width:48rem}.davide-dialog::backdrop{background:rgb(15 23 42 / 65%);backdrop-filter:blur(3px)}.davide-dialog__header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;border-bottom:1px solid #e2e8f0;padding:1.25rem 1.5rem}.davide-dialog__header p{color:#0369a1;font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.davide-dialog__header h2{margin-top:.25rem;font-size:1.5rem;font-weight:900}.davide-dialog__header button{display:flex;width:2.4rem;height:2.4rem;align-items:center;justify-content:center;border:0;border-radius:999px;color:#475569;background:#f1f5f9!important;cursor:pointer}.davide-dialog__body{padding:1.5rem}.davide-dialog__body>h3{margin-top:1.25rem;font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.davide-dialog__body>h3:first-child{margin-top:0}.davide-dialog__body>p{margin-top:.4rem;line-height:1.7;color:#475569}.davide-dialog__note{display:grid;gap:.3rem;margin-top:1.5rem;border-radius:1rem;background:#f1f5f9!important;padding:1rem;color:#475569;font-size:.8rem;line-height:1.5}.davide-dialog__note strong{color:#0f172a}
  .davide-video-link{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;border:1px solid #fecaca;border-radius:1.25rem;background:#fff!important;padding:1rem;text-decoration:none;box-shadow:0 6px 20px rgb(15 23 42 / 6%)}.davide-video-link:hover{border-color:#f87171;box-shadow:0 10px 28px rgb(15 23 42 / 10%)}.davide-video-link__play{display:flex;width:3rem;height:3rem;align-items:center;justify-content:center;border-radius:999px;background:#dc2626!important;color:#fff!important;font-size:.9rem}.davide-video-link small,.davide-video-link strong,.davide-video-link em{display:block}.davide-video-link small{color:#b91c1c;font-size:.65rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.davide-video-link strong{margin-top:.15rem;color:#0f172a;font-size:1rem}.davide-video-link em{margin-top:.15rem;color:#64748b;font-size:.7rem;font-style:normal}.davide-video-link__arrow{color:#b91c1c;font-weight:900}.davide-role-link{display:inline-flex;margin-top:1rem;color:#075985!important;font-size:.82rem;font-weight:900;text-decoration:none}.davide-role-link:hover{text-decoration:underline}
  @media(max-width:639px){.davide-service-card{min-height:0;padding:1.25rem}.davide-service-card h3{font-size:1.55rem;line-height:1.15}.davide-service-button{flex:1}.davide-qualifications-button{width:100%}.davide-dialog{width:100%;max-height:88dvh;margin:auto 0 0;border-radius:1.5rem 1.5rem 0 0}.davide-dialog__body{max-height:calc(88dvh - 5rem);overflow-y:auto;padding:1.15rem}.davide-dialog__header{padding:1rem 1.15rem}.davide-video-link{grid-template-columns:auto 1fr}.davide-video-link__arrow{display:none}}
</style>
