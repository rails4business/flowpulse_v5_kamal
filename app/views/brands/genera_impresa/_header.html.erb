<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <% home_link = link_to genera_impresa_path, class: "flex items-center gap-3 font-black text-slate-950" do %>
      <span class="flex size-9 items-center justify-center rounded-full bg-red-600 text-xs font-black text-white">GI</span>
      <span>GeneraImpresa</span>
    <% end %>
    <%= home_link %>
    <nav class="flex items-center gap-1 text-sm font-bold text-slate-600" aria-label="GeneraImpresa">
      <div class="hidden items-center gap-1 sm:flex">
        <%= link_to "Brand", "#{genera_impresa_path}#brand", class: "rounded-lg px-3 py-2 hover:bg-slate-100 hover:text-slate-950" %>
        <%= link_to "Progetti", "#{genera_impresa_path}#progetti", class: "rounded-lg px-3 py-2 hover:bg-slate-100 hover:text-slate-950" %>
      </div>

      <% if authenticated? %>
        <details class="group relative [&_summary::-webkit-details-marker]:hidden" data-close-on-outside>
          <summary class="profile-menu-toggle min-h-10 cursor-pointer list-none justify-center gap-1.5 whitespace-nowrap rounded-full border border-slate-200 bg-white p-1 pl-1 pr-2.5 align-middle text-sm font-bold leading-none text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500" aria-label="Apri menu profilo">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-red-600 text-xs font-black leading-none text-white"><%= (Current.user.profile&.display_name || Current.user.email_address).first.upcase %></span>
            <span class="flex size-4 shrink-0 items-center justify-center" aria-hidden="true">
              <svg class="block size-4 origin-center text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"/></svg>
            </span>
          </summary>
          <div class="absolute right-0 z-[80] mt-2 w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
            <div class="px-3 py-2">
              <p class="truncate text-sm font-black text-slate-950"><%= Current.user.profile&.display_name.presence || "Profilo" %></p>
              <p class="truncate text-xs font-normal text-slate-500"><%= Current.user.email_address %></p>
            </div>
            <div class="my-1 border-t border-slate-100"></div>
            <%= link_to "I miei Brand", "#{genera_impresa_path}#i-miei-brand", class: "block rounded-lg px-3 py-2 text-sm font-bold text-red-700 hover:bg-red-50" %>
            <%= link_to "Dashboard", dashboard_home_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
            <%= link_to "Profilo", profile_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
            <% if Current.user.superadmin_user? %><%= link_to "Superadmin", admin_dashboard_path, class: "block rounded-lg px-3 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50" %><% end %>
            <%= button_to "Esci", session_path, method: :delete, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-red-600 hover:bg-red-50" %>
          </div>
        </details>
      <% else %>
        <%= link_to "Accedi", new_session_path(return_to: genera_impresa_path), class: "rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-black text-slate-700 shadow-sm hover:bg-slate-50" %>
      <% end %>
    </nav>
  </div>
</header>
