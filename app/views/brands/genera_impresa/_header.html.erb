<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <% home_link = link_to genera_impresa_path, class: "flex items-center gap-3 font-black text-slate-950" do %>
      <span class="flex size-9 items-center justify-center rounded-full bg-red-600 text-xs font-black text-white">GI</span>
      <span>GeneraImpresa</span>
    <% end %>
    <%= home_link %>
    <nav class="flex items-center gap-1 text-sm font-bold text-slate-600" aria-label="GeneraImpresa">
      <%= link_to "Brand", "#{genera_impresa_path}#brand", class: "rounded-lg px-3 py-2 hover:bg-slate-100 hover:text-slate-950" %>
      <%= link_to "Progetti", "#{genera_impresa_path}#progetti", class: "rounded-lg px-3 py-2 hover:bg-slate-100 hover:text-slate-950" %>
      <%= link_to "Superadmin", admin_dashboard_path, class: "rounded-lg px-3 py-2 text-blue-700 hover:bg-blue-50" if Current.user&.superadmin_user? %>
    </nav>
  </div>
</header>
