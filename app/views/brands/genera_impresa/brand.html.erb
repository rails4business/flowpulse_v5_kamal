<% content_for :title, "#{@brand['name']} — GeneraImpresa" %>
<% content_for :description, @brand["description"] %>
<% content_for :landing_nav do %><%= render "brands/genera_impresa/header" %><% end %>

<main class="min-h-screen bg-slate-50">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <%= link_to "← Tutti i brand", "#{genera_impresa_path}#brand", class: "text-sm font-bold text-slate-500 hover:text-slate-900" %>
      <div class="mt-8 flex items-start gap-5">
        <% if @brand["logo_url"].present? %><%= image_tag @brand["logo_url"], alt: "", class: "size-16 rounded-full object-contain" %><% end %>
        <div><p class="text-xs font-black uppercase tracking-wider text-red-600">Brand</p><h1 class="mt-2 text-4xl font-black"><%= @brand["name"] %></h1><p class="mt-3 max-w-2xl leading-7 text-slate-600"><%= @brand["description"] %></p></div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-wider text-red-600">Portfolio</p><h2 class="mt-2 text-2xl font-black">Progetti del brand</h2></div><% if @brand["website_url"].present? %><%= link_to "Visita il sito ↗", @brand["website_url"], target: "_blank", rel: "noopener", class: "text-sm font-black text-red-600" %><% end %></div>
    <div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3"><% @brand.fetch("projects", []).each do |project| %><%= render "brands/genera_impresa/project_card", project: project %><% end %></div>
  </section>
</main>
