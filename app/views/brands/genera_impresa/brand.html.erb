<% content_for :title, "#{@brand['name']} — GeneraImpresa" %>
<% content_for :description, @brand["description"] %>
<% content_for :landing_nav do %><%= render "brands/genera_impresa/header" %><% end %>

<main class="min-h-screen bg-slate-50">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <%= link_to "← Tutti i brand", "#{genera_impresa_path}#brand", class: "text-sm font-bold text-slate-500 hover:text-slate-900" %>
      <div class="mt-8 flex items-start gap-5">
        <% if @brand["logo_url"].present? %><%= image_tag @brand["logo_url"], alt: "", class: "size-16 rounded-full object-contain" %><% end %>
        <div>
          <div class="flex flex-wrap items-center gap-2"><p class="text-xs font-black uppercase tracking-wider text-red-600"><%= @brand["kind_label"].presence || "Brand" %></p><% if @brand["status_label"].present? %><span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-amber-800"><%= @brand["status_label"] %></span><% end %></div>
          <h1 class="mt-2 text-4xl font-black"><%= @brand["name"] %></h1>
          <p class="mt-3 max-w-2xl leading-7 text-slate-600"><%= @brand["description"] %></p>
        </div>
      </div>
    </div>
  </section>

  <% if @brand["positioning"].present? || @brand["roles"].present? %>
    <section class="border-b border-slate-200 bg-amber-50/60">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[.8fr_1.2fr] lg:px-8">
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-amber-800">Proposta personale</p>
          <h2 class="mt-2 text-2xl font-black">Che cosa può portare Davide</h2>
          <p class="mt-4 leading-7 text-slate-700"><%= @brand["positioning"] %></p>
          <p class="mt-4 text-sm leading-6 text-slate-600">La scheda serve a costruire e verificare il Brand. Non presenta ancora un'offerta definitiva.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <% @brand.fetch("roles", []).each do |role| %>
            <article class="rounded-2xl border border-amber-200 bg-white p-5"><h3 class="font-black"><%= role["title"] %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= role["description"] %></p></article>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if @brand["project_ideas"].present? %>
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <p class="text-xs font-black uppercase tracking-wider text-red-600">Dal Brand ai progetti</p>
      <h2 class="mt-2 text-2xl font-black">Progetti da costruire e validare</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Ogni proposta resta un progetto distinto, con un proprio risultato e un responsabile. GeneraImpresa aiuta a provarla prima di presentarla come servizio già definito.</p>
      <div class="mt-7 grid gap-5 lg:grid-cols-3">
        <% @brand.fetch("project_ideas").each do |project| %>
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-slate-600"><%= project["status"] %></span>
            <h3 class="mt-4 text-lg font-black"><%= project["title"] %></h3>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= project["description"] %></p>
            <% if project["material"].present? %><p class="mt-4 border-t border-slate-100 pt-3 text-xs font-bold leading-5 text-slate-500"><%= project["material"] %></p><% end %>
            <p class="mt-4 text-xs font-black uppercase tracking-wider text-red-700">Responsabile · Davide Cattaneo</p>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @brand["connections"].present? || @brand["next_steps"].present? %>
    <section class="border-y border-slate-200 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:px-8">
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-red-600">Ecosistema</p><h2 class="mt-2 text-2xl font-black">Collegamenti del Brand</h2>
          <div class="mt-5 space-y-3"><% @brand.fetch("connections", []).each do |connection| %><article class="rounded-2xl bg-slate-50 p-5"><p class="text-[10px] font-black uppercase tracking-wider text-slate-400"><%= connection["label"] %></p><h3 class="mt-1 font-black"><% if connection["href"].present? %><%= link_to connection["title"], connection["href"], class: "hover:text-red-700" %><% else %><%= connection["title"] %><% end %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= connection["description"] %></p></article><% end %></div>
        </div>
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-red-600">GeneraImpresa</p><h2 class="mt-2 text-2xl font-black">Prossimi passi</h2>
          <ol class="mt-5 space-y-3"><% @brand.fetch("next_steps", []).each_with_index do |step, index| %><li class="flex gap-3 rounded-2xl bg-slate-50 p-4"><span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-black text-white"><%= index + 1 %></span><span class="pt-0.5 text-sm leading-6 text-slate-700"><%= step %></span></li><% end %></ol>
        </div>
      </div>
    </section>
  <% end %>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-wider text-red-600">Portfolio</p><h2 class="mt-2 text-2xl font-black">Progetti del brand</h2></div><% if @brand["website_url"].present? %><%= link_to "Visita il sito ↗", @brand["website_url"], target: "_blank", rel: "noopener", class: "text-sm font-black text-red-600" %><% end %></div>
    <% if @brand.fetch("projects", []).any? %><div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3"><% @brand.fetch("projects", []).each do |project| %><%= render "brands/genera_impresa/project_card", project: project %><% end %></div><% else %><div class="mt-7 rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-sm leading-6 text-slate-600">I progetti qui sopra sono ancora in costruzione. Entreranno nel portfolio quando avranno obiettivo, responsabile e primo ciclo di validazione definiti.</div><% end %>
  </section>
</main>
<footer class="border-t border-slate-200 bg-white px-5 py-6 text-center text-sm"><%= render "shared/changelog_footer_link", brand: "generaimpresa", class_name: "font-bold text-red-700 hover:text-red-900" %></footer>
