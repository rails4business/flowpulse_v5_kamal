<% if brands.any? %>
  <section class="<%= local_assigns[:section_class] %>">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-black uppercase tracking-wider text-red-600"><%= eyebrow %></p>
      <h2 class="mt-2 text-3xl font-black"><%= title %></h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600"><%= description %></p>
      <div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% brands.each do |brand| %>
          <%= link_to genera_impresa_brand_path(brand.fetch("slug")), class: "rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-red-200 hover:shadow-md" do %>
            <div class="flex items-center gap-4">
              <% if brand["logo_url"].present? %><%= image_tag brand["logo_url"], alt: "", class: "size-12 rounded-full object-contain" %><% elsif brand["profile_image_url"].present? %><%= image_tag brand["profile_image_url"], alt: "", class: "size-12 rounded-full object-cover" %><% else %><span class="flex size-12 items-center justify-center rounded-full bg-red-600 text-xs font-black text-white"><%= brand["name"].first(2).upcase %></span><% end %>
              <div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h3 class="font-black text-slate-950"><%= brand["name"] %></h3><span class="rounded-full px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= brand['status'] == 'launched' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= brand["status_label"] %></span></div><p class="mt-1 text-xs font-bold text-slate-400"><%= brand["kind_label"] %></p></div>
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-600"><%= brand["description"] %></p>
            <div class="mt-4 flex flex-wrap items-center gap-2 text-[11px] font-bold"><% if brand["domain"].present? %><span class="rounded-full bg-sky-50 px-2.5 py-1 text-sky-800"><%= brand["domain"] %></span><% else %><span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-500">Dominio non assegnato</span><% end %><span class="text-slate-400"><%= brand.fetch("projects", []).size + brand.fetch("project_ideas", []).size %> progetti</span></div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
