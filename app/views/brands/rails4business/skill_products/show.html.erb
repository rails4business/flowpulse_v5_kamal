<% content_for :title, "#{@product.title} — #{@skill.title}" %>

<main class="min-h-screen bg-stone-50 text-slate-900">
  <%= render "landing/rails4b_nav", active: :skills %>
  <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8">
    <%= link_to "← #{@skill.title}", rails4b_skill_path(@skill), class: "text-sm font-black text-violet-700 hover:underline" %>
    <header class="mt-5 border-b border-slate-200 pb-8">
      <p class="text-xs font-black uppercase tracking-[.16em] text-emerald-700"><%= @product.node.title %> · <%= @skill.title %></p>
      <h1 class="mt-2 text-4xl font-black tracking-[-.045em]"><%= @product.title %></h1>
      <p class="mt-3 font-mono text-xs text-slate-400"><%= @product.slug %></p>
    </header>

    <%= form_with model: @product, url: rails4b_skill_product_path(@skill, @product), class: "mt-8 space-y-8" do |form| %>
      <% if @product.errors.any? %><p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700"><%= @product.errors.full_messages.to_sentence %></p><% end %>
      <section class="grid gap-5 rounded-3xl border border-slate-200 bg-white p-6 md:grid-cols-2 sm:p-8">
        <div><%= form.label :title, "Titolo", class: "text-sm font-black" %><%= form.text_field :title, required: true, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" %></div>
        <div><%= form.label :slug, "Slug", class: "text-sm font-black" %><%= form.text_field :slug, required: true, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-mono" %></div>
        <div><%= form.label :reusable_skill_node_id, "Node produttore", class: "text-sm font-black" %><%= form.collection_select :reusable_skill_node_id, @activations, :id, ->(activation) { activation.node.title }, {}, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3" %></div>
        <div><%= form.label :format, "Formato", class: "text-sm font-black" %><%= form.select :format, SkillProduct::FORMATS.map { |format| [format.humanize, format] }, {}, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3" %></div>
        <div><%= form.label :status, "Stato", class: "text-sm font-black" %><%= form.select :status, SkillProduct::STATUSES.map { |status| [status.humanize, status] }, {}, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3" %></div>
        <div><%= form.label :visibility, "Visibilità", class: "text-sm font-black" %><%= form.select :visibility, SkillProduct::VISIBILITIES.map { |visibility| [visibility.humanize, visibility] }, {}, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3" %></div>
        <div class="md:col-span-2"><%= form.label :source_path, "Percorso del file nella repository", class: "text-sm font-black" %><%= form.text_field :source_path, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm" %></div>
        <div class="md:col-span-2"><%= form.label :body, "Markdown", class: "text-sm font-black" %><%= form.text_area :body, rows: 16, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm leading-6" %></div>
        <div class="md:col-span-2"><%= form.label :data_json, "Dati JSON", class: "text-sm font-black" %><%= form.text_area :data_json, value: JSON.pretty_generate(@product.data), rows: 10, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm leading-6" %></div>
      </section>
      <%= form.submit "Salva prodotto", class: "rounded-full bg-emerald-600 px-6 py-3 text-sm font-black text-white hover:bg-emerald-700" %>
    <% end %>
  </div>
</main>
