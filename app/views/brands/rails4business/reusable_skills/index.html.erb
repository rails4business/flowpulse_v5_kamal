<% content_for :title, "Skill — Rails4Business" %>

<main class="min-h-screen bg-stone-50 text-slate-900">
  <%= render "landing/rails4b_nav", active: :skills %>
  <header class="border-b border-blue-100 bg-gradient-to-br from-violet-50 via-white to-blue-50">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
      <p class="text-xs font-black uppercase tracking-[.18em] text-violet-700">Capacità riutilizzabili</p>
      <h1 class="mt-3 text-4xl font-black tracking-[-.045em] sm:text-5xl">Skill</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Una Skill è una funzione che sviluppiamo una volta e possiamo attivare in Brand diversi: contenuti, corsi, schede, contatti, luoghi, eventi o prenotazioni. I materiali e i dati rimangono del singolo Brand.</p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl space-y-10 px-5 py-10 sm:px-8">
    <% groups = [[%w[idea design], "Da progettare"], [%w[development testing], "In costruzione"], [%w[available maintenance], "Disponibili"], [%w[archived], "Archiviate"]] %>
    <div class="grid gap-6 lg:grid-cols-2">
      <% groups.each do |statuses, label| %>
        <% grouped_skills = statuses.flat_map { |status| @skills_by_status.fetch(status, []) } %>
        <section class="rounded-3xl border border-slate-200 bg-white p-6">
          <h2 class="text-xl font-black"><%= label %></h2>
          <div class="mt-5 space-y-3">
            <% grouped_skills.each do |skill| %>
              <%= link_to rails4b_skill_path(skill), class: "block rounded-2xl border border-slate-200 p-4 transition hover:border-violet-300 hover:bg-violet-50/40" do %>
                <div class="flex flex-wrap items-center justify-between gap-2"><h3 class="font-black"><%= skill.title %></h3><span class="rounded-full bg-slate-100 px-2.5 py-1 text-[.68rem] font-black uppercase tracking-wide text-slate-600"><%= skill.status_label %></span></div>
                <p class="mt-1 text-xs font-bold text-violet-700"><%= skill.category_label %></p>
                <% if skill.description.present? %><p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500"><%= skill.description %></p><% end %>
                <% if skill.nodes.any? %><p class="mt-3 text-xs font-bold text-slate-400">Attiva in <%= skill.nodes.map(&:title).to_sentence %></p><% end %>
              <% end %>
            <% end %>
            <% if grouped_skills.empty? %><p class="text-sm text-slate-400">Nessuna Skill in questa fase.</p><% end %>
          </div>
        </section>
      <% end %>
    </div>

    <section class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
      <h2 class="text-2xl font-black">Aggiungi una Skill</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300">Descrivi la capacità comune, non il contenuto di uno specifico Brand. “Corsi online” è una Skill; “Inizia con PosturaCorretta” è un corso del Brand.</p>
      <% if @skill.errors.any? %><p class="mt-4 rounded-xl bg-red-950 p-3 text-sm font-bold text-red-100"><%= @skill.errors.full_messages.to_sentence %></p><% end %>
      <%= form_with model: @skill, url: rails4b_skills_path, class: "mt-6 grid gap-4 md:grid-cols-2" do |form| %>
        <%= form.text_field :title, required: true, placeholder: "Nome della Skill", class: "rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500" %>
        <%= form.select :category, ReusableSkill::CATEGORIES.map { |value, label| [label, value] }, {}, class: "rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white" %>
        <%= form.text_area :description, rows: 3, placeholder: "Che cosa permette di fare?", class: "rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 md:col-span-2" %>
        <%= form.submit "Crea la Skill", class: "w-fit rounded-full bg-violet-500 px-5 py-3 text-sm font-black text-white hover:bg-violet-400" %>
      <% end %>
    </section>
  </div>
</main>
