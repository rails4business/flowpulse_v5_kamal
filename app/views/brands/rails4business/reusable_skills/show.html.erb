<% content_for :title, "#{@skill.title} — Skill Rails4Business" %>

<main class="min-h-screen bg-stone-50 text-slate-900">
  <%= render "landing/rails4b_nav", active: :skills %>
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
    <%= link_to "← Tutte le Skill", rails4b_skills_path, class: "text-sm font-black text-violet-700 hover:underline" %>
    <header class="mt-5 border-b border-slate-200 pb-8"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-[.16em] text-violet-700"><%= @skill.category_label %></p><h1 class="mt-2 text-4xl font-black tracking-[-.045em]"><%= @skill.title %></h1><p class="mt-3 font-mono text-xs text-slate-400"><%= @skill.slug %></p></div><span class="rounded-full bg-violet-100 px-4 py-2 text-sm font-black text-violet-800"><%= @skill.status_label %></span></div></header>

    <%= form_with model: @skill, url: rails4b_skill_path(@skill), class: "mt-8 space-y-8" do |form| %>
      <% if @skill.errors.any? %><p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700"><%= @skill.errors.full_messages.to_sentence %></p><% end %>
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8"><h2 class="text-xl font-black">Definizione della Skill</h2><div class="mt-6 grid gap-6 md:grid-cols-2">
        <div><%= form.label :title, "Nome", class: "text-sm font-black" %><%= form.text_field :title, required: true, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" %></div>
        <div><%= form.label :slug, "Slug", class: "text-sm font-black" %><%= form.text_field :slug, required: true, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-mono" %></div>
        <div><%= form.label :category, "Categoria", class: "text-sm font-black" %><%= form.select :category, ReusableSkill::CATEGORIES.map { |value, label| [label, value] }, {}, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3" %></div>
        <div><%= form.label :status, "Stato", class: "text-sm font-black" %><%= form.select :status, ReusableSkill::STATUS_LABELS.map { |value, label| [label, value] }, {}, class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3" %></div>
        <% [[:description, "Descrizione", "Che cosa permette di fare?"], [:purpose, "A che cosa serve", "Quale utilità comune offre ai Brand?"], [:operation_notes, "Come funziona", "Componenti, regole e comportamento generale."], [:reuse_notes, "Come si riutilizza", "Che cosa è comune e che cosa deve configurare ogni Brand?"]].each do |name, label, hint| %><div class="md:col-span-2"><%= form.label name, label, class: "text-sm font-black" %><p class="mt-1 text-sm text-slate-500"><%= hint %></p><%= form.text_area name, rows: 4, class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 leading-7" %></div><% end %>
      </div></section>

      <section class="rounded-3xl border border-blue-200 bg-blue-50/50 p-6 sm:p-8"><h2 class="text-xl font-black">Brand e progetti che la usano</h2><p class="mt-2 text-sm leading-6 text-slate-600">Seleziona i Node nei quali la Skill è attiva o in sperimentazione.</p><div class="mt-5 grid gap-3 sm:grid-cols-2"><%= form.collection_check_boxes :node_ids, @node_options, :id, :title do |box| %><label class="flex items-center gap-3 rounded-xl border border-blue-200 bg-white p-3 font-bold"><%= box.check_box(class: "size-4 rounded border-slate-300") %><span><%= box.text %></span></label><% end %></div></section>

      <section class="rounded-3xl border border-amber-200 bg-amber-50/50 p-6 sm:p-8"><h2 class="text-xl font-black">Problemi collegati</h2><p class="mt-2 text-sm leading-6 text-slate-600">Il collegamento è facoltativo: una Skill può nascere da un problema, modificarlo o risolverne più di uno.</p><div class="mt-5 grid gap-3 sm:grid-cols-2"><%= form.collection_check_boxes :problem_solving_cycle_ids, @problem_options, :id, :title do |box| %><label class="flex items-center gap-3 rounded-xl border border-amber-200 bg-white p-3 font-bold"><%= box.check_box(class: "size-4 rounded border-slate-300") %><span><%= box.text %></span></label><% end %><% if @problem_options.empty? %><p class="text-sm text-slate-500">Non hai ancora registrato problemi.</p><% end %></div></section>

      <%= form.submit "Salva la Skill", class: "rounded-full bg-violet-600 px-6 py-3 text-sm font-black text-white hover:bg-violet-700" %>
    <% end %>
  </div>
</main>
