<main class="min-h-screen bg-slate-50 py-8">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <%= link_to "← Esperienze", impegno_experiences_path, class: "text-sm font-bold text-slate-600 hover:text-slate-950" %>
    <section class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"><p class="text-xs font-black uppercase tracking-[0.16em] text-blue-700">Nuova esperienza · solo superadmin</p><h1 class="mt-1 text-3xl font-black text-slate-950">Da cosa vuoi partire?</h1><%= form_with model: @experience, url: impegno_experiences_path, class: "mt-6 space-y-4" do |form| %><% if @experience.errors.any? %><p class="rounded-lg bg-red-50 p-3 text-sm text-red-700"><%= @experience.errors.full_messages.to_sentence %></p><% end %><div><%= form.label :title, "Nome esperienza", class: "text-sm font-bold text-slate-800" %><%= form.text_field :title, required: true, autofocus: true, placeholder: "Es. Lezioni gruppo del venerdì", class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm" %></div><div><%= form.label :brand_process_id, "Processo del Brand", class: "text-sm font-bold text-slate-800" %><%= form.collection_select :brand_process_id, @brand_processes, :id, ->(process_record) { "#{process_record.node.title} · #{process_record.title}" }, { include_blank: "Nessun processo per ora" }, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm" %></div><div><%= form.label :description, "Descrizione", class: "text-sm font-bold text-slate-800" %><%= form.text_area :description, rows: 4, placeholder: "Facoltativa", class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm" %></div><%= form.submit "Crea esperienza →", class: "cursor-pointer rounded-xl bg-blue-600 px-5 py-3 text-sm font-black text-white hover:bg-blue-700" %><% end %></section>
  </div>
</main>
