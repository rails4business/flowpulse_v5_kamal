<dialog data-experience-add-target="dialog" data-action="click->experience-add#closeFromBackdrop cancel->experience-add#close" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50">
  <div class="p-5 sm:p-6">
    <div class="mb-5 flex items-start justify-between gap-4"><div><h2 data-experience-add-target="title" class="text-lg font-semibold text-slate-950">Nuova Sessione</h2><p data-experience-add-target="description" class="mt-1 text-sm text-slate-500">Direttamente nell’esperienza.</p></div><button type="button" data-action="experience-add#close" class="rounded-full p-2 text-slate-400 hover:bg-slate-100" aria-label="Chiudi">✕</button></div>
    <% [["session", DataSession.new, impegno_experience_sessions_path(experience), "Nome della Sessione", "Aggiungi Sessione"], ["slot", DataSlot.new, impegno_experience_slots_path(experience), "Nome dello Slot", "Aggiungi Slot"], ["commitment", Brands::Impegno::Commitment.new, impegno_experience_commitments_path(experience), "Nome dell’impegno", "Aggiungi Impegno"]].each_with_index do |(kind, record, url, label, submit), index| %>
      <div data-experience-add-target="panel" data-experience-add-kind-param="<%= kind %>" class="<%= "hidden" unless index.zero? %>">
        <%= form_with model: record, url: url, html: { data: { experience_add_default_url: url } }, class: "space-y-4" do |form| %>
          <div><%= form.label :title, label, class: "mb-1 block text-sm font-medium text-slate-700" %><%= form.text_field :title, required: true, autofocus: index.zero?, class: "block w-full rounded-lg border-slate-300 px-3 py-2 text-sm shadow-sm" %></div>
          <% if kind == "session" %>
            <div><%= form.label :professional_calendar_id, "Calendario professionale", class: "mb-1 block text-sm font-medium text-slate-700" %><%= form.collection_select :professional_calendar_id, @professional_calendars, :id, :full_label, { include_blank: "Da programmare senza calendario" }, class: "block w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-sm shadow-sm" %></div>
            <div class="grid grid-cols-2 gap-3">
              <div><%= form.label :service_id, "Servizio facoltativo", class: "mb-1 block text-sm font-medium text-slate-700" %><%= form.collection_select :service_id, @services, :id, :display_label, { include_blank: "Nessun servizio" }, class: "block w-full rounded-lg border-slate-300 bg-white px-2 py-2 text-xs shadow-sm" %></div>
              <div><%= form.label :visibility, "Visibilità", class: "mb-1 block text-sm font-medium text-slate-700" %><%= form.select :visibility, [["Privata", "private"], ["Pubblica", "public"]], {}, class: "block w-full rounded-lg border-slate-300 bg-white px-2 py-2 text-xs shadow-sm" %></div>
            </div>
          <% end %>
          <div class="grid grid-cols-2 gap-3"><div><%= form.label :starts_at, "Inizio", class: "mb-1 block text-sm font-medium text-slate-700" %><%= form.datetime_local_field :starts_at, class: "block w-full rounded-lg border-slate-300 px-2 py-2 text-xs shadow-sm" %></div><div><%= form.label :ends_at, "Fine", class: "mb-1 block text-sm font-medium text-slate-700" %><%= form.datetime_local_field :ends_at, class: "block w-full rounded-lg border-slate-300 px-2 py-2 text-xs shadow-sm" %></div></div>
          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4"><button type="button" data-action="experience-add#close" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100">Annulla</button><%= form.submit submit, class: "cursor-pointer rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %></div>
        <% end %>
      </div>
    <% end %>
  </div>
</dialog>
