<dialog data-experience-item-edit-target="dialog" data-action="click->experience-item-edit#closeFromBackdrop cancel->experience-item-edit#close" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50">
  <form method="post" data-experience-item-edit-target="form" data-turbo-frame="experience_workbench" class="p-5 sm:p-6">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <%= hidden_field_tag :_method, :patch %>
    <div class="mb-5 flex items-start justify-between gap-4">
      <h2 data-experience-item-edit-target="heading" class="text-lg font-semibold text-slate-950">Modifica</h2>
      <button type="button" data-action="experience-item-edit#close" class="rounded-full p-2 text-slate-400 hover:bg-slate-100" aria-label="Chiudi">✕</button>
    </div>
    <div class="space-y-4">
      <div><label for="experience-edit-title" class="mb-1 block text-sm font-medium text-slate-700">Nome</label><input id="experience-edit-title" data-experience-item-edit-target="title" type="text" required class="block w-full rounded-lg border-slate-300 px-3 py-2 text-sm shadow-sm"></div>
      <div data-experience-item-edit-target="descriptionRow" class="hidden"><label for="experience-edit-description" class="mb-1 block text-sm font-medium text-slate-700">Descrizione</label><textarea id="experience-edit-description" data-experience-item-edit-target="description" rows="4" class="block w-full rounded-lg border-slate-300 px-3 py-2 text-sm shadow-sm"></textarea></div>
      <div data-experience-item-edit-target="processRow" class="hidden"><label for="experience-edit-process" class="mb-1 block text-sm font-medium text-slate-700">Processo del Brand</label><select id="experience-edit-process" data-experience-item-edit-target="process" class="block w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-sm shadow-sm"><option value="">Nessun processo per ora</option><% @brand_processes.each do |process_record| %><option value="<%= process_record.id %>"><%= process_record.node.title %> · <%= process_record.title %></option><% end %></select></div>
      <div data-experience-item-edit-target="sessionContextRow" class="hidden space-y-3">
        <div><label for="experience-edit-calendar" class="mb-1 block text-sm font-medium text-slate-700">Calendario professionale</label><select id="experience-edit-calendar" data-experience-item-edit-target="calendar" class="block w-full rounded-lg border-slate-300 bg-white px-3 py-2 text-sm shadow-sm"><option value="">Da programmare senza calendario</option><% @professional_calendars.each do |calendar| %><option value="<%= calendar.id %>"><%= calendar.full_label %></option><% end %></select></div>
        <div class="grid grid-cols-2 gap-3"><div><label for="experience-edit-service" class="mb-1 block text-sm font-medium text-slate-700">Servizio facoltativo</label><select id="experience-edit-service" data-experience-item-edit-target="service" class="block w-full rounded-lg border-slate-300 bg-white px-2 py-2 text-xs shadow-sm"><option value="">Nessun servizio</option><% @services.each do |service| %><option value="<%= service.id %>"><%= service.display_label %></option><% end %></select></div><div><label for="experience-edit-visibility" class="mb-1 block text-sm font-medium text-slate-700">Visibilità</label><select id="experience-edit-visibility" data-experience-item-edit-target="visibility" class="block w-full rounded-lg border-slate-300 bg-white px-2 py-2 text-xs shadow-sm"><option value="private">Privata</option><option value="public">Pubblica</option></select></div></div>
      </div>
      <div data-experience-item-edit-target="datesRow" class="grid grid-cols-2 gap-3"><div><label for="experience-edit-starts-at" class="mb-1 block text-sm font-medium text-slate-700">Inizio</label><input id="experience-edit-starts-at" data-experience-item-edit-target="startsAt" type="datetime-local" class="block w-full rounded-lg border-slate-300 px-2 py-2 text-xs shadow-sm"></div><div><label for="experience-edit-ends-at" class="mb-1 block text-sm font-medium text-slate-700">Fine</label><input id="experience-edit-ends-at" data-experience-item-edit-target="endsAt" type="datetime-local" class="block w-full rounded-lg border-slate-300 px-2 py-2 text-xs shadow-sm"></div></div>
      <div data-experience-item-edit-target="statusRow" class="hidden"><label for="experience-edit-status" class="mb-1 block text-sm font-medium text-slate-700">Stato</label><select id="experience-edit-status" data-experience-item-edit-target="status" class="block w-full rounded-lg border-slate-300 px-3 py-2 text-sm shadow-sm"><% Brands::Impegno::Commitment::STATUSES.each do |status| %><option value="<%= status %>"><%= status.humanize %></option><% end %></select></div>
    </div>
    <div class="mt-5 flex justify-end gap-2 border-t border-slate-100 pt-4"><button type="button" data-action="experience-item-edit#close" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100">Annulla</button><button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">Salva</button></div>
  </form>
</dialog>
