<fieldset class="rounded-xl border border-amber-200 bg-amber-50/60 p-4" data-content-publication-fields>
  <% defaults = local_assigns.fetch(:defaults, {}) %>
  <% publication_object = form.object if form.object.respond_to?(:content_key) %>
  <legend class="px-1 text-xs font-black uppercase tracking-wider text-amber-800">Pubblicazione contenuto</legend>
  <p class="mb-4 text-xs leading-5 text-amber-900">Compila questi campi quando il tipo dell’impegno è “Contenuto”. Il collegamento a Sessione, Slot e Servizio verrà aggiunto in seguito.</p>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= render "brands/impegno/commitments/node_field", form:, defaults: %>
    <div class="sm:col-span-2"><%= form.label :content_key, "ID del contenuto collegato", class: "text-xs font-bold text-slate-700" %><%= form.text_field :content_key, value: (publication_object&.content_key.presence || defaults[:content_key]), placeholder: "inizia-incontro-salute-metodiche", class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm" %><p class="mt-1 text-xs text-slate-500">È l’ID editoriale stabile presente nel catalogo YAML. Per i contenuti storici senza ID viene usato lo slug.</p></div>
    <div><%= form.label :publication_status, "Stato editoriale", class: "text-xs font-bold text-slate-700" %><%= form.select :publication_status, [["Bozza", "draft"], ["Pubblicato", "published"], ["Archiviato", "archived"]], {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
    <div><%= form.label :publication_visibility, "Visibilità editoriale", class: "text-xs font-bold text-slate-700" %><%= form.select :publication_visibility, [["Privato", "private"], ["Member", "member"], ["Pubblico", "public"]], {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
  </div>
  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div><%= form.label :publication_change_kind, "Tipo di intervento", class: "text-xs font-bold text-slate-700" %><%= form.select :publication_change_kind, [["Pubblicazione", "publish"], ["Aggiornamento", "update"], ["Correzione", "fix"], ["Ritiro in bozza", "unpublish"], ["Archiviazione", "archive"]], { selected: (publication_object&.publication_change_kind.presence || defaults[:publication_change_kind]) }, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
    <div class="sm:col-span-2"><%= form.label :publication_note_md, "Note dell’intervento (Markdown)", class: "text-xs font-bold text-slate-700" %><%= form.text_area :publication_note_md, rows: 4, placeholder: "Descrivi cosa è stato pubblicato, aggiornato o corretto…", class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
  </div>
  <% selected_access_modes = form.object.respond_to?(:access_modes) ? Array(form.object.access_modes) : [] %>
  <% selected_access_modes = ["free"] if selected_access_modes.empty? %>
  <fieldset class="mt-4 rounded-lg border border-amber-200 bg-white/70 p-3" data-controller="access-modes">
    <legend class="px-1 text-xs font-bold text-slate-700">Accesso economico</legend>
    <%= hidden_field_tag "data_commitment[access_modes][]", "" %>
    <div class="mt-2 grid gap-2 sm:grid-cols-3">
      <% [["Libero", "free"], ["Abbonamento", "subscription"], ["Acquisto", "purchase"]].each do |label, value| %>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <%= check_box_tag "data_commitment[access_modes][]", value, selected_access_modes.include?(value), id: "#{form.object_name}_access_modes_#{value}", class: "rounded border-slate-300 text-amber-600", data: { access_modes_target: "option", action: "change->access-modes#change" } %>
          <span><%= label %></span>
        </label>
      <% end %>
    </div>
    <p class="mt-2 text-xs leading-5 text-slate-500">Abbonamento e acquisto possono essere selezionati insieme. L’accesso libero deve restare da solo.</p>
  </fieldset>
  <label class="mt-4 flex items-start gap-2 text-sm text-slate-700"><%= form.check_box :publish_on_completion, class: "mt-0.5 rounded border-slate-300 text-amber-600" %><span><strong>Pubblica quando concludo l’impegno</strong><small class="mt-0.5 block text-xs text-slate-500">La pubblicazione effettiva verrà attivata solo dopo il collegamento al Content e il controllo dei permessi.</small></span></label>
  <% if form.object.respond_to?(:published_at) && form.object.published_at.present? %><p class="mt-3 text-xs font-bold text-emerald-700">Pubblicato il <%= l(form.object.published_at, format: :long) %></p><% end %>
</fieldset>
