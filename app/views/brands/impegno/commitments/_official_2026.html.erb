<body class="oi-page">
<!-- RAILS: il contenitore, il CSS e i due script possono essere separati in partial/assets.
     Nessun dato viene inviato in rete. API: window.OneImpegno.getData(), loadData(json),
     extractEvents(weekStart), extractTasks(), exportWeekPlan(weekStart).
     Il contenitore emette oneimpegno:change con detail.data dopo una modifica.
     Per usare Rails come archivio, imposta data-persist="false" sul contenitore e
     fornisci il JSON iniziale nello script oneimpegno-data usando json_escape.
     Ascolta oneimpegno:change in Stimulus e salva detail.data nel tuo controller.
     Gli stati di accordo sono annotazioni locali: questa versione non invia inviti o pagamenti. -->
<main id="oneimpegno">
  <header class="oi-top">
    <div class="oi-inline"><span class="oi-mark" aria-hidden="true">1</span><div><h1>1Impegno</h1><div class="oi-small oi-muted">Root · Day · Session · Task</div></div></div>
    <div class="oi-inline"><button class="oi-btn" data-act="json">JSON · importa / esporta</button><button class="oi-btn" data-act="html">Salva HTML</button><button class="oi-btn oi-primary" data-act="new" data-kind="root">+ Root</button></div>
  </header>
  <nav class="oi-nav" aria-label="Viste">
    <div role="tablist" aria-label="Organizzazione"><button id="oi-tab-tree" class="oi-tab" role="tab" aria-selected="true" aria-controls="oi-tree-view" data-act="view" data-view="tree">Struttura</button><button id="oi-tab-week" class="oi-tab" role="tab" aria-selected="false" aria-controls="oi-week-view" tabindex="-1" data-act="view" data-view="week">Calendari</button></div>
    <label class="oi-scope">Calendario <select id="oi-group-filter" aria-label="Filtra per calendario"><option value="all">Tutti</option></select></label>
  </nav>
  <section id="oi-tree-view" role="tabpanel" aria-labelledby="oi-tab-tree">
    <div class="oi-tools"><div><h2>Organizza gli impegni</h2><p class="oi-small oi-muted" id="oi-counts"></p></div><div class="oi-inline"><button class="oi-btn oi-quiet" data-act="expand">Espandi tutto</button><button class="oi-btn oi-quiet" data-act="collapse">Comprimi</button></div></div>
    <div id="oi-roots"></div>
  </section>
  <section id="oi-week-view" role="tabpanel" aria-labelledby="oi-tab-week" hidden>
    <div class="oi-tools"><div class="oi-inline"><button class="oi-btn" data-act="prev" aria-label="Settimana precedente">‹</button><span class="oi-weekrange" id="oi-week-label"></span><button class="oi-btn" data-act="next" aria-label="Settimana successiva">›</button><button class="oi-btn" data-act="today">Oggi</button></div><label class="oi-small">Vai a <input id="oi-week-date" type="date" aria-label="Scegli settimana"></label></div>
    <div class="oi-tools"><p class="oi-small oi-muted" id="oi-week-count"></p><div class="oi-inline"><button class="oi-btn" data-act="range">Orari</button><button class="oi-btn" data-act="weekjson">Esporta week plan</button></div></div>
    <div id="oi-week-warnings"></div><div class="oi-weekscroll" id="oi-week-grid"></div>
    <p class="oi-calendar-note">Solo le sessioni «Evento» con data e orario entrano qui. I task restano nella struttura. Clicca un evento per modificarlo; trascinalo per spostarlo di giorno o orario.</p>
  </section>
  <footer class="oi-statusline"><span id="oi-save-status" role="status">Dati locali in questo browser.</span><span>Usa «Esporta JSON» per conservarne una copia.</span><button class="oi-btn oi-quiet" data-act="undo" id="oi-undo" disabled>Annulla ultima modifica</button></footer>
  <dialog id="oi-editor" aria-labelledby="oi-editor-title"><div class="oi-modalhead"><h2 id="oi-editor-title"></h2><button class="oi-btn oi-iconbtn" data-act="close" aria-label="Chiudi">×</button></div><form id="oi-form"><div id="oi-form-fields" class="oi-formgrid"></div><p id="oi-form-error" class="oi-error" role="alert"></p><div class="oi-formfoot"><button type="button" class="oi-btn oi-danger" id="oi-delete" data-act="delete-current">Elimina</button><button type="button" class="oi-btn" data-act="close">Annulla</button><button type="submit" class="oi-btn oi-primary">Salva</button></div></form></dialog>
  <dialog id="oi-json-modal" aria-labelledby="oi-json-title"><div class="oi-modalhead"><h2 id="oi-json-title">Dati JSON</h2><button class="oi-btn oi-iconbtn" data-act="close" aria-label="Chiudi">×</button></div><div class="oi-inline"><label class="oi-field">Contenuto<select id="oi-json-mode"><option value="all">Struttura completa</option><option value="root">Un root</option><option value="events">Eventi della settimana</option><option value="tasks">Task della struttura</option><option value="weekplan">Week plan compatibile</option></select></label><label class="oi-field" id="oi-json-root-field" hidden>Root<select id="oi-json-root"></select></label></div><p class="oi-small oi-muted" id="oi-json-help"></p><textarea id="oi-json-text" spellcheck="false" aria-label="Dati JSON"></textarea><p id="oi-json-error" class="oi-error" role="alert"></p><div class="oi-inline"><button class="oi-btn oi-primary" data-act="download-json">Esporta JSON</button><button class="oi-btn" data-act="copy-json">Copia</button><button class="oi-btn" data-act="read-file">Apri JSON / HTML</button><button class="oi-btn" data-act="legacy">Carica week plan allegato</button></div><div class="oi-formfoot"><button class="oi-btn" data-act="append-json">Aggiungi root dal JSON</button><button class="oi-btn" data-act="apply-json">Sostituisci dati dal JSON</button></div><input id="oi-json-file" type="file" accept=".json,.html,.txt,application/json,text/html,text/plain" hidden><p class="oi-small oi-muted">Struttura completa = archivio modificabile. Eventi e week plan = viste derivate. Il JSON di un root può essere aggiunto agli altri. L'importazione di un vecchio week plan usa la settimana selezionata.</p></dialog>
  <div class="oi-toast" id="oi-toast" role="status" hidden></div>
</main>
