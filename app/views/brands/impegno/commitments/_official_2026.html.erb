        if(!isDate(v('date'))||!validTime({start:v('start'),end:v('end')}))throw new Error('Questa occorrenza richiede data e orario completi.');
        obj.exceptions[occurrence]={...obj.exceptions[occurrence],date:v('date'),start:v('start'),end:v('end'),status:v('status')};
      }else{
        if(isNew){obj={id:uid(),tasks:[],exceptions:{}};found.day.sessions.push(obj)}
        Object.assign(obj,{title:v('title'),kind:v('kind'),start:v('start'),end:v('end'),status:v('status'),location:v('location'),assignee:v('assignee'),notes:v('notes')});
        if(v('date')!==found.day.date){moveSession(data,found.root.id,found.day.id,obj.id,v('date'),obj.start,obj.end);obj.exceptions={}}
      }
