    let start=-1,depth=0,quoted=false,escaped=false;const parts=[];
    for(let i=0;i<t.length;i++){const c=t[i];if(start===-1){if(/[\s,]/.test(c))continue;if(c!=='{')throw new Error('JSON non valido: '+original.message);start=i}
      if(quoted){if(escaped)escaped=false;else if(c==='\\')escaped=true;else if(c==='"')quoted=false;continue}
      if(c==='"')quoted=true;else if(c==='{'||c==='[')depth++;else if(c==='}'||c===']'){depth--;if(depth===0){parts.push(JSON.parse(t.slice(start,i+1)));start=-1}}
    }if(start!==-1||!parts.length)throw new Error('JSON incompleto o non valido.');if(parts.length===1)return parts[0];return parts;
  }
}
function legacyToData(old,weekStart){
