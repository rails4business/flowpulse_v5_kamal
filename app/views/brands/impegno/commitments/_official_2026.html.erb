#oneimpegno .oi-daycol{position:relative;border-left:1px solid var(--line);background:repeating-linear-gradient(to bottom,transparent 0,transparent calc(var(--step-h) - 1px),#edf0f5 calc(var(--step-h) - 1px),#edf0f5 var(--step-h))}
