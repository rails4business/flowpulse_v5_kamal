    else if(a==='apply-json'||a==='append-json')applyJSON(a==='append-json');
  }catch(err){if($('oi-json-modal').open)$('oi-json-error').textContent=err.message;else if($('oi-editor').open)$('oi-form-error').textContent=err.message;else toast(err.message)}
}
async function onChange(e){
  const el=e.target;
  try{
    if(el.id==='oi-group-filter'){filter=el.value;render()}
    else if(el.id==='oi-week-date'){if(!isDate(el.value))return;data.calendar.week_start=monday(el.value);persist();renderWeek()}
    else if(el.id==='oi-json-mode'||el.id==='oi-json-root')refreshJSON();
    else if(el.id==='oi-json-file'){
      const file=el.files[0];el.value='';if(!file)return;if(file.size>10*1024*1024)throw new Error('Il file supera 10 MB.');const parsed=decodedInput(await file.text());$('oi-json-mode').value='all';refreshJSON();$('oi-json-text').value=JSON.stringify(parsed,null,2);$('oi-json-help').textContent='File letto. Controlla i dati, poi scegli Aggiungi o Sostituisci.';
    }else if(el.dataset.toggleTask){const ref={root:el.dataset.root,day:el.dataset.day,session:el.dataset.session,task:el.dataset.task};commit(()=>{findNode(ref).task.done=el.checked},el.checked?'Task completato':'Task riaperto')}
    else if(el.name==='scope')syncOccurrenceFields();
    else if(el.name==='kind'&&editor?.kind==='session')$('oi-time-fields').hidden=el.value!=='event';
    else if(el.name==='kind'&&editor?.kind==='root'){$('oi-payment-fields').hidden=el.value!=='recurring_payment';if(el.value==='recurring_payment'&&$('oi-form').elements.frequency.value==='none')$('oi-form').elements.frequency.value='monthly'}
    else if(el.name==='group_title'&&editor?.kind==='root'){const g=data.groups.find(g=>g.title.toLocaleLowerCase()===el.value.trim().toLocaleLowerCase());if(g)$('oi-form').elements.color.value=g.color}
  }catch(err){if($('oi-json-modal').open)$('oi-json-error').textContent=err.message;else toast(err.message)}
}
function onDragStart(e){const block=e.target.closest('.oi-event');if(!block)return;const event=eventById(block.dataset.event);if(!event)return;dragging={event,offset:e.clientY-block.getBoundingClientRect().top};e.dataTransfer.setData('text/plain',event.id);e.dataTransfer.effectAllowed='move'}
function onDragOver(e){const col=e.target.closest('.oi-daycol');if(!col||!dragging)return;e.preventDefault();e.dataTransfer.dropEffect='move';app.querySelectorAll('.oi-drop').forEach(x=>x.classList.remove('oi-drop'));col.classList.add('oi-drop')}
function onDrop(e){
  const col=e.target.closest('.oi-daycol');if(!col||!dragging)return;e.preventDefault();const {event,offset}=dragging,duration=mins(event.end)-mins(event.start),step=data.calendar.step_minutes;
  const raw=Number(col.dataset.min)+(e.clientY-col.getBoundingClientRect().top-offset)/0.8;
  const start=Math.max(0,Math.min(1440-duration,Math.round(raw/step)*step)),date=col.dataset.date;dragging=null;ignoreClickUntil=Date.now()+350;
  try{commit(()=>{const found=findNode({root:event.root_id,day:event.day_id,session:event.session_id});if(event.recurring)found.session.exceptions[event.occurrence_date]={...found.session.exceptions[event.occurrence_date],date,start:hhmm(start),end:hhmm(start+duration)};else moveSession(data,event.root_id,event.day_id,event.session_id,date,hhmm(start),hhmm(start+duration))},event.recurring?'Spostata solo questa occorrenza':'Evento spostato')}catch(err){toast(err.message)}
}
function beforeCache(){if(!app)return;app.querySelectorAll('dialog[open]').forEach(d=>d.close());abort?.abort();app.removeAttribute('data-mounted');clearTimeout(toastTimer)}
function init(){
  const el=document.getElementById('oneimpegno');if(!el||el.dataset.mounted==='true')return;app=el;
  try{seed=normalize(JSON.parse(document.getElementById('oneimpegno-data').textContent));data=clone(seed)}catch(err){app.innerHTML='<p class="oi-error">Dati iniziali non validi: '+esc(err.message)+'</p>';return}
  let recovery='';
  if(app.dataset.persist!=='false')try{const saved=localStorage.getItem(storageKey());if(saved)data=normalize(JSON.parse(saved))}catch(err){recovery='Copia locale non leggibile: sto mostrando i dati del file. Esporta prima di modificare.';storageOK=false}
  app.dataset.mounted='true';abort=new AbortController();const opts={signal:abort.signal};app.addEventListener('click',onClick,opts);app.addEventListener('change',onChange,opts);$('oi-form').addEventListener('submit',e=>{e.preventDefault();try{saveEditor()}catch(err){$('oi-form-error').textContent=err.message}},opts);
  app.addEventListener('dragstart',onDragStart,opts);app.addEventListener('dragover',onDragOver,opts);app.addEventListener('drop',onDrop,opts);app.addEventListener('dragend',()=>{dragging=null;ignoreClickUntil=Date.now()+350;app.querySelectorAll('.oi-drop').forEach(x=>x.classList.remove('oi-drop'))},opts);
  app.addEventListener('keydown',e=>{if(e.target.matches('.oi-tab')&&['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();view=e.key==='Home'?'tree':e.key==='End'?'week':view==='tree'?'week':'tree';render();$('oi-tab-'+view).focus()}},opts);
  render();$('oi-save-status').textContent=recovery||(data.sample?'Esempi modificabili · dati locali in questo browser.':'Dati locali caricati in questo browser.');
  if(recovery)toast(recovery);
}
if(window.OneImpegno?.destroy)window.OneImpegno.destroy();
window.OneImpegno={
  init,
  destroy(){beforeCache();document.removeEventListener('turbo:load',init);document.removeEventListener('turbo:frame-load',init);document.removeEventListener('turbo:before-cache',beforeCache)},
  getData:()=>clone(data),
  loadData:input=>commit(()=>{data=normalize(typeof input==='string'?parseManyJSON(input):input);filter='all';collapsed.clear()},'Dati caricati'),
  extractEvents:(weekStart=data.calendar.week_start)=>extractEvents(data,weekStart),
  extractTasks:()=>extractTasks(data),
  exportWeekPlan:(weekStart=data.calendar.week_start)=>exportWeekPlan(data,weekStart),
  core:{normalize,extractEvents,extractTasks,exportWeekPlan,repeatDates,overlapLayout,moveSession,parseManyJSON}
};
document.addEventListener('turbo:load',init);document.addEventListener('turbo:frame-load',init);document.addEventListener('turbo:before-cache',beforeCache);init();
})();
</script>