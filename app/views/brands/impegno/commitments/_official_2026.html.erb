#oneimpegno .oi-btn{border:1px solid var(--line);border-radius:8px;background:white;padding:8px 12px;color:var(--ink);font-size:14px;min-height:38px;white-space:nowrap}
#oneimpegno .oi-btn:hover{background:#f0f3f8}#oneimpegno .oi-primary{background:var(--blue);color:white;border-color:var(--blue)}#oneimpegno .oi-primary:hover{background:#1944b8}
#oneimpegno .oi-quiet{background:transparent;border-color:transparent;color:var(--muted)}#oneimpegno .oi-danger{color:#b42334}
#oneimpegno .oi-iconbtn{padding:6px;min-height:30px;width:30px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
#oneimpegno svg{width:17px;height:17px;flex-shrink:0;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
#oneimpegno .oi-nav{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--line);margin-bottom:20px;flex-wrap:wrap}
#oneimpegno .oi-tab{font-size:15px;font-weight:600;background:none;border:0;border-bottom:3px solid transparent;padding:12px 16px;color:var(--muted)}
#oneimpegno .oi-tab[aria-selected=true]{border-color:var(--blue);color:var(--blue)}#oneimpegno .oi-nav .oi-scope{margin-left:auto;display:flex;align-items:center;gap:8px;padding-bottom:8px;font-size:14px}
#oneimpegno .oi-tools{justify-content:space-between;flex-wrap:wrap;margin-bottom:18px}#oneimpegno .oi-inline{flex-wrap:wrap}
#oneimpegno select,#oneimpegno input:not([type=checkbox]),#oneimpegno textarea{border:1px solid #cdd4de;background:white;color:var(--ink);border-radius:7px;padding:8px 10px;min-width:0}
#oneimpegno input[type=checkbox]{width:17px;height:17px;accent-color:var(--blue);cursor:pointer;flex-shrink:0}
#oneimpegno .oi-group{margin:22px 0 10px;display:flex;align-items:center;gap:9px;font-size:14px;font-weight:700}#oneimpegno .oi-swatch{width:10px;height:10px;border-radius:3px;display:inline-block;background:var(--c,#6b7280)}
#oneimpegno .oi-root{background:white;border:1px solid var(--line);border-radius:12px;padding:18px 16px;margin-bottom:12px;box-shadow:0 1px 2px #14203304}
#oneimpegno .oi-tree,#oneimpegno .oi-children{list-style:none;margin:0;padding:0}
#oneimpegno .oi-children{margin:4px 0 5px 14px;padding-left:25px;border-left:1px solid var(--line)}
#oneimpegno .oi-children.oi-leaves{margin-left:15px;padding-left:32px}
#oneimpegno .oi-row{gap:5px;min-height:38px;border-radius:6px;flex-wrap:wrap}
#oneimpegno .oi-row:hover{background:#f8f9fb}#oneimpegno .oi-node{flex:1;min-width:140px;text-align:left;background:none;border:0;border-radius:5px;padding:5px 6px;color:var(--ink);display:flex;align-items:center;gap:10px}
#oneimpegno .oi-node:hover{background:#f0f3f7}#oneimpegno .oi-node svg{color:#778296}
#oneimpegno .oi-node-text{display:flex;gap:6px 10px;align-items:baseline;flex-wrap:wrap;min-width:0}#oneimpegno .oi-title{font-size:14px;overflow-wrap:anywhere}#oneimpegno .oi-root-title{font-size:16px;font-weight:650}
#oneimpegno .oi-meta{font-size:13px;color:var(--muted)}#oneimpegno .oi-pill{font-size:12px;border-radius:5px;padding:2px 7px;background:#f0f2f6;color:#576277;white-space:nowrap}
#oneimpegno .oi-eventpill{background:#edf3ff;color:#2051b5}#oneimpegno .oi-actions{display:flex;gap:2px;margin-left:auto;align-items:center}
#oneimpegno .oi-add{font-size:13px;min-height:30px;padding:4px 8px}#oneimpegno .oi-fold svg{width:12px;height:12px;transition:transform .15s}#oneimpegno .oi-fold[aria-expanded=true] svg{transform:rotate(90deg)}
#oneimpegno .oi-done .oi-title{text-decoration:line-through;color:#7b8493}#oneimpegno .oi-note{font-size:13px;color:var(--muted);margin:2px 0 10px 43px;white-space:pre-wrap}
#oneimpegno .oi-empty{padding:24px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:8px;background:white}#oneimpegno .oi-empty-small{font-size:13px;color:var(--muted);padding:9px 7px}
#oneimpegno .oi-statusline{font-size:13px;color:var(--muted);margin-top:20px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
#oneimpegno .oi-weekrange{font-size:16px;font-weight:650;min-width:200px;text-align:center}
#oneimpegno .oi-weekscroll{border:1px solid var(--line);background:white;border-radius:12px;overflow:auto;max-height:calc(100vh - 275px);min-height:300px}
#oneimpegno .oi-weekhead,#oneimpegno .oi-weekbody{display:grid;grid-template-columns:56px repeat(7,minmax(112px,1fr));min-width:860px}
#oneimpegno .oi-weekhead{position:sticky;top:0;background:white;z-index:4;box-shadow:0 1px 0 var(--line)}
#oneimpegno .oi-dayhead{padding:9px 3px;text-align:center;border-left:1px solid var(--line);font-size:14px;font-weight:650}#oneimpegno .oi-dayhead .oi-small{font-weight:400;color:var(--muted)}#oneimpegno .oi-today{background:#f0f5ff;color:var(--blue)}
