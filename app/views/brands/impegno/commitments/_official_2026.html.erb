  for(const slot of old.slots){if(!DAY_KEYS.includes(slot.day)&&!isDate(slot.date))throw new Error('Giorno non valido nel week plan.');const type=String(slot.type||'altro');let root=d.roots.find(r=>r.legacy_type===type);if(!root){const [title,color]=map[type]||[type,'#52657d'],group={id:uid(),title,color};d.groups.push(group);root={id:uid(),title:'Week plan · '+title,kind:'multi_event',group_id:group.id,legacy_type:type,notes:'Importato dal week plan: verificare date e impegni.',repeat:{frequency:'weekly',interval:1,until:''},days:[]};d.roots.push(root)}const date=isDate(slot.date)?slot.date:plusDays(d.calendar.week_start,DAY_KEYS.indexOf(slot.day));let day=root.days.find(x=>x.date===date);if(!day){day={id:uid(),title:'Giornata',date,sessions:[]};root.days.push(day)}day.sessions.push({id:uid(),title:slot.title||'Evento',kind:'event',start:slot.start,end:slot.end,location:'',assignee:'',status:'draft',notes:(slot.details||[]).join(' · '),tasks:[],exceptions:{}})}return normalize(d);
