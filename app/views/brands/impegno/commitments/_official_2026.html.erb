  }else value=parseManyJSON(text);
  if(value?.slots)return legacyToData(value,data.calendar.week_start);
  if(Array.isArray(value)&&value.some(x=>x&&(x.root_id||x.session_id)&&!x.days))throw new Error('Questo è un elenco derivato di eventi o task. Importa la struttura completa o il JSON di un root.');
