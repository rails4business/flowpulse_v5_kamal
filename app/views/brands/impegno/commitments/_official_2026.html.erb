    const found=findNode(ref);let obj=found[kind];
    if(kind==='root'){
      let group=data.groups.find(g=>g.title.toLocaleLowerCase()===v('group_title').toLocaleLowerCase());if(!group){group={id:uid(),title:v('group_title'),color:v('color')};data.groups.push(group)}group.color=v('color');
