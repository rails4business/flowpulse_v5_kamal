function saveEditor(){
  const f=$('oi-form'),values=new FormData(f),v=n=>String(values.get(n)||'').trim(),{kind,ref,isNew,occurrence}=editor;
  if(kind==='session'&&v('kind')==='event'&&v('start')&&v('end')&&!validTime({start:v('start'),end:v('end')}))throw new Error('La fine deve essere successiva all’inizio.');
