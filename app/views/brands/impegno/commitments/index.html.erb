<% posturacorretta_domain = @scoped_domain.present? %>
<% calendar_path = posturacorretta_domain ? posturacorretta_impegno_path : data_commitments_path %>
<% calendar_url = ->(**params) { posturacorretta_domain ? posturacorretta_impegno_path(**params) : data_commitments_path(**params) } %>
<% content_for :title, posturacorretta_domain ? "Calendario PosturaCorretta" : "Impegno" %>

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    <% home_link = link_to calendar_path, class: "flex items-center gap-2 text-lg font-black text-slate-950" do %>
      <% if posturacorretta_domain %>
        <img src="https://ik.imagekit.io/posturacorretta/logo_pc_scontornato.png?updatedAt=1747975596766" alt="PosturaCorretta" class="h-8 w-auto">
        <span class="hidden h-6 border-l border-slate-200 sm:block" aria-hidden="true"></span>
        <span class="text-sm font-bold text-slate-500 sm:text-base">Calendario</span>
      <% else %>
        <span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-sm text-white">1</span>
        <span>Impegno</span>
      <% end %>
    <% end %>
    <%= home_link %>

    <div class="flex items-center gap-2">
      <% if authenticated? %>
        <details class="group relative [&_summary::-webkit-details-marker]:hidden">
          <summary class="profile-menu-toggle cursor-pointer list-none gap-2 rounded-full border border-slate-200 bg-white p-1.5 pr-3 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-label="Apri menu profilo">
            <span class="flex size-8 items-center justify-center rounded-full bg-blue-600 text-xs text-white"><%= (Current.user.profile&.display_name || Current.user.email_address).first.upcase %></span>
            <svg aria-hidden="true" class="size-4 text-slate-400 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"/></svg>
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-60 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
            <div class="px-3 py-2">
              <p class="truncate text-sm font-bold text-slate-950"><%= Current.user.profile&.display_name.presence || "Profilo" %></p>
              <p class="truncate text-xs text-slate-500"><%= Current.user.email_address %></p>
            </div>
            <div class="my-1 border-t border-slate-100"></div>
            <%= link_to posturacorretta_domain ? "Calendario" : "I miei impegni", calendar_path, class: "block rounded-lg bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700" %>
            <%= link_to "Profilo", profile_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
            <%= button_to "Esci", session_path, method: :delete, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-red-600 hover:bg-red-50" %>
          </div>
        </details>
      <% else %>
        <%= link_to "Accedi", new_session_path(return_to: calendar_path), class: "rounded-lg px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100" %>
        <%= link_to "Registrati", new_user_path(return_to: calendar_path), class: "rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-bold text-white hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>
</header>
<%= render "shared/active_commitment", commitment: active_data_commitment if active_data_commitment %>

<main class="min-h-[calc(100vh-4rem)] bg-slate-50">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    <% unless authenticated? %>
      <section class="mx-auto max-w-2xl py-12 text-center">
        <span class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-blue-100 text-xl font-black text-blue-700">1</span>
        <h1 class="mt-6 text-3xl font-black tracking-tight text-slate-950 sm:text-5xl">I tuoi impegni, in un solo posto</h1>
        <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-slate-600">Inizia con un elenco semplice: cosa devi fare, in quale dominio e quando.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <%= link_to "Registrati", new_user_path(return_to: calendar_path), class: "rounded-lg bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-blue-700" %>
          <%= link_to "Accedi", new_session_path(return_to: calendar_path), class: "rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50" %>
        </div>
      </section>
    <% else %>
      <% kind_labels = { "personal" => "Personale", "appointment" => "Appuntamento", "event" => "Evento", "project" => "Progetto", "path" => "Percorso", "content" => "Contenuto", "academy" => "Accademia", "work" => "Lavoro", "service" => "Servizio", "purchase" => "Acquisto", "report" => "Report" } %>
      <% status_labels = { "draft" => "Bozza", "planned" => "Da iniziare", "confirmed" => "Confermato", "in_progress" => "In corso", "completed" => "Concluso", "cancelled" => "Annullato" } %>
      <%
        format_duration = lambda do |minutes|
          next "—" unless minutes

          hours, remaining = minutes.divmod(60)
          [("#{hours}h" if hours.positive?), ("#{remaining}m" if remaining.positive?)].compact.join(" ")
        end
      %>
      <% upcoming_tab = link_to calendar_url.call(**{ tab: "upcoming", date: @commitment_date&.iso8601 }.compact), aria: { current: ("page" if @commitment_tab == "upcoming") }, class: "commitment-period-tab rounded-md px-3 py-1.5 text-sm font-bold text-slate-600 transition hover:text-slate-900" do %>
        Prossimi <span class="ml-1 text-xs opacity-75">(<%= @upcoming_commitments.size %>)</span>
      <% end %>
      <% past_tab = link_to calendar_url.call(**{ tab: "past", date: @commitment_date&.iso8601 }.compact), aria: { current: ("page" if @commitment_tab == "past") }, class: "commitment-period-tab rounded-md px-3 py-1.5 text-sm font-bold text-slate-600 transition hover:text-slate-900" do %>
        Passati <span class="ml-1 text-xs opacity-75">(<%= @past_commitments.size %>)</span>
      <% end %>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 pb-4 mb-4">
        <div class="flex flex-wrap items-center gap-4">
          <div>
            <h1 class="text-2xl font-black tracking-tight text-slate-950"><%= posturacorretta_domain ? "Calendario PosturaCorretta" : "I miei impegni" %></h1>
            <% if posturacorretta_domain %><p class="mt-0.5 text-xs font-medium text-slate-500">Solo gli impegni collegati a PosturaCorretta.</p><% end %>
          </div>
          
          <nav class="flex gap-1 rounded-lg bg-slate-100 p-1" aria-label="Periodo degli impegni">
            <%= upcoming_tab %>
            <%= past_tab %>
          </nav>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <% date_filter = form_with url: calendar_path, method: :get, class: "flex items-center gap-2" do |form| %>
            <%= hidden_field_tag :tab, @commitment_tab %>
            <%= form.label :date, "Cerca per data", class: "sr-only" %>
            <%= form.date_field :date, value: @commitment_date&.iso8601, class: "h-9 w-36 rounded-lg border border-slate-300 bg-white px-2.5 text-sm text-slate-700" %>
            <%= form.submit "Cerca", class: "cursor-pointer h-9 rounded-lg border border-slate-300 bg-white px-3 text-sm font-bold text-slate-700 hover:bg-slate-50" %>
            <% if @commitment_date %><%= link_to "Azzera", calendar_path, class: "text-xs font-bold text-slate-500 hover:text-slate-700" %><% end %>
          <% end %>
          <%= date_filter %>
          <button type="button" command="show-modal" commandfor="record-commitment-dialog" class="h-9 rounded-lg border border-blue-200 bg-white px-3 text-sm font-bold text-blue-700 shadow-sm hover:bg-blue-50">● Registra</button>
          <button type="button" command="show-modal" commandfor="new-commitment-dialog" class="h-9 rounded-lg bg-blue-600 px-3 text-sm font-bold text-white shadow-sm hover:bg-blue-700">+ Nuovo</button>
        </div>
      </div>

      <dialog id="record-commitment-dialog" class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50">
        <div class="flex items-start justify-between border-b border-slate-200 px-5 py-4">
          <div><p class="text-xs font-black uppercase tracking-wider text-blue-600">Registrazione rapida</p><h2 class="mt-1 text-xl font-black text-slate-950">Cosa stai facendo?</h2><p class="mt-1 text-sm text-slate-500">Il timer partirà quando confermi.</p></div>
          <button type="button" command="close" commandfor="record-commitment-dialog" class="rounded-full p-2 text-slate-400 hover:bg-slate-100" aria-label="Chiudi">✕</button>
        </div>
        <% record_form = form_with url: data_commitments_path, scope: :data_commitment, class: "space-y-4 p-5" do |form| %>
          <%= hidden_field_tag :start_now, "1" %>
          <div><%= form.label :title, "Attività", class: "text-xs font-bold text-slate-700" %><%= form.text_field :title, required: true, autofocus: true, placeholder: "Es. Preparazione contenuti", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
          <div><%= form.label :description, "Cosa farai (facoltativo)", class: "text-xs font-bold text-slate-700" %><%= form.text_area :description, rows: 2, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :domain_id, "Dominio", class: "text-xs font-bold text-slate-700" %>
              <% if posturacorretta_domain %>
                <%= form.hidden_field :domain_id, value: @scoped_domain.id %>
                <div class="mt-1 flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-bold text-blue-700"><span class="size-2 rounded-full bg-blue-600"></span> PosturaCorretta</div>
              <% else %>
                <%= form.select :domain_id, @domains.map { |domain| [domain.display_hostname, domain.id] }, { prompt: "Scegli il dominio" }, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
              <% end %>
            </div>
            <div><%= form.label :kind, "Tipo", class: "text-xs font-bold text-slate-700" %><%= form.select :kind, [["Personale", "personal"], ["Lavoro", "work"], ["Progetto", "project"], ["Percorso", "path"], ["Contenuto", "content"]], {}, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
          </div>
          <div><%= form.label :calendar_label, "Calendario di", class: "text-xs font-bold text-slate-700" %><%= form.text_field :calendar_label, value: @profile.display_name.presence || @profile.username, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4"><button type="button" command="close" commandfor="record-commitment-dialog" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-600">Annulla</button><%= form.submit "Avvia registrazione", class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700" %></div>
        <% end %>
        <%= record_form %>
      </dialog>

      <dialog id="new-commitment-dialog" class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50">
        <div class="flex items-start justify-between border-b border-slate-200 px-5 py-4">
          <div><p class="text-xs font-black uppercase tracking-wider text-blue-600">Impegno</p><h2 class="mt-1 text-xl font-black text-slate-950">Nuovo impegno</h2></div>
          <button type="button" command="close" commandfor="new-commitment-dialog" class="rounded-full p-2 text-slate-400 hover:bg-slate-100" aria-label="Chiudi">✕</button>
        </div>
        <% commitment_form = form_with url: data_commitments_path, scope: :data_commitment, class: "space-y-4 p-5" do |form| %>
          <div><%= form.label :title, "Titolo", class: "text-xs font-bold text-slate-700" %><%= form.text_field :title, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
          <div><%= form.label :description, "Descrizione", class: "text-xs font-bold text-slate-700" %><%= form.text_area :description, rows: 2, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :domain_id, "Dominio", class: "text-xs font-bold text-slate-700" %>
              <% if posturacorretta_domain %>
                <%= form.hidden_field :domain_id, value: @scoped_domain.id %>
                <div class="mt-1 flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-bold text-blue-700"><span class="size-2 rounded-full bg-blue-600"></span> PosturaCorretta</div>
              <% else %>
                <%= form.select :domain_id, @domains.map { |domain| [domain.display_hostname, domain.id] }, { prompt: "Scegli il dominio" }, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
              <% end %>
            </div>
            <div><%= form.label :kind, "Di cosa si tratta", class: "text-xs font-bold text-slate-700" %><%= form.select :kind, [["Personale", "personal"], ["Appuntamento", "appointment"], ["Evento", "event"], ["Progetto", "project"], ["Percorso", "path"], ["Contenuto", "content"], ["Accademia", "academy"]], {}, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
          </div>
          <div><%= form.label :context_label, "Contesto (facoltativo)", class: "text-xs font-bold text-slate-700" %><%= form.text_field :context_label, placeholder: "Es. Igiene Posturale", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
          <div><%= form.label :calendar_label, "Calendario di", class: "text-xs font-bold text-slate-700" %><%= form.text_field :calendar_label, value: @profile.display_name.presence || @profile.username, required: true, placeholder: "Il tuo nome oppure il nome del paziente", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %><p class="mt-1 text-xs text-slate-400">Gli impegni della stessa persona non possono sovrapporsi.</p></div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div><%= form.label :starts_at, "Inizio", class: "text-xs font-bold text-slate-700" %><%= form.datetime_local_field :starts_at, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
            <div><%= form.label :ends_at, "Fine", class: "text-xs font-bold text-slate-700" %><%= form.datetime_local_field :ends_at, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
          </div>
          <label class="flex items-center gap-2 text-sm text-slate-600"><%= form.check_box :all_day, class: "rounded border-slate-300 text-blue-600" %> Giornata intera</label>
          <div class="flex justify-end gap-2 border-t border-slate-100 pt-4"><button type="button" command="close" commandfor="new-commitment-dialog" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-600">Annulla</button><%= form.submit "Aggiungi", class: "cursor-pointer rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700" %></div>
        <% end %>
        <%= commitment_form %>
      </dialog>

      <section>

        <% if @commitment_date %><p class="mt-4 text-xs font-bold text-slate-500">Impegni del <%= l(@commitment_date, format: :long) %></p><% end %>
        <div class="mt-3 space-y-2">
          <% if @visible_commitments.any? %>
            <% @visible_commitments.each do |commitment| %>
              <%
                displayed_start = commitment.actual_started_at || commitment.starts_at
                displayed_end = commitment.actual_ended_at || commitment.ends_at
                actual_times = commitment.actual_started_at.present?
              %>
              <article id="commitment-<%= commitment.id %>" class="grid gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[8.5rem_minmax(0,1fr)_auto] sm:items-center">
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                  <div class="bg-blue-600 px-3 py-1.5 text-center text-[10px] font-black uppercase tracking-widest text-white"><%= l(displayed_start, format: "%A") %></div>
                  <div class="flex items-center justify-center gap-2 px-3 py-2">
                    <span class="text-3xl font-black leading-none text-slate-950"><%= displayed_start.strftime("%d") %></span>
                    <span class="text-xs font-black uppercase leading-4 text-slate-500"><%= l(displayed_start, format: "%B") %></span>
                  </div>
                  <div class="border-t border-slate-100 bg-slate-50 px-2 py-1.5 text-xs text-slate-600">
                    <% if commitment.all_day? %>
                      <p class="text-center font-bold">Tutto il giorno</p>
                    <% else %>
                      <div class="flex items-center justify-between gap-2"><span class="text-[9px] font-black uppercase tracking-wide text-slate-400">Inizio</span><strong class="text-slate-800"><%= displayed_start.strftime("%H:%M") %></strong></div>
                      <div class="mt-0.5 flex items-center justify-between gap-2"><span class="text-[9px] font-black uppercase tracking-wide text-slate-400">Fine</span><strong class="text-slate-800"><%= displayed_end&.strftime("%H:%M") || "In corso" %></strong></div>
                      <% if actual_times %><p class="mt-1 border-t border-slate-200 pt-1 text-center text-[9px] font-bold uppercase tracking-wide text-emerald-600">Tempo effettivo</p><% end %>
                    <% end %>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2"><h3 class="font-black text-slate-950"><%= commitment.title %></h3><span class="rounded-full px-2 py-0.5 text-[10px] font-black <%= commitment.tracking? ? "bg-amber-100 text-amber-700" : (commitment.status == "completed" ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-600") %>"><%= status_labels.fetch(commitment.status, commitment.status.humanize) %></span></div>
                  <p class="mt-1 truncate text-xs text-slate-500"><%= commitment.metadata["context_label"].presence || commitment.description.presence || "Nessun dettaglio" %></p>
                  <% if commitment.actual_started_at %>
                    <p class="mt-1 text-xs font-medium text-slate-500">Reale: <%= commitment.actual_started_at.strftime("%d/%m/%Y %H:%M") %><%= "–#{commitment.actual_ended_at.strftime('%H:%M')}" if commitment.actual_ended_at %> · <strong class="text-slate-700"><%= format_duration.call(commitment.duration_minutes) %></strong></p>
                  <% end %>
                </div>
                <div class="flex max-w-xs flex-wrap items-center gap-1.5 sm:justify-end">
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-600"><%= commitment.domain.display_hostname %></span><span class="rounded-full bg-blue-50 px-2.5 py-1 text-[10px] font-bold text-blue-700"><%= kind_labels.fetch(commitment.kind, commitment.kind.humanize) %></span>
                  <% if %w[draft planned confirmed].include?(commitment.status) && commitment.actual_started_at.blank? %>
                    <%= button_to "Inizia", start_data_commitment_path(commitment), method: :patch, class: "rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-emerald-700" %>
                  <% elsif commitment.tracking? %>
                    <button type="button" command="show-modal" commandfor="complete-commitment-<%= commitment.id %>" class="rounded-lg bg-slate-950 px-3 py-1.5 text-xs font-bold text-white hover:bg-slate-800">Concludi</button>
                  <% end %>
                  <button type="button" command="show-modal" commandfor="edit-commitment-<%= commitment.id %>" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-50">Modifica</button>
                  <% if @commitment_tab == "past" %>
                    <%= button_to "Elimina", data_commitment_path(commitment), method: :delete, form: { data: { turbo_confirm: "Eliminare definitivamente questo impegno? L’operazione non può essere annullata." } }, class: "rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-bold text-red-600 hover:bg-red-50" %>
                  <% end %>
                </div>
              </article>

              <dialog id="edit-commitment-<%= commitment.id %>" class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50">
                <div class="flex items-start justify-between border-b border-slate-200 px-5 py-4"><div><p class="text-xs font-black uppercase tracking-wider text-blue-600">Impegno</p><h2 class="mt-1 text-xl font-black text-slate-950">Modifica impegno</h2></div><button type="button" command="close" commandfor="edit-commitment-<%= commitment.id %>" class="rounded-full p-2 text-slate-400 hover:bg-slate-100" aria-label="Chiudi">✕</button></div>
                <% edit_form = form_with model: commitment, url: data_commitment_path(commitment), class: "space-y-4 p-5" do |form| %>
                  <div><%= form.label :title, "Titolo", class: "text-xs font-bold text-slate-700" %><%= form.text_field :title, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
                  <div><%= form.label :description, "Descrizione", class: "text-xs font-bold text-slate-700" %><%= form.text_area :description, rows: 2, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                      <%= form.label :domain_id, "Dominio", class: "text-xs font-bold text-slate-700" %>
                      <% if posturacorretta_domain %>
                        <%= form.hidden_field :domain_id, value: @scoped_domain.id %>
                        <div class="mt-1 flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-bold text-blue-700"><span class="size-2 rounded-full bg-blue-600"></span> PosturaCorretta</div>
                      <% else %>
                        <%= form.select :domain_id, @domains.map { |domain| [domain.display_hostname, domain.id] }, {}, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
                      <% end %>
                    </div>
                    <div><%= form.label :kind, "Di cosa si tratta", class: "text-xs font-bold text-slate-700" %><%= form.select :kind, [["Personale", "personal"], ["Appuntamento", "appointment"], ["Evento", "event"], ["Progetto", "project"], ["Percorso", "path"], ["Contenuto", "content"], ["Accademia", "academy"]], {}, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
                  </div>
                  <div><%= form.label :context_label, "Contesto", class: "text-xs font-bold text-slate-700" %><%= form.text_field :context_label, value: commitment.metadata["context_label"], class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
                  <div><%= form.label :calendar_label, "Calendario di", class: "text-xs font-bold text-slate-700" %><%= form.text_field :calendar_label, value: commitment.calendar_label, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
                  <div class="grid gap-4 sm:grid-cols-2"><div><%= form.label :starts_at, "Inizio previsto", class: "text-xs font-bold text-slate-700" %><%= form.datetime_local_field :starts_at, value: commitment.starts_at&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div><div><%= form.label :ends_at, "Fine prevista", class: "text-xs font-bold text-slate-700" %><%= form.datetime_local_field :ends_at, value: commitment.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div></div>
                  <% if commitment.actual_started_at.present? %>
                    <fieldset class="rounded-xl border border-slate-200 bg-slate-50 p-4"><legend class="px-1 text-xs font-black uppercase tracking-wider text-slate-500">Tempo reale</legend><div class="grid gap-4 sm:grid-cols-2"><div><%= form.label :actual_started_at, "Inizio effettivo", class: "text-xs font-bold text-slate-700" %><%= form.datetime_local_field :actual_started_at, value: commitment.actual_started_at&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div><div><%= form.label :actual_ended_at, "Fine effettiva", class: "text-xs font-bold text-slate-700" %><%= form.datetime_local_field :actual_ended_at, value: commitment.actual_ended_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div></div></fieldset>
                  <% end %>
                  <label class="flex items-center gap-2 text-sm text-slate-600"><%= form.check_box :all_day, class: "rounded border-slate-300 text-blue-600" %> Giornata intera</label>
                  <div class="flex items-center justify-between gap-3 border-t border-slate-100 pt-4"><%= link_to "Elimina", data_commitment_path(commitment), data: { turbo_method: :delete, turbo_confirm: "Eliminare definitivamente questo impegno?" }, class: "rounded-lg px-3 py-2 text-sm font-bold text-red-600 hover:bg-red-50" %><div class="flex gap-2"><button type="button" command="close" commandfor="edit-commitment-<%= commitment.id %>" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-600">Annulla</button><%= form.submit "Salva modifiche", class: "cursor-pointer rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700" %></div></div>
                <% end %>
                <%= edit_form %>
              </dialog>
            <% end %>
          <% else %>
            <p class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-sm text-slate-400"><%= @commitment_date ? "Nessun impegno nella data selezionata." : "Nessun impegno." %></p>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</main>
