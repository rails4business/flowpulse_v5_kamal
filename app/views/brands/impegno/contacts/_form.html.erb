<% contact_form = form_with model: contact, url: contact.persisted? ? impegno_contact_path(contact) : impegno_contacts_path, class: "grid gap-4 sm:grid-cols-2" do |form| %>
  <% if contact.errors.any? %>
    <div class="sm:col-span-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= contact.errors.full_messages.to_sentence %></div>
  <% end %>
  <label class="grid gap-1.5 text-sm font-bold text-slate-700">Nome
    <%= form.text_field :name, class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-900", autofocus: true %>
  </label>
  <label class="grid gap-1.5 text-sm font-bold text-slate-700">Tipo
    <%= form.select :kind, [["Persona", "person"], ["Organizzazione", "organization"]], {}, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900" %>
  </label>
  <label class="grid gap-1.5 text-sm font-bold text-slate-700">Email
    <%= form.email_field :email, class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-900" %>
  </label>
  <label class="grid gap-1.5 text-sm font-bold text-slate-700">Telefono
    <%= form.telephone_field :phone, class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-900" %>
  </label>
  <label class="grid gap-1.5 text-sm font-bold text-slate-700 sm:col-span-2">Note
    <%= form.text_area :notes, rows: 3, class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-900" %>
  </label>
  <div class="flex items-center gap-3 sm:col-span-2">
    <%= form.submit contact.persisted? ? "Salva contatto" : "Aggiungi contatto", class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-700" %>
    <% if contact.persisted? %><%= link_to "Annulla", impegno_path(area: "contacts"), class: "text-sm font-bold text-slate-600 hover:text-slate-900" %><% end %>
  </div>
<% end %>
<%= contact_form %>
