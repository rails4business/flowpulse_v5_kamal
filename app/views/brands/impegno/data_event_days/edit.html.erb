<% content_for :title, "Modifica fascia · 1impegno" %>
<% content_for :landing_nav do %><%= render "brands/impegno/header" %><% end %>
<main class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6"><div class="mx-auto max-w-3xl"><p class="text-xs font-black uppercase tracking-wider text-blue-600"><%= @root_event.title %></p><h1 class="mt-1 text-3xl font-black text-slate-950">Modifica fascia giornaliera</h1><div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"><%= render "form", day: @day, root_event: @root_event, form_url: impegno_data_event_day_path(@root_event, @day) %></div><section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby="sessions-title"><div class="flex items-center justify-between gap-3"><h2 id="sessions-title" class="text-xl font-black text-slate-950">Sessioni</h2><%= link_to "Aggiungi sessione", new_impegno_data_event_session_path(@root_event, @day), class: "rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white" %></div><% if @sessions.any? %><ul class="mt-4 divide-y divide-slate-100"><% @sessions.each do |session| %><li class="flex items-center justify-between gap-3 py-3"><div><p class="font-bold text-slate-900"><%= session.title %></p><p class="mt-1 text-sm text-slate-500"><%= session.starts_at.strftime("%H:%M") %>–<%= session.ends_at.strftime("%H:%M") %> · <%= session.bookable? ? "Prenotabile" : "Non prenotabile" %><% if session.maximum_participants %> · <%= session.maximum_participants %> posti<% end %></p></div><%= link_to "Modifica", edit_impegno_data_event_session_path(@root_event, @day, session), class: "text-sm font-bold text-blue-700" %></li><% end %></ul><% else %><p class="mt-4 text-sm text-slate-500">Nessuna sessione concreta in questa fascia.</p><% end %></section></div></main>
