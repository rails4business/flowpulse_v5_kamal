<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <% impegno_logo = link_to(impegno_path, class: "flex items-center gap-2.5 font-black text-slate-950", aria: { label: "1impegno" }) do %>
      <span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-sm text-white">1</span><span>impegno</span>
    <% end %>
    <%= impegno_logo %>
    <nav class="flex items-center gap-2" aria-label="Navigazione 1impegno">
      <%= link_to "Agenda", impegno_path(area: "agenda", view: "agenda"), class: "rounded-lg px-3 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-950" %>
      <% if authenticated? %>
        <details class="group relative [&_summary::-webkit-details-marker]:hidden" data-close-on-outside>
          <summary class="profile-menu-toggle cursor-pointer list-none gap-2 rounded-full border border-slate-200 bg-white p-1 pr-3 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-label="Apri menu profilo">
            <span class="flex size-8 items-center justify-center rounded-full bg-blue-600 text-xs font-black text-white"><%= (Current.user.profile&.display_name || Current.user.email_address).first.upcase %></span>
            <svg aria-hidden="true" class="size-4 text-slate-400 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"/></svg>
          </summary>
          <div class="absolute right-0 z-[80] mt-2 w-60 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
            <div class="px-3 py-2"><p class="truncate text-sm font-bold text-slate-950"><%= Current.user.profile&.display_name.presence || "Profilo" %></p><p class="truncate text-xs text-slate-500"><%= Current.user.email_address %></p></div>
            <div class="my-1 border-t border-slate-100"></div>
            <%= link_to "Dashboard", dashboard_home_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
            <%= link_to "Profilo", profile_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
            <% if Current.user.superadmin_user? %><%= link_to "Superadmin", admin_dashboard_path, class: "block rounded-lg px-3 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50" %><% end %>
            <%= button_to "Esci", session_path, method: :delete, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-red-600 hover:bg-red-50" %>
          </div>
        </details>
      <% else %>
        <%= link_to "Accedi", new_session_path(return_to: impegno_path), class: "rounded-lg px-3 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100" %>
        <%= link_to "Registrati", new_user_path(return_to: impegno_path), class: "rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white hover:bg-blue-700" %>
      <% end %>
    </nav>
  </div>
</header>
