<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <% impegno_logo = link_to(impegno_path, class: "flex items-center gap-2.5 font-black text-slate-950", aria: { label: "1impegno" }) do %>
      <span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-sm text-white">1</span><span>impegno</span>
    <% end %>
    <%= impegno_logo %>
    <nav class="flex items-center gap-1" aria-label="Navigazione 1impegno">
      <%= link_to "Agenda", impegno_path(area: "user", view: "agenda"), class: "rounded-lg px-3 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-950" %>
      <% if authenticated? %><%= link_to "Profilo", profile_path, class: "rounded-lg px-3 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-950" %><%= link_to "Superadmin", admin_dashboard_path, class: "rounded-lg px-3 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50" if Current.user.superadmin_user? %><% else %><%= link_to "Accedi", new_session_path(return_to: impegno_path), class: "rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white hover:bg-blue-700" %><% end %>
    </nav>
  </div>
</header>
