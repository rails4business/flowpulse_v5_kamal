<% frame = turbo_frame_tag "impegno_workspace" do %>
  <div class="space-y-6">
    <header class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <p class="text-xs font-black uppercase tracking-[.16em] text-amber-700">Attenzione personale</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Un problema alla volta.</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">Puoi raccogliere più problemi, ma solo uno rimane attivo. Non occupano una fascia del calendario: servono a tenere fermo il punto finché la soluzione viene provata, corretta, validata oppure abbandonata.</p>
    </header>

    <% if @problem_errors.present? %><div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700"><%= @problem_errors.to_sentence %></div><% end %>

    <% if @active_problem %>
      <% completed = Array(@active_problem.metadata["completed_steps"]) %>
      <section class="rounded-3xl border-2 border-slate-950 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div><span class="rounded-full bg-amber-400 px-3 py-1 text-xs font-black uppercase tracking-wider text-slate-950">Problema attivo</span><h2 class="mt-4 text-2xl font-black text-slate-950"><%= @active_problem.title %></h2><% if @active_problem.description.present? %><p class="mt-2 max-w-3xl leading-7 text-slate-600"><%= @active_problem.description %></p><% end %></div>
          <span class="text-sm font-bold text-slate-500"><%= completed.size %>/<%= @steps.size %> passaggi</span>
        </div>
        <ol class="mt-7 divide-y divide-slate-200 border-y border-slate-200">
          <% @steps.each_with_index do |(key, label), index| %>
            <% done = completed.include?(key) %><% current = !done && @steps.take(index).all? { |step| completed.include?(step.first) } %>
            <li class="flex items-center gap-4 py-4 <%= current ? 'text-slate-950' : 'text-slate-500' %>"><span class="flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-black <%= done ? 'bg-emerald-600 text-white' : current ? 'bg-amber-400 text-slate-950' : 'bg-slate-100' %>"><%= done ? "✓" : index + 1 %></span><span class="font-bold"><%= label %></span></li>
          <% end %>
        </ol>
        <div class="mt-6 flex flex-wrap gap-3">
          <% if completed.size < @steps.size %><%= button_to "Completa il prossimo passaggio", impegno_problem_path(@active_problem), method: :patch, params: { operation: "advance" }, class: "impegno-problem-button impegno-problem-button--primary" %><% end %>
          <% if completed.size == @steps.size %><%= button_to "Segna come risolto", impegno_problem_path(@active_problem), method: :patch, params: { operation: "resolve" }, class: "impegno-problem-button impegno-problem-button--success" %><% end %>
        </div>
      </section>
    <% else %>
      <section class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center"><h2 class="text-xl font-black">Nessun problema attivo</h2><p class="mt-2 text-slate-600">Aggiungine uno oppure riprendine uno dall’elenco dei problemi futuri.</p></section>
    <% end %>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-black">Problemi futuri</h2><p class="mt-1 text-sm text-slate-500">Restano qui senza rubare attenzione al problema attivo.</p>
        <div class="mt-5 space-y-3"><% @future_problems.each do |problem| %><article class="rounded-2xl border border-slate-200 p-4"><h3 class="font-black"><%= problem.title %></h3><p class="mt-1 line-clamp-2 text-sm text-slate-500"><%= problem.description %></p><%= button_to "Lavora su questo", impegno_problem_path(problem), method: :patch, params: { operation: "focus" }, class: "impegno-problem-button impegno-problem-button--accent mt-3" %></article><% end %><% if @future_problems.empty? %><p class="mt-5 text-sm text-slate-400">Nessun problema in attesa.</p><% end %></div>
      </section>
      <section class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-black">Problemi risolti</h2><p class="mt-1 text-sm text-slate-500">La memoria delle soluzioni che hai portato fino in fondo.</p>
        <div class="mt-5 space-y-3"><% @resolved_problems.each do |problem| %><article class="rounded-2xl border border-emerald-100 bg-emerald-50/60 p-4"><div class="flex gap-3"><span class="font-black text-emerald-700">✓</span><div><h3 class="font-black"><%= problem.title %></h3><p class="mt-1 text-xs font-bold text-emerald-700"><%= l(problem.resolved_at, format: :short) if problem.resolved_at %></p><%= button_to "Riapri", impegno_problem_path(problem), method: :patch, params: { operation: "reopen" }, class: "mt-3 text-xs font-black text-slate-600 underline" %></div></div></article><% end %><% if @resolved_problems.empty? %><p class="mt-5 text-sm text-slate-400">Le soluzioni concluse compariranno qui.</p><% end %></div>
      </section>
    </div>

    <section class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8"><h2 class="text-2xl font-black">Aggiungi un problema</h2><p class="mt-2 text-sm text-slate-300">Se ne esiste già uno attivo, il nuovo entra automaticamente tra i futuri.</p><%= form_with url: impegno_problems_path, scope: :problem, class: "mt-6 grid gap-4" do |form| %><%= form.text_field :title, required: true, placeholder: "Qual è il problema?", class: "rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500" %><%= form.text_area :description, rows: 3, placeholder: "Cosa succede, a chi e in quale situazione?", class: "rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500" %><%= form.submit "Aggiungi all’elenco", class: "impegno-problem-button impegno-problem-button--accent w-fit" %><% end %></section>
  </div>
<% end %>
<%= frame %>
