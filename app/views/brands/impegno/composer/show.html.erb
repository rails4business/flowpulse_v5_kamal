<% content_for :title, "Composer operativo — 1Impegno" %>
<% content_for :landing_nav do %><%= render "brands/impegno/header" %><% end %>

<main class="min-h-screen bg-slate-50 py-8">
  <div class="mx-auto max-w-4xl px-4 sm:px-6" data-controller="operational-composer">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div><p class="text-xs font-black uppercase tracking-wider text-blue-600">Bozza operativa · superadmin</p><h1 class="mt-1 text-3xl font-black tracking-tight text-slate-950">Root, Day, Sessione, Task</h1><p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Il Root può essere un multievento, un programma, un percorso, un corso o altro. Solo le sessioni con data e ora diventeranno in seguito impegni di calendario.</p></div>
      <div class="flex gap-2"><button type="button" data-action="operational-composer#reset" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-600">Azzera bozza</button><%= link_to "Torna ad Agenda", impegno_path(area: "agenda", view: "agenda"), class: "rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white" %></div>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-5 flex items-center justify-between"><div><h2 class="text-lg font-black text-slate-950">Struttura</h2><p class="mt-1 text-sm text-slate-500">La bozza è salvata solo in questo browser.</p></div><button type="button" data-action="operational-composer#addRoot" class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-bold text-white">+ Root</button></div>
      <div data-operational-composer-target="tree" class="space-y-4"></div>
    </section>

    <template data-operational-composer-target="rootTemplate"><section class="rounded-xl border border-blue-200 bg-blue-50/40 p-4" data-root><div class="flex flex-wrap items-center gap-2"><span class="rounded-md bg-blue-600 px-2 py-1 text-xs font-black text-white">ROOT</span><input data-field="title" placeholder="Titolo del contenitore" class="min-w-[16rem] flex-1 rounded-lg border border-blue-200 bg-white px-3 py-2 text-sm font-bold text-slate-900"><select data-field="kind" class="rounded-lg border border-blue-200 bg-white px-3 py-2 text-sm font-bold text-slate-700"><option value="multievento">Multievento</option><option value="programma">Programma</option><option value="percorso">Percorso</option><option value="corso">Corso</option><option value="altro">Altro</option></select><button type="button" data-action="operational-composer#remove" class="px-2 text-sm font-bold text-red-600">Rimuovi</button></div><div data-days class="mt-4 space-y-3"></div><button type="button" data-action="operational-composer#addDay" class="mt-3 text-sm font-bold text-blue-700">+ Giorno</button></section></template>
    <template data-operational-composer-target="dayTemplate"><section class="ml-5 border-l-2 border-slate-200 pl-4" data-day><div class="flex flex-wrap items-center gap-2"><span class="text-xs font-black text-slate-500">DAY</span><input data-field="date" type="date" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><input data-field="label" placeholder="Es. mattina, primo incontro" class="min-w-[14rem] flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><button type="button" data-action="operational-composer#remove" class="px-2 text-sm font-bold text-red-600">Rimuovi</button></div><div data-sessions class="mt-3 space-y-3"></div><button type="button" data-action="operational-composer#addSession" class="mt-3 text-sm font-bold text-slate-700">+ Sessione / ora</button></section></template>
    <template data-operational-composer-target="sessionTemplate"><section class="ml-5 border-l-2 border-violet-200 pl-4" data-session><div class="flex flex-wrap items-center gap-2"><span class="text-xs font-black text-violet-600">SESSIONE</span><input data-field="title" placeholder="Titolo sessione" class="min-w-[13rem] flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><input data-field="starts_at" type="time" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><input data-field="ends_at" type="time" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><button type="button" data-action="operational-composer#remove" class="px-2 text-sm font-bold text-red-600">Rimuovi</button></div><div data-tasks class="mt-3 space-y-2"></div><button type="button" data-action="operational-composer#addTask" class="mt-3 text-sm font-bold text-violet-700">+ Task</button></section></template>
    <template data-operational-composer-target="taskTemplate"><div class="ml-5 flex items-center gap-2 border-l-2 border-amber-200 pl-4" data-task><span class="text-xs font-black text-amber-600">TASK</span><input data-field="title" placeholder="Cosa serve fare?" class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><button type="button" data-action="operational-composer#remove" class="px-2 text-sm font-bold text-red-600">Rimuovi</button></div></template>
  </div>
</main>
