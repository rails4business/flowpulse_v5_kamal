<%= form_with model: session, url: form_url, class: "space-y-5" do |form| %>
  <% if session.errors.any? %><div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"><p class="font-bold">Controlla la sessione inserita</p><ul class="mt-2 list-disc pl-5"><% session.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div><%= form.label :title, "Titolo", class: "text-sm font-bold text-slate-700" %><%= form.text_field :title, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5" %></div>
  <div class="grid gap-4 sm:grid-cols-2"><div><%= form.label :starts_at, "Inizio", class: "text-sm font-bold text-slate-700" %><%= form.datetime_local_field :starts_at, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5" %></div><div><%= form.label :ends_at, "Fine", class: "text-sm font-bold text-slate-700" %><%= form.datetime_local_field :ends_at, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5" %></div></div>
  <div><%= form.label :maximum_participants, "Capienza massima", class: "text-sm font-bold text-slate-700" %><%= form.number_field :maximum_participants, min: 1, placeholder: "Lascia vuoto se non definita", class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5" %></div>
  <label class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4"><%= form.check_box :bookable, class: "mt-0.5 size-4 rounded border-slate-300 text-blue-600" %><span><span class="block text-sm font-bold text-slate-800">Sessione prenotabile</span><span class="mt-1 block text-xs text-slate-500">L’utente richiede direttamente questo appuntamento con giorno e ora definiti.</span></span></label>
  <div class="flex flex-wrap gap-3 border-t border-slate-200 pt-5"><%= form.submit session.persisted? ? "Salva sessione" : "Aggiungi sessione", class: "cursor-pointer rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white" %><%= link_to "Annulla", edit_impegno_data_event_day_path(root_event, day), class: "rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-700" %></div>
<% end %>
