<% content_for :title, "Impegno — Il tuo tempo, in un solo posto" %>
<% content_for :description, "Organizza appuntamenti, attività e tempo lavorato in un calendario personale collegato ai tuoi brand." %>
<% if @impegno_brand == "posturacorretta" %>
  <% content_for :landing_nav do %><%= render "posturacorretta/header" %><% end %>
<% else %>
  <% content_for :landing_nav do %><%= render "brands/impegno/header" %><% end %>
<% end %>

<% if authenticated? %>
  <%
    state_path = lambda do |overrides = {}|
      impegno_path({
        brand: @impegno_brand,
        area: @impegno_area,
        view: @impegno_view,
        tab: @impegno_tab,
        date: params[:date].presence,
        period: @impegno_period
      }.merge(overrides).compact)
    end
    view_labels = {
      "user" => { "agenda" => "Agenda", "practices" => "Esperienze", "recurring" => "Ricorrenze" },
      "professional" => { "agenda" => "Agenda", "offering" => "Offerta", "exchange" => "Valore e scambi", "reports" => "Resoconti" },
      "places" => {},
      "contacts" => {}
    }
  %>

  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto grid min-h-16 max-w-7xl grid-cols-1 items-center gap-3 px-4 py-3 sm:px-6 lg:grid-cols-[1fr_auto_1fr] lg:gap-5">
      <% workspace_filter = form_with url: impegno_path, method: :get, class: "flex min-w-0 items-center gap-2" do |form| %>
        <%= form.select :brand,
                        [["1impegno", "impegno"], ["PosturaCorretta", "posturacorretta"], ["GeneraImpresa", "generaimpresa"], ["Personale", "personale"]],
                        { selected: @impegno_brand },
                        onchange: "this.form.requestSubmit()",
                        class: "min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700" %>
        <%= form.select :area,
                        [["Utente", "user"]] + (@impegno_professional_access ? [["Professionista", "professional"]] : []) + [["Luoghi", "places"], ["Contatti", "contacts"]],
                        { selected: @impegno_area },
                        onchange: "this.form.requestSubmit()",
                        class: "min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900" %>
        <%= form.hidden_field :view, value: @impegno_view if %w[user professional].include?(@impegno_area) %>
      <% end %>
      <%= workspace_filter %>

      <% if @impegno_area == "user" && @impegno_view == "agenda" %>
        <div class="grid justify-center gap-2">
          <nav class="flex items-center justify-center gap-1.5" aria-label="Navigazione del calendario">
            <%= link_to "‹", state_path.call(date: (@workspace_date << 1).iso8601, period: nil), class: "flex size-9 items-center justify-center rounded-lg border border-slate-300 bg-white text-lg font-bold text-slate-700 hover:bg-slate-50", aria: { label: "Mese precedente" } %>
            <%= link_to "Oggi", state_path.call(date: Date.current.iso8601, period: nil), class: "h-9 rounded-lg border border-slate-300 bg-white px-3 text-sm font-bold leading-9 text-slate-700 hover:bg-slate-50" %>
            <% date_form = form_with url: impegno_path, method: :get, class: "contents" do |form| %>
              <%= form.hidden_field :brand, value: @impegno_brand %><%= form.hidden_field :area, value: @impegno_area %><%= form.hidden_field :view, value: @impegno_view %>
              <%= form.date_field :date, value: @workspace_date.iso8601, onchange: "this.form.requestSubmit()", class: "h-9 w-36 rounded-lg border border-slate-300 bg-white px-2 text-sm font-semibold text-slate-700" %>
            <% end %>
            <%= date_form %>
            <%= link_to "›", state_path.call(date: (@workspace_date >> 1).iso8601, period: nil), class: "flex size-9 items-center justify-center rounded-lg border border-slate-300 bg-white text-lg font-bold text-slate-700 hover:bg-slate-50", aria: { label: "Mese successivo" } %>
            <%= link_to "Reset data", state_path.call(date: nil, period: nil), class: "h-9 rounded-lg px-2 text-xs font-bold text-slate-500 hover:bg-slate-100 hover:text-slate-900" %>
          </nav>
          <nav class="flex justify-center gap-1" aria-label="Periodo degli impegni">
            <%= link_to "Tutti", state_path.call(date: nil, period: nil), class: "rounded-lg border px-2.5 py-1 text-xs font-bold transition #{@impegno_period.blank? && params[:date].blank? ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-50'}" %>
            <%= link_to "Prossimi", state_path.call(date: nil, period: "upcoming"), class: "rounded-lg border px-2.5 py-1 text-xs font-bold transition #{@impegno_period == 'upcoming' ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-50'}" %>
            <%= link_to "Passati", state_path.call(date: nil, period: "past"), class: "rounded-lg border px-2.5 py-1 text-xs font-bold transition #{@impegno_period == 'past' ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-50'}" %>
          </nav>
        </div>
      <% else %>
        <div></div>
      <% end %>

      <div class="flex items-center justify-start gap-2 lg:justify-end">
        <button type="button" data-controller="modal" data-modal-dialog-id-value="start-commitment-dialog" data-action="modal#open" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">● Registra</button>
        <button type="button" data-controller="modal" data-modal-dialog-id-value="new-commitment-dialog" data-action="modal#open" class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white hover:bg-blue-700">+ Nuovo impegno</button>
      </div>
    </div>
  </header>

  <dialog id="start-commitment-dialog" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50">
    <div class="flex items-start justify-between border-b border-slate-200 px-5 py-4"><div><p class="text-xs font-black uppercase tracking-wider text-emerald-600">Registra attività</p><h2 class="mt-1 text-xl font-black text-slate-950">Cosa stai facendo?</h2></div><button type="button" data-controller="modal" data-modal-dialog-id-value="start-commitment-dialog" data-action="modal#close" class="rounded-full p-2 text-slate-400 hover:bg-slate-100" aria-label="Chiudi">✕</button></div>
    <% start_form = form_with url: data_commitments_path, scope: :data_commitment, class: "space-y-4 p-5" do |form| %>
      <%= hidden_field_tag :start_now, "1" %>
      <%= hidden_field_tag :return_to, request.fullpath %>
      <div><%= form.label :title, "Titolo", class: "text-xs font-bold text-slate-700" %><%= form.text_field :title, required: true, placeholder: "Es. Preparare il programma dell'evento", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
      <div><%= form.label :description, "Cosa fai in questo momento?", class: "text-xs font-bold text-slate-700" %><%= form.text_area :description, rows: 3, placeholder: "Descrivi brevemente l'attività.", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
      <div class="grid gap-4 sm:grid-cols-2"><div><%= form.label :domain_id, "Brand", class: "text-xs font-bold text-slate-700" %><%= form.select :domain_id, @impegno_domains.map { |domain| [domain.display_hostname, domain.id] }, { prompt: "Scegli il brand" }, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div><div><%= form.label :kind, "Tipo", class: "text-xs font-bold text-slate-700" %><%= form.select :kind, [["Attività", "work"], ["Personale", "personal"], ["Contenuto", "content"], ["Progetto", "project"]], {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div></div>
      <%= form.hidden_field :calendar_label, value: Current.user.profile.display_name.presence || Current.user.profile.username %>
      <div class="flex justify-end gap-2 border-t border-slate-100 pt-4"><button type="button" data-controller="modal" data-modal-dialog-id-value="start-commitment-dialog" data-action="modal#close" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-600">Annulla</button><%= form.submit "▶ Avvia attività", class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700" %></div>
    <% end %>
    <%= start_form %>
  </dialog>

  <main class="min-h-[calc(100vh-4rem)] bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6">
      <nav class="mb-5 flex gap-1 overflow-x-auto border-b border-slate-200" aria-label="Sezioni di Impegno">
        <% if %w[places contacts].include?(@impegno_area) %>
          <%= link_to "Luoghi", state_path.call(area: "places", view: nil, tab: nil), aria: { current: ("page" if @impegno_area == "places") }, class: "whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-bold transition #{@impegno_area == 'places' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>
          <%= link_to "Contatti", state_path.call(area: "contacts", view: nil, tab: nil), aria: { current: ("page" if @impegno_area == "contacts") }, class: "whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-bold transition #{@impegno_area == 'contacts' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>
        <% else %>
          <% view_labels.fetch(@impegno_area).each do |view, label| %>
            <%= link_to label,
                        state_path.call(view: view, tab: nil),
                        aria: { current: ("page" if @impegno_view == view) },
                        class: "whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-bold transition #{@impegno_view == view ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>
          <% end %>
          <%= link_to "Luoghi", state_path.call(area: "places", view: nil, tab: nil), class: "whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 text-sm font-bold text-slate-500 transition hover:text-slate-800" %>
          <%= link_to "Contatti", state_path.call(area: "contacts", view: nil, tab: nil), class: "whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 text-sm font-bold text-slate-500 transition hover:text-slate-800" %>
        <% end %>
      </nav>

      <% if @impegno_area == "professional" && @impegno_view == "offering" %>
        <nav class="mb-5 flex gap-1 overflow-x-auto" aria-label="Tipi di offerta professionale">
          <% { "services" => "Prestazioni", "paths" => "Percorsi", "classes" => "Classi", "courses" => "Corsi", "events" => "Eventi" }.each do |tab, label| %>
            <%= link_to label,
                        state_path.call(tab: tab),
                        aria: { current: ("page" if @impegno_tab == tab) },
                        class: "whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-bold transition #{@impegno_tab == tab ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-blue-300 hover:text-blue-700'}" %>
          <% end %>
        </nav>
      <% elsif @impegno_area == "user" && @impegno_view == "practices" %>
        <nav class="mb-5 flex gap-1 overflow-x-auto" aria-label="Tipi di esperienza">
          <% { "habits" => "Routine", "paths" => "Percorsi", "classes" => "Classi", "courses" => "Corsi", "events" => "Eventi" }.each do |tab, label| %>
            <%= link_to label,
                        state_path.call(tab: tab),
                        aria: { current: ("page" if @impegno_tab == tab) },
                        class: "whitespace-nowrap rounded-lg border px-3 py-2 text-sm font-bold transition #{@impegno_tab == tab ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-blue-300 hover:text-blue-700'}" %>
          <% end %>
        </nav>
      <% end %>

      <% if @workspace_src %>
        <% workspace_frame = turbo_frame_tag "impegno_workspace", src: @workspace_src, loading: :eager do %>
          <div class="rounded-xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-500">Caricamento dell’Agenda…</div>
        <% end %>
        <%= workspace_frame %>
      <% else %>
        <% workspace_frame = turbo_frame_tag "impegno_workspace" do %>
          <section class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
            <p class="text-xs font-black uppercase tracking-wider text-blue-600"><%= @impegno_area == "user" ? "Utente" : "Professionista" %></p>
            <% workspace_title = if @impegno_area == "professional" && @impegno_view == "offering"
              { "services" => "Prestazioni", "paths" => "Percorsi", "classes" => "Classi", "courses" => "Corsi", "events" => "Eventi" }.fetch(@impegno_tab)
            elsif @impegno_area == "user" && @impegno_view == "practices"
              { "habits" => "Routine", "paths" => "Percorsi", "classes" => "Classi", "courses" => "Corsi", "events" => "Eventi" }.fetch(@impegno_tab)
            else
              view_labels.fetch(@impegno_area).fetch(@impegno_view)
            end %>
            <h1 class="mt-2 text-2xl font-black text-slate-950"><%= workspace_title %></h1>
            <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-slate-500">La shell e l’URL di questa sezione sono pronti. Il contenuto verrà migrato dal prototipo nella prossima fase.</p>
          </section>
        <% end %>
        <%= workspace_frame %>
      <% end %>
    </div>
  </main>
<% else %>
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <% brand_link = link_to impegno_path, class: "flex items-center gap-3 font-black text-slate-950" do %>
      <span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-sm text-white">I</span>
      <span>Impegno</span>
    <% end %>
    <%= brand_link %>
    <%= link_to authenticated? ? "Apri il calendario" : "Accedi", authenticated? ? data_commitments_path : new_session_path(return_to: data_commitments_path), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700" %>
  </div>
</header>

<main class="bg-white">
  <section class="mx-auto grid min-h-[calc(100vh-4rem)] max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_25rem] lg:py-24">
    <div>
      <span class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-black uppercase tracking-wider text-blue-700">Calendario personale</span>
      <h1 class="mt-5 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-6xl">Il tuo tempo, in un solo posto.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Raccogli appuntamenti, attività e tempo lavorato. Guarda tutto insieme oppure filtra il calendario per PosturaCorretta, GeneraImpresa, SvuotaMente e gli altri brand a cui partecipi.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to "Apri Impegno →", authenticated? ? data_commitments_path : new_user_path(return_to: data_commitments_path), class: "rounded-lg bg-blue-600 px-5 py-3 text-sm font-black text-white hover:bg-blue-700" %>
        <% unless authenticated? %><%= link_to "Ho già un account", new_session_path(return_to: data_commitments_path), class: "rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-black text-slate-700 hover:bg-slate-50" %><% end %>
      </div>
    </div>
    <aside class="rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
      <p class="text-xs font-black uppercase tracking-wider text-blue-700">Un calendario, più contesti</p>
      <ul class="mt-5 space-y-3 text-sm font-bold text-slate-700">
        <% ["Tutti i brand", "PosturaCorretta", "GeneraImpresa", "SvuotaMente"].each_with_index do |label, index| %>
          <li class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3"><span class="size-2 rounded-full <%= index.zero? ? 'bg-blue-600' : 'bg-slate-300' %>"></span><%= label %></li>
        <% end %>
      </ul>
    </aside>
  </section>
</main>
<% end %>
