<% content_for :title, "Impegno — Il tuo tempo, in un solo posto" %>
<% content_for :description, "Organizza appuntamenti, attività e tempo lavorato in un calendario personale collegato ai tuoi brand." %>
<% if @impegno_brand == "posturacorretta" %>
  <% content_for :landing_nav do %><%= render "posturacorretta/header" %><% end %>
<% else %>
  <% content_for :landing_nav do %><%= render "brands/impegno/header" %><% end %>
<% end %>
<% if authenticated? %>
  <%
    state_path = lambda do |overrides = {}|
      impegno_path({
        brand: @impegno_brand,
        area: @impegno_area,
        role: @impegno_role,
        view: @impegno_view,
        tab: @impegno_tab,
        date: params[:date].presence,
        period: @impegno_period,
        agenda_filter: @impegno_agenda_filter,
        request_status: @impegno_request_status,
        view_mode: params[:view_mode].presence
      }.merge(overrides).compact)
    end
  %>

  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto grid min-h-16 max-w-7xl grid-cols-1 items-center gap-3 px-4 py-3 sm:px-6 lg:grid-cols-[1fr_auto_1fr] lg:gap-5">
      <div class="flex min-w-0 flex-wrap items-center gap-2">
        <nav class="flex max-w-full items-center gap-1 overflow-x-auto" aria-label="Sezioni di Impegno">
          <% agenda_active = @impegno_area == "agenda" && !%w[weekplan experiences structure].include?(params[:view_mode]) %>
          <%= link_to "Agenda", state_path.call(area: "agenda", view: "agenda", tab: nil, view_mode: nil), aria: { current: ("page" if agenda_active) }, class: "shrink-0 rounded-lg px-3 py-2 text-sm font-bold #{agenda_active ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}" %>
          <% week_active = @impegno_area == "agenda" && params[:view_mode] == "weekplan" %>
          <%= link_to "Settimana", state_path.call(area: "agenda", view: "agenda", tab: nil, view_mode: "weekplan"), aria: { current: ("page" if week_active) }, class: "shrink-0 rounded-lg px-3 py-2 text-sm font-bold #{week_active ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}" %>
          <% if Current.user.superadmin_user? %>
            <% experiences_active = @impegno_area == "agenda" && params[:view_mode] == "experiences" %>
            <%= link_to "Esperienze", state_path.call(area: "agenda", view: "agenda", tab: nil, view_mode: "experiences", date: nil, period: nil), aria: { current: ("page" if experiences_active) }, class: "shrink-0 rounded-lg px-3 py-2 text-sm font-bold #{experiences_active ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}" %>
          <% end %>
          <%= link_to "Luoghi", state_path.call(area: "places", view: nil, tab: nil, view_mode: nil, date: nil, period: nil), aria: { current: ("page" if @impegno_area == "places") }, class: "shrink-0 rounded-lg px-3 py-2 text-sm font-bold #{@impegno_area == 'places' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}" %>
          <%= link_to "Contatti", state_path.call(area: "contacts", view: nil, tab: nil, view_mode: nil, date: nil, period: nil), aria: { current: ("page" if @impegno_area == "contacts") }, class: "shrink-0 rounded-lg px-3 py-2 text-sm font-bold #{@impegno_area == 'contacts' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}" %>
          <% if @impegno_professional_access %><%= link_to "Professionista", state_path.call(area: "professional", view: nil, tab: nil, view_mode: nil, date: nil, period: nil), aria: { current: ("page" if @impegno_area == "professional") }, class: "shrink-0 rounded-lg px-3 py-2 text-sm font-bold #{@impegno_area == 'professional' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}" %><% end %>
        </nav>

        <% if @impegno_area == "agenda" && @impegno_has_domain_roles %>
          <% if @impegno_domain_options.many? %>
            <% domain_filter = form_with url: impegno_path, method: :get, class: "min-w-0" do |form| %>
              <%= form.hidden_field :area, value: "agenda" %>
              <%= form.hidden_field :view, value: "agenda" %>
              <%= form.select :brand, @impegno_domain_options, { selected: @impegno_brand }, onchange: "this.form.requestSubmit()", aria: { label: "Sito dei ruoli operativi" }, class: "min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900" %>
            <% end %>
            <%= domain_filter %>
          <% elsif @impegno_default_domain.present? %>
            <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-bold text-slate-700"><%= @impegno_default_domain.site_title.presence || @impegno_default_domain.hostname %></span>
          <% end %>

          <span class="flex flex-wrap gap-1.5" aria-label="Ruoli assegnati nel sito">
            <% @impegno_domain_roles.each do |role| %>
              <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700"><%= @impegno_domain_role_labels.fetch(role, role.humanize) %></span>
            <% end %>
          </span>
        <% end %>
      </div>

      <% if @impegno_area == "agenda" && @impegno_view == "agenda" && !%w[experiences structure].include?(params[:view_mode]) %>
        <div class="grid justify-center gap-2">
          <nav class="flex items-center justify-center gap-1.5" aria-label="Navigazione del calendario">
            <%= link_to "‹", state_path.call(date: (@workspace_date - 1.day).iso8601, period: nil), class: "flex size-9 items-center justify-center rounded-lg border border-slate-300 bg-white text-lg font-bold text-slate-700 hover:bg-slate-50", aria: { label: "Giorno precedente" } %>
            <%= link_to "Oggi", state_path.call(date: Date.current.iso8601, period: nil), class: "h-9 rounded-lg border border-slate-300 bg-white px-3 text-sm font-bold leading-9 text-slate-700 hover:bg-slate-50" %>
            <% date_form = form_with url: impegno_path, method: :get, class: "contents" do |form| %>
              <%= form.hidden_field :brand, value: @impegno_brand %><%= form.hidden_field :area, value: @impegno_area %><%= form.hidden_field :view, value: @impegno_view %>
              <%= form.date_field :date, value: @workspace_date.iso8601, onchange: "this.form.requestSubmit()", class: "h-9 w-36 rounded-lg border border-slate-300 bg-white px-2 text-sm font-semibold text-slate-700" %>
            <% end %>
            <%= date_form %>
            <%= link_to "›", state_path.call(date: (@workspace_date + 1.day).iso8601, period: nil), class: "flex size-9 items-center justify-center rounded-lg border border-slate-300 bg-white text-lg font-bold text-slate-700 hover:bg-slate-50", aria: { label: "Giorno successivo" } %>
            <%= link_to "Reset data", state_path.call(date: nil, period: nil), class: "h-9 rounded-lg px-2 text-xs font-bold text-slate-500 hover:bg-slate-100 hover:text-slate-900" %>
          </nav>
          <nav class="flex justify-center gap-1" aria-label="Periodo degli impegni">
            <%= link_to "Tutti", state_path.call(date: nil, period: nil), class: "rounded-lg border px-2.5 py-1 text-xs font-bold transition #{@impegno_period.blank? && params[:date].blank? ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-50'}" %>
            <%= link_to "Prossimi", state_path.call(date: nil, period: "upcoming"), class: "rounded-lg border px-2.5 py-1 text-xs font-bold transition #{@impegno_period == 'upcoming' ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-50'}" %>
            <%= link_to "Passati", state_path.call(date: nil, period: "past"), class: "rounded-lg border px-2.5 py-1 text-xs font-bold transition #{@impegno_period == 'past' ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-slate-400 hover:bg-slate-50'}" %>
          </nav>
        </div>
      <% else %>
        <div></div>
      <% end %>

      <div class="flex items-center justify-start gap-2 lg:justify-end">
        <button type="button" data-controller="modal" data-modal-dialog-id-value="start-commitment-dialog" data-action="click->modal#open" onclick="document.getElementById('start-commitment-dialog')?.showModal()" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">● Registra</button>
        <% unless %w[experiences structure].include?(params[:view_mode]) || @impegno_area != "agenda" %><button type="button" data-controller="modal" data-modal-dialog-id-value="new-commitment-dialog" data-action="click->modal#open" onclick="document.getElementById('new-commitment-dialog')?.showModal()" class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white hover:bg-blue-700">+ Nuovo impegno</button><% end %>
      </div>
    </div>
  </header>

  <dialog id="start-commitment-dialog" data-controller="modal" data-action="click->modal#backdropClose" onclick="if (event.target === this) this.close()" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50">
    <div class="flex items-start justify-between border-b border-slate-200 px-5 py-4">
      <div>
        <p class="text-xs font-black uppercase tracking-wider text-emerald-600">Registra attività</p>
        <h2 class="mt-1 text-xl font-black text-slate-950">Cosa stai facendo?</h2>
      </div>
      <button type="button" data-controller="modal" data-modal-dialog-id-value="start-commitment-dialog" data-action="click->modal#close" onclick="this.closest('dialog')?.close()" class="rounded-full p-2 text-slate-400 hover:bg-slate-100" aria-label="Chiudi">✕</button>
    </div>
    <%= form_with url: data_commitments_path, scope: :data_commitment, class: "space-y-4 p-5" do |form| %>
      <%= hidden_field_tag :start_now, "1" %>
      <%= hidden_field_tag :return_to, request.fullpath %>
      <%= hidden_field_tag :context_brand, @impegno_brand %>
      <%= form.hidden_field :domain_id, value: @impegno_default_domain&.id %>
      <div><%= form.label :title, "Titolo", class: "text-xs font-bold text-slate-700" %><%= form.text_field :title, required: true, placeholder: "Es. Preparare il programma dell'evento", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
      <div><%= form.label :description, "Cosa fai in questo momento?", class: "text-xs font-bold text-slate-700" %><%= form.text_area :description, rows: 3, placeholder: "Descrivi brevemente l'attività.", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
      <div><%= form.label :kind, "Tipo", class: "text-xs font-bold text-slate-700" %><%= form.select :kind, [["Attività", "work"], ["Personale", "personal"], ["Contenuto", "content"], ["Progetto", "project"]], {}, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %></div>
      <% if @impegno_experiences.any? %>
        <div>
          <%= form.label :data_experience_id, "Esperienza (facoltativa)", class: "text-xs font-bold text-slate-700" %>
          <%= form.collection_select :data_experience_id, @impegno_experiences, :id, :title, { include_blank: "Attività indipendente" }, class: "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
          <p class="mt-1 text-xs text-slate-400">Se la selezioni, la registrazione comparirà anche dentro l’Esperienza.</p>
        </div>
      <% end %>
      <%= form.hidden_field :calendar_label, value: Current.user.profile.display_name.presence || Current.user.profile.username %>
      <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
        <button type="button" data-controller="modal" data-modal-dialog-id-value="start-commitment-dialog" data-action="click->modal#close" onclick="this.closest('dialog')?.close()" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-50">Annulla</button>
        <%= form.submit "▶ Avvia attività", class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700" %>
      </div>
    <% end %>
  </dialog>

  <main class="min-h-[calc(100vh-4rem)] bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6">
      <% if @impegno_area == "agenda" %>
        <section class="mb-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2" aria-label="Contesti dell'agenda">
          <div>
            <p class="text-xs font-black uppercase tracking-wider text-blue-600">Utente</p>
            <p class="mt-1 text-sm font-bold text-slate-900">La mia agenda</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">Appuntamenti, attività e tempo personale sono raccolti qui.</p>
          </div>
          <div class="border-t border-slate-100 pt-3 sm:border-l sm:border-t-0 sm:pl-4 sm:pt-0">
            <p class="text-xs font-black uppercase tracking-wider text-violet-600">Ruoli operativi</p>
            <% if @impegno_has_domain_roles && @impegno_domain_roles.any? %>
              <p class="mt-1 text-sm font-bold text-slate-900"><%= @impegno_default_domain&.site_title.presence || @impegno_default_domain&.hostname || "Brand selezionato" %></p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <% @impegno_domain_roles.each do |role| %><span class="rounded-full bg-violet-50 px-2.5 py-1 text-xs font-bold text-violet-700"><%= @impegno_domain_role_labels.fetch(role, role.humanize) %></span><% end %>
                <% %w[Lezioni Percorsi Classi Corsi Eventi].each do |label| %><span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= label %></span><% end %>
              </div>
            <% else %>
              <p class="mt-1 text-xs leading-5 text-slate-500">Quando avrai un ruolo operativo su un brand, le sue attività compariranno qui insieme alla tua agenda.</p>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @workspace_src %>
        <% workspace_frame = turbo_frame_tag "impegno_workspace", src: @workspace_src, loading: :eager do %>
          <div class="rounded-xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-500">Caricamento dell’Agenda…</div>
        <% end %>
        <%= workspace_frame %>
      <% else %>
        <% workspace_frame = turbo_frame_tag "impegno_workspace" do %>
          <section class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
            <p class="text-xs font-black uppercase tracking-wider text-blue-600"><%= @impegno_area == "agenda" ? "Agenda" : @impegno_area.humanize %></p>
            <% workspace_title = @impegno_area == "agenda" ? "Agenda" : @impegno_area.humanize %>
            <h1 class="mt-2 text-2xl font-black text-slate-950"><%= workspace_title %></h1>
            <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-slate-500">La shell e l’URL di questa sezione sono pronti. Il contenuto verrà migrato dal prototipo nella prossima fase.</p>
          </section>
        <% end %>
        <%= workspace_frame %>
      <% end %>
    </div>
  </main>
  <% if Current.user.superadmin_user? %>
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <span class="text-xs font-semibold text-slate-400">Strumenti di lavoro · accesso superadmin</span>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Prototipi di lavoro">
          <%= link_to "1Impegno 2026", state_path.call(view_mode: "structure"), class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>
          <%= link_to "Orario ufficiale", admin_prototype_path(path: "viste_html/orario_ufficiale.html"), class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>
          <%= link_to "Vista evento", admin_prototype_path(path: "viste_html/0_dataevent_show.html"), class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>
          <%= link_to "Composer operativo", impegno_composer_path, class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>
          <%= link_to "Progetti e sovranità", admin_prototype_path(path: "viste_html/flowpulse_sovranita_progetti_community.html"), class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>
        </nav>
      </div>
    </footer>
  <% end %>
<% else %>
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <% brand_link = link_to impegno_path, class: "flex items-center gap-3 font-black text-slate-950" do %>
      <span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-sm text-white">I</span>
      <span>Impegno</span>
    <% end %>
    <%= brand_link %>
    <%= link_to authenticated? ? "Apri il calendario" : "Accedi", authenticated? ? data_commitments_path : new_session_path(return_to: data_commitments_path), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700" %>
  </div>
</header>

<main class="bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-100 via-stone-50 to-stone-50">
  <section class="mx-auto grid min-h-[calc(100vh-4rem)] max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_25rem] lg:py-24">
    <div>
      <span class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-black uppercase tracking-wider text-blue-700">Calendario personale</span>
      <h1 class="mt-5 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-6xl">Il tuo tempo, in un solo posto.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Raccogli appuntamenti, attività e tempo lavorato. Guarda tutto insieme oppure filtra il calendario per PosturaCorretta, GeneraImpresa, SvuotaMente e gli altri brand a cui partecipi.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to "Apri Impegno →", authenticated? ? data_commitments_path : new_user_path(return_to: data_commitments_path), class: "rounded-lg bg-blue-600 px-5 py-3 text-sm font-black text-white hover:bg-blue-700" %>
        <% unless authenticated? %><%= link_to "Ho già un account", new_session_path(return_to: data_commitments_path), class: "rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-black text-slate-700 hover:bg-slate-50" %><% end %>
      </div>
    </div>
    <aside class="rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
      <p class="text-xs font-black uppercase tracking-wider text-blue-700">Un calendario, più contesti</p>
      <ul class="mt-5 space-y-3 text-sm font-bold text-slate-700">
        <% ["Tutti i brand", "PosturaCorretta", "GeneraImpresa", "SvuotaMente"].each_with_index do |label, index| %>
          <li class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3"><span class="size-2 rounded-full <%= index.zero? ? 'bg-blue-600' : 'bg-slate-300' %>"></span><%= label %></li>
        <% end %>
      </ul>
    </aside>
  </section>
</main>
<% end %>
<footer class="border-t border-slate-200 bg-white px-5 py-5 text-center text-sm"><%= render "shared/changelog_footer_link", brand: "impegno" %></footer>
