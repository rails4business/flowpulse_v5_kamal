<% content_for :title, "Modifica evento · 1impegno" %>
<% content_for :landing_nav do %><%= render "brands/impegno/header" %><% end %>
<main class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6"><div class="mx-auto max-w-3xl"><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-black uppercase tracking-wider text-blue-600">DataEvent radice</p><h1 class="mt-1 text-3xl font-black text-slate-950">Modifica evento</h1></div><%= link_to "Vista operativa", impegno_data_event_path(@data_event), class: "rounded-lg border border-blue-200 bg-white px-3 py-2 text-sm font-bold text-blue-700" %></div><div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"><%= render "form", data_event: @data_event, form_url: impegno_data_event_path(@data_event) %></div><section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby="day-windows-title"><div class="flex items-center justify-between gap-3"><div><p class="text-xs font-black uppercase tracking-wider text-blue-600">Programmazione</p><h2 id="day-windows-title" class="mt-1 text-xl font-black text-slate-950">Fasce giornaliere</h2></div><%= link_to "Aggiungi fascia", new_impegno_data_event_day_path(@data_event), class: "rounded-lg bg-blue-600 px-3 py-2 text-sm font-bold text-white" %></div><% if @days.any? %><ul class="mt-4 divide-y divide-slate-100"><% @days.each do |day| %><li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-bold text-slate-900"><%= day.title %></p><p class="mt-1 text-sm text-slate-500"><%= l(day.starts_at, format: :short) %>–<%= day.ends_at.strftime("%H:%M") %> · <%= day.bookable? ? "Prenotabile" : "Non prenotabile" %></p></div><%= link_to "Modifica fascia", edit_impegno_data_event_day_path(@data_event, day), class: "text-sm font-bold text-blue-700" %></li><% end %></ul><% else %><p class="mt-4 text-sm text-slate-500">Nessuna fascia ancora configurata.</p><% end %></section></div></main>
