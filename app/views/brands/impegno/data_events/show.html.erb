<% content_for :title, "#{@data_event.title} · 1impegno" %>
<% content_for :landing_nav do %><%= render "brands/impegno/header" %><% end %>

<main class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-black uppercase tracking-wider text-blue-600">Vista operativa · DataEvent</p>
        <h1 class="mt-1 text-3xl font-black text-slate-950"><%= @data_event.title %></h1>
        <p class="mt-2 text-sm text-slate-500"><%= @data_event.domain.site_title.presence || @data_event.domain.hostname %> · <%= @data_event.classification.humanize %></p>
      </div>
      <div class="flex gap-2"><%= link_to "Modifica", edit_impegno_data_event_path(@data_event), class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700" %><%= link_to "Elenco eventi", impegno_data_events_path(domain_id: @data_event.domain_id), class: "rounded-lg px-3 py-2 text-sm font-bold text-blue-700" %></div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_17rem]">
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby="event-program-title">
        <p class="text-xs font-black uppercase tracking-wider text-blue-600">Programma</p>
        <h2 id="event-program-title" class="mt-1 text-xl font-black text-slate-950">Struttura e persone</h2>
        <div class="mt-5" role="tree" aria-label="Struttura del DataEvent"><%= render "operational_node", event: @data_event, commitments_by_event_id: @commitments_by_event_id, depth: 0 %></div>
      </section>
      <aside class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-black uppercase tracking-wider text-blue-600">Separazione chiara</p>
        <h2 class="mt-1 text-lg font-black text-slate-950">Evento e impegni</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Qui vedi il programma. Le persone compaiono solo quando hanno un commitment collegato alla sessione.</p>
        <%= link_to "Apri agenda 1impegno", impegno_agenda_path, class: "mt-4 inline-flex text-sm font-bold text-blue-700" %>
      </aside>
    </div>
  </div>
</main>
