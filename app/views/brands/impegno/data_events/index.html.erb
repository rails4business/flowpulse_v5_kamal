<% content_for :title, "Eventi · 1impegno" %>
<% content_for :landing_nav do %><%= render "brands/impegno/header" %><% end %>

<main class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div><p class="text-xs font-black uppercase tracking-wider text-blue-600">Ruoli operativi</p><h1 class="mt-1 text-3xl font-black text-slate-950">Eventi</h1></div>
      <%= link_to "Nuovo evento", new_impegno_data_event_path(domain_id: @selected_domain&.id), class: "rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-700" %>
    </div>

    <%= form_with url: impegno_data_events_path, method: :get, class: "mt-6 max-w-md" do |form| %>
      <%= form.label :domain_id, "Filtra per dominio / brand", class: "text-sm font-bold text-slate-700" %>
      <%= form.collection_select :domain_id, @domains, :id, ->(domain) { domain.site_title.presence || domain.hostname }, { include_blank: "Tutti i domini" }, onchange: "this.form.requestSubmit()", class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %>
    <% end %>

    <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <% if @data_events.any? %>
        <ul class="divide-y divide-slate-100">
          <% @data_events.each do |event| %>
            <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
              <div><p class="font-black text-slate-950"><%= event.title %></p><p class="mt-1 text-sm text-slate-500"><%= event.domain.site_title.presence || event.domain.hostname %> · <%= event.classification.humanize %> · <%= event.status.humanize %> · <%= event.visibility == "public" ? "Pubblico" : "Privato" %></p></div>
              <div class="flex gap-2"><%= link_to "Vista operativa", impegno_data_event_path(event), class: "rounded-lg border border-blue-200 px-3 py-2 text-center text-sm font-bold text-blue-700 hover:bg-blue-50" %><%= link_to "Modifica", edit_impegno_data_event_path(event), class: "rounded-lg border border-slate-300 px-3 py-2 text-center text-sm font-bold text-slate-700 hover:border-blue-300 hover:text-blue-700" %></div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-6 py-14 text-center text-sm text-slate-500">Nessun evento radice per il filtro selezionato.</p>
      <% end %>
    </div>
    <%= link_to "Torna a 1impegno", impegno_path(area: "domain_roles", view: "requests"), class: "mt-5 inline-flex text-sm font-bold text-blue-700" %>
  </div>
</main>
