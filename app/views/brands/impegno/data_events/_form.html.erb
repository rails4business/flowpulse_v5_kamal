<%= form_with model: data_event, url: form_url, class: "space-y-5" do |form| %>
  <% if data_event.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <p class="font-bold">Controlla i dati inseriti</p>
      <ul class="mt-2 list-disc pl-5"><% data_event.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <div>
    <%= form.label :domain_id, "Dominio / brand", class: "text-sm font-bold text-slate-700" %>
    <%= form.collection_select :domain_id, @domains, :id, ->(domain) { domain.site_title.presence || domain.hostname }, { prompt: "Scegli il dominio" }, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %>
  </div>
  <div>
    <%= form.label :title, "Titolo", class: "text-sm font-bold text-slate-700" %>
    <%= form.text_field :title, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5" %>
  </div>
  <div>
    <%= form.label :description, "Descrizione", class: "text-sm font-bold text-slate-700" %>
    <%= form.text_area :description, rows: 5, class: "mt-1 w-full rounded-xl border border-slate-300 px-3 py-2.5" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :classification, "Classificazione", class: "text-sm font-bold text-slate-700" %>
      <%= form.select :classification, DataEvent::CLASSIFICATIONS.map { |value| [value.humanize, value] }, {}, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %>
    </div>
    <div>
      <%= form.label :responsible_profile_id, "Responsabile", class: "text-sm font-bold text-slate-700" %>
      <%= form.collection_select :responsible_profile_id, @responsible_profiles, :id, ->(profile) { profile.display_name.presence || profile.username }, { include_blank: "Da assegnare" }, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %>
    </div>
    <div>
      <%= form.label :status, "Stato", class: "text-sm font-bold text-slate-700" %>
      <%= form.select :status, DataEvent::STATUSES.map { |value| [value.humanize, value] }, {}, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %>
    </div>
    <div>
      <%= form.label :visibility, "Visibilità", class: "text-sm font-bold text-slate-700" %>
      <%= form.select :visibility, [["Privato", "private"], ["Pubblico", "public"]], {}, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %>
      <p class="mt-1 text-xs text-slate-500">Una bozza deve restare privata.</p>
    </div>
  </div>

  <% unless data_event.persisted? %>
    <fieldset class="rounded-xl border border-blue-100 bg-blue-50/50 p-4">
      <legend class="px-1 text-sm font-bold text-slate-800">Data e orario già definiti (opzionale)</legend>
      <p class="mb-3 text-xs text-slate-500">Compilandoli verranno creati automaticamente root, day e sessione prenotabile.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><%= label_tag :session_starts_at, "Inizio appuntamento", class: "text-sm font-bold text-slate-700" %><%= datetime_local_field_tag :session_starts_at, @session_starts_at, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %></div>
        <div><%= label_tag :session_ends_at, "Fine appuntamento", class: "text-sm font-bold text-slate-700" %><%= datetime_local_field_tag :session_ends_at, @session_ends_at, class: "mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5" %></div>
      </div>
    </fieldset>
  <% end %>

  <div class="flex flex-wrap gap-3 border-t border-slate-200 pt-5">
    <%= form.submit data_event.persisted? ? "Salva modifiche" : "Crea evento", class: "cursor-pointer rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-700" %>
    <%= link_to "Annulla", impegno_data_events_path(domain_id: data_event.domain_id), class: "rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50" %>
  </div>
<% end %>
