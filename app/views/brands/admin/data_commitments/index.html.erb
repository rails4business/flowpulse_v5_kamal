<% content_for :title, "#{@brand.title} · Impegni e richieste" %>
<%
  status_labels = {
    "draft" => "Bozza", "requested" => "Richiesto", "planned" => "Pianificato",
    "confirmed" => "Confermato", "in_progress" => "In corso",
    "completed" => "Completato", "cancelled" => "Annullato"
  }
  kind_labels = {
    "personal" => "Personale", "appointment" => "Appuntamento", "event" => "Evento",
    "project" => "Progetto", "path" => "Percorso", "content" => "Contenuto",
    "academy" => "Accademia", "work" => "Lavoro", "service" => "Servizio",
    "purchase" => "Acquisto", "report" => "Report"
  }
  request_kind_labels = {
    "group_path" => "Percorso di gruppo", "individual_treatment" => "Trattamento individuale",
    "events" => "Eventi", "information" => "Informazioni", "training" => "Formazione",
    "find_professional" => "Ricerca professionista",
    "professional_application" => "Registrazione professionista", "other" => "Altro"
  }
  audience_labels = { "user" => "Utente", "professional" => "Professionista" }
%>

<main class="brand-admin-shell max-w-6xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500">
    <%= link_to @brand.title, brand_admin_nodes_path(@brand.slug), class: "font-semibold text-teal-700" %>
    <span>/</span><span>Impegni e richieste</span>
  </nav>

  <header class="brand-admin-card p-6">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-violet-700">Amministrazione del Brand</p>
    <h1 class="brand-admin-title mt-2 text-3xl"><%= @brand.title %> · Impegni e richieste</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">DataCommitment collegati ai domini del Brand o a uno dei suoi nodi. Le richieste inviate da persone non registrate compaiono qui con i loro recapiti.</p>

    <nav class="mt-5 flex flex-wrap gap-2" aria-label="Filtra richieste aperte e chiuse">
      <%= link_to "Aperte · #{@state_counts.fetch('open')}", brand_admin_data_commitments_path(@brand.slug, state: "open"), aria: { current: ("page" if @active_state == "open") }, class: "brand-admin-filter" %>
      <%= link_to "Chiuse · #{@state_counts.fetch('closed')}", brand_admin_data_commitments_path(@brand.slug, state: "closed"), aria: { current: ("page" if @active_state == "closed") }, class: "brand-admin-filter" %>
      <%= link_to "Tutte · #{@state_counts.values.sum}", brand_admin_data_commitments_path(@brand.slug, state: "all"), aria: { current: ("page" if @active_state == "all") }, class: "brand-admin-filter" %>
    </nav>

    <nav class="mt-3 flex flex-wrap gap-2" aria-label="Filtra per stato tecnico">
      <% status_labels.each do |status, label| %>
        <% next if @status_counts[status].to_i.zero? %>
        <%= link_to "#{label} · #{@status_counts.fetch(status)}", brand_admin_data_commitments_path(@brand.slug, state: @active_state, status: status), aria: { current: ("page" if @active_status == status) }, class: "brand-admin-filter" %>
      <% end %>
    </nav>
  </header>

  <% if @commitments.any? %>
    <section class="mt-6 space-y-4" aria-label="DataCommitment del Brand">
      <% @commitments.each do |commitment| %>
        <% contact = commitment.participant_contact %>
        <% metadata = commitment.metadata.to_h %>
        <% audience = metadata["request_audience"].presence || (%w[training professional_application].include?(metadata["request_kind"]) ? "professional" : "user") %>
        <article id="data-commitment-<%= commitment.id %>" class="brand-admin-card p-5 sm:p-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2 text-[11px] font-extrabold uppercase tracking-wide">
                <span class="brand-admin-badge brand-admin-badge--status"><%= status_labels.fetch(commitment.status, commitment.status.humanize) %></span>
                <span class="brand-admin-badge brand-admin-badge--kind"><%= kind_labels.fetch(commitment.kind, commitment.kind.humanize) %></span>
                <% if metadata["request_kind"].present? %><span class="brand-admin-badge brand-admin-badge--request"><%= request_kind_labels.fetch(metadata["request_kind"], metadata["request_kind"].humanize) %></span><% end %>
                <% if contact %><span class="brand-admin-badge brand-admin-badge--<%= audience %>"><%= audience_labels.fetch(audience) %></span><% end %>
              </div>
              <h2 class="mt-3 text-xl font-extrabold text-slate-950"><%= commitment.title %></h2>
              <% if commitment.description.present? %><p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600"><%= commitment.description %></p><% end %>
            </div>
            <div class="text-right text-xs text-slate-500">
              <time datetime="<%= commitment.created_at.iso8601 %>"><%= l(commitment.created_at, format: :long) %></time>
              <p class="mt-1 font-semibold"><%= commitment.domain.display_hostname %></p>
              <% if commitment.resolved_at.present? %><p class="mt-1">Chiusa <%= l(commitment.resolved_at, format: :short) %></p><% end %>
            </div>
          </div>

          <% if contact || metadata["city"].present? || commitment.starts_at.present? %>
            <dl class="mt-5 grid gap-3 border-t border-slate-200 pt-5 text-sm sm:grid-cols-2 lg:grid-cols-4">
              <% if contact %>
                <div><dt class="text-xs font-bold text-slate-500">Persona</dt><dd class="mt-1 font-semibold text-slate-900"><%= contact.name %></dd></div>
                <div><dt class="text-xs font-bold text-slate-500">Recapiti</dt><dd class="mt-1 flex flex-wrap gap-x-3 gap-y-1"><% if contact.email.present? %><%= mail_to contact.email, contact.email, class: "font-semibold text-teal-700" %><% end %><% if contact.phone.present? %><%= link_to contact.phone, "tel:#{contact.phone}", class: "font-semibold text-teal-700" %><% end %></dd></div>
              <% end %>
              <% if metadata["city"].present? %><div><dt class="text-xs font-bold text-slate-500">Località</dt><dd class="mt-1 font-semibold text-slate-900"><%= metadata["city"] %><%= " · #{metadata['country_code']}" if metadata["country_code"].present? %></dd></div><% end %>
              <% if commitment.starts_at.present? %><div><dt class="text-xs font-bold text-slate-500">Quando</dt><dd class="mt-1 font-semibold text-slate-900"><%= l(commitment.starts_at, format: :long) %></dd></div><% end %>
            </dl>
          <% end %>

          <footer class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
            <% if commitment.subject.is_a?(Node) %><span>Nodo: <strong><%= commitment.subject.title %></strong></span><% end %>
            <span>Calendario: <strong><%= commitment.calendar_label %></strong></span>
            <span class="font-mono">ID <%= commitment.id %></span>
          </footer>

          <% if contact %>
            <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-200 pt-4">
              <% if commitment.status == "requested" %><%= button_to "Prendi in carico", brand_admin_data_commitment_state_path(@brand.slug, commitment), method: :patch, params: { transition: "take_charge" }, class: "brand-admin-action brand-admin-action--primary" %><% end %>
              <% if %w[requested in_progress planned confirmed].include?(commitment.status) %><%= button_to "Chiudi", brand_admin_data_commitment_state_path(@brand.slug, commitment), method: :patch, params: { transition: "complete" }, class: "brand-admin-action" %><%= button_to "Annulla", brand_admin_data_commitment_state_path(@brand.slug, commitment), method: :patch, params: { transition: "cancel" }, class: "brand-admin-action brand-admin-action--danger" %><% end %>
              <% if %w[completed cancelled].include?(commitment.status) %><%= button_to "Riapri", brand_admin_data_commitment_state_path(@brand.slug, commitment), method: :patch, params: { transition: "reopen" }, class: "brand-admin-action" %><% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </section>
  <% else %>
    <p class="brand-admin-card mt-6 border-dashed p-10 text-center text-sm text-slate-500">Non ci sono DataCommitment<%= " con stato #{status_labels.fetch(@active_status)}" if @active_status %> per questo Brand.</p>
  <% end %>
</main>
