<% content_for :title, "Amministrazione #{@brand.title}" %>

<main class="brand-admin-main">
  <header class="brand-admin-page-header">
    <div>
      <p class="brand-admin-eyebrow">Dashboard del Brand</p>
      <h1><%= @brand.title %> · Amministrazione</h1>
      <p>Le funzioni disponibili dipendono dal Brand e dall’incarico con cui stai operando.</p>
    </div>
  </header>

  <% if @sections.any? %>
    <%= render "shared/dashboard/section_grid", sections: @sections %>
  <% elsif dashboard_access_context.selection_required? %>
    <section class="brand-admin-card mt-6 p-6">
      <h2 class="text-lg font-black">Scegli con quale ruolo operare</h2>
      <p class="mt-2 text-sm text-slate-600">Seleziona il tuo incarico dal menu laterale per aprire le relative funzioni.</p>
    </section>
  <% else %>
    <section class="brand-admin-card mt-6 p-6">
      <h2 class="text-lg font-black">Nessuna funzione amministrativa disponibile</h2>
      <p class="mt-2 text-sm text-slate-600">Il tuo accesso al Brand non include incarichi gestionali attivi.</p>
    </section>
  <% end %>
</main>
