<% content_for :title, "#{@development_entry.fetch("title")} — #{@brand.title}" %>
<% status_labels = { "proposed" => "Proposta", "approved" => "Approvata", "in_progress" => "In sviluppo", "verified" => "Verificata", "deployed" => "Distribuita", "paused" => "In pausa" } %>
<main class="brand-admin-shell max-w-4xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500"><%= link_to @brand.title, brand_admin_nodes_path(@brand.slug), class: "font-semibold text-teal-700" %><span>/</span><%= link_to "Sviluppo", brand_admin_development_path(@brand.slug), class: "font-semibold text-teal-700" %><span>/</span><span><%= @development_entry.fetch("title") %></span></nav>
  <article><div class="flex flex-wrap items-center gap-2 text-xs font-bold text-slate-500"><span class="rounded-full bg-amber-50 px-2.5 py-1 text-amber-800"><%= status_labels.fetch(@development_entry.fetch("status")) %></span><time>Aggiornata <%= I18n.l(@development_entry.fetch("updated_on_value"), format: :long) %></time><% if @development_node %><%= link_to "Node · #{@development_node.slug}", brand_admin_node_path(@brand.slug, @development_node), class: "rounded-full bg-teal-50 px-2.5 py-1 font-mono text-teal-800 hover:bg-teal-100" %><% end %></div><h1 class="mt-4 text-4xl font-black tracking-[-0.04em]"><%= @development_entry.fetch("title") %></h1><p class="mt-4 text-lg leading-8 text-slate-600"><%= @development_entry.fetch("summary") %></p><div class="editorial-rich-text mt-10 border-t border-slate-200 pt-10 text-lg leading-8 text-slate-700"><%= markdown(@development_entry.fetch("body")) %></div><p class="mt-10 rounded-xl bg-amber-50 px-4 py-3 font-mono text-xs text-amber-900">Sorgente: <%= @development_entry.fetch("source_path") %></p></article>
</main>
