<% content_for :title, "Sviluppo di #{@brand.title}" %>
<% status_labels = { "proposed" => "Proposta", "approved" => "Approvata", "in_progress" => "In sviluppo", "verified" => "Verificata", "deployed" => "Distribuita", "paused" => "In pausa" } %>
<main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500"><%= link_to "Brand e progetti", admin_brands_path, class: "font-semibold text-blue-700" %><span>/</span><%= link_to @brand.title, admin_brand_path(@brand), class: "font-semibold text-blue-700" %><span>/</span><span>Sviluppo</span></nav>
  <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-amber-700">Amministrazione del Brand · superadmin</p><h1 class="mt-2 text-3xl font-extrabold"><%= @brand.title %> · Sviluppo</h1><p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Decisioni e attività di implementazione che appartengono a questo Brand.</p>
    <nav class="mt-6 flex flex-wrap gap-2 text-sm font-bold"><%= link_to "Nodi", brand_admin_nodes_path(@brand.slug), class: "rounded-full bg-slate-100 px-4 py-2 text-slate-700" %><%= link_to "Sviluppo", brand_admin_development_path(@brand.slug), aria: { current: "page" }, class: "rounded-full bg-slate-950 px-4 py-2 text-white" %></nav>
  </header>
  <section class="mt-6 grid gap-4 lg:grid-cols-2">
    <% if @development_entries.any? %>
      <% @development_entries.each do |entry| %><%= link_to brand_admin_development_entry_path(@brand.slug, entry.fetch("slug")), class: "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:border-blue-300" do %><article><div class="flex items-center justify-between gap-3"><span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-black text-amber-800"><%= status_labels.fetch(entry.fetch("status")) %></span><time class="text-xs font-bold text-slate-400"><%= I18n.l(entry.fetch("updated_on_value"), format: :long) %></time></div><h2 class="mt-4 text-xl font-extrabold"><%= entry.fetch("title") %></h2><p class="mt-3 text-sm leading-6 text-slate-600"><%= entry.fetch("summary") %></p></article><% end %><% end %>
    <% else %><p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-500 lg:col-span-2">Questo Brand non ha ancora schede di sviluppo.</p><% end %>
  </section>
</main>
