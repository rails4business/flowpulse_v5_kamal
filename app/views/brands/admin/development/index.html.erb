<% content_for :title, "Sviluppo di #{@brand.title}" %>
<% status_labels = { "proposed" => "Proposta", "approved" => "Approvata", "in_progress" => "In sviluppo", "verified" => "Verificata", "deployed" => "Distribuita", "paused" => "In pausa" } %>
<main class="brand-admin-shell max-w-6xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500"><%= link_to @brand.title, brand_admin_nodes_path(@brand.slug), class: "font-semibold text-teal-700" %><span>/</span><span>Sviluppo</span></nav>
  <header class="brand-admin-card p-6">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-amber-700">Amministrazione del Brand</p><h1 class="brand-admin-title mt-2 text-3xl"><%= @brand.title %> · Sviluppo</h1><p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Decisioni e attività di implementazione che appartengono a questo Brand.</p>
  </header>
  <section class="mt-6 grid gap-4 lg:grid-cols-2">
    <% if @development_entries.any? %>
      <% @development_entries.each do |entry| %><%= link_to brand_admin_development_entry_path(@brand.slug, entry.fetch("slug")), class: "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:border-blue-300" do %><article><div class="flex items-center justify-between gap-3"><span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-black text-amber-800"><%= status_labels.fetch(entry.fetch("status")) %></span><time class="text-xs font-bold text-slate-400"><%= I18n.l(entry.fetch("updated_on_value"), format: :long) %></time></div><% if entry["node_slug"].present? %><p class="mt-4 font-mono text-[11px] font-bold text-teal-700">Node · <%= entry.fetch("node_slug") %></p><% end %><h2 class="<%= entry["node_slug"].present? ? "mt-1" : "mt-4" %> text-xl font-extrabold"><%= entry.fetch("title") %></h2><p class="mt-3 text-sm leading-6 text-slate-600"><%= entry.fetch("summary") %></p></article><% end %><% end %>
    <% else %><p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-500 lg:col-span-2">Questo Brand non ha ancora schede di sviluppo.</p><% end %>
  </section>
</main>
