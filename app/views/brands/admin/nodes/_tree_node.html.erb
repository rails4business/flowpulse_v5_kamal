<% domain_boundary = node != brand && node.brand? %>
<% can_open_brand_admin = domain_boundary && node.administered_by?(Current.user) %>
<% destination = domain_boundary ? (can_open_brand_admin ? brand_admin_nodes_path(node.slug) : node_path(node)) : brand_admin_node_path(brand.slug, node) %>
<li role="treeitem" aria-expanded="<%= !domain_boundary %>">
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 hover:border-blue-300">
    <div class="min-w-0">
      <%= link_to node.title, destination, class: "font-extrabold text-slate-900 hover:text-blue-700" %>
      <span class="ml-2 text-xs font-bold text-slate-400"><%= node.status.humanize %> · <%= domain_boundary ? node.domains.map(&:hostname).to_sentence : pluralize(node.node_processes.size, "processo", "processi") %></span>
      <% if domain_boundary %><span class="ml-2 rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wide text-blue-700">sotto-Brand</span><% end %>
    </div>
    <% if domain_boundary %><%= link_to(can_open_brand_admin ? "Apri Brand →" : "Pagina pubblica →", destination, class: "text-xs font-black text-blue-700 hover:underline") %><% else %><button type="button" data-node-add-parent="<%= node.id %>" class="rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-black text-slate-600 hover:border-blue-400 hover:text-blue-700" aria-label="Aggiungi un nodo sotto <%= node.title %>">+ sotto</button><% end %>
  </div>
  <% children = domain_boundary ? [] : (nodes_by_parent_id[node.id] || []) %>
  <% if children.any? %>
    <ul class="ml-5 mt-2 space-y-2 border-l-2 border-slate-200 pl-4" role="group">
      <% children.each do |child| %><%= render "tree_node", node: child, nodes_by_parent_id: nodes_by_parent_id, brand: brand %><% end %>
    </ul>
  <% end %>
</li>
