<% content_for :title, "Nodi di #{@brand.title}" %>
<% map_nodes = @nodes.map { |node| { id: node.id, title: node.title, parent_id: node.parent_id, status: node.status, link_node_id: node.link_node_id, process_count: node.brand_processes.size, url: brand_admin_node_path(@brand.slug, node) } } if @active_view == "schema" %>

<style nonce="<%= content_security_policy_nonce %>">
  .brand-node-map { --ink:#172033; --muted:#64748b; --line:#cbd5e1; --draft:#94a3b8; --published:#16805c; --archived:#b45309; }
  .brand-node-map__canvas { overflow:auto; border:1px solid #dbe3ee; border-radius:1rem; background:#f8fafc; }
  .brand-node-map__canvas svg { display:block; min-width:100%; }
  .brand-node-map__edge { fill:none; stroke:var(--line); stroke-width:2; }
  .brand-node-map__bridge { fill:none; stroke:#7c3aed; stroke-width:2; stroke-dasharray:7 6; }
  .brand-node-map__node { color:var(--draft); text-decoration:none; }
  .brand-node-map__node[data-status="published"] { color:var(--published); }
  .brand-node-map__node[data-status="archived"] { color:var(--archived); }
  .brand-node-map__node rect { fill:white; stroke:currentColor; stroke-width:2.5; }
  .brand-node-map__node:hover rect, .brand-node-map__node:focus rect { fill:#eff6ff; stroke-width:4; }
  .brand-node-map__title { fill:var(--ink); font:700 14px ui-sans-serif,system-ui,sans-serif; text-anchor:middle; }
  .brand-node-map__meta { fill:currentColor; font:800 10px ui-sans-serif,system-ui,sans-serif; letter-spacing:.05em; text-anchor:middle; text-transform:uppercase; }
</style>

<main class="brand-node-map mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500" aria-label="Percorso">
    <%= link_to "Brand e progetti", admin_brands_path, class: "font-semibold text-blue-700" %><span>/</span><%= link_to @brand.title, admin_brand_path(@brand), class: "font-semibold text-blue-700" %><span>/</span><span>Nodi</span>
  </nav>

  <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-blue-600">Amministrazione del Brand · superadmin</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-5">
      <div><h1 class="text-3xl font-extrabold tracking-tight"><%= @brand.title %> · Nodi</h1><p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Costruisci la struttura aggiungendo un nodo alla volta. Apri un nodo per vedere i processi che gli appartengono.</p></div>
      <button type="button" data-node-dialog-open class="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-black text-white hover:bg-blue-700">+ Nodo</button>
    </div>
    <nav class="mt-6 flex flex-wrap gap-2 text-sm font-bold" aria-label="Amministrazione del Brand">
      <%= link_to "Elenco", brand_admin_nodes_path(@brand.slug), aria: (@active_view == "list" ? { current: "page" } : {}), class: "rounded-full px-4 py-2 #{@active_view == "list" ? "bg-slate-950 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200"}" %>
      <%= link_to "Schema", brand_admin_nodes_path(@brand.slug, view: "schema"), aria: (@active_view == "schema" ? { current: "page" } : {}), class: "rounded-full px-4 py-2 #{@active_view == "schema" ? "bg-slate-950 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200"}" %>
      <%= link_to "Sviluppo", brand_admin_development_path(@brand.slug), class: "rounded-full bg-slate-100 px-4 py-2 text-slate-700 hover:bg-slate-200" %>
    </nav>
  </header>

  <% if @active_view == "list" %>
    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6" aria-labelledby="brand-node-tree-title">
      <div class="mb-5 flex items-center justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-wide text-blue-700">Struttura operativa</p><h2 id="brand-node-tree-title" class="mt-1 text-xl font-extrabold">Albero dei nodi</h2></div><span class="text-sm font-bold text-slate-400"><%= pluralize(@nodes.size, "nodo", "nodi") %></span></div>
      <ul class="space-y-2" role="tree" aria-label="Albero dei nodi di <%= @brand.title %>">
        <%= render "tree_node", node: @brand, nodes_by_parent_id: @nodes_by_parent_id, brand: @brand %>
      </ul>
    </section>
  <% else %>
    <section class="brand-node-map__canvas mt-6" aria-label="Schema dei nodi di <%= @brand.title %>">
      <svg id="brand-node-map-svg" role="img" aria-label="Nodi e collegamenti del Brand"></svg>
    </section>
  <% end %>

  <dialog data-node-dialog class="w-[min(34rem,calc(100%-2rem))] rounded-2xl border border-slate-300 p-0 shadow-2xl backdrop:bg-slate-950/40">
    <%= form_with model: Node.new, url: brand_admin_nodes_path(@brand.slug), class: "space-y-4 p-6" do |form| %>
      <div class="flex items-center justify-between gap-4"><h2 class="text-xl font-extrabold">Aggiungi un nodo</h2><button type="button" data-node-dialog-close class="rounded-lg px-2 py-1 text-slate-500 hover:bg-slate-100" aria-label="Chiudi">×</button></div>
      <div><%= form.label :title, "Nome", class: "text-sm font-bold text-slate-700" %><%= form.text_field :title, required: true, autofocus: true, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <div><%= form.label :parent_id, "Nasce sotto", class: "text-sm font-bold text-slate-700" %><%= form.collection_select :parent_id, @parent_options, :id, :title, { selected: @brand.id }, class: "mt-1 w-full rounded-xl border-slate-300 bg-white" %></div>
      <div><%= form.label :link_node_id, "Nodo ponte verso", class: "text-sm font-bold text-slate-700" %><%= form.collection_select :link_node_id, @link_node_options, :id, :title, { include_blank: "Nodo normale — nessun ponte" }, class: "mt-1 w-full rounded-xl border-slate-300 bg-white" %><p class="mt-1 text-xs text-slate-500">Un nodo ponte rimanda a un altro nodo dello stesso proprietario e non può avere figli.</p></div>
      <div><%= form.label :description, "Descrizione iniziale", class: "text-sm font-bold text-slate-700" %><%= form.text_area :description, rows: 3, class: "mt-1 w-full rounded-xl border-slate-300" %></div>
      <%= form.hidden_field :status, value: "draft" %>
      <div class="flex justify-end gap-2"><button type="button" data-node-dialog-close class="rounded-xl px-4 py-2.5 text-sm font-bold text-slate-600">Annulla</button><%= form.submit "Crea nodo", class: "cursor-pointer rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-black text-white" %></div>
    <% end %>
  </dialog>

  <% if @active_view == "schema" %><script type="application/json" id="brand-node-map-data"><%== json_escape(map_nodes.to_json) %></script><% end %>
</main>

<script nonce="<%= content_security_policy_nonce %>">
(() => {
  const dialog=document.querySelector('[data-node-dialog]');
  const parentSelect=dialog?.querySelector('select[name="node[parent_id]"]');
  const openDialog=parentId => { if(parentSelect && parentId) parentSelect.value=String(parentId); dialog?.showModal(); };
  document.querySelector('[data-node-dialog-open]')?.addEventListener('click',()=>openDialog());
  document.querySelectorAll('[data-node-add-parent]').forEach(button=>button.addEventListener('click',()=>openDialog(button.dataset.nodeAddParent)));
  document.querySelectorAll('[data-node-dialog-close]').forEach(button=>button.addEventListener('click',()=>dialog?.close()));
  const svg = document.getElementById('brand-node-map-svg');
  const source = document.getElementById('brand-node-map-data');
  if (!svg || !source) return;
  const nodes = JSON.parse(source.textContent), byId = Object.fromEntries(nodes.map(node => [String(node.id), node]));
  const esc = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const memo = {};
  const depth = node => memo[node.id] ??= (byId[String(node.parent_id)] ? depth(byId[String(node.parent_id)]) + 1 : 0);
  const columns = {}; nodes.forEach(node => (columns[depth(node)] ||= []).push(node));
  const keys = Object.keys(columns).map(Number).sort((a,b) => a-b), w = 184, h = 78, gx = 74, gy = 38, pad = 54;
  const rows = Math.max(...keys.map(key => columns[key].length), 1), width = pad*2 + keys.length*w + Math.max(keys.length-1,0)*gx, height = pad*2 + rows*h + Math.max(rows-1,0)*gy;
  const positions = {};
  keys.forEach(column => { const list=columns[column], block=list.length*h+Math.max(list.length-1,0)*gy, top=(height-block)/2; list.forEach((node,row) => positions[node.id]={x:pad+column*(w+gx),y:top+row*(h+gy)}); });
  const split = title => { const out=[]; let line=''; title.split(/\s+/).forEach(word => { const next=`${line} ${word}`.trim(); if(next.length>22&&line){out.push(line);line=word}else line=next; }); if(line)out.push(line); return out.slice(0,2); };
  let html='<defs><marker id="brand-node-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#cbd5e1"/></marker></defs>';
  nodes.forEach(node => { const parent=byId[String(node.parent_id)]; if(!parent)return; const a=positions[parent.id],b=positions[node.id],x1=a.x+w,y1=a.y+h/2,x2=b.x,y2=b.y+h/2,m=(x1+x2)/2; html+=`<path class="brand-node-map__edge" marker-end="url(#brand-node-arrow)" d="M${x1},${y1} C${m},${y1} ${m},${y2} ${x2-7},${y2}"/>`; });
  nodes.forEach(node => { if(!node.link_node_id||!positions[node.link_node_id])return; const a=positions[node.id],b=positions[node.link_node_id]; html+=`<path class="brand-node-map__bridge" d="M${a.x+w/2},${a.y} C${a.x+w/2},${a.y-55} ${b.x+w/2},${b.y-55} ${b.x+w/2},${b.y}"/>`; });
  nodes.forEach(node => { const p=positions[node.id], lines=split(node.title).map((line,i)=>`<tspan x="${w/2}" dy="${i?17:0}">${esc(line)}</tspan>`).join(''), meta=node.process_count===1?'1 processo':`${node.process_count} processi`; html+=`<a class="brand-node-map__node" data-status="${esc(node.status)}" href="${esc(node.url)}" transform="translate(${p.x},${p.y})"><rect width="${w}" height="${h}" rx="14"/><text class="brand-node-map__title" x="${w/2}" y="25">${lines}</text><text class="brand-node-map__meta" x="${w/2}" y="64">${esc(meta)}</text></a>`; });
  svg.setAttribute('viewBox',`0 0 ${width} ${height}`); svg.setAttribute('width',width); svg.setAttribute('height',height); svg.innerHTML=html;
})();
</script>
