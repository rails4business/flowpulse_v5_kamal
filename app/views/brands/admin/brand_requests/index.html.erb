<% content_for :title, "#{@brand.title} · Richieste" %>
<%
  status_labels = {
    "open" => "Aperta", "in_progress" => "In carico", "waiting" => "In attesa",
    "invited" => "Invitata", "accepted" => "Accettata", "closed" => "Archiviata",
    "rejected" => "Rifiutata", "cancelled" => "Annullata"
  }
  kind_labels = {
    "waitlist" => "Lista d’attesa", "access" => "Accesso", "group_path" => "Percorso di gruppo",
    "individual_treatment" => "Trattamento individuale", "event" => "Evento", "events" => "Eventi",
    "service" => "Servizio", "information" => "Informazioni", "training" => "Formazione",
    "find_professional" => "Ricerca professionista", "professional_application" => "Registrazione professionista",
    "contact" => "Contatto", "other" => "Altro"
  }
  audience_labels = { "user" => "Utente", "professional" => "Professionista", "organization" => "Organizzazione" }
  status_groups = {
    "open" => BrandRequest::ACTIVE_STATUSES,
    "closed" => BrandRequest::CLOSED_STATUSES
  }
%>

<main class="brand-admin-shell max-w-6xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500">
    <%= link_to @brand.title, brand_admin_nodes_path(@brand.slug), class: "font-semibold text-teal-700" %>
    <span>/</span><span>Richieste</span>
  </nav>

  <header class="brand-admin-card p-6">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-violet-700">Amministrazione del Brand</p>
    <h1 class="brand-admin-title mt-2 text-3xl"><%= @brand.title %> · Richieste</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Contatti, liste d’attesa, candidature e richieste di accesso. Una richiesta può essere chiusa direttamente oppure trasformata in invito, servizio, evento o impegno.</p>

    <nav class="mt-5 flex flex-wrap gap-2" aria-label="Filtra richieste aperte e chiuse">
      <%= link_to "Aperte · #{@state_counts.fetch('open')}", brand_admin_requests_path(@brand.slug, state: "open"), aria: { current: ("page" if @active_state == "open") }, class: "brand-admin-filter" %>
      <%= link_to "Chiuse · #{@state_counts.fetch('closed')}", brand_admin_requests_path(@brand.slug, state: "closed"), aria: { current: ("page" if @active_state == "closed") }, class: "brand-admin-filter" %>
      <%= link_to "Tutte · #{@state_counts.values.sum}", brand_admin_requests_path(@brand.slug, state: "all"), aria: { current: ("page" if @active_state == "all") }, class: "brand-admin-filter" %>
    </nav>

    <% if status_groups.key?(@active_state) %>
      <nav class="mt-3 flex flex-wrap gap-2" aria-label="Filtra per stato">
        <%= link_to "Tutte #{@active_state == 'open' ? 'le aperte' : 'le chiuse'}", brand_admin_requests_path(@brand.slug, state: @active_state), aria: { current: ("page" unless @active_status) }, class: "brand-admin-filter brand-admin-filter--secondary" %>
        <% status_groups.fetch(@active_state).each do |status| %>
          <% next if @status_counts[status].to_i.zero? %>
          <%= link_to "#{status_labels.fetch(status)} · #{@status_counts.fetch(status)}", brand_admin_requests_path(@brand.slug, state: @active_state, status:), aria: { current: ("page" if @active_status == status) }, class: "brand-admin-filter brand-admin-filter--secondary" %>
        <% end %>
      </nav>
    <% end %>
  </header>

  <% if flash[:invitation_url].present? %>
    <section class="brand-admin-card mt-6 border-teal-200 bg-teal-50 p-5" aria-label="Collegamento di invito">
      <p class="text-xs font-extrabold uppercase tracking-wide text-teal-700">Invito pronto</p>
      <h2 class="mt-2 text-xl font-extrabold text-slate-950">Copia e invia personalmente questo collegamento</h2>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row">
        <input id="brand-invitation-url" type="text" readonly value="<%= flash[:invitation_url] %>" class="min-w-0 flex-1 rounded-lg border border-teal-200 bg-white px-3 py-2 font-mono text-xs text-slate-800">
        <button type="button" class="brand-admin-action brand-admin-action--primary" data-controller="clipboard" data-clipboard-text-value="<%= flash[:invitation_url] %>" data-action="clipboard#copy">Copia link</button>
      </div>
      <p class="mt-3 text-xs leading-5 text-slate-600">Il collegamento è personale, monouso e scade dopo sette giorni.</p>
    </section>
  <% end %>

  <% if @requests.any? && @active_state == "all" %>
    <section class="brand-admin-card brand-admin-table-wrap mt-6" aria-label="Tutte le richieste del Brand">
      <table class="brand-admin-table">
        <thead><tr><th>Data</th><th>Persona</th><th>Richiesta</th><th>Stato</th><th>Responsabile</th><th>Esito</th><th><span class="sr-only">Apri</span></th></tr></thead>
        <tbody>
          <% @requests.each do |brand_request| %>
            <% contact = brand_request.participant_contact %>
            <% person_name = contact&.name.presence || brand_request.requester_profile&.display_name || "—" %>
            <tr>
              <td><time datetime="<%= brand_request.created_at.iso8601 %>"><%= l(brand_request.created_at.to_date, format: :short) %></time></td>
              <td><strong><%= person_name %></strong><% if contact&.email.present? %><small><%= contact.email %></small><% end %></td>
              <td><strong><%= kind_labels.fetch(brand_request.kind, brand_request.kind.humanize) %></strong><small><%= brand_request.title %></small></td>
              <td><span class="brand-admin-badge brand-admin-badge--status"><%= status_labels.fetch(brand_request.status, brand_request.status.humanize) %></span></td>
              <td><%= brand_request.assigned_to_profile&.display_name || "—" %></td>
              <td><%= brand_request.active? ? "—" : status_labels.fetch(brand_request.status) %></td>
              <td><%= link_to "Apri", brand_admin_requests_path(@brand.slug, state: (brand_request.active? ? "open" : "closed"), status: brand_request.status, anchor: "brand-request-#{brand_request.id}"), class: "brand-admin-action" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% elsif @requests.any? %>
    <section class="mt-6 space-y-4" aria-label="Richieste del Brand">
      <%= render partial: "request_card", collection: @requests, as: :brand_request, locals: { status_labels:, kind_labels:, audience_labels: } %>
    </section>
  <% else %>
    <p class="brand-admin-card mt-6 border-dashed p-10 text-center text-sm text-slate-500">Non ci sono richieste<%= " con stato #{status_labels.fetch(@active_status)}" if @active_status %> per questo Brand.</p>
  <% end %>
</main>
