<% content_for :title, "#{@brand.title} · Richieste" %>
<%
  status_labels = {
    "open" => "Aperta", "in_progress" => "In carico", "waiting" => "In attesa",
    "invited" => "Invitata", "accepted" => "Accettata", "closed" => "Archiviata",
    "rejected" => "Rifiutata", "cancelled" => "Rifiutata"
  }
  kind_labels = {
    "waitlist" => "Lista d’attesa", "access" => "Accesso", "group_path" => "Percorso di gruppo",
    "individual_treatment" => "Trattamento individuale", "event" => "Evento", "events" => "Eventi",
    "service" => "Servizio", "information" => "Informazioni", "training" => "Formazione",
    "find_professional" => "Ricerca professionista", "professional_application" => "Registrazione professionista",
    "contact" => "Contatto", "other" => "Altro"
  }
  audience_labels = { "user" => "Utente", "professional" => "Professionista", "organization" => "Organizzazione" }

  accepted_count = @status_counts["accepted"].to_i
  rejected_count = @status_counts["rejected"].to_i + @status_counts["cancelled"].to_i
%>

<main class="brand-admin-shell max-w-6xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500">
    <%= link_to @brand.title, brand_admin_nodes_path(@brand.slug), class: "font-semibold text-teal-700" %>
    <span>/</span><span>Richieste</span>
  </nav>

  <header class="brand-admin-card p-6">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-violet-700">Amministrazione del Brand</p>
    <h1 class="brand-admin-title mt-2 text-3xl"><%= @brand.title %> · Richieste</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Contatti, liste d’attesa, candidature e richieste di accesso. Una richiesta può essere chiusa direttamente oppure trasformata in invito, servizio, evento o impegno.</p>

    <!-- LIVELLO PRINCIPALE: Aperte / Chiuse / Tutte -->
    <nav class="mt-5 flex flex-wrap gap-2" aria-label="Filtra richieste aperte e chiuse">
      <%= link_to "Aperte · #{@state_counts.fetch('open')}", brand_admin_requests_path(@brand.slug, state: "open"), aria: { current: ("page" if @active_state == "open") }, class: "brand-admin-filter" %>
      <%= link_to "Chiuse · #{@state_counts.fetch('closed')}", brand_admin_requests_path(@brand.slug, state: "closed"), aria: { current: ("page" if @active_state == "closed") }, class: "brand-admin-filter" %>
      <%= link_to "Tutte · #{@state_counts.values.sum}", brand_admin_requests_path(@brand.slug, state: "all"), aria: { current: ("page" if @active_state == "all") }, class: "brand-admin-filter" %>
    </nav>

    <!-- SOTTOMENU: SOLO SOTTO CHIUSE (Accettate e Rifiutate) -->
    <% if @active_state == "closed" %>
      <nav class="mt-3 flex flex-wrap gap-2" aria-label="Filtra richieste chiuse">
        <%= link_to "Tutte le chiuse · #{@state_counts.fetch('closed')}", brand_admin_requests_path(@brand.slug, state: "closed"), aria: { current: ("page" unless @active_status) }, class: "brand-admin-filter brand-admin-filter--secondary" %>
        <%= link_to "Accettate · #{accepted_count}", brand_admin_requests_path(@brand.slug, state: "closed", status: "accepted"), aria: { current: ("page" if @active_status == "accepted") }, class: "brand-admin-filter brand-admin-filter--secondary" %>
        <%= link_to "Rifiutate · #{rejected_count}", brand_admin_requests_path(@brand.slug, state: "closed", status: "rejected"), aria: { current: ("page" if @active_status == "rejected") }, class: "brand-admin-filter brand-admin-filter--secondary" %>
      </nav>
    <% end %>
  </header>

  <% if flash[:invitation_url].present? %>
    <section class="brand-admin-card mt-6 border-teal-200 bg-teal-50 p-5" aria-label="Collegamento di invito">
      <p class="text-xs font-extrabold uppercase tracking-wide text-teal-700">Invito pronto</p>
      <h2 class="mt-2 text-xl font-extrabold text-slate-950">Copia e invia personalmente questo collegamento</h2>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row">
        <input id="brand-invitation-url" type="text" readonly value="<%= flash[:invitation_url] %>" class="min-w-0 flex-1 rounded-lg border border-teal-200 bg-white px-3 py-2 font-mono text-xs text-slate-800">
        <button type="button" class="brand-admin-action brand-admin-action--primary" data-controller="clipboard" data-clipboard-text-value="<%= flash[:invitation_url] %>" data-action="clipboard#copy">Copia link</button>
      </div>
      <p class="mt-3 text-xs leading-5 text-slate-600">Il collegamento è personale, monouso e scade dopo sette giorni.</p>
    </section>
  <% end %>

  <% if @requests.any? %>
    <section class="brand-admin-card brand-admin-table-wrap mt-6" aria-label="Richieste del Brand">
      <table class="brand-admin-table">
        <thead>
          <tr>
            <th>Data</th>
            <th>Richiedente & Contatti</th>
            <th>Richiesta</th>
            <th>Stato</th>
            <th>Responsabile</th>
            <th class="text-right">Azioni</th>
          </tr>
        </thead>
        <tbody>
          <% @requests.each do |brand_request| %>
            <%
              contact = brand_request.participant_contact
              metadata = brand_request.metadata.to_h
              person_name = contact&.name.presence || brand_request.requester_profile&.display_name || "—"
              status_badge_modifier = case brand_request.status
                when "accepted" then "brand-admin-badge--accepted"
                when "rejected", "cancelled" then "brand-admin-badge--rejected"
                when "waiting" then "brand-admin-badge--waiting"
                else "brand-admin-badge--status"
              end
            %>
            <tr id="brand-request-<%= brand_request.id %>">
              <td class="whitespace-nowrap">
                <time datetime="<%= brand_request.created_at.iso8601 %>" class="font-bold">
                  <%= l(brand_request.created_at.to_date, format: :short) %>
                </time>
                <small class="text-slate-400 font-mono"><%= brand_request.domain.display_hostname %></small>
              </td>

              <td>
                <strong class="text-slate-900"><%= person_name %></strong>
                <% if contact&.email.present? %>
                  <div class="mt-0.5"><%= mail_to contact.email, contact.email, class: "font-semibold text-teal-700 hover:underline" %></div>
                <% end %>
                <% if contact&.phone.present? %>
                  <div><%= link_to contact.phone, "tel:#{contact.phone}", class: "text-xs font-semibold text-slate-600 hover:text-teal-700 hover:underline" %></div>
                <% end %>
                <% if metadata["city"].present? %>
                  <small class="text-slate-500">📍 <%= metadata["city"] %><%= " (#{metadata['country_code']})" if metadata["country_code"].present? %></small>
                <% end %>
              </td>

              <td>
                <div class="flex flex-wrap items-center gap-1.5 mb-1">
                  <span class="brand-admin-badge brand-admin-badge--request"><%= kind_labels.fetch(brand_request.kind, brand_request.kind.humanize) %></span>
                  <span class="brand-admin-badge brand-admin-badge--<%= brand_request.audience %>"><%= audience_labels.fetch(brand_request.audience, brand_request.audience.humanize) %></span>
                </div>
                <strong class="text-slate-900 block"><%= brand_request.title %></strong>
                <% if brand_request.message.present? %>
                  <p class="mt-1 text-xs text-slate-600 max-w-sm" title="<%= brand_request.message %>"><%= brand_request.message %></p>
                <% end %>
                <% if brand_request.subject.is_a?(Node) %>
                  <small class="text-slate-500">Nodo: <%= brand_request.subject.title %></small>
                <% end %>
              </td>

              <td class="whitespace-nowrap">
                <span class="brand-admin-badge <%= status_badge_modifier %>">
                  <%= status_labels.fetch(brand_request.status, brand_request.status.humanize) %>
                </span>
                <% if brand_request.resolved_at.present? %>
                  <small class="text-slate-500">Chiusa <%= l(brand_request.resolved_at, format: :short) %></small>
                <% end %>
              </td>

              <td class="whitespace-nowrap">
                <%= brand_request.assigned_to_profile&.display_name || "—" %>
              </td>

              <td class="text-right whitespace-nowrap">
                <div class="inline-flex flex-wrap items-center justify-end gap-1.5">
                  <% if brand_request.active? %>
                    <% if brand_request.kind == "access" && contact&.email.present? %>
                      <%= button_to(brand_request.brand_invitations.pending.exists? ? "Rigenera invito" : "Genera invito", brand_admin_request_invitation_path(@brand.slug, brand_request), method: :post, class: "brand-admin-action brand-admin-action--primary brand-admin-action--sm") %>
                    <% end %>

                    <% if brand_request.status == "open" %>
                      <%= button_to "In carico", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "take_charge" }, class: "brand-admin-action brand-admin-action--sm" %>
                    <% end %>

                    <% if %w[open in_progress].include?(brand_request.status) %>
                      <%= button_to "In attesa", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "wait" }, class: "brand-admin-action brand-admin-action--sm" %>
                    <% end %>

                    <% unless brand_request.kind == "access" %>
                      <%= button_to "Accetta", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "accept" }, class: "brand-admin-action brand-admin-action--primary brand-admin-action--sm" %>
                    <% end %>

                    <%= button_to "Rifiuta", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "reject" }, class: "brand-admin-action brand-admin-action--danger brand-admin-action--sm", data: { turbo_confirm: "Confermi di voler rifiutare questa richiesta?" } %>
                  <% else %>
                    <%= button_to "Riapri", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "reopen" }, class: "brand-admin-action brand-admin-action--sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% else %>
    <p class="brand-admin-card mt-6 border-dashed p-10 text-center text-sm text-slate-500">
      Non ci sono richieste<%= " con stato #{status_labels.fetch(@active_status)}" if @active_status %> per questo Brand.
    </p>
  <% end %>
</main>
