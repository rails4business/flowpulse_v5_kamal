<%
  contact = brand_request.participant_contact
  metadata = brand_request.metadata.to_h
%>

<article id="brand-request-<%= brand_request.id %>" class="brand-admin-card p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2 text-[11px] font-extrabold uppercase tracking-wide">
        <span class="brand-admin-badge brand-admin-badge--status"><%= status_labels.fetch(brand_request.status, brand_request.status.humanize) %></span>
        <span class="brand-admin-badge brand-admin-badge--request"><%= kind_labels.fetch(brand_request.kind, brand_request.kind.humanize) %></span>
        <span class="brand-admin-badge brand-admin-badge--<%= brand_request.audience %>"><%= audience_labels.fetch(brand_request.audience, brand_request.audience.humanize) %></span>
      </div>
      <h2 class="mt-3 text-xl font-extrabold text-slate-950"><%= brand_request.title %></h2>
      <% if brand_request.message.present? %><p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600"><%= brand_request.message %></p><% end %>
    </div>
    <div class="text-right text-xs text-slate-500">
      <time datetime="<%= brand_request.created_at.iso8601 %>"><%= l(brand_request.created_at, format: :long) %></time>
      <p class="mt-1 font-semibold"><%= brand_request.domain.display_hostname %></p>
      <% if brand_request.resolved_at.present? %><p class="mt-1">Conclusa <%= l(brand_request.resolved_at, format: :short) %></p><% end %>
    </div>
  </div>

  <% if contact || brand_request.requester_profile || metadata["city"].present? %>
    <dl class="mt-5 grid gap-3 border-t border-slate-200 pt-5 text-sm sm:grid-cols-2 lg:grid-cols-4">
      <% if contact %>
        <div><dt class="text-xs font-bold text-slate-500">Persona</dt><dd class="mt-1 font-semibold text-slate-900"><%= contact.name %></dd></div>
        <div><dt class="text-xs font-bold text-slate-500">Recapiti</dt><dd class="mt-1 flex flex-wrap gap-x-3 gap-y-1"><% if contact.email.present? %><%= mail_to contact.email, contact.email, class: "font-semibold text-teal-700" %><% end %><% if contact.phone.present? %><%= link_to contact.phone, "tel:#{contact.phone}", class: "font-semibold text-teal-700" %><% end %></dd></div>
      <% elsif brand_request.requester_profile %>
        <div><dt class="text-xs font-bold text-slate-500">Profilo</dt><dd class="mt-1 font-semibold text-slate-900"><%= brand_request.requester_profile.display_name %></dd></div>
      <% end %>
      <% if metadata["city"].present? %><div><dt class="text-xs font-bold text-slate-500">Località</dt><dd class="mt-1 font-semibold text-slate-900"><%= metadata["city"] %><%= " · #{metadata['country_code']}" if metadata["country_code"].present? %></dd></div><% end %>
      <% if brand_request.assigned_to_profile %><div><dt class="text-xs font-bold text-slate-500">Responsabile</dt><dd class="mt-1 font-semibold text-slate-900"><%= brand_request.assigned_to_profile.display_name %></dd></div><% end %>
    </dl>
  <% end %>

  <footer class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
    <% if brand_request.subject.is_a?(Node) %><span>Nodo: <strong><%= brand_request.subject.title %></strong></span><% end %>
    <span class="font-mono">Richiesta #<%= brand_request.id %></span>
  </footer>

  <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-200 pt-4">
    <% if brand_request.kind == "access" && brand_request.participant_contact&.email.present? && brand_request.active? %><%= button_to(brand_request.brand_invitations.pending.exists? ? "Rigenera invito" : "Approva e genera invito", brand_admin_request_invitation_path(@brand.slug, brand_request), method: :post, class: "brand-admin-action brand-admin-action--primary") %><% end %>
    <% if brand_request.status == "open" %><%= button_to "Prendi in carico", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "take_charge" }, class: "brand-admin-action brand-admin-action--primary" %><% end %>
    <% if %w[open in_progress].include?(brand_request.status) %><%= button_to "Metti in attesa", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "wait" }, class: "brand-admin-action" %><% end %>
    <% if brand_request.active? %>
      <% unless brand_request.kind == "access" %><%= button_to "Accetta", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "accept" }, class: "brand-admin-action" %><% end %>
      <%= button_to "Archivia", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "close" }, class: "brand-admin-action" %>
      <%= button_to "Rifiuta", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "reject" }, class: "brand-admin-action brand-admin-action--danger" %>
    <% else %>
      <%= button_to "Riapri", brand_admin_request_state_path(@brand.slug, brand_request), method: :patch, params: { transition: "reopen" }, class: "brand-admin-action" %>
    <% end %>
  </div>
</article>
