<% content_for :title, "Contenuti · #{@brand.title}" %>

<main class="brand-admin-shell max-w-6xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500" aria-label="Percorso">
    <%= link_to @brand.title, brand_admin_nodes_path(@brand.slug), class: "font-semibold text-teal-700" %><span>/</span><span>Contenuti</span>
  </nav>

  <header class="mb-6 max-w-3xl">
    <p class="text-xs font-black uppercase tracking-[.14em] text-teal-700">Pubblicazione</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950"><%= @brand.title %> · Contenuti</h1>
    <p class="mt-3 leading-7 text-slate-600">Qui si decide se un contenuto è pubblicato, per chi e da quando. Testo e struttura si modificano nei file YAML e Markdown.</p>
  </header>

  <nav class="mb-6 flex flex-wrap gap-2" aria-label="Tipo di contenuto">
    <%= link_to "Tutti", brand_admin_contents_path(@brand.slug), class: "rounded-full border px-3 py-1 text-sm font-bold #{@format ? 'border-slate-200 text-slate-600' : 'border-teal-700 bg-teal-700 text-white'}" %>
    <% Content::FORMATS.each do |format| %>
      <%= link_to format_label(format), brand_admin_contents_path(@brand.slug, tipo: format), class: "rounded-full border px-3 py-1 text-sm font-bold #{@format == format ? 'border-teal-700 bg-teal-700 text-white' : 'border-slate-200 text-slate-600'}" %>
    <% end %>
  </nav>

  <section aria-labelledby="brand-contents-title" class="space-y-3">
    <h2 id="brand-contents-title" class="text-xl font-extrabold text-slate-950">Nel brand <span class="text-sm font-semibold text-slate-500">(<%= @brand_contents.size %>)</span></h2>
    <% if @brand_contents.any? %>
      <%= render "table", contents: @brand_contents %>
    <% else %>
      <p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-600">Nessun contenuto.</p>
    <% end %>
  </section>

  <% if @owned_elsewhere.any? %>
    <section aria-labelledby="owned-contents-title" class="mt-10 space-y-3">
      <h2 id="owned-contents-title" class="text-xl font-extrabold text-slate-950">I contenuti di <%= @owner_profile.display_name %> in altri brand <span class="text-sm font-semibold text-slate-500">(<%= @owned_elsewhere.size %>)</span></h2>
      <%= render "table", contents: @owned_elsewhere %>
    </section>
  <% end %>
</main>
