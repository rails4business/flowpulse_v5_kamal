<% content_for :title, "Contenuti · #{@brand.title}" %>

<main class="brand-admin-shell max-w-6xl">
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-500" aria-label="Percorso">
    <%= link_to @brand.title, brand_admin_nodes_path(@brand.slug), class: "font-semibold text-teal-700" %><span>/</span><span>Contenuti</span>
  </nav>

  <header class="mb-6 max-w-3xl">
    <p class="text-xs font-black uppercase tracking-[.14em] text-teal-700">Pubblicazione</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950"><%= @brand.title %> · Contenuti</h1>
    <p class="mt-3 leading-7 text-slate-600">Qui si decide se un contenuto è pubblicato, per chi e da quando. Testo e struttura si modificano nei file YAML e Markdown.</p>
  </header>

  <%= form_with url: brand_admin_contents_path(@brand.slug), method: :get, class: "mb-6 flex flex-wrap items-end gap-3", aria: { label: "Filtra i contenuti" } do %>
    <label class="text-xs font-bold text-slate-600">Dominio
      <%= select_tag :dominio, options_for_select(@domain_choices, @domain), include_blank: "Tutti", onchange: "this.form.requestSubmit()", class: "mt-1 block rounded-lg border border-slate-300 px-2 py-1.5 text-sm" %>
    </label>
    <label class="text-xs font-bold text-slate-600">Tipo
      <%= select_tag :tipo, options_for_select(@format_choices.map { |format| [ format_label(format), format ] }, @format), include_blank: "Tutti", onchange: "this.form.requestSubmit()", class: "mt-1 block rounded-lg border border-slate-300 px-2 py-1.5 text-sm" %>
    </label>
    <%= submit_tag "Filtra", name: nil, class: "rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-700" %>
  <% end %>

  <section aria-labelledby="brand-contents-title" class="space-y-3">
    <h2 id="brand-contents-title" class="text-xl font-extrabold text-slate-950">Contenuti <span class="text-sm font-semibold text-slate-500">(<%= @contents.size %>)</span></h2>
    <% if @contents.any? %>
      <%= render "table", contents: @contents %>
    <% else %>
      <p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-600">Nessun contenuto.</p>
    <% end %>
  </section>
</main>
