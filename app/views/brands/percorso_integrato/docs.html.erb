<% content_for :title, "Docs — Percorso Integrato" %>
<% content_for :description, "Come funziona il Percorso Integrato." %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="min-h-screen bg-[#f8fbf8] px-5 py-12 text-slate-950 sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[18rem_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Indice Docs Percorso Integrato">
      <%= link_to "← Percorso Integrato", percorso_integrato_path, class: "text-sm font-bold text-emerald-800 hover:text-emerald-950" %>
      <% @docs_sections.each do |section| %>
        <h2 class="mt-7 text-xs font-black uppercase tracking-[.16em] text-emerald-700"><%= section.fetch("title") %></h2>
        <nav class="mt-3 space-y-1">
          <% section.fetch("items", []).each do |item| %>
            <%= link_to item.fetch("title"), percorso_integrato_docs_path(doc: item.fetch("slug")), class: ["block rounded-lg px-3 py-2 text-sm font-semibold", item == @current_doc ? "bg-emerald-100 text-emerald-950" : "text-slate-600 hover:bg-white hover:text-emerald-900"].join(" ") %>
          <% end %>
        </nav>
      <% end %>
    </aside>

    <article class="rounded-3xl border border-emerald-100 bg-white p-7 shadow-sm sm:p-10">
      <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Docs · Percorso Integrato</p>
      <% if @doc_component %>
        <div class="mt-5"><%= render @doc_component %></div>
      <% else %>
        <div class="editorial-rich-text editorial-rich-text--emerald mt-5 max-w-3xl"><%= markdown(@doc_markdown) %></div>
      <% end %>
    </article>
  </div>
</main>
