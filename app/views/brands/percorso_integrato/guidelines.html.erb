<% content_for :title, "Linee guida — Percorso Integrato" %>
<% content_for :description, "Presentazione, modello del percorso, ruoli, documentazione e materiali del Percorso Integrato." %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="pi-upgrade min-h-screen bg-slate-50 text-slate-950">
  <header class="border-b border-emerald-100 bg-white px-5 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <nav class="mb-6 flex items-center gap-2 text-sm text-slate-500" aria-label="Breadcrumb">
        <%= link_to "Percorso Integrato", percorso_integrato_path, class: "font-semibold text-emerald-800 hover:underline" %>
        <span aria-hidden="true">/</span><span aria-current="page">Linee guida</span>
      </nav>
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Percorso Integrato</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">Linee guida</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">Cos’è il percorso, come si costruisce e chi partecipa. Qui trovi anche la documentazione per persone e professionisti.</p>
      <nav class="mt-7 flex flex-wrap gap-2" aria-label="Indice delle linee guida">
        <% [["presentazione", "1 · Cos’è"], ["modello", "2 · Come funziona"], ["ruoli", "3 · Chi partecipa"], ["corso", "4 · Corso"], ["documentazione", "5 · Documentazione e materiali"], ["inizia", "6 · Da dove iniziare"]].each do |anchor, label| %>
          <%= link_to label, "##{anchor}", class: "rounded-lg border border-emerald-200 px-3 py-2 text-sm font-semibold text-emerald-900 hover:bg-emerald-50" %>
        <% end %>
      </nav>
    </div>
  </header>

  <div id="presentazione" class="scroll-mt-24"><%= render "brands/percorso_integrato/guidelines/presentation" %></div>
  <div id="modello" class="scroll-mt-24"><%= render "brands/percorso_integrato/guidelines/model" %></div>

  <section id="corso" class="scroll-mt-24 border-t border-emerald-100 bg-white px-5 py-16 sm:px-6 lg:px-8" aria-labelledby="guidelines-course-title">
    <div class="mx-auto max-w-7xl">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Per approfondire</p>
      <h2 id="guidelines-course-title" class="mt-3 text-3xl font-black tracking-tight">Il corso del Percorso Integrato</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-600">I capitoli del corso, dal questionario iniziale alla costruzione della rete.</p>
      <div class="mt-7 divide-y divide-slate-200 rounded-xl border border-slate-200">
        <% @guidelines_chapters.each_with_index do |chapter, index| %>
          <details id="capitolo-<%= chapter.fetch('slug') %>" class="group scroll-mt-24" <%= "open" if params[:capitolo] == chapter.fetch("slug") %>>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 hover:bg-slate-50">
              <span>
                <small class="block text-xs font-semibold text-emerald-700">Capitolo <%= format("%02d", index + 1) %><%= " · In arrivo" unless chapter.fetch("visibility", "private") == "public" %></small>
                <h3 class="mt-1 font-semibold leading-6"><%= chapter.fetch("title") %></h3>
              </span>
              <span aria-hidden="true" class="text-emerald-700 transition group-open:rotate-45">＋</span>
            </summary>
            <div class="border-t border-slate-100 p-5 sm:p-7">
              <div class="editorial-rich-text editorial-rich-text--emerald"><%= percorso_integrato_guideline_body(markdown(chapter.fetch("body_md")), "corso-#{chapter.fetch('slug')}") %></div>
              <%= link_to "Link a questo capitolo", percorso_integrato_guidelines_path(capitolo: chapter.fetch("slug"), anchor: "capitolo-#{chapter.fetch('slug')}"), class: "mt-5 inline-block text-xs font-semibold text-emerald-800 hover:underline" %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <section id="documentazione" class="scroll-mt-24 border-y border-emerald-100 bg-white px-5 py-16 sm:px-6 lg:px-8" aria-labelledby="guidelines-docs-title">
    <div class="mx-auto max-w-7xl">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Da consultare</p>
      <h2 id="guidelines-docs-title" class="mt-3 text-3xl font-black tracking-tight">Documentazione e materiali</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-600">Apri un argomento per leggere il documento completo.</p>
      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Argomenti della documentazione">
        <% @guidelines_sections.each do |section| %>
          <%= link_to section.fetch("title"), "#documentazione-#{section.fetch('id')}", class: "rounded-full bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-900" %>
        <% end %>
      </nav>
      <div class="mt-10 space-y-10">
        <% @guidelines_sections.each do |section| %>
          <section id="documentazione-<%= section.fetch('id') %>" class="scroll-mt-24">
            <h3 class="mb-4 text-xl font-bold"><%= section.fetch("title") %></h3>
            <div class="divide-y divide-slate-200 rounded-xl border border-slate-200">
              <% section.fetch("items").each do |item| %>
                <details id="doc-<%= item.fetch('slug') %>" class="group scroll-mt-24" <%= "open" if params[:doc] == item.fetch("slug") %>>
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 hover:bg-slate-50">
                    <h4 class="font-semibold leading-6"><%= item.fetch("title") %></h4>
                    <span aria-hidden="true" class="text-emerald-700 transition group-open:rotate-45">＋</span>
                  </summary>
                  <div class="border-t border-slate-100 p-5 sm:p-7">
                    <% if item["component_path"] %>
                      <%= percorso_integrato_guideline_body(render(item.fetch("component_path")), item.fetch("slug")) %>
                    <% else %>
                      <div class="editorial-rich-text editorial-rich-text--emerald"><%= percorso_integrato_guideline_body(markdown(item.fetch("body_md")), item.fetch("slug")) %></div>
                    <% end %>
                    <%= link_to "Link a questo documento", percorso_integrato_document_path(item.fetch("slug")), class: "mt-5 inline-block text-xs font-semibold text-emerald-800 hover:underline" %>
                  </div>
                </details>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    </div>
  </section>

  <%= render "brands/percorso_integrato/guidelines/start" %>
  <%= render "shared/ecosystem/three_projects_connection", current_project: :percorso_integrato %>
</main>
<%= render "posturacorretta/footer" %>
