<% content_for :title, "Spazi e Strutture per Professionisti — Comune di #{@comune['name']} — Percorso Integrato" %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="min-h-screen bg-[#f8fbf8] px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">

    <!-- BREADCRUMB / NAV SUPERIORE -->
    <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-bold text-slate-500" aria-label="Breadcrumb">
      <%= link_to "Percorso Integrato", percorso_integrato_path, class: "hover:text-emerald-700" %>
      <span>/</span>
      <%= link_to "Comuni", percorso_integrato_municipalities_path, class: "hover:text-emerald-700" %>
      <span>/</span>
      <%= link_to @comune["name"], percorso_integrato_municipality_path(@comune["slug"]), class: "hover:text-emerald-700" %>
      <span>/</span>
      <span class="text-emerald-800">Spazi per Professionisti</span>
    </nav>

    <!-- HEADER SEZIONE PROFESSIONISTI -->
    <header class="rounded-3xl border border-emerald-100 bg-white p-6 sm:p-10 shadow-sm mb-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="max-w-3xl">
          <span class="inline-block rounded-full bg-emerald-50 px-3 py-1 text-xs font-black uppercase tracking-wider text-emerald-800">
            Rete Professionale · <%= @comune["name"] %> (<%= @comune["province"] %>)
          </span>
          <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-950 sm:text-5xl">
            Strutture libere e spazi operativi a <%= @comune["name"] %>
          </h1>
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-600">
            Per medici, osteopati, fisioterapisti, chinesiologi, psicologi e operatori del benessere accreditati o interessati a collaborare nella rete di Percorso Integrato.
          </p>
        </div>

        <div>
          <%= link_to "← Pagina Comune per i Cittadini", percorso_integrato_municipality_path(@comune["slug"]), class: "rounded-2xl border border-emerald-200 bg-white px-5 py-3 text-xs sm:text-sm font-bold text-emerald-900 transition hover:bg-emerald-50 shadow-sm flex items-center gap-2" %>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-slate-100 pt-6 text-xs sm:text-sm">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🔑</span>
          <div>
            <p class="font-bold text-slate-900">Chiavi in mano</p>
            <p class="text-slate-500">Studi e palestre già completamente allestiti e a norma.</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-2xl">⏱️</span>
          <div>
            <p class="font-bold text-slate-900">Flessibilità oraria</p>
            <p class="text-slate-500">A ore singole, a mezze giornate o continuativo con sconti di rete.</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-2xl">🤝</span>
          <div>
            <p class="font-bold text-slate-900">Integrazione clinica</p>
            <p class="text-slate-500">Confronto interdisciplinare continuo con i colleghi del presidio.</p>
          </div>
        </div>
      </div>
    </header>

    <!-- ELENCO STRUTTURE E SPAZI LIBERI -->
    <div class="space-y-8">
      <% @comune_spaces.each do |space| %>
        <article class="rounded-3xl border border-emerald-100 bg-white p-6 sm:p-10 shadow-sm transition hover:shadow-md hover:border-emerald-300">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-black uppercase tracking-wider text-emerald-800">
                  <%= space["space_type"] %>
                </span>
                <% if space["surface"].present? %>
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">
                    📐 <%= space["surface"] %>
                  </span>
                <% end %>
              </div>
              <h2 class="mt-3 text-2xl sm:text-3xl font-black text-slate-950"><%= space["name"] %></h2>
              <p class="mt-1 text-sm font-bold text-emerald-800">
                Presso: <%= space["center_name"] %> · <%= space["address"] %>
              </p>
            </div>

            <% whatsapp_msg = "Buongiorno, vorrei informazioni sulla disponibilità dello spazio '#{space['name']}' nel Comune di #{@comune['name']}." %>
            <% if @comune["whatsapp_number"].present? %>
              <a href="https://wa.me/<%= @comune['whatsapp_number'] %>?text=<%= ERB::Util.url_encode(whatsapp_msg) %>" target="_blank" rel="noopener" class="pi-button pi-button--primary rounded-2xl px-5 py-3 text-xs sm:text-sm font-bold shadow-sm flex items-center gap-2">
                <span>💬 Richiedi Disponibilità Spazio</span>
              </a>
            <% end %>
          </div>

          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-slate-100 pt-6">
            <!-- Dotazioni e Attrezzature -->
            <div>
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 mb-3">🛠️ Dotazioni e Attrezzature incluse</h3>
              <ul class="space-y-2">
                <% Array(space["equipment"]).each do |item| %>
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-600">
                    <span class="text-emerald-600 font-bold">✓</span>
                    <span><%= item %></span>
                  </li>
                <% end %>
              </ul>
            </div>

            <!-- Condizioni, Requisiti e Disponibilità -->
            <div class="space-y-4">
              <% if space["availability"].present? %>
                <div>
                  <h4 class="text-xs font-black uppercase tracking-wider text-slate-700">🕒 Disponibilità indicativa</h4>
                  <p class="mt-1 text-xs sm:text-sm text-slate-800 font-semibold"><%= space["availability"] %></p>
                </div>
              <% end %>

              <% if space["requirements"].present? %>
                <div>
                  <h4 class="text-xs font-black uppercase tracking-wider text-slate-700">📋 Requisiti professionali</h4>
                  <p class="mt-1 text-xs sm:text-sm text-slate-600"><%= space["requirements"] %></p>
                </div>
              <% end %>

              <% if space["note"].present? %>
                <div class="rounded-2xl bg-emerald-50/60 p-4 border border-emerald-100">
                  <h4 class="text-xs font-black uppercase tracking-wider text-emerald-900">💡 Formula e Condizioni</h4>
                  <p class="mt-1 text-xs text-emerald-950"><%= space["note"] %></p>
                </div>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <!-- PROFESSIONISTI GIA' ATTIVI NEL COMUNE -->
    <div class="mt-12 rounded-3xl border border-emerald-100 bg-white p-6 sm:p-10 shadow-sm">
      <div class="max-w-2xl">
        <span class="inline-block rounded-full bg-emerald-50 px-3 py-1 text-xs font-black uppercase tracking-wider text-emerald-800">
          Equipe Territoriale
        </span>
        <h2 class="mt-3 text-2xl sm:text-3xl font-black text-slate-950">Professionisti già attivi a <%= @comune["name"] %></h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600">
          I colleghi che operano già sul territorio e con cui potrai coordinare percorsi e invii condivisi.
        </p>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @comune_professionals.each do |prof| %>
          <div class="rounded-2xl border border-emerald-100 bg-slate-50/50 p-5 flex flex-col justify-between">
            <div>
              <p class="font-black text-slate-900 text-base"><%= prof["name"] || prof["slug"].titleize %></p>
              <p class="text-xs font-bold text-emerald-800 mt-1"><%= prof["role_in_comune"] || prof["profession"] %></p>
              <% if prof["availability_note"].present? %>
                <p class="text-xs text-slate-500 mt-2"><%= prof["availability_note"] %></p>
              <% end %>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200/60">
              <%= link_to "Vedi scheda professionale →", percorso_integrato_professional_path(prof["slug"]), class: "text-xs font-bold text-emerald-700 hover:text-emerald-950 underline" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</main>

<%= render "posturacorretta/footer" %>
