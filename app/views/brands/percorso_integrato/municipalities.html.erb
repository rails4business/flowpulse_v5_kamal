<% content_for :title, "Comuni e Territorio — Percorso Integrato" %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="min-h-screen bg-[#f8fbf8] px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-emerald-100 pb-8">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Presidi territoriali</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Comuni del Percorso Integrato</h1>
        <p class="mt-4 max-w-3xl text-lg text-slate-600">Ogni comune ha la sua rete di professionisti accreditati, centri attivi e servizi dedicati alla salute dei residenti.</p>
      </div>
      <div>
        <%= link_to "Tutti i Professionisti", percorso_integrato_professionals_path, class: "rounded-xl border border-emerald-200 bg-white px-5 py-3 text-sm font-bold text-emerald-800 shadow-sm hover:bg-emerald-50" %>
      </div>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <% @comuni.each do |slug, comune| %>
        <article class="flex flex-col justify-between rounded-3xl border border-emerald-100 bg-white p-8 shadow-sm transition hover:border-emerald-300 hover:shadow-lg">
          <div>
            <div class="flex items-center justify-between gap-3">
              <span class="inline-block rounded-full bg-emerald-50 px-3 py-1 text-xs font-black uppercase tracking-wider text-emerald-800">
                Provincia di <%= comune["province"] %> · <%= comune["postal_code"] %>
              </span>
              <span class="text-xs font-bold text-slate-500"><%= Array(comune["professionals"]).size %> professionisti</span>
            </div>

            <h2 class="mt-4 text-3xl font-black text-slate-950">Comune di <%= comune["name"] %></h2>
            <p class="mt-2 text-xs font-bold uppercase tracking-wider text-emerald-700"><%= comune["eyebrow"] %></p>
            <p class="mt-4 text-base leading-7 text-slate-600"><%= comune["description"] %></p>

            <div class="mt-6 grid grid-cols-2 gap-4 rounded-2xl bg-slate-50 p-4 text-xs">
              <div>
                <p class="font-bold uppercase tracking-wider text-slate-500">Centri operativi</p>
                <p class="mt-1 font-semibold text-slate-800"><%= Array(comune["centers"]).size %> strutture</p>
              </div>
              <div>
                <p class="font-bold uppercase tracking-wider text-slate-500">Spazi per Professionisti</p>
                <p class="mt-1 font-semibold text-emerald-700"><%= Array(comune["available_spaces"]).size %> strutture a disposizione</p>
              </div>
            </div>
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-t border-slate-100 pt-6">
            <%= link_to "Apri pagina #{comune["name"]} per i cittadini →", percorso_integrato_municipality_path(slug), class: "pi-button pi-button--primary rounded-xl px-5 py-2.5 text-center font-bold" %>
            <%= link_to "Strutture libere per professionisti", percorso_integrato_municipality_professionals_path(slug), class: "text-xs font-bold text-emerald-800 hover:underline text-center" %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
