<section id="inizia" class="scroll-mt-24 border-y border-emerald-100 bg-white px-5 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
          <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Primo passo</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-5xl">Racconta da dove parti.</h2>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Il primo contatto serve a comprendere la situazione e orientarti verso il campo, la modalità o il professionista più appropriato. Nessun programma viene deciso senza discuterne obiettivi, tempi e condizioni.</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <%= link_to "Scrivi su WhatsApp", "https://wa.me/#{@site.fetch("whatsapp_number")}?text=#{ERB::Util.url_encode(@site.fetch("whatsapp_message"))}", target: "_blank", rel: "noopener noreferrer", class: "pi-button pi-button--primary rounded-xl px-6 py-3.5 font-bold" %>
            <%= link_to "Trova un professionista", percorso_integrato_professionals_path, class: "rounded-xl border border-emerald-200 bg-white px-6 py-3.5 text-center font-bold text-emerald-900 hover:bg-emerald-50" %>
          </div>
      </div>
      <div id="passi-per-iniziare" class="scroll-mt-24">
        <h2 class="text-2xl font-black tracking-tight">Il programma si decide insieme.</h2>
        <p class="mb-6 mt-4 leading-7 text-slate-600">Il primo contatto serve a capire la situazione e scegliere con chi parlarne. Nessun programma viene aperto prima che attività, tempi e condizioni siano stati discussi e accettati.</p>
        <ol class="space-y-4">
          <% @steps.each_with_index do |step, index| %>
            <li class="flex gap-4 rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-emerald-100 text-xs font-black text-emerald-800"><%= index + 1 %></span>
              <div><h3 class="font-black"><%= step.fetch("title") %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= step.fetch("description") %></p></div>
            </li>
          <% end %>
        </ol>
      </div>
    </div>
    <div class="mt-10">
        <aside class="rounded-3xl border border-slate-200 bg-slate-50 p-7">
          <p class="text-xs font-black uppercase tracking-[.14em] text-slate-500">Funzione avanzata</p>
          <h2 class="mt-3 text-2xl font-black">Vuoi approfondire il modello?</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">Esplora ciclo, modalità, programmi, verifiche, mappe orientative e livelli del percorso nelle sezioni precedenti di queste linee guida.</p>
          <%= link_to "Rivedi il modello →", "#modello", class: "mt-5 inline-flex rounded-xl bg-slate-900 px-5 py-3 text-sm font-black text-white hover:bg-slate-700" %>
        </aside>
    </div>
  </div>
</section>
