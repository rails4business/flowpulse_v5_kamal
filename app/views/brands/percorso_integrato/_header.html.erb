<header class="sticky top-0 z-50 border-b border-emerald-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <%= link_to percorso_integrato_path, class: "flex items-center gap-3 font-black tracking-tight text-emerald-950" do %>
      <span aria-hidden="true" class="grid size-9 place-items-center rounded-full bg-emerald-100 text-emerald-800">↗</span>
      <span>Percorso Integrato</span>
    <% end %>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Navigazione Percorso Integrato">
      <a href="#come-funziona" class="text-sm font-semibold text-slate-600 hover:text-emerald-800">Come funziona</a>
      <a href="#ruoli" class="text-sm font-semibold text-slate-600 hover:text-emerald-800">Chi partecipa</a>
      <%= link_to "Professionisti", percorso_integrato_professionals_path, class: "text-sm font-semibold text-slate-600 hover:text-emerald-800" %>
      <%= link_to "Luoghi", percorso_integrato_places_path, class: "text-sm font-semibold text-slate-600 hover:text-emerald-800" %>
      <%= link_to "PosturaCorretta", posturacorretta_path, class: "text-sm font-semibold text-slate-600 hover:text-blue-700" %>
    </nav>
    <a href="#inizia" class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-800">Inizia</a>
  </div>
</header>
