<header class="sticky top-0 z-50 border-b border-emerald-100 bg-white/95 backdrop-blur">
  <div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <%= link_to percorso_integrato_path, class: "flex min-w-0 items-center gap-3 font-black tracking-tight text-emerald-950" do %>
      <%= image_tag "https://ik.imagekit.io/posturacorretta/percorso_integrato_vecchio.png?updatedAt=1789395080250&tr=w-96,h-96,c-at_max,q-80,f-auto", alt: "", class: "size-9 rounded-full object-contain", width: 36, height: 36, decoding: "async" %>
      <span class="truncate">Percorso Integrato</span>
    <% end %>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Navigazione Percorso Integrato">
      <%= link_to "Docs", percorso_integrato_docs_path, class: "text-sm font-semibold text-slate-600 hover:text-emerald-800" %>
      <%= link_to "Chi partecipa", percorso_integrato_path(anchor: "ruoli"), class: "text-sm font-semibold text-slate-600 hover:text-emerald-800" %>
      <%= link_to "Professionisti", percorso_integrato_professionals_path, class: "text-sm font-semibold text-slate-600 hover:text-emerald-800" %>
      <%= link_to "Luoghi", percorso_integrato_places_path, class: "text-sm font-semibold text-slate-600 hover:text-emerald-800" %>
    </nav>
    <%= link_to "Inizia", percorso_integrato_path(anchor: "inizia"), class: "pi-button pi-button--primary hidden rounded-lg px-4 py-2 text-sm font-bold md:inline-flex" %>

    <details class="pi-mobile-menu md:hidden">
      <summary class="pi-mobile-menu__trigger" aria-label="Apri il menu di Percorso Integrato">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span>Menu</span>
      </summary>
      <nav class="pi-mobile-menu__panel" aria-label="Navigazione mobile Percorso Integrato">
        <%= link_to "Home", percorso_integrato_path %>
        <%= link_to "Docs", percorso_integrato_docs_path %>
        <%= link_to "Chi partecipa", percorso_integrato_path(anchor: "ruoli") %>
        <%= link_to "Professionisti", percorso_integrato_professionals_path %>
        <%= link_to "Luoghi", percorso_integrato_places_path %>
        <%= link_to "Inizia", percorso_integrato_path(anchor: "inizia"), class: "pi-button pi-button--primary mt-1 w-full rounded-lg px-4 py-2.5 font-bold" %>
      </nav>
    </details>
  </div>
</header>
