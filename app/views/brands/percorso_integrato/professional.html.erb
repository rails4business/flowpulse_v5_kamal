<% content_for :title, "#{@professional.fetch('name')} — Percorso Integrato" %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="min-h-screen bg-[#f8fbf8] px-4 py-12 sm:px-6 lg:px-8">
  <article class="mx-auto max-w-4xl rounded-3xl border border-emerald-100 bg-white p-7 shadow-sm sm:p-10">
    <%= link_to "← Professionisti", percorso_integrato_professionals_path, class: "text-sm font-bold text-emerald-800" %>
    <p class="mt-8 text-xs font-black uppercase tracking-[.16em] text-emerald-700"><%= @professional.fetch("city", "Sede da definire") %></p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-slate-950"><%= @professional.fetch("name") %></h1>
    <p class="mt-2 text-lg font-semibold text-slate-600"><%= @professional.fetch("profession") %></p>
    <p class="mt-6 text-base leading-8 text-slate-600"><%= @professional.fetch("description", "") %></p>

    <% public_services = @services.select { |service| service.fetch("public", false) } %>
    <section class="mt-10 border-t border-slate-100 pt-8">
      <h2 class="text-2xl font-black text-slate-950">Programmi e servizi</h2>
      <% if public_services.present? %>
        <div class="mt-5 space-y-4"><% public_services.each do |service| %><div class="rounded-xl bg-emerald-50 p-5"><h3 class="font-black"><%= service.fetch("title") %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= service.fetch("description", "") %></p></div><% end %></div>
      <% else %>
        <p class="mt-3 text-sm leading-6 text-slate-500">Le proposte pubbliche verranno aggiunte dopo la conferma del professionista.</p>
      <% end %>
    </section>
  </article>
</main>

<%= render "posturacorretta/footer" %>
