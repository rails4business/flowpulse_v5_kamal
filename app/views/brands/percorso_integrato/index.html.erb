<% content_for :title, "Percorso Integrato — Programmi, professionisti e verifiche" %>
<% content_for :description, @site.fetch("description") %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<div class="pi-upgrade min-h-screen text-slate-950">
  <main>
    <section class="overflow-hidden border-b border-emerald-100 bg-white">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.1fr_.9fr] lg:items-center lg:px-8">
        <div>
          <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700"><%= @site.fetch("eyebrow") %></p>
          <h1 class="mt-5 max-w-4xl text-5xl font-black leading-[.98] tracking-[-.045em] text-slate-950 sm:text-6xl"><%= @site.fetch("title") %></h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600"><%= @site.fetch("description") %></p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#inizia" class="pi-button pi-button--primary rounded-xl px-6 py-3.5 font-bold shadow-lg shadow-emerald-900/10">Capisci da dove iniziare</a>
            <%= link_to "Apri le Docs", percorso_integrato_docs_path, class: "pi-button pi-button--secondary rounded-xl border border-emerald-200 px-6 py-3.5 font-bold hover:border-emerald-400" %>
          </div>
        </div>
        <div class="rounded-[2rem] border border-teal-200 bg-[#173f43] p-8 text-white shadow-xl shadow-emerald-950/10 sm:p-10">
          <p class="text-xs font-black uppercase tracking-[.16em] text-teal-200">La persona al centro</p>
          <p class="mt-5 text-3xl font-black leading-tight">Un percorso può cambiare mentre impari a conoscerti.</p>
          <p class="mt-5 leading-7 text-teal-50">Si osserva la situazione iniziale, si prova ciò che può essere utile e si verifica insieme che cosa sta davvero cambiando.</p>
        </div>
      </div>
    </section>

    <section id="come-funziona" class="scroll-mt-24 border-b border-emerald-100 bg-white px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Un percorso che evolve</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-5xl">Conoscere, provare e capire che cosa funziona.</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">Bisogni e obiettivi cambiano. Per questo il percorso non viene deciso una volta per tutte: cresce attraverso esperienza, verifiche e correzioni.</p>
        </div>

        <% cycle_steps = [
          ["01", "Conoscere", "Situazione, bisogni e obiettivi"],
          ["02", "Esplorare", "Risorse e possibili soluzioni"],
          ["03", "Sperimentare", "Un programma sostenibile"],
          ["04", "Verificare", "Test, osservazioni e feedback"],
          ["05", "Migliorare", "Correggere e proseguire"]
        ] %>
        <div class="pi-cycle" aria-label="Conoscere, esplorare, sperimentare, verificare e migliorare">
          <svg class="pi-cycle__track" viewBox="0 0 720 440" aria-hidden="true">
            <defs><marker id="pi-cycle-arrow" markerWidth="10" markerHeight="10" refX="7" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#34a37a" /></marker></defs>
            <path d="M360 54 C555 54 654 140 654 220 C654 330 516 386 360 386 C204 386 66 330 66 220 C66 140 165 54 330 54" fill="none" stroke="#a7e4ce" stroke-width="4" stroke-dasharray="8 10" marker-end="url(#pi-cycle-arrow)" />
          </svg>
          <div class="pi-cycle__center"><small>Al centro</small><strong>Il percorso<br>della persona</strong></div>
          <ol class="pi-cycle__steps">
            <% cycle_steps.each_with_index do |(number, title, description), index| %>
              <li class="pi-cycle__step pi-cycle__step--<%= index + 1 %>">
                <span><%= number %></span><div><strong><%= title %></strong><small><%= description %></small></div>
              </li>
            <% end %>
          </ol>
        </div>

        <div class="mx-auto mt-10 max-w-4xl rounded-3xl border border-dashed border-emerald-300 bg-emerald-50/60 p-6 sm:p-8">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
            <span class="shrink-0 rounded-full bg-emerald-700 px-3 py-1 text-xs font-black uppercase tracking-[.12em] text-white">In sviluppo</span>
            <p class="leading-7 text-slate-700">Nel tempo test, protocolli e strumenti aiuteranno a osservare e confrontare l’evoluzione dei percorsi, un po’ come PageSpeed Insights rende leggibile l’andamento di un sito. I racconti delle persone resteranno feedback; le evidenze di efficacia richiederanno verifiche adeguate.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="modalita" class="scroll-mt-24 px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-xs font-black uppercase tracking-[.18em] text-orange-700">Un percorso, tre modalità</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-5xl">Non devi sceglierne una sola.</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">Puoi imparare in autonomia, partecipare a un gruppo ed essere seguito da uno o più professionisti nello stesso periodo.</p>
        </div>
        <div class="pi-modes">
          <div class="pi-modes__person"><small>Il tuo</small><strong>percorso</strong></div>
          <div class="pi-modes__grid">
            <article><span aria-hidden="true">⌂</span><h3>In autonomia</h3><p>Contenuti, corsi, esercizi, test e strumenti personali.</p></article>
            <article><span aria-hidden="true">◎</span><h3>In gruppo</h3><p>Corsi, eventi, attività condivise e gruppi di appartenenza.</p></article>
            <article><span aria-hidden="true">＋</span><h3>Con professionisti</h3><p>Valutazioni, consulenze, trattamenti e accompagnamento personale.</p></article>
          </div>
          <p class="pi-modes__note">Le tre modalità si possono intrecciare e cambiare nel tempo.</p>
        </div>
      </div>
    </section>

    <section id="presa-in-carico" class="scroll-mt-24 border-y border-emerald-100 bg-white px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Dalla profilazione al programma</p>
        <h2 class="mt-3 max-w-4xl text-3xl font-black tracking-tight sm:text-5xl">Prima capiamo la situazione. Poi un professionista apre il primo programma.</h2>
        <p class="mt-5 max-w-4xl text-lg leading-8 text-slate-600">La profilazione iniziale è uguale per tutti e serve a raccogliere le informazioni di base. Il primo professionista valuta la situazione e decide, insieme alla persona, se può diventare il responsabile del percorso.</p>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          <article class="rounded-3xl border border-emerald-100 bg-white p-7 shadow-sm"><span class="text-xs font-black text-emerald-700">01</span><h3 class="mt-3 text-xl font-black">La prima valutazione</h3><p class="mt-3 leading-7 text-slate-600">Se il caso rientra nelle sue competenze e il professionista si sente adatto a seguirlo, apre un programma e rimane il primo riferimento.</p></article>
          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm"><span class="text-xs font-black text-orange-700">02</span><h3 class="mt-3 text-xl font-black">Se serve un’altra competenza</h3><p class="mt-3 leading-7 text-slate-600">Può consigliare un altro professionista oppure restare responsabile e aggiungere al percorso le persone necessarie. Ognuno lavora entro le proprie competenze.</p></article>
          <article class="rounded-3xl border border-sky-100 bg-white p-7 shadow-sm"><span class="text-xs font-black text-sky-700">03</span><h3 class="mt-3 text-xl font-black">Uno o più programmi</h3><p class="mt-3 leading-7 text-slate-600">Ogni professionista può proporre il proprio programma: consulenze, trattamenti, lavoro individuale o di gruppo, eventi e attività da svolgere in autonomia.</p></article>
        </div>

        <details class="group mt-12 rounded-[2rem] bg-[#173f43] text-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5 p-7 sm:p-10">
            <span><small class="text-xs font-black uppercase tracking-[.16em] text-teal-200">Una traccia comune</small><strong class="mt-3 block text-2xl font-black sm:text-3xl">Che cosa dovrebbe spiegare ogni programma</strong></span>
            <span class="text-3xl text-teal-200 transition group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <div class="border-t border-white/15 px-7 pb-7 sm:px-10 sm:pb-10">
          <p class="mt-6 max-w-4xl leading-7 text-teal-50">Il programma viene discusso con la persona. Se partecipano più professionisti, questa traccia aiuta a confrontarsi e a capire che cosa sta funzionando.</p>
          <% program_fields = [
            ["Problema", "Che cosa sta succedendo e che cosa vuole cambiare la persona."],
            ["Possibili cause", "Quali sistemi sembrano coinvolti e possono aver contribuito al problema."],
            ["Rimedio proposto", "La soluzione consigliata e perché potrebbe essere utile."],
            ["Principi e metodiche", "Le idee e i metodi sui quali il professionista basa la proposta."],
            ["Ambiti e aree", "Su quali ambiti della persona e su quali delle cinque aree interviene."],
            ["Comportamento", "Che cosa farà il professionista e che cosa viene chiesto alla persona."],
            ["Tempi", "Durata indicativa, frequenza e momento della verifica."],
            ["Feedback", "Risultati, difficoltà e modifiche da condividere con la persona e con gli altri professionisti."]
          ] %>
          <dl class="mt-8 grid gap-3 sm:grid-cols-2"><% program_fields.each do |label, text| %><div class="rounded-2xl border border-white/15 bg-white/10 p-5"><dt class="font-black text-white"><%= label %></dt><dd class="mt-2 text-sm leading-6 text-teal-50"><%= text %></dd></div><% end %></dl>
          </div>
        </details>

        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          <details class="group rounded-3xl border border-blue-100 bg-white shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-black text-slate-950"><span>I sette ambiti della persona</span><span class="text-blue-700 transition group-open:rotate-45">＋</span></summary>
            <div class="border-t border-blue-100"><%= render "posturacorretta/chakras_ambiti" %></div>
          </details>
          <details class="group rounded-3xl border border-blue-100 bg-white shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-black text-slate-950"><span>Le cinque aree di intervento</span><span class="text-blue-700 transition group-open:rotate-45">＋</span></summary>
            <div class="border-t border-blue-100"><%= render "posturacorretta/aree" %></div>
          </details>
        </div>
      </div>
    </section>

    <section id="percorso" class="scroll-mt-24 px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange-700">Il cammino</p>
        <h2 class="mt-3 max-w-3xl text-3xl font-black tracking-tight sm:text-5xl">Si parte da dove sei. Si sale un livello alla volta.</h2>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Quattro livelli, dal recuperare la salute allo stare bene. Non devi attraversarli tutti: il percorso comincia dal bisogno reale della persona.</p>

        <% primary_levels = [
          ["1", "Salute a rischio", "La mia salute è a rischio", "Recuperare", "#c0392b", "⚕"],
          ["2", "Prevenzione, lavoro e sport", "Prevenire i rischi", "Prevenire", "#e8662a", "🏃"],
          ["3", "Performance e obiettivi", "Ottenere un risultato", "Ottenere", "#d49a10", "◎"],
          ["4", "Star bene", "Coltivare e mantenere il benessere", "Mantenere", "#3f9a4f", "☯"]
        ] %>
        <p class="pi-upgrade__start">● Parti da qui</p>
        <div class="pi-upgrade__ladder" aria-label="Livelli principali del Percorso Integrato">
          <% primary_levels.each do |number, title, description, action, color, icon| %>
            <article class="pi-upgrade__level" style="--pi-color: <%= color %>">
              <span class="pi-upgrade__number"><%= number %></span>
              <div class="pi-upgrade__lotus" aria-hidden="true">✺</div>
              <div class="pi-upgrade__level-card"><span class="pi-upgrade__icon" aria-hidden="true"><%= icon %></span><div><h3><%= title %></h3><p><%= description %></p><small><%= action %></small></div></div>
            </article>
          <% end %>
        </div>

        <details class="pi-upgrade__deep">
          <summary><span><strong>Vuoi andare oltre?</strong><small>Per chi vuole approfondire: dal benessere alla connessione</small></span></summary>
          <div class="pi-upgrade__ladder pi-upgrade__ladder--deep">
            <% [["5", "Espressione", "Dare voce a ciò che hai capito", "#2f86d6", "◖"], ["6", "Consapevolezza", "Vedere cosa succede dentro di te", "#5b4fc9", "◉"], ["7", "Connessione", "Sentirsi parte di qualcosa di più grande", "#9b59d0", "∞"]].each do |number, title, description, color, icon| %>
              <article class="pi-upgrade__level" style="--pi-color: <%= color %>">
                <span class="pi-upgrade__number"><%= number %></span><div class="pi-upgrade__lotus" aria-hidden="true">✺</div>
                <div class="pi-upgrade__level-card"><span class="pi-upgrade__icon" aria-hidden="true"><%= icon %></span><div><h3><%= title %></h3><p><%= description %></p></div></div>
              </article>
            <% end %>
          </div>
        </details>
      </div>
    </section>

    <section id="ruoli" class="scroll-mt-24 px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Chi partecipa</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-5xl">Ruoli differenti, responsabilità leggibili.</h2>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          <% @roles.each do |role| %>
            <article class="rounded-2xl border border-slate-200 p-7">
              <h3 class="text-xl font-black"><%= role.fetch("title") %></h3>
              <p class="mt-3 text-sm leading-7 text-slate-600"><%= role.fetch("description") %></p>
            </article>
          <% end %>
        </div>
      </div>
    </section>

    <section id="inizia" class="scroll-mt-24 border-y border-emerald-100 bg-white px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Primo passo</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-5xl">Racconta da dove parti. Il programma si decide insieme.</h2>
          <p class="mt-5 leading-7 text-slate-600">Il primo contatto serve a capire la situazione e scegliere con chi parlarne. Nessun programma viene aperto prima che attività, tempi e condizioni siano stati discussi e accettati.</p>
          <%= link_to "Scrivi su WhatsApp", "https://wa.me/#{@site.fetch("whatsapp_number")}?text=#{ERB::Util.url_encode(@site.fetch("whatsapp_message"))}", target: "_blank", rel: "noopener noreferrer", class: "pi-button pi-button--primary mt-7 rounded-xl px-6 py-3.5 font-bold" %>
        </div>
        <ol class="space-y-4">
          <% @steps.each_with_index do |step, index| %>
            <li class="flex gap-4 rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-emerald-100 text-xs font-black text-emerald-800"><%= index + 1 %></span>
              <div><h3 class="font-black"><%= step.fetch("title") %></h3><p class="mt-2 text-sm leading-6 text-slate-600"><%= step.fetch("description") %></p></div>
            </li>
          <% end %>
        </ol>
      </div>
    </section>

    <%= render "shared/ecosystem/three_projects_connection", current_project: :percorso_integrato %>
  </main>
  <%= render "posturacorretta/footer" %>
</div>
