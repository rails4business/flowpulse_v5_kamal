<% content_for :title, "Professionisti — Percorso Integrato" %>
<% content_for :description, "Professionisti che possono proporre programmi all'interno di un Percorso Integrato." %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="min-h-screen bg-[#f8fbf8] px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <header class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Rete professionale</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Professionisti del Percorso Integrato</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">Ogni professionista mantiene identità, competenze e responsabilità e può aggiungere il proprio programma al percorso della persona.</p>
    </header>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% @professionals.each do |professional| %>
        <article class="rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm">
          <p class="text-xs font-black uppercase tracking-[.14em] text-emerald-700"><%= professional.fetch("city", "Da definire") %></p>
          <h2 class="mt-2 text-xl font-black text-slate-950"><%= professional.fetch("name") %></h2>
          <p class="mt-1 text-sm font-semibold text-slate-600"><%= professional.fetch("profession") %></p>
          <p class="mt-4 text-sm leading-6 text-slate-600"><%= professional.fetch("description", "") %></p>
          <%= link_to "Vedi profilo →", percorso_integrato_professional_path(professional.fetch("slug")), class: "mt-6 inline-flex text-sm font-bold text-emerald-800 hover:text-emerald-950" %>
        </article>
      <% end %>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
