<% content_for :title, "Luoghi — Percorso Integrato" %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="min-h-screen bg-[#f8fbf8] px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Sul territorio</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Luoghi del Percorso Integrato</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Studi e strutture nei quali possono essere proposti programmi coordinati da uno o più professionisti.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% @places.each do |place| %>
        <article class="rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm"><p class="text-xs font-black uppercase tracking-[.14em] text-emerald-700"><%= place.fetch("city") %></p><h2 class="mt-2 text-xl font-black"><%= place.fetch("name") %></h2><p class="mt-3 text-sm text-slate-600"><%= place.fetch("type") %></p></article>
      <% end %>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
