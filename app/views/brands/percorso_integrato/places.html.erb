<% content_for :title, "Centri — Percorso Integrato" %>
<% content_for :landing_nav do %><%= render "brands/percorso_integrato/header" %><% end %>

<main class="min-h-screen bg-[#f8fbf8] px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-emerald-700">Sul territorio</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Centri del Percorso Integrato</h1>
      </div>
      <%= link_to "Vedi per Comune →", percorso_integrato_municipalities_path, class: "rounded-xl border border-emerald-200 bg-white px-4 py-2 text-sm font-bold text-emerald-800 hover:bg-emerald-50" %>
    </div>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Studi, strutture e spazi nei quali vengono proposti programmi coordinati da uno o più professionisti della rete.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% @places.each do |place| %>
        <article class="flex flex-col justify-between rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm transition hover:shadow-md hover:border-emerald-300">
          <div>
            <span class="inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-black uppercase tracking-wider text-emerald-700"><%= place.fetch("city") %></span>
            <h2 class="mt-3 text-xl font-black text-slate-900"><%= place.fetch("name") %></h2>
            <p class="mt-2 text-sm font-semibold text-emerald-900/80"><%= place.fetch("type") %></p>
            <% if place["address"].present? %>
              <p class="mt-3 text-xs text-slate-500">📍 <%= place["address"] %></p>
            <% end %>
          </div>
          <% if place["directions_url"].present? %>
            <div class="mt-5 pt-4 border-t border-slate-100">
              <%= link_to "Mappa & Indicazioni ↗", place["directions_url"], target: "_blank", rel: "noopener", class: "text-xs font-bold text-emerald-700 hover:text-emerald-900 underline" %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
