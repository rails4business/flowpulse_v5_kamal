<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<% content_for :title, "PosturaCorretta — Un nuovo punto di vista sulla salute" %>

<main class="bg-white text-slate-900">
  <% introduction = @home_slides.first || {} %>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto grid max-w-screen-xl items-center gap-10 px-5 py-12 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.9fr)] lg:px-14 lg:py-20 xl:px-20">
      <div class="min-w-0">
        <div class="mb-7 max-w-2xl [&>form]:mt-0"><%= render "components/home_content_search" %></div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700"><%= introduction["kicker"] %></p>
        <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"><%= introduction["title"] %></h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg"><%= introduction["description"] %></p>
        <%= link_to introduction.fetch("cta"), posturacorretta_primo_mese_path, class: "mt-7 inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2" %>
      </div>
      <% if introduction["image"].present? %>
        <img src="<%= introduction["image"] %>" alt="<%= introduction["image_alt"] %>" class="max-h-[28rem] w-full object-contain" loading="eager">
      <% end %>
    </div>
  </section>

  <section class="bg-slate-50" aria-labelledby="home-directions-title">
    <div class="mx-auto max-w-screen-xl px-5 py-14 sm:px-6 lg:px-14 lg:py-20 xl:px-20">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700">Dopo il primo mese</p>
        <h2 id="home-directions-title" class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Scegli come continuare</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">Dopo la valutazione e la prima scheda puoi continuare il percorso educativo — prima nei gruppi posturali e poi, se vuoi approfondire, nell’Accademia — costruire un Percorso Integrato personalizzato oppure partecipare agli eventi.</p>
      </div>

      <div class="mt-10 space-y-6">
        <% @home_slides.drop(1).each_with_index do |slide, index| %>
          <% href = posturacorretta_builder_route(slide.fetch("route")) %>
          <article class="grid overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:grid-cols-[minmax(0,1fr)_19rem] lg:grid-cols-[minmax(0,1fr)_24rem]">
            <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
              <p class="text-xs font-bold uppercase tracking-[0.16em] <%= %w[text-blue-700 text-emerald-700 text-violet-700][index] %>"><%= slide["kicker"] %></p>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl"><%= slide.fetch("title") %></h2>
              <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600"><%= slide.fetch("description") %></p>
              <%= link_to slide.fetch("cta"), href, class: "mt-6 inline-flex w-fit items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-900" %>
            </div>
            <div class="flex min-h-56 items-center justify-center bg-white p-5 sm:p-7">
              <img src="<%= slide.fetch("image") %>" alt="<%= slide.fetch("image_alt") %>" class="max-h-64 w-full object-contain" loading="lazy">
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>
</main>

<%= render "posturacorretta/footer" %>
