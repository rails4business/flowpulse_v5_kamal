<% home_active = request.path == posturacorretta_path && params[:sezione].blank? && params[:capitolo].blank? %>
<nav class="sticky top-0 z-50 border-y border-slate-200 bg-white/95 shadow-sm backdrop-blur" aria-label="Navigazione principale PosturaCorretta">
  <div class="mx-auto flex h-16 max-w-screen-xl items-center gap-3 px-4 text-sm font-semibold sm:gap-5 sm:px-6 lg:px-8">
    <a href="<%= posturacorretta_path %>" class="flex shrink-0 items-center" aria-label="PosturaCorretta home">
      <img src="https://ik.imagekit.io/posturacorretta/logo_pc_scontornato.png?updatedAt=1747975596766" alt="PosturaCorretta" class="relative -top-0.5 hidden h-7 w-auto sm:block">
      <img src="https://ik.imagekit.io/posturacorretta/Sassi-icona-cerchio-bianco.png?updatedAt=1785386494945" alt="" class="size-8 rounded-full bg-blue-600 object-cover sm:hidden">
    </a>

    <div class="flex min-w-0 flex-1 items-center gap-4 overflow-x-auto px-1 sm:gap-5 lg:overflow-visible">
      <%= link_to "Home", posturacorretta_path, class: "shrink-0 border-b-2 pb-1 #{home_active ? 'border-blue-600 text-slate-950' : 'border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950'}" %>
      <%= link_to "Guida", posturacorretta_path(sezione: "primo_mese"), class: "shrink-0 border-b-2 pb-1 border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950" %>
      <%= link_to "Percorso personalizzato", posturacorretta_percorso_path, class: "shrink-0 border-b-2 pb-1 border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950" %>
      <%= link_to "Eventi", posturacorretta_eventi_path, class: "shrink-0 border-b-2 pb-1 border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950" %>
      <details class="group relative shrink-0 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center gap-1 border-b-2 border-transparent pb-1 text-slate-600 hover:border-blue-500 hover:text-slate-950">Esplora <span class="text-[10px] transition group-open:rotate-180">▼</span></summary>
        <div class="absolute left-0 z-[80] mt-3 w-60 overflow-hidden rounded-xl border border-slate-200 bg-white py-1 shadow-xl ring-1 ring-slate-900/5">
        <%= link_to "Contenuti", posturacorretta_contenuti_path, class: "block px-4 py-2.5 hover:bg-blue-50 hover:text-blue-700" %>
        <%= link_to "Professionisti e luoghi", posturacorretta_percorsi_sul_territorio_path, class: "block px-4 py-2.5 hover:bg-blue-50 hover:text-blue-700" %>
        <%= link_to "Accademia", posturacorretta_accademia_path, class: "block px-4 py-2.5 hover:bg-blue-50 hover:text-blue-700" %>
        <%= link_to "Metodiche", posturacorretta_metodiche_path, class: "block px-4 py-2.5 hover:bg-blue-50 hover:text-blue-700" %>
        <% if Current.user&.superadmin_user? %><%= link_to "Visione e progetto · Bozza", posturacorretta_path(sezione: "progetto"), class: "block bg-amber-50 px-4 py-2.5 text-amber-800 hover:bg-amber-100" %><% end %>
        <div class="my-1 border-t border-slate-100"></div>
        <%= link_to "Libri", posturacorretta_libri_path, class: "block px-4 py-2.5 hover:bg-blue-50 hover:text-blue-700" %>
        <%= link_to "Collabora", posturacorretta_collabora_path, class: "block px-4 py-2.5 hover:bg-blue-50 hover:text-blue-700" %>
        </div>
      </details>
    </div>

    <%= render "posturacorretta/account_nav" %>
  </div>
</nav>
