<% content_for :title, "#{@teacher.fetch("name")} · Insegnante PosturaCorretta" %>
<% content_for :description, "Profilo pubblico dell'insegnante PosturaCorretta #{@teacher.fetch("name")}." %>
<% content_for :landing_nav do %><%= render "posturacorretta/header" %><% end %>

<% tabs = [["schedule", "Orario"], ["centres", "Centri"], ["training", "Formazione"], ["bio", "Bio"]] %>
<main class="min-h-screen bg-white px-4 py-8 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-4xl">
    <%= link_to "← Tutti gli insegnanti", posturacorretta_insegnanti_path, class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>

    <section class="mt-5 border-b border-slate-200 pb-7 sm:pb-9">
      <div class="flex items-center gap-4">
        <img src="<%= @teacher.fetch("img") %>" alt="Foto profilo di <%= @teacher.fetch("name") %>" class="size-20 rounded-full border border-blue-100 bg-blue-600 object-cover sm:size-24">
        <div class="min-w-0">
          <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Insegnante PosturaCorretta</p>
          <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"><%= @teacher.fetch("name") %></h1>
          <p class="mt-1 text-sm font-semibold text-slate-600"><%= @teacher.fetch("role") %></p>
        </div>
      </div>
    </section>

    <nav class="flex gap-1 overflow-x-auto border-b border-slate-200" aria-label="Profilo insegnante">
      <% tabs.each do |key, label| %>
        <%= link_to label, posturacorretta_insegnante_path(@teacher.fetch("slug"), tab: key), class: "shrink-0 border-b-2 px-4 py-2.5 text-sm font-bold transition #{@teacher_tab == key ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-600 hover:border-blue-300 hover:text-blue-700'}", aria: { current: ("page" if @teacher_tab == key) } %>
      <% end %>
    </nav>

    <% case @teacher_tab %>
    <% when "schedule" %>
      <section class="mt-6" aria-labelledby="teacher-schedule-title">
        <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Orario</p>
        <h2 id="teacher-schedule-title" class="mt-1 text-2xl font-semibold tracking-tight text-slate-950">Gruppi e appuntamenti</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <% @teacher_group_lessons.each do |lesson| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <p class="text-xs font-black uppercase tracking-[.14em] text-blue-700">Lezione di gruppo</p>
              <p class="mt-2 text-lg font-bold text-slate-950"><%= lesson.fetch("day") %> · <%= lesson.fetch("start") %>–<%= lesson.fetch("end") %></p>
              <p class="mt-1 text-sm text-slate-600"><%= lesson.fetch("location") %></p>
            </article>
          <% end %>
        </div>
        <article class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <p class="text-xs font-black uppercase tracking-[.14em] text-slate-500">Appuntamenti individuali</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">Gli appuntamenti individuali vengono definiti insieme alla persona e pubblicati nel calendario quando confermati.</p>
          <%= link_to "Apri il Week Plan di MarkPostura →", markpostura_weekplan_path, class: "mt-4 inline-flex text-sm font-bold text-blue-700 hover:text-blue-900 hover:underline" %>
        </article>
      </section>
    <% when "centres" %>
      <section class="mt-6" aria-labelledby="teacher-centres-title">
        <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Centri</p>
        <h2 id="teacher-centres-title" class="mt-1 text-2xl font-semibold tracking-tight text-slate-950">Dove insegna</h2>
        <% if @teacher_centers.any? %>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <% @teacher_centers.each do |center| %>
              <%= link_to posturacorretta_centre_path(center.fetch("slug")), class: "block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" do %>
                <article><h3 class="font-bold text-slate-950"><%= center.fetch("name") %></h3><p class="mt-1 text-sm text-slate-600"><%= center.fetch("city") %> · <%= center.fetch("type") %></p><span class="mt-4 inline-flex text-sm font-bold text-blue-700">Apri centro →</span></article>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5 text-sm text-slate-600">Le sedi delle prossime lezioni saranno pubblicate qui.</p>
        <% end %>
      </section>
    <% when "bio" %>
      <section class="mt-6" aria-labelledby="teacher-bio-title">
        <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Professione e bio</p>
        <h2 id="teacher-bio-title" class="mt-1 text-2xl font-semibold tracking-tight text-slate-950"><%= @teacher["profession"].presence || @teacher.fetch("role") %></h2>
        <% if @teacher_bio.present? %>
          <div class="mt-4 max-w-3xl text-base leading-7 text-slate-600 [&_a]:font-bold [&_a]:text-blue-700 [&_a:hover]:text-blue-900 [&_p+p]:mt-4"><%= markdown(@teacher_bio) %></div>
        <% end %>
      </section>
    <% when "training" %>
      <section class="mt-6" aria-labelledby="teacher-training-title">
        <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Formazione insegnante</p>
        <h2 id="teacher-training-title" class="mt-1 text-2xl font-semibold tracking-tight text-slate-950"><%= @teacher_training.fetch("title", "Formazione insegnante PosturaCorretta") %></h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600"><%= @teacher_training.fetch("description", "") %></p>

        <% if @teacher_founder_formation.fetch("entries", []).any? %>
          <section class="mt-7" aria-labelledby="founder-formation-title">
            <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Fondatore</p>
            <h3 id="founder-formation-title" class="mt-1 text-xl font-bold text-slate-950"><%= @teacher_founder_formation.fetch("title") %></h3>
            <% if @teacher_founder_formation["description"].present? %><p class="mt-2 text-sm leading-6 text-slate-600"><%= @teacher_founder_formation.fetch("description") %></p><% end %>
            <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
              <table class="min-w-[760px] w-full text-left text-sm" aria-label="Formazione del fondatore">
                <thead class="bg-slate-50 text-xs font-black uppercase tracking-[.12em] text-slate-500"><tr><th class="px-5 py-3">Anni</th><th class="px-5 py-3">Formazione</th><th class="px-5 py-3">Maestro / formatore</th><th class="px-5 py-3">Metodica</th></tr></thead>
                <tbody class="divide-y divide-slate-100">
                  <% @teacher_founder_formation.fetch("entries").each do |entry| %>
                    <tr class="align-top"><td class="whitespace-nowrap px-5 py-4 font-semibold text-slate-700"><%= entry.fetch("years") %></td><td class="px-5 py-4"><p class="font-bold text-slate-950"><%= entry.fetch("title") %></p><p class="mt-1 leading-5 text-slate-600"><%= entry.fetch("detail") %></p></td><td class="px-5 py-4 leading-5 text-slate-600"><%= entry.fetch("teacher", "—") %></td><td class="px-5 py-4"><% if entry["methodology"] %><%= link_to entry.fetch("methodology").fetch("title"), posturacorretta_metodica_path(entry.fetch("methodology").fetch("slug")), class: "font-semibold text-blue-700 hover:text-blue-900 hover:underline" %><% if entry.fetch("methodology")["founder"].present? %><p class="mt-1 text-xs leading-5 text-slate-500">Fondatore: <%= entry.fetch("methodology").fetch("founder") %></p><% end %><% else %><span class="text-slate-400">—</span><% end %></td></tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </section>
        <% end %>

        <% course_number = 0 %>
        <div class="mt-7 space-y-8">
          <% @teacher_training.fetch("sections", []).each do |section| %>
            <section aria-labelledby="training-section-<%= section.fetch("key") %>">
              <p class="text-xs font-black uppercase tracking-[.14em] text-slate-500">Sezione</p>
              <h3 id="training-section-<%= section.fetch("key") %>" class="mt-1 text-xl font-bold text-slate-950"><%= section.fetch("title") %></h3>
              <% if section["description"].present? %><p class="mt-1 text-sm text-slate-600"><%= section.fetch("description") %></p><% end %>

              <% section.fetch("courses", []).each do |course| %>
                <% course_number += 1 %>
                <article class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                  <header class="flex items-start gap-3 border-b border-slate-200 bg-slate-50 px-5 py-4">
                    <span class="grid size-8 shrink-0 place-items-center rounded-full bg-blue-700 text-xs font-black text-white"><%= course_number %></span>
                    <div><h4 class="font-bold text-slate-950"><%= course.fetch("title") %></h4></div>
                  </header>
                  <div class="overflow-x-auto">
                    <table class="min-w-[620px] w-full text-left text-sm" aria-label="<%= course.fetch("title") %>">
                      <thead class="text-xs font-black uppercase tracking-[.12em] text-slate-500"><tr><th class="px-5 py-3">Lezione</th><th class="px-5 py-3">Data</th><th class="px-5 py-3">Insegnante</th><% if @teacher_training_professional_access %><th class="px-5 py-3">Tirocinio</th><% end %></tr></thead>
                      <tbody class="divide-y divide-slate-100">
                        <% course.fetch("lessons", []).each do |lesson| %>
                          <% chapter = lesson.fetch("theory_chapter") %>
                          <tr><td class="px-5 py-3"><%= link_to "#{lesson.fetch("number")}. #{lesson.fetch("title")}", posturacorretta_course_chapter_path(chapter.fetch("course_key"), chapter.fetch("chapter_key")), class: "font-semibold text-blue-700 hover:text-blue-900 hover:underline" %></td><td class="px-5 py-3 text-slate-600"><%= course["date"] %></td><td class="px-5 py-3 text-slate-600"><%= course.fetch("teacher_name") %></td><% if @teacher_training_professional_access %><td class="px-5 py-3"></td><% end %></tr>
                        <% end %>
                        <% if @teacher_training_professional_access %>
                          <% course.fetch("internship", []).each do |requirement| %>
                            <tr class="bg-blue-50/50" data-teacher-internship><td class="px-5 py-3 font-semibold text-blue-950">Tirocinio · <%= requirement %></td><td class="px-5 py-3 text-slate-600"></td><td class="px-5 py-3 text-slate-600"><%= course.fetch("teacher_name") %></td><td class="px-5 py-3"></td></tr>
                          <% end %>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </article>
              <% end %>
            </section>
          <% end %>
        </div>

        <section class="mt-8 border-t border-slate-200 pt-7" aria-labelledby="teacher-certificates-title">
          <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Attestati e diploma</p>
          <h3 id="teacher-certificates-title" class="mt-1 text-xl font-bold text-slate-950">Riconoscere il percorso svolto</h3>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5"><h4 class="font-bold text-slate-950">Attestato del corso</h4><p class="mt-2 text-sm leading-6 text-slate-600">Disponibile quando sono completate le lezioni richieste e, dove previsto, il tirocinio.</p></article>
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5"><h4 class="font-bold text-slate-950">Diploma insegnante PosturaCorretta</h4><p class="mt-2 text-sm leading-6 text-slate-600">Disponibile al completamento di tutti i corsi obbligatori, delle presenze e dei tirocini previsti.</p></article>
          </div>
        </section>
      </section>
    <% end %>

    <% if Current.user&.superadmin_user? %>
      <aside class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5" aria-label="Sorgente profilo insegnante">
        <p class="text-xs font-black uppercase tracking-[.14em] text-amber-800">Solo superadmin</p>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
          <%= link_to "Dati insegnante · #{@teacher.fetch("slug")}.yml", admin_didactic_source_path(path: "teachers/#{@teacher.fetch("slug")}.yml"), class: "inline-flex text-sm font-bold text-blue-800 hover:underline" %>
          <% if @teacher["bio_source"].present? %>
            <%= link_to "Bio · #{@teacher["bio_source"].split("/").last}", admin_didactic_source_path(path: @teacher.fetch("bio_source")), class: "inline-flex text-sm font-bold text-blue-800 hover:underline" %>
          <% end %>
        </div>
      </aside>
    <% end %>
  </div>
</main>

<%= render "posturacorretta/footer" %>
