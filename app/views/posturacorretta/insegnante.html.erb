<% content_for :title, "#{@teacher.fetch("name")} · Insegnante PosturaCorretta" %>
<% content_for :description, @teacher["bio"].presence || "Profilo pubblico dell'insegnante PosturaCorretta #{@teacher.fetch("name")}." %>
<% content_for :landing_nav do %><%= render "posturacorretta/header" %><% end %>

<main class="min-h-screen bg-slate-50 px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <%= link_to "← Tutti gli insegnanti", posturacorretta_insegnanti_path, class: "text-sm font-bold text-blue-700 hover:text-blue-900" %>

    <section class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="p-6 sm:p-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <img src="<%= @teacher.fetch("img") %>" alt="" class="size-28 rounded-full border border-blue-100 bg-blue-600 object-cover">
          <div class="min-w-0 flex-1">
            <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Insegnante PosturaCorretta</p>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"><%= @teacher.fetch("name") %></h1>
            <p class="mt-2 font-semibold text-slate-700"><%= @teacher.fetch("role") %></p>
            <p class="mt-1 text-sm text-slate-500"><%= @teacher.fetch("city") %> · <%= @teacher.fetch("province") %></p>
            <% if @teacher["bio"].present? %><p class="mt-5 max-w-2xl text-sm leading-6 text-slate-600"><%= @teacher.fetch("bio") %></p><% end %>
          </div>
        </div>
      </div>
    </section>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7">
        <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Corsi e sedi</p>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight text-slate-950">Dove insegna</h2>
        <% if @teacher_centers.any? %>
          <ul class="mt-5 space-y-3">
            <% @teacher_centers.each do |center| %>
              <li class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3"><p class="font-bold text-slate-900"><%= center.fetch("name") %></p><p class="mt-0.5 text-sm text-slate-600"><%= center.fetch("city") %> · <%= center.fetch("type") %></p></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-5 text-sm leading-6 text-slate-600">Le sedi delle prossime lezioni saranno pubblicate qui.</p>
        <% end %>
        <p class="mt-6 text-sm font-semibold text-slate-700">Le date dei corsi aperti compariranno qui quando saranno pubblicate.</p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7">
        <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Formazione PosturaCorretta</p>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight text-slate-950">Scheda insegnante</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= @teacher.fetch("qualification", "teacher").humanize %> · attivo dal <%= @teacher.fetch("date") %>.</p>
        <ul class="mt-5 space-y-2 text-sm text-slate-700">
          <% @teacher_modules.each do |academy_module| %>
            <li class="rounded-lg bg-blue-50 px-3 py-2 font-semibold text-blue-900"><%= academy_module.fetch("title") %></li>
          <% end %>
        </ul>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 lg:col-span-2">
        <p class="text-xs font-black uppercase tracking-[.15em] text-blue-700">Professione e bio</p>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight text-slate-950"><%= @teacher["profession"].presence || @teacher.fetch("role") %></h2>
        <% if @teacher["bio"].present? %><p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600"><%= @teacher.fetch("bio") %></p><% end %>
      </section>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
