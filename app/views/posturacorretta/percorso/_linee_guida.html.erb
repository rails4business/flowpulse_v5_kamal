<%
  guide_pages = {
    "cura" => "stop-al-dolore",
    "prevenzione" => "prevenzione",
    "performance" => "performance",
    "benessere" => "benessere-integrato",
    "attivita" => "attivita-corporee",
    "fisiologia" => "postura-fisiologia",
    "ambiente" => "corpo-ambiente",
    "potenziale" => "potenziale-umano"
  }
%>

<section id="quale-percorso" class="scroll-mt-24">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">Percorso PosturaCorretta</p>
  <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">Quale percorso scegliere?</h1>
  <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
    Le linee guida collegano bisogni, obiettivi e possibili attività. Ogni documento aiuta a mettere ordine nelle informazioni e a comprendere quale passo approfondire.
  </p>
  <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-500">
    Sono strumenti di orientamento: non sostituiscono valutazioni, diagnosi, trattamenti o il parere di un professionista sanitario.
  </p>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <% guide_pages.each do |key, slug| %>
      <% guide = @paths.fetch(key) %>
      <a href="<%= posturacorretta_percorso_path(page: slug) %>" class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-blue-700"><%= guide["kicker"] %></p>
        <h2 class="mt-2 text-xl font-black text-slate-950 transition group-hover:text-blue-700"><%= guide["title"] %></h2>
        <p class="mt-2 text-sm leading-6 text-slate-600"><%= guide["description"] %></p>
        <span class="mt-4 inline-flex items-center text-sm font-semibold text-blue-700">Apri la linea guida <span aria-hidden="true" class="ml-2">&rarr;</span></span>
      </a>
    <% end %>
  </div>
</section>
