<% home_active = request.path == posturacorretta_path || request.path.start_with?("/posturacorretta/corsi/") %>
<% lessons_active = request.path == posturacorretta_student_dashboard_path %>
<% contents_active = request.path.start_with?(posturacorretta_contenuti_path) || request.path.start_with?(posturacorretta_eventi_path) %>
<nav class="pc-mobile-app-nav sm:hidden" aria-label="Navigazione app PosturaCorretta">
  <%= link_to posturacorretta_path, aria: { current: ("page" if home_active) }, class: (home_active ? "is-active" : nil) do %><span aria-hidden="true">⌂</span><small>Home</small><% end %>
  <%= link_to posturacorretta_student_dashboard_path, aria: { current: ("page" if lessons_active) }, class: (lessons_active ? "is-active" : nil) do %><span aria-hidden="true">▤</span><small>Lezioni</small><% end %>
  <%= link_to posturacorretta_contenuti_path, aria: { current: ("page" if contents_active) }, class: (contents_active ? "is-active" : nil) do %><span aria-hidden="true">◫</span><small>Contenuti</small><% end %>
  <%= link_to posturacorretta_guida_path(sezione: "accademia", capitolo: "educazione") do %><span aria-hidden="true">•••</span><small>Esplora</small><% end %>
</nav>
