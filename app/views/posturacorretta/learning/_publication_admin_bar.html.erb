<% if posturacorretta_chapter_editor?(chapter) && chapter["id"].present? %>
  <%# Stato del Content, modificato direttamente; gli impegni di pubblicazione passati restano come storico. %>
  <% history = Array(chapter["publication_history"]) %>
  <% dialog_id = "publication-#{chapter.fetch('slug').parameterize}" %>
  <% status = chapter["status"].presence || "draft" %>
  <% published = status == "published" %>
  <% shown_at = chapter["revised_at"] || chapter["published_at"] %>
  <% publication_path = posturacorretta_content_publication_path(chapter.fetch("id")) %>
  <aside class="<%= local_assigns[:inline] ? 'contents' : 'mt-3 flex flex-wrap items-center gap-2' %> text-xs" aria-label="Stato editoriale del contenuto">
    <% pill_classes = published ? "bg-emerald-100 text-emerald-800 ring-emerald-200" : status == "archived" ? "bg-slate-200 text-slate-700 ring-slate-300" : "bg-amber-100 text-amber-800 ring-amber-200" %>
    <% status_label = published ? "Pubblicato" : status == "archived" ? "Archiviato" : "Bozza" %>
    <button type="button" onclick="document.getElementById('<%= dialog_id %>')?.showModal()" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-black ring-1 <%= pill_classes %>" title="Apri informazioni editoriali"><span aria-hidden="true"><%= published ? '✓' : status == 'archived' ? '■' : '●' %></span><%= status_label %><%= " · #{l(shown_at, format: :short)}" if shown_at %></button>
    <% if published %>
      <%= button_to "Aggiorna", publication_path, method: :patch, params: { change: "update" },
            class: "pc-action-button pc-action-button--update pc-action-button--compact",
            form: { data: { turbo_confirm: "Segnare questo contenuto come aggiornato?" } } %>
      <%= button_to "Sospendi", publication_path, method: :patch, params: { change: "suspend" },
            class: "pc-action-button pc-action-button--warning pc-action-button--compact",
            form: { data: { turbo_confirm: "Sospendere la visibilità di questo contenuto?" } } %>
    <% else %>
      <%= button_to "Pubblica", publication_path, method: :patch, params: { change: "publish" },
            class: "pc-action-button pc-action-button--success pc-action-button--compact",
            form: { data: { turbo_confirm: "Pubblicare questo contenuto?" } } %>
    <% end %>
  </aside>
  <dialog id="<%= dialog_id %>" class="w-[min(42rem,calc(100%-2rem))] rounded-2xl border border-slate-300 p-0 shadow-2xl backdrop:bg-slate-950/40"><div class="space-y-5 p-6">
    <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-wide text-violet-700">Pubblicazione</p><h2 class="mt-1 text-xl font-extrabold"><%= chapter.fetch("title") %></h2></div><button type="button" onclick="this.closest('dialog').close()" class="rounded-lg px-2 py-1 text-slate-500">×</button></div>
    <dl class="grid gap-3 text-sm sm:grid-cols-2">
      <div><dt class="font-bold text-slate-500">Stato</dt><dd><%= status_label %></dd></div>
      <div><dt class="font-bold text-slate-500">Visibilità</dt><dd><%= { "public" => "Pubblico", "member" => "Membri", "private" => "Privato" }.fetch(chapter["visibility"].to_s, "—") %></dd></div>
      <div><dt class="font-bold text-slate-500">Accesso</dt><dd><%= chapter["access"] == "paid" ? "A pagamento" : "Libero" %></dd></div>
      <div><dt class="font-bold text-slate-500">Pubblicato il</dt><dd><%= chapter["published_at"] ? l(chapter["published_at"], format: :long) : "—" %></dd></div>
      <div><dt class="font-bold text-slate-500">Aggiornato il</dt><dd><%= chapter["revised_at"] ? l(chapter["revised_at"], format: :long) : "—" %></dd></div>
    </dl>
    <% if history.any? %>
      <details class="rounded-xl border border-slate-200 p-4"><summary class="cursor-pointer font-black text-violet-700">Storico degli impegni di pubblicazione (<%= history.size %>)</summary><ol class="mt-4 space-y-3"><% history.each do |item| %><li class="rounded-lg bg-slate-50 p-3 text-sm"><div class="flex flex-wrap gap-2"><strong><%= item.publication_status.humanize %></strong><span>· <%= item.publication_change_kind.presence&.humanize || "Intervento" %></span><time class="text-slate-500"><%= l(publication_decision_time(item), format: :short) %></time></div><% if item.publication_note_md.present? %><p class="mt-2 whitespace-pre-wrap text-slate-600"><%= item.publication_note_md %></p><% end %></li><% end %></ol></details>
    <% end %>
  </div></dialog>
<% end %>
