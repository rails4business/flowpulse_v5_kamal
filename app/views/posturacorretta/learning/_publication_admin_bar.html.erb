<% if posturacorretta_editorial_preview? %>
  <% commitment = chapter["publication_commitment"] %>
  <% history = Array(chapter["publication_history"]) %>
  <% dialog_id = "publication-#{chapter.fetch('slug').parameterize}" %>
  <% commitment_path = impegno_agenda_path(workspace: "1", default_brand: "posturacorretta", new_content: "1", content_key: chapter["id"].presence || chapter.fetch("slug"), content_title: chapter.fetch("title"), publication_change_kind: (commitment ? "update" : "publish"), subject_node_id: chapter["publication_node_id"], return_to: request.fullpath) %>
  <aside class="<%= local_assigns[:inline] ? 'contents' : 'mt-3 flex flex-wrap items-center gap-2' %> text-xs" aria-label="Stato editoriale del capitolo">
    <% if commitment %>
      <% end_time = commitment.actual_ended_at || commitment.ends_at || publication_decision_time(commitment) %>
      <% pill_classes = commitment.publication_status == "published" ? "bg-emerald-100 text-emerald-800 ring-emerald-200" : commitment.publication_status == "archived" ? "bg-slate-200 text-slate-700 ring-slate-300" : "bg-amber-100 text-amber-800 ring-amber-200" %>
      <button type="button" onclick="document.getElementById('<%= dialog_id %>')?.showModal()" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-black ring-1 <%= pill_classes %>" title="Apri informazioni editoriali"><span aria-hidden="true"><%= commitment.publication_status == 'published' ? '✓' : commitment.publication_status == 'archived' ? '■' : '●' %></span><%= l(end_time, format: :short) %></button>
    <% else %>
      <%= link_to "＋ DataCommitment", commitment_path, class: "inline-flex rounded-full bg-violet-50 px-3 py-1 font-black text-violet-700 ring-1 ring-violet-200 hover:bg-violet-100" %>
    <% end %>
  </aside>
  <% if commitment %>
    <dialog id="<%= dialog_id %>" class="w-[min(42rem,calc(100%-2rem))] rounded-2xl border border-slate-300 p-0 shadow-2xl backdrop:bg-slate-950/40"><div class="space-y-5 p-6">
      <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-black uppercase tracking-wide text-violet-700">Ultima decisione editoriale</p><h2 class="mt-1 text-xl font-extrabold"><%= chapter.fetch("title") %></h2></div><button type="button" onclick="this.closest('dialog').close()" class="rounded-lg px-2 py-1 text-slate-500">×</button></div>
      <dl class="grid gap-3 text-sm sm:grid-cols-2"><div><dt class="font-bold text-slate-500">Stato</dt><dd><%= commitment.publication_status.humanize %></dd></div><div><dt class="font-bold text-slate-500">Intervento</dt><dd><%= commitment.publication_change_kind.presence&.humanize || "—" %></dd></div><div><dt class="font-bold text-slate-500">Visibilità</dt><dd><%= commitment.publication_visibility.humanize %></dd></div><div><dt class="font-bold text-slate-500">Accesso</dt><dd><%= commitment.access_modes.map(&:humanize).join(" + ") %></dd></div><div><dt class="font-bold text-slate-500">Nodo</dt><dd><%= commitment.subject_type == "Node" ? commitment.subject.title : "—" %></dd></div><div><dt class="font-bold text-slate-500">Data</dt><dd><%= l(publication_decision_time(commitment), format: :long) %></dd></div></dl>
      <% if commitment.publication_note_md.present? %><div class="rounded-xl border border-slate-200 bg-slate-50 p-4"><p class="text-xs font-black uppercase tracking-wide text-slate-500">Note</p><div class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700"><%= commitment.publication_note_md %></div></div><% end %>
      <div><%= link_to "＋ Nuovo aggiornamento", commitment_path, class: "inline-flex rounded-full bg-violet-700 px-4 py-2 text-sm font-black text-white hover:bg-violet-800" %></div>
      <details class="rounded-xl border border-slate-200 p-4"><summary class="cursor-pointer font-black text-violet-700">Vedi storico (<%= history.size %>)</summary><ol class="mt-4 space-y-3"><% history.each do |item| %><li class="rounded-lg bg-slate-50 p-3 text-sm"><div class="flex flex-wrap gap-2"><strong><%= item.publication_status.humanize %></strong><span>· <%= item.publication_change_kind.presence&.humanize || "Intervento" %></span><time class="text-slate-500"><%= l(publication_decision_time(item), format: :short) %></time></div><% if item.publication_note_md.present? %><p class="mt-2 whitespace-pre-wrap text-slate-600"><%= item.publication_note_md %></p><% end %></li><% end %></ol></details>
    </div></dialog>
  <% end %>
<% end %>
