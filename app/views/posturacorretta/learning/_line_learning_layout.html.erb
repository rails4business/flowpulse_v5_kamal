<% active_node = local_assigns.fetch(:active_node) %>
<% line = local_assigns.fetch(:line) %>
<% courses = local_assigns.fetch(:courses) %>
<% main_content = local_assigns.fetch(:main_content) %>

<main class="min-h-screen bg-slate-50" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
  <div class="border-b border-slate-200 bg-white p-4 lg:hidden">
    <button type="button" class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="line-learning-aside" aria-expanded="false">
      <span>Programma del percorso</span><span aria-hidden="true">☰</span>
    </button>
  </div>
  <div class="fixed inset-0 z-[100] hidden bg-slate-950/30 opacity-0 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>

  <div class="mx-auto max-w-screen-xl px-4 py-5 sm:px-6 lg:grid lg:grid-cols-[22rem_minmax(0,1fr)] lg:gap-6 lg:px-8 lg:py-6">
    <aside id="line-learning-aside" class="fixed inset-y-0 left-0 z-[110] w-80 max-w-[88vw] -translate-x-full overflow-y-auto border-r border-slate-200 bg-white p-4 shadow-2xl transition-transform lg:sticky lg:top-24 lg:z-auto lg:h-auto lg:max-h-[calc(100vh-7rem)] lg:w-auto lg:max-w-none lg:translate-x-0 lg:overscroll-contain lg:rounded-2xl lg:border lg:border-slate-200 lg:shadow-sm" data-mobile-aside-target="panel" aria-hidden="true">
      <div class="mb-5 flex items-center justify-between lg:hidden">
        <p class="text-sm font-bold text-slate-900">Programma del percorso</p>
        <button type="button" class="rounded-lg p-2 text-slate-500" data-mobile-aside-target="close" data-action="mobile-aside#close" aria-label="Chiudi indice">✕</button>
      </div>
      <div data-action="click->mobile-aside#closeFromNavigation">
        <%= render "posturacorretta/learning/line_course_aside", active_node: active_node, line: line, courses: courses %>
      </div>
    </aside>

    <div class="min-w-0 space-y-6"><%= main_content %></div>
  </div>
</main>
