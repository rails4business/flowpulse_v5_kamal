<% context_course = @lesson ? @selected_course : (@selected_program_step ? @learning_course : nil) %>
<% context_mode = @lesson ? "capitoli" : (@selected_program_step ? "programma" : nil) %>
<% content_for :landing_nav do %>
  <% if @dashboard_kind == "student" %>
    <%= render "posturacorretta/learning/student_dashboard_header" %>
  <% elsif @course_overview %>
    <%= render "posturacorretta/learning/student_dashboard_header", active_item: :percorso %>
  <% elsif context_course && context_mode %>
    <%= render "posturacorretta/learning/course_reader_header", course: context_course, active: context_mode %>
  <% else %>
    <%= render "posturacorretta/learning/header" %>
  <% end %>
<% end %>
<% content_for :title, @lesson ? "#{@lesson.fetch("title")} · PosturaCorretta" : (@dashboard_kind ? "#{@dashboard_kind == 'teacher' ? 'Insegnante' : 'Lezioni'} · PosturaCorretta" : (@integrated_paths_page ? "Percorsi integrati · PosturaCorretta" : (@direct_courses ? "Percorso PosturaCorretta · Educazione alla salute" : "Percorso PosturaCorretta · Educazione alla salute"))) %>
<% content_for :description, "Il percorso educativo alla salute grazie alle metodiche posturali. Scopri come funziona il tuo corpo e riattiva i tuoi sistemi." %>

<div class="min-h-screen bg-[#F6F7F4] text-slate-800">
  <% if @dashboard_kind == "student" %>
    <%= render "posturacorretta/learning/student_dashboard" %>
  <% elsif @dashboard_kind == "teacher" %>
    <%= render "posturacorretta/learning/teacher_dashboard" %>
  <% elsif @lesson %>
    <%= render "posturacorretta/learning/lesson" %>
  <% elsif @course_overview %>
    <%= render "posturacorretta/learning/course_overview" %>
  <% elsif @selected_course %>
    <%= render "posturacorretta/learning/course_index" %>
  <% elsif @integrated_paths_page %>
    <%= render "posturacorretta/learning/integrated_paths" %>
  <% elsif @direct_courses %>
    <%= render "posturacorretta/learning/percorso" %>
  <% else %>
    <%= render "posturacorretta/learning/home" %>
  <% end %>
</div>
