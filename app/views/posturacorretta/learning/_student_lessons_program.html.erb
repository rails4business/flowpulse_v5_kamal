<section class="mx-auto max-w-4xl" aria-labelledby="programma-lezioni-title">
  <%= render "posturacorretta/lessons_page_intro",
             active: :program,
             title: @student_lessons_program_title,
             description: "Un percorso pratico per conoscere il corpo, muoverti con più consapevolezza e costruire abitudini che restano. Puoi iniziare in gruppo o individualmente." %>

  <ol class="mt-6 space-y-3" aria-label="Lezioni del programma studenti">
    <% previous_stage_key = nil %>
    <% @student_lessons_program.each do |lesson| %>
      <% stage_key = lesson.dig("stage", "key") %>
      <% stage_changed = stage_key.present? && stage_key != previous_stage_key %>
      <% if stage_changed %>
        <li class="py-3 first:pt-0" aria-label="Sezione <%= lesson.dig("stage", "title") %>">
          <div class="flex items-center gap-3">
            <span class="h-px flex-1 bg-blue-200"></span>
            <div class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-center">
              <p class="text-sm font-bold text-slate-950"><%= lesson.dig("stage", "title") %></p>
            </div>
            <span class="h-px flex-1 bg-blue-200"></span>
          </div>
          <% if lesson.dig("stage", "description").present? %><p class="mx-auto mt-2 max-w-xl text-center text-sm text-slate-500"><%= lesson.dig("stage", "description") %></p><% end %>
        </li>
      <% end %>
      <li class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
        <div class="flex gap-4">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-blue-700 text-sm font-black text-white"><%= lesson.fetch("number") %></span>
          <div class="min-w-0 flex-1">
            <p class="text-[11px] font-bold uppercase tracking-[.13em] text-slate-500"><%= lesson.dig("course", "title") || "Programma" %></p>
            <h2 class="mt-0.5 text-lg font-bold text-slate-950"><%= lesson.fetch("title") %></h2>
            <% if lesson.fetch("release_locked", false) %><p class="mt-1 text-xs font-bold text-slate-500">🔒 Disponibile dal <%= l(Time.zone.parse(lesson.fetch("release_at")).to_date, format: :long) %></p><% end %>

            <% if lesson.fetch("items", []).any? %>
              <ul class="mt-3 space-y-1.5 text-sm leading-6 text-slate-700">
                <% lesson.fetch("items").each do |item| %>
                  <li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-blue-500"></span><span><%= item %></span></li>
                <% end %>
              </ul>
            <% end %>

            <% if lesson.fetch("chapter_links", []).any? %>
              <div class="mt-3 flex flex-wrap gap-2">
                <% lesson.fetch("chapter_links").each do |chapter| %>
                  <% practical = chapter.fetch("chapter_type", "theory") == "practical" %>
                  <% if lesson.fetch("release_locked", false) %>
                    <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-400"><span aria-hidden="true">🔒</span><%= chapter.fetch("title") %></span>
                  <% else %>
                    <%= link_to chapter.fetch("path"), class: "inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-bold transition #{practical ? 'border-red-200 bg-red-50 text-red-800 hover:bg-red-100' : 'border-blue-200 bg-blue-50 text-blue-800 hover:bg-blue-100'}" do %>
                      <span aria-hidden="true"><%= practical ? "◆" : "▤" %></span>
                      <span><%= chapter.fetch("title") %></span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% end %>

            <% if lesson.fetch("practical_chapters", []).any? %>
              <div class="mt-3 flex flex-wrap gap-2" aria-label="Schede pratiche">
                <% lesson.fetch("practical_chapters").each do |sheet| %>
                  <span class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-bold text-red-800"><span aria-hidden="true">◆</span><%= sheet.fetch("title", sheet.fetch("area").humanize) %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </li>
      <% previous_stage_key = stage_key %>
    <% end %>
  </ol>

  <% if @student_internship_stages.present? %>
    <aside class="mt-8 rounded-2xl border border-violet-200 bg-violet-50 p-5" aria-label="Tirocinio insegnanti">
      <p class="text-xs font-black uppercase tracking-[.14em] text-violet-800">Riservato tirocinanti</p>
      <h2 class="mt-1 text-xl font-bold text-slate-950">Tirocinio e abilitazioni progressive</h2>
      <div class="mt-4 space-y-4">
        <% @student_internship_stages.each do |stage| %>
          <section class="rounded-xl border border-violet-100 bg-white p-4">
            <h3 class="font-bold text-slate-950"><%= stage.fetch("title") %></h3>
            <% if stage["qualification"].present? %><p class="mt-1 text-sm font-semibold text-violet-800"><%= stage.fetch("qualification") %></p><% end %>
            <% if stage.dig("internship", "requirements").present? %><ul class="mt-2 space-y-1 text-sm leading-6 text-slate-700"><% stage.dig("internship", "requirements").each do |requirement| %><li>• <%= requirement %></li><% end %></ul><% else %><p class="mt-1 text-sm text-slate-600">Requisiti di tirocinio da definire con il responsabile del percorso.</p><% end %>
          </section>
        <% end %>
      </div>
    </aside>
  <% end %>

  <% if Current.user&.superadmin_user? %>
    <aside class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5" aria-label="Sorgenti YAML del programma">
      <p class="text-xs font-black uppercase tracking-[.14em] text-amber-800">Solo superadmin</p>
      <h2 class="mt-1 text-base font-bold text-slate-950">File che costruiscono percorso e lezioni</h2>
      <div class="mt-3 flex flex-col gap-2 text-sm">
        <%= link_to "Percorso · percorso.yml", admin_didactic_source_path(path: "contenuti/percorso.yml"), class: "font-bold text-blue-800 hover:underline" %>
        <%= link_to "Corsi e capitoli · contents.yml", admin_didactic_source_path(path: "contenuti/contents.yml"), class: "font-bold text-blue-800 hover:underline" %>
        <%= link_to "Programma lezioni · programma_lezioni_posturacorretta.yml", admin_didactic_source_path(path: "programmi/programma_lezioni_posturacorretta.yml"), class: "font-bold text-blue-800 hover:underline" %>
        <%= link_to "Calendario di gruppo · calendario_lezioni_gruppo.yml", admin_didactic_source_path(path: "programmi/calendario_lezioni_gruppo.yml"), class: "font-bold text-blue-800 hover:underline" %>
      </div>
    </aside>
  <% end %>
</section>
