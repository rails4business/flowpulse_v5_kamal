<section class="pc-lessons-program mx-auto w-full min-w-0 max-w-4xl" aria-labelledby="programma-lezioni-title">
  <%= render "posturacorretta/lessons_page_intro",
             active: :program,
             title: @student_lessons_program_title,
             description: "Ogni corso raccoglie le lezioni da svolgere con un insegnante. Ogni lezione contiene le sue schede pratiche, collegate al percorso online." %>

  <nav class="pc-lesson-stepper" aria-label="Corsi del programma lezioni">
    <div class="pc-lesson-stepper-track">
      <span class="pc-lesson-stepper-line" aria-hidden="true"></span>
      <% course_number = 0 %>

      <% if @student_lesson_root_courses.any? %>
        <div class="pc-course-standalone" aria-label="Corso introduttivo">
          <div class="pc-course-steps">
            <% @student_lesson_root_courses.each do |course| %>
              <% course_number += 1 %>
              <%= render "posturacorretta/learning/lesson_course_step", course: course, course_number: course_number %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% @student_lesson_sections.each do |section| %>
        <section class="pc-course-section" data-color="<%= section.fetch("color", "blue") %>" aria-labelledby="lesson-section-<%= section.fetch("key") %>">
          <p id="lesson-section-<%= section.fetch("key") %>" class="pc-course-section-title"><%= section.fetch("title") %></p>
          <div class="pc-course-steps">
            <% if section.fetch("courses").any? %>
              <% section.fetch("courses").each do |course| %>
                <% course_number += 1 %>
                <%= render "posturacorretta/learning/lesson_course_step", course: course, course_number: course_number %>
              <% end %>
            <% else %>
              <div class="pc-course-empty"><span aria-hidden="true">＋</span><span>In preparazione</span></div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </nav>

  <% if @selected_student_course.present? %>
    <% locked = @selected_student_course.fetch("release_locked") %>
    <section class="pc-selected-course" aria-labelledby="selected-course-title">
      <header class="pc-selected-course-header">
        <div>
          <p class="text-xs font-black uppercase tracking-[.13em] text-blue-700"><%= @selected_student_section&.fetch("title") || "Corso introduttivo" %></p>
          <h2 id="selected-course-title" class="mt-1 text-2xl font-bold tracking-tight text-slate-950"><%= @selected_student_course.fetch("title") %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= pluralize(@selected_student_course.fetch("lessons").size, "lezione", "lezioni") %> · ogni lezione contiene una o più schede</p>
        </div>
        <% if locked && @selected_student_course["release_at"].present? %>
          <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">Disponibile dal <%= Time.zone.parse(@selected_student_course.fetch("release_at")).strftime("%d/%m/%Y") %></span>
        <% else %>
          <span class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-800">Disponibile</span>
        <% end %>
      </header>

      <ol class="pc-lesson-list" aria-label="Lezioni di <%= @selected_student_course.fetch("title") %>">
        <% @selected_student_course.fetch("lessons").each do |lesson| %>
          <li>
            <details class="pc-lesson-card" <%= "open" if @selected_student_course.fetch("lessons").one? %>>
              <summary class="pc-lesson-summary">
                <span class="pc-lesson-number"><%= lesson.fetch("number") %></span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-bold text-slate-950"><%= lesson.fetch("title") %></span>
                  <span class="mt-0.5 block text-xs text-slate-500"><%= pluralize(lesson.fetch("sheets").size, "scheda", "schede") %></span>
                </span>
                <span class="pc-lesson-chevron" aria-hidden="true">›</span>
              </summary>

              <div class="pc-lesson-sheets">
                <p class="text-[10px] font-black uppercase tracking-[.13em] text-red-700">Schede della lezione</p>
                <ul class="mt-2 space-y-1.5">
                  <% lesson.fetch("sheets").each do |sheet| %>
                    <li>
                      <% if locked %>
                        <span class="flex items-center gap-2 rounded-lg bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-400"><span aria-hidden="true">◆</span><%= sheet.fetch("title") %></span>
                      <% else %>
                        <%= link_to sheet.fetch("path"), class: "flex items-center gap-2 rounded-lg border border-red-100 bg-red-50 px-3 py-2 text-sm font-semibold text-red-900 transition hover:bg-red-100" do %>
                          <span aria-hidden="true">◆</span><span><%= sheet.fetch("title") %></span>
                        <% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </details>
          </li>
        <% end %>
      </ol>

      <% teacher_path = @selected_student_course["teacher_path"] %>
      <% if @student_teacher_path_active && teacher_path.present? %>
        <section class="pc-teacher-path" aria-label="Percorso insegnante del corso selezionato">
          <p class="text-xs font-black uppercase tracking-[.14em] text-violet-800">Riservato al percorso insegnante</p>
          <h3 class="mt-1 text-lg font-bold text-slate-950"><%= teacher_path.fetch("title") %></h3>
          <ol class="pc-teacher-lesson-list" aria-label="Lezioni di tirocinio">
            <% teacher_path.fetch("lessons", []).each_with_index do |lesson, index| %>
              <li class="pc-teacher-lesson">
                <span class="pc-lesson-number">T<%= index + 1 %></span>
                <span class="min-w-0 flex-1 text-sm font-bold text-slate-800"><%= lesson.fetch("title") %></span>
                <span class="text-xs font-semibold text-violet-700">Da completare</span>
              </li>
            <% end %>
          </ol>
          <% if @selected_student_course["qualification"].present? %>
            <p class="mt-3 rounded-xl border border-violet-100 bg-violet-50 px-3 py-2 text-sm font-semibold text-violet-900"><%= @selected_student_course.fetch("qualification") %></p>
          <% end %>
        </section>
      <% end %>
    </section>
  <% end %>

  <% if Current.user&.superadmin_user? %>
    <aside class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5" aria-label="Sorgenti YAML del programma">
      <p class="text-xs font-black uppercase tracking-[.14em] text-amber-800">Solo superadmin</p>
      <h2 class="mt-1 text-base font-bold text-slate-950">Le due fonti didattiche</h2>
      <div class="mt-3 flex flex-col gap-2 text-sm">
        <%= link_to "Percorso online · Section → Course → Chapter", admin_didactic_source_path(path: "contenuti/percorso.yml"), class: "font-bold text-blue-800 hover:underline" %>
        <%= link_to "Programma lezioni · Course + Section → Course → Lesson → Schede", admin_didactic_source_path(path: "programmi/programma_lezioni_posturacorretta.yml"), class: "font-bold text-blue-800 hover:underline" %>
      </div>
    </aside>
  <% end %>
</section>
