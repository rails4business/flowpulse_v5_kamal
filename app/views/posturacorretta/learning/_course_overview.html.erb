<% course_position = @all_didactic_courses.index { |course| course.fetch("slug") == @reader_course_slug } %>
<% course_code = format("%02d", (course_position || 0) + 1) %>
<% first_chapter = @course_lessons.find { |chapter| chapter.fetch("show_available", false) } %>
<% first_line_lesson = @course_line_lessons&.first %>
<% course_start_path = if first_line_lesson
  posturacorretta_postura_recupero_path(tappa: first_line_lesson.slug, tab: "online")
elsif first_chapter&.fetch("show_available", false)
  posturacorretta_course_chapter_path(corso: @reader_course_slug, capitolo: first_chapter.fetch("slug"))
end %>
<% displayed_course_title = @course_show_node&.title || @selected_course.fetch("title") %>
<% displayed_course_description = @course_show_node&.description.presence || @selected_course["description"] %>

<% course_main = capture do %>
    <div class="min-w-0 space-y-6">
      <section class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 shadow-md" aria-label="Video del corso">
        <% if @course_show_publication %>
          <div class="aspect-video"><%= content_publication_embed(@course_show_publication) %></div>
          <div class="flex items-center justify-between gap-3 border-t border-white/10 px-4 py-3 text-xs text-slate-300"><span><%= @course_show_publication.title.presence || "Video di presentazione" %></span><span class="font-bold text-teal-300">Corso <%= course_code %></span></div>
        <% else %>
          <div class="flex aspect-video items-center justify-center p-6 text-center" data-course-video-placeholder>
            <div>
              <span class="mx-auto grid size-16 place-items-center rounded-full bg-teal-500 text-white shadow-lg" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" class="size-8 translate-x-0.5"><path d="M8 5.5v13l10-6.5z" /></svg></span>
              <p class="mt-4 text-sm font-semibold text-slate-200">Video di presentazione</p>
              <p class="mt-1 text-xs text-slate-400">Il video del corso sarà disponibile qui.</p>
            </div>
          </div>
          <div class="flex items-center justify-between gap-3 border-t border-white/10 px-4 py-3 text-xs text-slate-400"><span>In preparazione</span><span class="font-bold text-teal-300">Corso <%= course_code %></span></div>
        <% end %>
      </section>
      <div class="space-y-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
      <header class="border-b border-slate-100 pb-5">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full border border-teal-200 bg-teal-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[.13em] text-teal-700">Corso <%= course_code %></span>
                <% if @selected_course["status"] == "draft" %><span class="rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-700">In preparazione</span><% end %>
              </div>
              <h1 class="mt-3 text-3xl font-semibold tracking-[-.03em] text-slate-950 sm:text-4xl"><%= displayed_course_title %></h1>
              <% if displayed_course_description.present? %><p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600"><%= displayed_course_description %></p><% end %>
              <%= render "posturacorretta/learning/publication_admin_bar", chapter: @selected_course %>
              <% if @course_enrollment && !@course_line_node %>
                <div class="mt-5" aria-label="Avanzamento del corso">
                  <div class="flex items-center justify-between gap-3 text-xs font-semibold"><span class="text-slate-600"><%= @completed_chapter_slugs.size %> di <%= @course_lessons.size %> capitoli letti</span><span class="text-blue-700"><%= @course_progress_percent %>%</span></div>
                  <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-label="<%= @course_progress_percent %>% completato" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= @course_progress_percent %>"><span class="block h-full rounded-full bg-blue-600 transition-all" style="width: <%= @course_progress_percent %>%"></span></div>
                </div>
              <% end %>
              <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
                <p class="text-xs font-semibold text-slate-500"><%= @course_line_node ? pluralize(@course_line_lessons.size, "lezione", "lezioni") : pluralize(@course_lessons.size, "capitolo", "capitoli") %><%= " · #{@course_progress_percent}% completato" if @course_enrollment && !@course_line_node %></p>
                <% if first_line_lesson && @course_enrollment %>
                  <%= link_to "Apri la prima lezione", course_start_path, class: "pc-primary-cta inline-flex min-w-24 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-bold transition" %>
                <% elsif first_line_lesson && authenticated? %>
                  <%= button_to "Iscriviti al corso", posturacorretta_course_enrollment_path(corso: @reader_course_slug), class: "pc-action-button pc-action-button--primary min-w-24" %>
                <% elsif first_line_lesson %>
                  <%= link_to "Accedi per iscriverti", new_session_path(return_to: posturacorretta_course_path(corso: @reader_course_slug)), class: "pc-primary-cta inline-flex min-w-24 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-bold transition" %>
                <% elsif @course_enrollment && course_start_path %>
                  <%= link_to(@completed_chapter_slugs.any? ? "Continua il corso" : "Inizia", course_start_path, class: "pc-primary-cta inline-flex min-w-24 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-bold transition") %>
                <% elsif authenticated? %>
                  <%= button_to "Inizia", posturacorretta_course_enrollment_path(corso: @reader_course_slug), params: ({ capitolo: first_chapter.fetch("slug") } if first_chapter), class: "pc-action-button pc-action-button--primary min-w-24" %>
                <% elsif course_start_path %>
                  <%= link_to "Accedi per iniziare", new_session_path(return_to: posturacorretta_course_path(corso: @reader_course_slug)), class: "pc-primary-cta inline-flex min-w-24 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-bold transition" %>
                <% else %>
                  <span class="inline-flex rounded-lg bg-slate-100 px-4 py-2 text-xs font-bold text-slate-500">In preparazione</span>
                <% end %>
              </div>
            </div>
      </header>

      <% if @course_show_content %>
        <%= render "posturacorretta/learning/course_show_content", content: @course_show_content %>
      <% end %>

      <div>
        <section id="capitoli" class="border-t border-slate-100 pt-6">
          <% if @course_line_node %>
          <p class="text-xs font-extrabold uppercase tracking-[.15em] text-violet-700">Programma accompagnato</p>
          <h2 class="mt-1 text-2xl font-semibold text-slate-950">Lezioni del corso</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Apri una lezione per consultarne i dati e l’indice dei capitoli.</p>
          <% if @course_line_lessons.any? %>
            <ol class="mt-5 grid gap-3 sm:grid-cols-2">
              <% @course_line_lessons.each_with_index do |lesson, index| %>
                <li><%= link_to posturacorretta_postura_recupero_path(tappa: lesson.slug, tab: "online"), class: "group flex items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-violet-300 hover:bg-violet-50/40" do %>
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-violet-100 text-xs font-black text-violet-700"><%= index + 1 %></span>
                  <span class="min-w-0"><small class="block text-[10px] font-black uppercase tracking-wide text-slate-400">Lezione</small><strong class="mt-0.5 block text-sm text-slate-900 group-hover:text-violet-800"><%= lesson.short_title %></strong></span>
                  <span aria-hidden="true" class="ml-auto text-violet-700">→</span>
                <% end %></li>
              <% end %>
            </ol>
          <% else %>
            <p class="mt-5 rounded-xl border border-dashed border-slate-300 p-5 text-sm text-slate-500">Le lezioni di questo corso sono in preparazione.</p>
          <% end %>
          <% else %>
          <p class="text-xs font-extrabold uppercase tracking-[.15em] text-indigo-700">Studio in autonomia</p>
          <h2 class="mt-1 text-2xl font-semibold text-slate-950">Corso online</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Testi e approfondimenti da consultare in autonomia, prima o dopo gli appuntamenti.</p>
          <% if posturacorretta_editorial_preview? && Rails.env.development? %>
            <div class="mt-4 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-xs leading-5 text-sky-900"><strong>Ambiente di sviluppo.</strong> I DataCommitment creati qui restano nel database locale e non modificano la pubblicazione in produzione.</div>
          <% end %>
          <% if @course_lessons.present? %>
            <ol class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
              <% @course_lessons.each_with_index do |chapter, index| %>
                <% show_available = chapter.fetch("show_available", false) %>
                <li>
                  <% chapter_body = capture do %>
                    <% chapter_completed_at = @completed_chapter_commitments[chapter.fetch("slug")]&.actual_ended_at %>
                    <span class="text-[11px] font-extrabold uppercase tracking-[.12em] text-slate-500">Capitolo <%= format("%02d", index + 1) %></span>
                    <span class="min-w-0 text-base font-bold leading-6 <%= show_available ? 'text-slate-900 group-hover:text-indigo-800' : 'text-slate-700' %>"><%= chapter.fetch("title") %></span>
                    <%= render "posturacorretta/learning/chapter_progress_indicator", chapter: chapter, completed: @completed_chapter_slugs.include?(chapter.fetch("slug")), completed_at: chapter_completed_at, show_date: true %>
                  <% end %>
                  <% if show_available %>
                    <%= link_to chapter_body, posturacorretta_course_chapter_path(corso: @reader_course_slug, capitolo: chapter.fetch("slug")), class: "group grid gap-3 px-1 py-5 transition hover:bg-slate-50 sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:items-center sm:px-3" %>
                  <% else %>
                    <div class="grid gap-3 px-1 py-5 sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:items-center sm:px-3"><%= chapter_body %></div>
                  <% end %>
                  <%= render "posturacorretta/learning/publication_admin_bar", chapter: chapter %>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="mt-6 rounded-xl border border-dashed border-indigo-200 bg-indigo-50/40 p-5 text-sm text-indigo-900">I capitoli di questo corso sono in preparazione.</p>
          <% end %>
          <% end %>
        </section>
      </div>
      </div>
    </div>
<% end %>

<% if @course_line_node && @course_show_node %>
  <%= render "posturacorretta/learning/line_learning_layout",
    active_node: @course_show_node,
    line: @course_line_node,
    courses: @course_line_courses,
    main_content: course_main %>
<% else %>
  <main class="min-h-screen bg-slate-50"><div class="mx-auto max-w-5xl px-4 py-6 sm:px-6 lg:px-8"><%= course_main %></div></main>
<% end %>

<%= render "posturacorretta/footer" %>
