<% content = local_assigns.fetch(:content) %>

<section aria-labelledby="course-show-content-title">
  <div>
    <article>
      <div class="flex flex-wrap items-center gap-2">
        <p class="text-xs font-extrabold uppercase tracking-[.15em] text-blue-700">Presentazione del corso</p>
        <% if Current.user&.superadmin_user? && !content.published_for_public? %><span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-black uppercase text-amber-800">Anteprima <%= content.publication_status %></span><% end %>
      </div>
      <h2 id="course-show-content-title" class="mt-2 text-2xl font-semibold tracking-tight text-slate-950"><%= content.title %></h2>
      <% if content.description.present? %><p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600"><%= content.description %></p><% end %>
      <% duration = content.data.to_h["duration"].presence || content.data.to_h["duration_minutes"].presence %>
      <% if duration %><p class="mt-4 text-xs font-bold uppercase tracking-wide text-slate-500">Durata indicativa · <%= duration.to_s.match?(/\A\d+\z/) ? "#{duration} minuti" : duration %></p><% end %>
      <% if content.body.present? %>
        <div class="node-public-content mt-6"><%= content.body %></div>
      <% elsif content.body_md.present? %>
        <div class="node-public-content mt-6"><%= render_node_markdown(content.body_md) %></div>
      <% end %>
    </article>
  </div>
</section>
