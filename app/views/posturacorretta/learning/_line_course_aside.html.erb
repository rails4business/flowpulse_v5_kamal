<%# Aside comune alle pagine di corso, lezione e contenuto: Corso → Lezione → Contenuti.
    I corsi della linea sono moduli (aperto quello attuale) con le loro lezioni; i contenuti compaiono solo
    dentro la lezione del contenuto aperto. %>
<% active_node = local_assigns.fetch(:active_node) %>
<% line = local_assigns.fetch(:line) %>
<% courses = local_assigns.fetch(:courses) %>
<% active_content = local_assigns[:active_content] %>
<%
  content_types = { "chapter" => "Capitolo" }
  preview = Current.user&.superadmin_user?
  completed = posturacorretta_completed_chapter_keys
  active_course = courses.find { |course| course == active_node || course.children.include?(active_node) }
  active_course_index = courses.index(active_course)
  icon = ->(name, css) do
    paths = {
      done: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
      next: '<circle cx="12" cy="12" r="10"/><path d="M10 8.5v7l5.5-3.5z"/>',
      todo: '<circle cx="12" cy="12" r="10"/>',
      chevron: '<path d="m9 18 6-6-6-6"/>'
    }
    tag.svg(paths.fetch(name).html_safe, class: css, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": true)
  end
%>

<header class="pc-line-aside__header">
  <%= link_to posturacorretta_path, class: "pc-line-aside__back" do %><span aria-hidden="true">←</span> Torna al programma<% end %>
  <p class="pc-line-aside__eyebrow"><%= line.content_type.presence || "Percorso educativo" %></p>
  <h2 class="pc-line-aside__title"><%= line.title %></h2>
  <% if active_course_index %><p class="pc-line-aside__meta">Corso <%= active_course_index + 1 %> di <%= courses.size %></p><% end %>
</header>

<nav aria-label="Programma della linea" class="pc-line-aside__modules" data-controller="scroll-selected">
  <% courses.each_with_index do |course_node, course_index| %>
    <%
      number = course_index + 1
      lessons = course_node.children.where(view_type: "course_lesson").order(:position, :id).to_a
      lesson_chapters = lessons.to_h do |lesson|
        chapters = lesson.editorial_contents.where(format: "chapter").includes(:parent).order(:position, :id).to_a
        [lesson, chapters.select { |chapter| chapter.published_for_public? || preview }]
      end
      read = ->(chapter) { completed.include?([chapter.parent&.slug, chapter.slug]) }
      readable = lesson_chapters.values.flatten
      done_count = readable.count(&read)
      course_done = readable.any? && done_count == readable.size
      # La lezione da continuare è la prima con capitoli non ancora letti.
      next_lesson = lessons.find { |lesson| lesson_chapters.fetch(lesson).any? { |chapter| !read.(chapter) } }
      open = course_node == active_course
    %>
    <% course_selected = course_node == active_node %>
    <details class="pc-line-aside__module <%= 'is-active' if open %>" <%= 'open' if open %>>
      <%# Il titolo porta alla pagina del corso; la freccia apre e chiude l'elenco. %>
      <summary class="pc-line-aside__summary">
        <%= link_to posturacorretta_course_node_path(course_node), aria: { current: ("page" if course_selected) }, data: ({ scroll_selected_target: "item" } if course_selected), class: "pc-line-aside__summary-text #{'is-selected' if course_selected}" do %>
          <span class="pc-line-aside__course-label">Corso <%= number %><% if course_done %> · completato<% end %></span>
          <strong><%= course_node.title %></strong>
        <% end %>
        <% if readable.any? %><span class="pc-line-aside__count"><%= done_count %>/<%= readable.size %></span><% end %>
        <%= icon.(:chevron, "pc-line-aside__chevron") %>
      </summary>

      <ol class="pc-line-aside__items">

        <%# Le lezioni; i loro contenuti si aprono solo nella pagina di un contenuto. %>
        <% lessons.each_with_index do |lesson, lesson_index| %>
          <%
            chapters = lesson_chapters.fetch(lesson)
            lesson_done_count = chapters.count(&read)
            done = chapters.any? && lesson_done_count == chapters.size
            upcoming = lesson == next_lesson && lesson_done_count.positive?
            lesson_selected = lesson == active_node
            status = done ? :done : (upcoming ? :next : :todo)
          %>
          <li>
            <%= link_to posturacorretta_postura_recupero_path(tappa: lesson.slug, tab: "online"), aria: { current: ("page" if lesson_selected) }, data: ({ scroll_selected_target: "item" } if lesson_selected), class: "pc-line-aside__item #{'is-selected' if lesson_selected} #{'is-done' if done}" do %>
              <%= icon.(status, "pc-line-aside__icon #{{ done: 'text-emerald-500', next: 'text-blue-600', todo: 'text-slate-300' }.fetch(status)}") %>
              <span class="pc-line-aside__label">Lezione <%= number %>.<%= lesson_index + 1 %> · <%= lesson.short_title %></span>
              <% if chapters.any? %><span class="pc-line-aside__count"><%= lesson_done_count %>/<%= chapters.size %></span><% end %>
            <% end %>
            <% if active_content && active_content.node == lesson && chapters.any? %>
              <ol class="pc-line-aside__contents" aria-label="Contenuti della lezione">
                <% first_unread = chapters.find { |chapter| !read.(chapter) } %>
                <% chapters.each do |chapter| %>
                  <%
                    content_done = read.(chapter)
                    content_selected = chapter == active_content
                    content_status = content_done ? :done : (chapter == first_unread ? :next : :todo)
                  %>
                  <li>
                    <%= link_to posturacorretta_course_chapter_path(corso: chapter.parent.slug, capitolo: chapter.slug), aria: { current: ("page" if content_selected) }, data: ({ scroll_selected_target: "item" } if content_selected), class: "pc-line-aside__content #{'is-selected' if content_selected} #{'is-done' if content_done}" do %>
                      <%= icon.(content_status, "pc-line-aside__icon #{{ done: 'text-emerald-500', next: 'text-blue-600', todo: 'text-slate-300' }.fetch(content_status)}") %>
                      <span class="pc-line-aside__label"><span class="pc-line-aside__type"><%= content_types.fetch(chapter.format, chapter.format.humanize) %></span> <%= chapter.title %></span>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            <% end %>
          </li>
        <% end %>

        <% if lessons.empty? %>
          <li class="pc-line-aside__empty">Lezioni in preparazione</li>
        <% end %>
      </ol>
    </details>
  <% end %>
</nav>
