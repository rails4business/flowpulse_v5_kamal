<main>
  <div class="fixed inset-0 z-[100] hidden bg-slate-950/30 opacity-0 transition-opacity lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>
  <div class="mx-auto max-w-screen-xl px-4 py-6 sm:px-6 lg:grid lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-8 lg:px-8 lg:py-8">
    <aside id="seme-aside" class="pc-course-aside-enter fixed inset-y-0 left-0 z-[110] flex w-80 max-w-[88vw] -translate-x-full flex-col overflow-hidden border-r border-slate-200 bg-white p-5 shadow-2xl transition-transform lg:sticky lg:top-8 lg:z-auto lg:h-auto lg:max-h-[calc(100vh-4rem)] lg:w-auto lg:max-w-none lg:translate-x-0 lg:overscroll-contain lg:rounded-xl lg:border lg:shadow-sm" data-mobile-aside-target="panel" aria-hidden="true">
      <div class="mb-4 flex shrink-0 items-center justify-between gap-3 border-b border-slate-200 pb-3 lg:hidden">
        <%= link_to posturacorretta_path, class: "inline-flex items-center gap-1 rounded-lg px-2 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50", aria: { label: "Torna alla home PosturaCorretta" } do %><span aria-hidden="true">←</span> Home<% end %>
        <button type="button" class="rounded-lg px-3 py-2 text-xl font-bold leading-none text-slate-500 hover:bg-slate-100" data-mobile-aside-target="close" data-action="mobile-aside#close" aria-label="Chiudi indice">×</button>
      </div>
      <div class="mb-5 hidden shrink-0 border-b border-slate-200 bg-white pb-4 lg:block" data-course-aside-header>
        <%= link_to posturacorretta_path, aria: { label: "Torna alla home PosturaCorretta" }, class: "mb-4 inline-flex items-center gap-2 text-blue-700 opacity-80 transition hover:opacity-100" do %>
          <span aria-hidden="true">←</span>
          <img src="https://ik.imagekit.io/posturacorretta/logo_pc_scontornato.png?updatedAt=1747975596766" alt="PosturaCorretta" class="h-7 w-auto">
        <% end %>
        <%= link_to posturacorretta_course_path(corso: @reader_course_slug), class: "mt-3 block text-base font-bold leading-6 text-slate-900 hover:text-blue-700" do %><%= @selected_course.fetch("title") %><% end %>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain pb-10 [scrollbar-color:rgb(203_213_225)_transparent] [scrollbar-width:thin]" data-controller="scroll-selected" data-scroll-selected-position-selected-at-top-value="true">
        <div data-action="click->mobile-aside#closeFromNavigation">
          <%= render "posturacorretta/learning/curriculum_aside", active: :path, course: @selected_course, lesson: @lesson, manage_own_scroll: false %>
        </div>
      </div>
    </aside>

    <article class="pc-course-main-enter min-w-0 rounded-xl border border-slate-200 bg-white px-5 py-10 shadow-sm sm:px-8 lg:px-12 lg:py-14 xl:px-16">
      <div class="mx-auto max-w-4xl">
        <% if posturacorretta_editorial_preview? && Rails.env.development? %>
          <div class="mb-4 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-xs leading-5 text-sky-900"><strong>Ambiente di sviluppo.</strong> Questo stato editoriale è locale e non modifica la produzione.</div>
        <% end %>
        <p class="mb-2 text-sm font-medium text-slate-500"><%= @selected_course.fetch("title") %></p>
        <div class="flex flex-wrap items-center gap-2">
          <% lesson_completed_at = @completed_chapter_commitments[@lesson.fetch("slug")]&.actual_ended_at %>
          <%= render "posturacorretta/learning/chapter_progress_indicator", chapter: @lesson, completed: @completed_chapter_slugs.include?(@lesson.fetch("slug")), completed_at: lesson_completed_at %>
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-blue-700">Capitolo <%= format("%02d", @lesson_number) %></p>
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-emerald-700"><%= @lesson.fetch("access", "free") == "free" ? "Libero" : "A pagamento" %></span>
          <%= render "posturacorretta/learning/publication_admin_bar", chapter: @lesson, inline: true %>
        </div>
        <% if @lesson_access_allowed %>
          <%= render "posturacorretta/shared/rich_text", rendered_content: markdown(@lesson_content), class_name: "mt-4 min-w-0" %>
        <% else %>
          <section class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-6">
            <h2 class="text-xl font-semibold text-amber-950">Capitolo a pagamento</h2>
            <p class="mt-2 text-sm leading-6 text-amber-900">L'acquisto non è ancora attivo. Il contenuto resterà protetto finché non saranno definite offerta e modalità di accesso.</p>
          </section>
        <% end %>
        <% if @lesson_access_allowed %>
          <section class="mt-10 border-t border-slate-200 pt-6" aria-label="Completamento del capitolo">
            <% if !@course_enrollment && @course_lessons.first == @lesson && authenticated? %>
              <%= button_to "Inizia il corso", posturacorretta_course_enrollment_path(corso: @reader_course_slug), params: { capitolo: @lesson.fetch("slug") }, class: "pc-action-button pc-action-button--primary", aria: { label: "Inizia il corso e apri il primo capitolo" } %>
            <% elsif @course_enrollment && !@completed_chapter_slugs.include?(@lesson.fetch("slug")) && @chapter_completion_unlocked %>
              <%= button_to "Segna come letto", posturacorretta_course_chapter_completion_path(corso: @reader_course_slug, capitolo: @lesson.fetch("slug")), class: "pc-action-button pc-action-button--success", aria: { label: "Segna il capitolo come letto" } %>
            <% elsif @course_enrollment && !@completed_chapter_slugs.include?(@lesson.fetch("slug")) %>
              <span class="rounded-lg bg-slate-100 px-3 py-2 text-sm font-bold text-slate-500">🔒 Completa prima il capitolo precedente</span>
            <% elsif @completed_chapter_slugs.include?(@lesson.fetch("slug")) %>
              <% completed_at = @completed_chapter_commitments.fetch(@lesson.fetch("slug")).actual_ended_at %>
              <p class="inline-flex items-center gap-2 text-sm font-bold text-emerald-700"><span class="grid size-5 place-items-center rounded-full bg-emerald-600 text-[11px] text-white" aria-hidden="true">✓</span>Letto<% if completed_at %> il <time datetime="<%= completed_at.iso8601 %>"><%= completed_at.strftime("%d/%m/%Y") %></time><% end %></p>
            <% end %>
          </section>
        <% end %>
      </div>
    </article>
  </div>

  <nav class="sticky bottom-0 z-40 hidden border-t border-slate-200 bg-white/95 px-3 py-3 shadow-[0_-8px_24px_rgba(15,23,42,.08)] backdrop-blur sm:block" aria-label="Navigazione del capitolo">
    <div class="mx-auto max-w-4xl">
      <div class="flex items-center justify-between gap-2">
        <%= link_to "☰ Indice", posturacorretta_course_path(corso: @reader_course_slug, anchor: "capitoli"), class: "rounded-lg px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100" %>
        <span class="flex items-center gap-2">
        <% if @previous_lesson %><%= link_to "← Precedente", posturacorretta_course_chapter_path(corso: @reader_course_slug, capitolo: @previous_lesson.fetch("slug")), class: "rounded-lg px-3 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50" %><% end %>
        <% if @next_lesson %><%= link_to "Successivo →", posturacorretta_course_chapter_path(corso: @reader_course_slug, capitolo: @next_lesson.fetch("slug")), class: "rounded-lg px-3 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50" %><% end %>
        </span>
      </div>
    </div>
  </nav>
</main>
