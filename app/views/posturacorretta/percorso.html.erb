<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<div id="top" class="bg-white text-slate-900 antialiased min-h-screen">

  <%# -- SUPERADMIN DEBUG BANNER -- %>
  <% if Current.user&.superadmin_user? %>
    <div class="bg-indigo-600 text-white text-sm font-semibold py-2 px-4 flex justify-between items-center shadow-inner">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
        <span>Area Superadmin: Hub Documentale "Percorso"</span>
      </div>
      <div class="text-xs font-mono opacity-90 truncate max-w-lg" title="/Users/hselectronics/Documents/Code/flowpulse_v_5/config/data/posturacorretta/percorso">
        Path: /config/data/posturacorretta/percorso
      </div>
    </div>
  <% end %>

  <main>
    <section class="px-5 py-12 md:py-20">
      <div class="mx-auto w-full max-w-6xl" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
        <!-- Mobile Sidebar Toggle -->
        <div class="lg:hidden mb-6 flex items-center justify-between">
          <h1 class="text-xl font-bold text-slate-900"><%= @current_item&.fetch("title", "Percorso") %></h1>
          <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="percorso-mobile-aside" aria-expanded="false">
            <svg class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span>Indice</span>
          </button>
        </div>

        <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">

          <%# -- BACKDROP SCURO (Mobile) -- %>
          <div class="fixed inset-0 z-40 hidden bg-slate-900/20 backdrop-blur-sm opacity-0 transition-opacity duration-300 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>

          <%# -- DINAMIC ASIDE (2 Levels) -- %>
          <aside id="percorso-mobile-aside" class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] transform -translate-x-full overflow-y-auto bg-white p-6 shadow-2xl transition-transform duration-300 ease-in-out lg:static lg:z-auto lg:block lg:w-auto lg:max-w-none lg:translate-x-0 lg:overflow-visible lg:bg-transparent lg:p-0 lg:shadow-none" data-mobile-aside-target="panel" aria-hidden="true">
            
            <!-- Mobile Close Button -->
            <div class="mb-6 flex items-center justify-between lg:hidden">
              <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-950">Menu Navigazione</span>
              <button type="button" class="rounded-md p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500" data-mobile-aside-target="close" data-action="mobile-aside#close">
                <span class="sr-only">Chiudi menu</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
            <nav class="sticky top-24 space-y-4 text-sm" aria-label="Indice della pagina" data-action="click->mobile-aside#closeFromNavigation">
              <% @aside_items.each do |item| %>
                <div class="space-y-1">
                  <% if item["type"] == "group" %>
                    <p class="pt-2 pb-1 text-xs font-bold uppercase tracking-[0.16em] text-slate-950"><%= item["title"] %></p>
                  <% else %>
                    <a href="<%= posturacorretta_percorso_path(page: item['slug']) %>" class="block py-1.5 font-semibold <%= params[:page] == item['slug'] || (params[:page].blank? && item['slug'] == 'inizia') ? 'text-blue-700' : 'text-slate-900 hover:text-blue-700' %>">
                      <%= item["title"] %>
                    </a>
                  <% end %>

                  <% if item["children"].present? %>
                    <div class="-ml-1 mt-1 space-y-1 border-l border-slate-100 pl-3">
                      <% item["children"].each do |child| %>
                        <% child_active = params[:page] == child["slug"] || (params[:page].blank? && child["slug"] == "inizia") %>
                        <% adherence_link = child["slug"] == "professionisti-aderisci-linee-guida" %>
                        <% integrated_guide_link = child["slug"] == "professionisti-percorso-integrato" %>
                        <% child_classes = if adherence_link
                          "mt-2 border-t border-slate-200 pt-3 pb-1.5 font-bold text-emerald-700 hover:text-emerald-800 #{'underline decoration-2 underline-offset-4' if child_active}"
                        elsif integrated_guide_link
                          "py-1.5 font-normal text-slate-500 hover:text-blue-700"
                        elsif child_active
                          "py-1.5 font-semibold text-blue-700 underline decoration-2 underline-offset-4"
                        else
                          "py-1.5 text-slate-500 hover:text-blue-700"
                        end %>
                        <% if child["type"] == "group" %>
                          <p class="mt-4 border-t border-slate-200 pt-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-500"><%= child["title"] %></p>
                        <% else %>
                          <a href="<%= posturacorretta_percorso_path(page: child['slug']) %>" class="block text-sm <%= child_classes %>">
                            <%= child["title"] %>
                          </a>
                        <% end %>
                        <% if child["children"].present? %>
                          <div class="ml-2 space-y-1 border-l border-slate-100 pl-3">
                            <% child["children"].each do |grandchild| %>
                              <a href="<%= posturacorretta_percorso_path(page: grandchild['slug']) %>" class="block py-1 text-xs <%= params[:page] == grandchild['slug'] ? 'font-medium text-blue-700' : 'text-slate-500 hover:text-blue-700' %>">
                                <%= grandchild["title"] %>
                              </a>
                            <% end %>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </nav>
          </aside>

          <%# -- DINAMIC CONTENT AREA -- %>
          <div class="min-w-0">
            <% current_page_slug = @current_item&.fetch("slug", nil) %>
            <% adherence_page = current_page_slug == "professionisti-aderisci-linee-guida" %>
            <% professional_page = @professional_page_slugs.include?(current_page_slug) %>
            <% if @page_content.present? %>
              <% if adherence_page %>
                <section id="adesione-linee-guida" class="mb-10 scroll-mt-24 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8" aria-labelledby="integrated-path-cta-title">
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-700">Prossimo passo</p>
                  <h2 id="integrated-path-cta-title" class="mt-2 text-2xl font-bold">Aderisci alle Linee guida del Percorso</h2>
                  <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">Entra nella rete professionale di PosturaCorretta. In futuro potrai creare una cerchia di collaboratori, individuare le competenze necessarie e invitare altri professionisti nei tuoi percorsi integrati.</p>
                  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                    <a href="https://wa.me/393792891488?text=<%= ERB::Util.url_encode('Ciao, vorrei aderire alle Linee guida del Percorso PosturaCorretta e ricevere informazioni sulla futura rete di collaboratori.') %>" target="_blank" rel="noopener noreferrer" class="pc-cta-primary">
                      Aderisci
                    </a>
                    <a href="https://wa.me/393792891488?text=<%= ERB::Util.url_encode('Ciao, vorrei maggiori informazioni sulle Linee guida del Percorso e sulla futura cerchia dei collaboratori di PosturaCorretta.') %>" target="_blank" rel="noopener noreferrer" class="pc-cta-secondary">
                      Chiedi informazioni
                    </a>
                  </div>
                </section>
              <% end %>

              <div class="flex flex-col xl:flex-row gap-10 xl:items-start">
                <%= render "posturacorretta/shared/rich_text",
                           rendered_content: markdown(@page_content),
                           class_name: "min-w-0 flex-1" %>

                <aside class="hidden xl:block w-64 shrink-0 sticky top-24">
                  <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Indice della pagina</div>
                  <nav class="path-document-toc border-l border-slate-200 pl-4" aria-label="Titoli del documento">
                    <%= markdown_toc(@page_content) %>
                  </nav>
                </aside>
              </div>

              <% if professional_page && !adherence_page %>
                <%= render "posturacorretta/percorso/integrated_path_prompt" %>
              <% end %>

              <% if adherence_page %>
                <div class="mt-8 border-t border-slate-200 pt-5 text-right">
                  <a href="#adesione-linee-guida" class="pc-inline-cta">Torna all'adesione <span aria-hidden="true">&uarr;</span></a>
                </div>
              <% end %>
            <% elsif @page_partial.present? %>
              <%= render @page_partial %>
              <% if professional_page && !adherence_page %>
                <%= render "posturacorretta/percorso/integrated_path_prompt" %>
              <% end %>
            <% else %>
              <div class="rounded-xl border border-red-200 bg-red-50 p-6 text-center text-red-700">
                <svg class="mx-auto h-8 w-8 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                <h3 class="font-bold text-lg mb-1">Contenuto non trovato</h3>
                <p>La pagina richiesta non esiste o è stata rimossa.</p>
                <a href="<%= posturacorretta_percorso_path(page: 'inizia') %>" class="mt-4 inline-block font-semibold underline">Torna all'inizio</a>
              </div>
            <% end %>
          </div>

        </div>
      </div>
    </section>
  </main>

  <%= render "posturacorretta/footer" %>
</div>
