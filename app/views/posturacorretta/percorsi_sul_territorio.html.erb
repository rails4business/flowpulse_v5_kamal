<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<div id="top" class="min-h-screen bg-white text-slate-900 antialiased">
  <main class="px-5 py-12 md:py-20">
    <div class="mx-auto w-full max-w-6xl">
      <div class="mb-10">
        <%= render "posturacorretta/percorso/access_switcher" %>
      </div>

      <section id="territorio" class="max-w-4xl scroll-mt-24">
        <h1 class="text-3xl font-black tracking-tight text-slate-950 md:text-5xl">Percorsi sul territorio</h1>

        <div class="mt-8 -mb-px border-b border-slate-200">
          <nav class="flex gap-1" aria-label="Catalogo territoriale">
            <% [["paths", "Percorsi"], ["people", "Professionisti"], ["places", "Luoghi"]].each do |tab, label| %>
              <%= link_to label, posturacorretta_percorsi_sul_territorio_path(tab: tab), class: "border-b-2 px-4 py-2 text-sm font-medium transition-colors #{@territory_tab == tab ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-600 hover:text-slate-900'}" %>
            <% end %>
          </nav>
        </div>

        <% if @territory_tab == "paths" %>
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            <% @territorial_paths.each do |path| %>
              <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700"><%= path.city.presence || "In presenza" %></p>
                <h2 class="mt-2 text-xl font-black text-slate-950"><%= path.title %></h2>
                <p class="mt-3 text-sm leading-6 text-slate-600"><%= path.summary %></p>
                <dl class="mt-5 space-y-2 border-t border-slate-100 pt-4 text-sm">
                  <div class="flex justify-between gap-4"><dt class="text-slate-500">Responsabile</dt><dd class="font-semibold text-slate-900"><%= path.responsible_person.name %></dd></div>
                  <% if path.place.present? %><div class="flex justify-between gap-4"><dt class="text-slate-500">Luogo</dt><dd class="font-semibold text-slate-900"><%= path.place.name %></dd></div><% end %>
                </dl>
                <% if path.programs.any? %>
                  <div class="mt-4 flex flex-wrap gap-2"><% path.programs.each do |program| %><span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700"><%= program["title"] %> · <%= program["visits"] %> visite</span><% end %></div>
                <% end %>
                <a href="https://wa.me/393792891488?text=<%= ERB::Util.url_encode("Ciao, vorrei ricevere informazioni su #{path.title}.") %>" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900">Chiedi informazioni <span class="ml-1" aria-hidden="true">→</span></a>
              </article>
            <% end %>
          </div>
        <% elsif @territory_tab == "people" %>
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            <% @territory_people.each do |person| %>
              <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700"><%= person.city.presence || "PosturaCorretta" %></p><h2 class="mt-2 text-xl font-black text-slate-950"><%= person.name %></h2><p class="mt-2 text-sm font-semibold text-slate-700"><%= person.role %></p><p class="mt-3 text-sm leading-6 text-slate-600"><%= person.summary %></p><div class="mt-4 flex flex-wrap gap-2"><% person.listing_sections.each do |section| %><span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= section.humanize %></span><% end %></div></article>
            <% end %>
          </div>
        <% else %>
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            <% @territory_places.each do |place| %>
              <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700"><%= place.city.presence || "PosturaCorretta" %></p><h2 class="mt-2 text-xl font-black text-slate-950"><%= place.name %></h2><p class="mt-3 text-sm leading-6 text-slate-600"><%= place.summary %></p><p class="mt-4 text-sm font-medium text-slate-700"><%= place.address %></p></article>
            <% end %>
          </div>
        <% end %>

        <% visible_entries = @territory_tab == "paths" ? @territorial_paths : (@territory_tab == "people" ? @territory_people : @territory_places) %>
        <% if visible_entries.empty? %><p class="mt-8 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-sm text-slate-600">Le informazioni saranno aggiunte progressivamente.</p><% end %>
      </section>
    </div>
  </main>

  <%= render "posturacorretta/footer" %>
</div>
