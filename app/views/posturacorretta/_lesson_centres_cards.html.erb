<% @territory_places.each do |place| %>
  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-blue-300 hover:shadow-md sm:p-7">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700"><%= place.city.presence || "PosturaCorretta" %></p>
    <h2 class="mt-2 text-xl font-black text-slate-950"><%= place.name %></h2>
    <p class="mt-3 text-sm leading-6 text-slate-600"><%= place.summary %></p>
    <p class="mt-4 text-sm font-medium text-slate-700"><%= place.address %></p>
  </article>
<% end %>
<% @territory_catalog_places.each do |place| %>
  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-blue-300 hover:shadow-md sm:p-7">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700"><%= place["type"] == "Eventi" ? "Luogo ed esperienze" : "Centro e struttura" %></p>
    <h2 class="mt-2 text-xl font-black text-slate-950"><%= place["name"] %></h2>
    <p class="mt-3 text-sm font-semibold text-slate-700"><%= place["city"] %></p>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= place["type"] %></p>
  </article>
<% end %>
