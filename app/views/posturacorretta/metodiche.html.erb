<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<% methodologies_tab = params[:tab] == "how" ? "how" : "catalog" %>

<main class="min-h-screen bg-white">
  <section class="border-b border-slate-200 bg-white pt-8">
    <div class="mx-auto max-w-7xl px-6">
      <nav class="-mb-px flex gap-1" aria-label="Sezioni Metodiche">
        <%= link_to "Metodiche", posturacorretta_metodiche_path(tab: "catalog"), class: "border-b-2 px-4 py-3 text-sm font-semibold transition #{methodologies_tab == 'catalog' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-600 hover:text-slate-800'}", aria: { current: ("page" if methodologies_tab == "catalog") } %>
        <%= link_to "Come funziona", posturacorretta_metodiche_path(tab: "how"), class: "border-b-2 px-4 py-3 text-sm font-semibold transition #{methodologies_tab == 'how' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-600 hover:text-slate-800'}", aria: { current: ("page" if methodologies_tab == "how") } %>
      </nav>
    </div>
  </section>

  <% if methodologies_tab == "catalog" %>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-12">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">Archivio metodiche</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">
       Professioni, metodiche posturali e per la guarigione
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
        Ogni metodica ha una storia, un linguaggio e un modo specifico di osservare postura, movimento e salute.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-4 bg-white px-6 py-8 md:grid-cols-2 xl:grid-cols-3">
    <% @methodologies.each do |methodology| %>
      <% professionals = methodology_professionals_for(@methodology_professionals, methodology.fetch("slug")) %>
      <a href="<%= posturacorretta_metodica_path(methodology.fetch("slug")) %>" class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg">
        <div class="flex items-start justify-between gap-3">
          <span class="flex items-center gap-3">
            <% if methodology.fetch("logo_url").present? %>
              <img src="<%= methodology.fetch("logo_url") %>" alt="<%= methodology.fetch("title") %>" class="h-10 w-10 rounded-xl border border-slate-200 object-contain p-1">
            <% else %>
              <span class="grid h-10 w-10 place-items-center rounded-xl border border-blue-100 bg-blue-50 text-sm font-extrabold text-blue-700"><%= methodology.fetch("title").first %></span>
            <% end %>
            <span class="rounded-full border px-3 py-1 text-[10px] font-extrabold uppercase tracking-wide <%= methodology_badge_classes(methodology.fetch("badge")) %>">
              <%= methodology_badge_label(methodology.fetch("badge")) %>
            </span>
          </span>
          <span class="text-xs font-bold text-slate-400"><%= professionals.size %> professionisti</span>
        </div>
        <h2 class="mt-4 text-xl font-bold text-slate-950"><%= methodology.fetch("title") %></h2>
        <p class="mt-1 text-sm font-semibold text-slate-500">Fondatore: <%= methodology.fetch("founder") %></p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <% if methodology.fetch("profession") %>
            <span class="rounded-full border border-red-200 bg-red-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-red-700">Professione</span>
          <% end %>
          <% if methodology.fetch("postural_methodology") %>
            <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-blue-700">Metodica posturale</span>
          <% end %>
          <% if methodology.fetch("healing_methodology") %>
            <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-emerald-700">Metodica per la guarigione</span>
          <% end %>
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= methodology.fetch("short_description") %></p>
        <% if methodology.fetch("website_url").present? %>
          <span class="mt-3 block text-xs font-bold text-slate-500">Sito: <%= methodology_website_host(methodology.fetch("website_url")) %></span>
        <% end %>
        <span class="mt-5 inline-flex text-sm font-bold text-blue-700">
          Apri metodica <span class="ml-1 transition group-hover:translate-x-1">→</span>
        </span>
      </a>
    <% end %>
  </section>
  <% else %>
    <section class="bg-slate-50">
      <div class="mx-auto max-w-7xl px-6 py-12 lg:py-16" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
        <div class="mb-8 lg:hidden">
          <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="metodiche-mobile-aside" aria-expanded="false">
            <span aria-hidden="true">☰</span>
            <span>Indice</span>
          </button>
        </div>
        <div class="lg:grid lg:grid-cols-12 lg:gap-12">
          <div class="fixed inset-0 z-40 hidden bg-slate-900/20 backdrop-blur-sm opacity-0 transition-opacity duration-300 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>

          <aside id="metodiche-mobile-aside" class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] -translate-x-full overflow-y-auto bg-white p-6 shadow-2xl transition-transform duration-300 ease-in-out lg:static lg:z-auto lg:block lg:col-span-3 lg:mb-0 lg:w-auto lg:max-w-none lg:translate-x-0 lg:overflow-visible lg:bg-transparent lg:p-0 lg:shadow-none lg:sticky lg:top-24 lg:self-start lg:border-r lg:border-slate-200 lg:pr-6" data-mobile-aside-target="panel" aria-hidden="true">
            <div class="mb-6 flex items-center justify-between lg:hidden">
              <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-950">Indice</span>
              <button type="button" class="rounded-md p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500" data-mobile-aside-target="close" data-action="mobile-aside#close">
                <span class="sr-only">Chiudi indice</span>
                <span aria-hidden="true">✕</span>
              </button>
            </div>
            <nav class="text-sm" aria-label="Indice Metodiche" data-action="click->mobile-aside#closeFromNavigation">
              <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-900">Come funziona</p>
              <ul class="space-y-2">
                <li><a href="#persone" class="block font-medium text-slate-600 transition hover:text-blue-600">Per le persone</a></li>
                <li><a href="#professionisti" class="block font-medium text-slate-600 transition hover:text-blue-600">Per i professionisti</a></li>
                <li><a href="#scuole" class="block font-medium text-slate-600 transition hover:text-blue-600">Per scuole e metodiche</a></li>
              </ul>
            </nav>
          </aside>

          <div class="lg:col-span-9">
            <div class="max-w-3xl space-y-12">
              <section class="border-b border-slate-200 pb-10">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-700">Orientarsi tra le metodiche</p>
                <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Conoscere i diversi approcci senza confonderli.</h1>
                <p class="mt-5 text-lg leading-8 text-slate-600">Professioni, metodiche posturali e approcci per la guarigione hanno linguaggi, strumenti e confini diversi. L'archivio serve a riconoscerli e a orientarsi con maggiore chiarezza.</p>
                <p class="mt-4 text-base leading-7 text-slate-600">PosturaCorretta non sostituisce la valutazione di un professionista: mette a disposizione informazioni per comprendere meglio le possibilità, fare domande più precise e scegliere il passo successivo con consapevolezza.</p>
              </section>

              <section id="persone" class="scroll-mt-24 border-b border-slate-200 pb-12">
                <h2 class="text-3xl font-semibold tracking-tight text-slate-950">Per le persone</h2>
                <p class="mt-3 text-lg font-semibold leading-7 text-slate-800">Trova parole e riferimenti per orientarti.</p>
                <p class="mt-4 text-base leading-7 text-slate-600">Puoi esplorare ogni voce per capire da dove nasce, che cosa osserva e quale tipo di professionista la utilizza. Questo non basta per stabilire che cosa sia adatto alla tua situazione, ma aiuta a preparare un confronto più consapevole.</p>
                <p class="mt-4 text-base leading-7 text-slate-600">Se hai un problema di salute, la diagnosi e le indicazioni terapeutiche restano di competenza dei professionisti abilitati.</p>
              </section>

              <section id="professionisti" class="scroll-mt-24 border-b border-slate-200 pb-12">
                <h2 class="text-3xl font-semibold tracking-tight text-slate-950">Per i professionisti</h2>
                <p class="mt-3 text-lg font-semibold leading-7 text-slate-800">Rendi più leggibile il tuo lavoro senza semplificarlo troppo.</p>
                <p class="mt-4 text-base leading-7 text-slate-600">Ogni scheda può aiutare a distinguere ruolo professionale, metodica, formazione e ambito di intervento. È un punto di partenza per spiegare con parole comprensibili ciò che fai, rispettando competenze, responsabilità e confini professionali.</p>
                <p class="mt-4 text-base leading-7 text-slate-600">Nel tempo l'archivio potrà collegare professionisti, contenuti e percorsi integrati; per ora invita a presentare la propria proposta in modo chiaro e verificabile.</p>
              </section>

              <section id="scuole" class="scroll-mt-24 pb-2">
                <h2 class="text-3xl font-semibold tracking-tight text-slate-950">Per scuole e metodiche</h2>
                <p class="mt-3 text-lg font-semibold leading-7 text-slate-800">Raccontare un metodo nel suo contesto.</p>
                <p class="mt-4 text-base leading-7 text-slate-600">Una metodica non è solo un nome: ha una storia, principi, un percorso formativo e un modo specifico di dialogare con le persone e con le altre competenze. La presentazione dovrebbe aiutare a comprenderne l'identità, senza attribuire promesse che non le appartengono.</p>
                <p class="mt-4 text-base leading-7 text-slate-600">Se rappresenti una scuola o vuoi segnalare una correzione, puoi contribuire a rendere le informazioni più chiare e aggiornate.</p>
                <a href="https://wa.me/393792891488?text=Ciao%2C%20vorrei%20segnalare%20o%20presentare%20una%20metodica%20nell%27archivio%20PosturaCorretta." target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">Segnala una metodica <span aria-hidden="true" class="ml-2">→</span></a>
              </section>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% end %>
</main>
