<%
  area_category_map = { "cura" => "dolore", "prevenzione" => "prevenzione", "movimento" => "attivita", "fisiologia" => "fisiologia", "benessere" => "benessere", "territorio" => "giardino" }
  filter_path = lambda do |filter_name, value|
    selected_values = params[filter_name].to_s.split(",").reject(&:blank?)
    selected_values.include?(value) ? selected_values.delete(value) : selected_values << value
    query = params.permit(:categoria, :tema, :ambito, :area, :paradigma, :professionista, :luogo, :metodica, :canale, :piattaforma, :zona, :livello).to_h
    selected_values.any? ? query[filter_name] = selected_values.join(",") : query.delete(filter_name)
    posturacorretta_contenuti_path(query)
  end
  filter_groups = [
    ["Ambito", "ambito", @content_taxonomy.fetch("ambiti", {}).map { |key, ambit| [key, ambit.fetch("label")] }, true],
    ["Aree della salute", "area", @content_taxonomy.fetch("aree", {}).map { |key, label| [key, label] }, true],
    ["Paradigmi", "paradigma", @content_taxonomy.fetch("paradigmi", {}).map { |key, label| [key, label] }, true],
    ["Metodiche", "metodica", @content_taxonomy.fetch("metodiche", {}).map { |key, label| [key, label] }, true],
    ["Canali", "canale", @content_taxonomy.fetch("canali", {}).map { |key, label| [key, label] }, true],
    ["Piattaforme", "piattaforma", @content_taxonomy.fetch("piattaforme", {}).map { |key, label| [key, label] }, true],
    ["Zone del corpo", "zona", @content_taxonomy.fetch("zone-corpo", {}).map { |key, label| [key, label] }, true],
    ["Livello di approfondimento", "livello", @content_taxonomy.fetch("livelli", {}).map { |key, label| [key, label] }, true],
    ["Professionisti", "professionista", @content_directory_people.map { |person| [person.metadata.fetch("content_creator_key", person.slug), person.name] }, true],
    ["Luoghi", "luogo", @content_directory_places.map { |place| [place.slug, [place.name, place.city].compact.join(" · ")] }, true]
  ]
%>
<aside id="contenuti-mobile-filtri" class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] -translate-x-full overflow-y-auto bg-white p-5 shadow-2xl transition-transform duration-300 ease-in-out lg:static lg:z-auto lg:block lg:w-auto lg:max-w-none lg:translate-x-0 lg:overflow-visible lg:bg-transparent lg:p-0 lg:shadow-none lg:self-stretch lg:border-r lg:border-slate-200 lg:pr-6" data-mobile-aside-target="panel" aria-label="Ricerca contenuti" aria-hidden="true">
  <div class="bg-white p-4 lg:p-0">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-blue-700">Ricerca</p>
        <h2 class="mt-1 text-sm font-black text-slate-950">Filtra i contenuti</h2>
      </div>
      <button type="button" class="rounded-md p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 lg:hidden" data-mobile-aside-target="close" data-action="mobile-aside#close" aria-label="Chiudi filtri">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" class="size-5"><path d="m5 5 10 10M15 5 5 15" stroke-linecap="round" stroke-width="1.8"/></svg>
      </button>
      <%= link_to "Azzera", posturacorretta_contenuti_path, class: "text-xs font-semibold text-blue-700 hover:text-blue-900" %>
    </div>

    <% filter_groups.each do |title, filter_name, options, search_first| %>
      <%= render "posturacorretta/content_filter_multiselect", title: title, filter_name: filter_name, options: options, filter_path: filter_path, search_first: search_first %>
    <% end %>
  </div>
</aside>
