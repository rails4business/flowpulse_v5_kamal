<% content_for :title, "Insegnanti PosturaCorretta" %>
<% content_for :description, "Conosci gli insegnanti che accompagnano il percorso educativo PosturaCorretta." %>
<% content_for :landing_nav do %><%= render "posturacorretta/header" %><% end %>

<main class="min-h-screen bg-slate-50 px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-screen-xl">
    <header class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[.18em] text-blue-700">Percorso educativo</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Insegnanti PosturaCorretta</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">Gli insegnanti guidano l’educazione al corpo e le lezioni del percorso. Le competenze professionali specifiche appartengono invece ai professionisti del Percorso Integrato.</p>
    </header>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <% @teachers.each do |teacher| %>
        <% modules = teacher.fetch("active_modules", []).filter_map { |slug| @academy_modules_by_slug[slug]&.fetch("title") } %>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-blue-300 hover:shadow-md sm:p-7">
          <div class="flex items-start gap-4">
            <img src="<%= teacher.fetch("img") %>" alt="" class="size-20 rounded-full border border-blue-100 bg-blue-600 object-cover">
            <div class="min-w-0">
              <p class="text-xs font-black uppercase tracking-[.14em] text-blue-700">@<%= teacher.fetch("username", teacher.fetch("slug")) %></p>
              <h2 class="mt-1 text-2xl font-black text-slate-950"><%= teacher.fetch("name") %></h2>
              <p class="mt-1 text-sm font-semibold text-slate-600"><%= teacher.fetch("role") %></p>
              <p class="mt-1 text-sm text-slate-500"><%= teacher.fetch("city") %> (<%= teacher.fetch("province") %>)</p>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-2">
            <% if teacher.dig("teaching", "levels")&.include?("base") %><span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-800">Lezioni base</span><% end %>
            <% if teacher.dig("teaching", "levels")&.include?("advanced") %><span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-bold text-violet-800">Lezioni avanzate</span><% end %>
            <% if teacher.dig("teaching", "online") %><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Online</span><% end %>
            <% if teacher.dig("teaching", "can_supervise_trainees") %><span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800">Supervisione tirocinio</span><% end %>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-5">
            <p class="text-xs font-black uppercase tracking-[.13em] text-slate-400">Corsi e moduli</p>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= modules.join(" · ") %></p>
          </div>
          <%= link_to "Apri profilo insegnante →", posturacorretta_insegnante_path(teacher.fetch("slug")), class: "mt-6 inline-flex text-sm font-bold text-blue-700 hover:text-blue-900 hover:underline" %>
        </article>
      <% end %>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
