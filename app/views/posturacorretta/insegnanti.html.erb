<% content_for :title, "Insegnanti PosturaCorretta" %>
<% content_for :description, "Conosci gli insegnanti che accompagnano il percorso educativo PosturaCorretta." %>
<% content_for :landing_nav do %><%= render "posturacorretta/header" %><% end %>

<main class="min-h-screen bg-white px-4 py-8 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-4xl">
    <%= render "posturacorretta/lessons_page_intro",
               active: :teachers,
               title: "Insegnanti PosturaCorretta",
               description: "Le persone che accompagnano le lezioni del percorso: in gruppo, individualmente e nel tirocinio." %>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <% @teachers.each do |teacher| %>
        <%= link_to posturacorretta_insegnante_path(teacher.fetch("slug")), class: "block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-blue-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:p-7" do %>
          <article>
            <div class="flex items-start gap-4">
              <img src="<%= teacher.fetch("img") %>" alt="Foto profilo di <%= teacher.fetch("name") %>" class="size-20 rounded-full border border-blue-100 bg-blue-600 object-cover">
              <div class="min-w-0">
                <p class="text-xs font-black uppercase tracking-[.14em] text-blue-700">@<%= teacher.fetch("username", teacher.fetch("slug")) %></p>
                <h2 class="mt-1 text-2xl font-black text-slate-950"><%= teacher.fetch("name") %></h2>
                <p class="mt-1 text-sm font-semibold text-slate-600"><%= teacher.fetch("role") %></p>
              </div>
            </div>
          </article>
        <% end %>
      <% end %>
    </div>
  </div>
</main>

<%= render "posturacorretta/footer" %>
