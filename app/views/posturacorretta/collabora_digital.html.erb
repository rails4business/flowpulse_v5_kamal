<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<div class="bg-slate-50 text-slate-900 antialiased min-h-screen">
  <!-- Hero Section -->
  <div class="bg-orange-600 pb-24 pt-16 sm:pb-32 sm:pt-24 lg:pb-32 lg:pt-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-base font-semibold leading-7 text-orange-200 uppercase tracking-widest">Bacheca Lavori</h2>
        <p class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-5xl font-['Cormorant_Garamond']">Task Digitali & Freelance</p>
        <p class="mt-6 text-lg leading-8 text-orange-100">
          Aiutaci a sviluppare PosturaCorretta. In questa pagina trovi i task tecnici, operativi e digitali a cui stiamo lavorando. Se hai le competenze giuste, candidati per prenderne in carico uno!
        </p>
      </div>
    </div>
  </div>

  <!-- Task List -->
  <div class="mx-auto max-w-5xl px-6 lg:px-8 -mt-16 sm:-mt-24 pb-24">
    <% if @freelance_tasks.any? %>
      <div class="grid grid-cols-1 gap-6">
        <% @freelance_tasks.each do |task| %>
          <div class="flex flex-col bg-white rounded-3xl shadow-xl ring-1 ring-gray-900/5 sm:flex-row p-6 sm:p-8 transition hover:shadow-2xl hover:-translate-y-1">
            
            <!-- Left Info -->
            <div class="flex-1 sm:pr-8">
              <div class="flex items-center gap-x-3 mb-3">
                <span class="inline-flex items-center rounded-full bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-700 ring-1 ring-inset ring-orange-600/10"><%= task[:type] || 'Sviluppo' %></span>
                <span class="text-sm font-medium text-gray-500">Progetto: <%= task[:project_name] %></span>
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-2 font-['Cormorant_Garamond']"><%= task[:title] %></h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6"><%= task[:notes] || task[:description] || 'Nessuna descrizione aggiuntiva fornita.' %></p>
              
              <div class="flex flex-wrap gap-4 text-sm">
                <!-- Budget -->
                <div class="flex items-center gap-2 font-medium <%= task[:budget].present? ? 'text-emerald-700' : 'text-gray-500' %>">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <%= task[:budget].present? ? "Budget: €#{task[:budget]}" : "Compenso da concordare" %>
                </div>

                <!-- Deadline -->
                <div class="flex items-center gap-2 font-medium <%= task[:deadline].present? ? 'text-red-700' : 'text-gray-500' %>">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <%= task[:deadline].present? ? "Scadenza: #{task[:deadline]}" : "Scadenza flessibile" %>
                </div>
              </div>
            </div>

            <!-- Right Actions -->
            <div class="mt-6 flex flex-col justify-center border-t border-gray-100 pt-6 sm:mt-0 sm:border-t-0 sm:border-l sm:pl-8 sm:pt-0 sm:w-64 shrink-0">
              <a href="https://wa.me/393792891488?text=<%= ERB::Util.url_encode("Ciao, vorrei candidarmi per il task '#{task[:title]}' (Progetto: #{task[:project_name]}).") %>" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-orange-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600 transition">
                Candidati ora
              </a>
              <p class="mt-4 text-xs text-center text-gray-500">Ti metteremo in contatto su WhatsApp con il responsabile del progetto.</p>
            </div>
            
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-3xl bg-white p-12 text-center shadow-xl ring-1 ring-gray-900/5">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
        <h3 class="mt-4 text-lg font-semibold text-gray-900">Nessun task aperto</h3>
        <p class="mt-2 text-sm text-gray-500">Attualmente non ci sono task in bacheca. Torna a controllare più tardi.</p>
        <div class="mt-6">
          <a href="<%= posturacorretta_collabora_path %>" class="text-sm font-semibold text-orange-600 hover:text-orange-500">
            <span aria-hidden="true">&larr;</span> Torna all'Hub
          </a>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render "posturacorretta/footer" %>
