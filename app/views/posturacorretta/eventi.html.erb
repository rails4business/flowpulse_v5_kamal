<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<% events_tab = params[:tab] == "how" ? "how" : "calendar" %>

<div id="top" class="bg-white text-slate-900 antialiased">

  <div class="border-b border-slate-200 bg-white pt-8">
    <div class="mx-auto max-w-7xl px-5 text-center">
      <nav class="-mb-px flex justify-center gap-1" aria-label="Sezioni Eventi">
        <%= link_to "📅 Calendario Eventi", posturacorretta_eventi_path(tab: "calendar"), class: "border-b-2 px-4 py-3 text-sm font-semibold transition #{events_tab == 'calendar' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-600 hover:text-slate-800'}", aria: { current: ("page" if events_tab == "calendar") } %>
        <%= link_to "📖 Come funziona?", posturacorretta_eventi_path(tab: "how"), class: "border-b-2 px-4 py-3 text-sm font-semibold transition #{events_tab == 'how' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-600 hover:text-slate-800'}", aria: { current: ("page" if events_tab == "how") } %>
      </nav>
    </div>
  </div>

  <div id="content-tab-calendario" class="<%= 'hidden ' if events_tab == 'how' %>bg-white pt-8" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
    <!-- EVENTI INTERACTIVE GRID SECTION -->
    <section class="px-5 pb-20">
    <div class="mx-auto grid w-full max-w-7xl gap-7 lg:grid-cols-[15rem_minmax(0,1fr)]">
      
      <!-- Filters aside -->
      <div class="fixed inset-0 z-40 hidden bg-slate-900/20 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>
      <aside id="eventi-filtri-mobile-aside" class="fixed inset-y-0 left-0 z-50 w-80 max-w-[88vw] -translate-x-full overflow-y-auto border-r border-slate-200 bg-white p-6 shadow-2xl transition-transform duration-300 ease-in-out lg:sticky lg:top-24 lg:z-auto lg:block lg:w-auto lg:max-w-none lg:translate-x-0 lg:self-start lg:overflow-visible lg:border-r lg:border-slate-200 lg:bg-transparent lg:p-0 lg:pr-6 lg:shadow-none" data-mobile-aside-target="panel" aria-label="Filtra eventi" aria-hidden="true">
        <div class="mb-6 flex items-center justify-between lg:hidden">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-950">Filtra eventi</span>
          <button type="button" class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-mobile-aside-target="close" data-action="mobile-aside#close" aria-label="Chiudi filtri">✕</button>
        </div>
        <div class="flex items-center justify-between gap-3">
          <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-blue-700">Ricerca</p><h2 class="mt-1 text-sm font-black text-slate-950">Filtra gli eventi</h2></div>
          <button type="button" onclick="resetEventFilters()" class="text-xs font-semibold text-blue-700 hover:text-blue-900">Azzera</button>
        </div>
      <div class="mt-5 flex flex-col gap-4 border-t border-slate-100 pt-4">
        
        <div class="flex flex-col gap-3">
          <!-- Temporal Dropdown -->
          <div class="relative w-full sm:w-auto" id="temporal-select-container">
            <select id="temporal-select" onchange="switchTemporalTab(this.value)" class="w-full sm:w-auto appearance-none rounded-xl border border-slate-200 bg-white py-2 pl-4 pr-8 text-xs font-bold text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100 cursor-pointer">
              <option value="future">Prossimi</option>
              <option value="past">Passati</option>
            </select>
            <span class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-slate-400 text-xs">▼</span>
          </div>

          <div class="relative w-full sm:w-auto" id="event-status-select-container">
            <select id="event-status-select" onchange="switchEventStatus(this.value)" class="w-full sm:w-auto appearance-none rounded-xl border border-slate-200 bg-white py-2 pl-4 pr-8 text-xs font-bold text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100 cursor-pointer">
              <option value="all">Stato evento</option>
              <option value="organizing">In organizzazione</option>
              <option value="proposed">Proposti al pubblico</option>
              <option value="confirmed">Confermati</option>
              <option value="cancelled">Annullati</option>
            </select>
            <span class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-slate-400 text-xs">▼</span>
          </div>

          <div class="relative w-full sm:w-auto" id="participation-select-container">
            <select id="participation-select" onchange="switchParticipation(this.value)" class="w-full sm:w-auto appearance-none rounded-xl border border-slate-200 bg-white py-2 pl-4 pr-8 text-xs font-bold text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100 cursor-pointer">
              <option value="all">Partecipazione</option>
              <option value="open">Iscrizioni aperte</option>
              <option value="free_access">Accesso libero</option>
              <option value="full">Completi</option>
              <option value="closed">Iscrizioni chiuse</option>
            </select>
            <span class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-slate-400 text-xs">▼</span>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <!-- Date Filter -->
          <div class="flex items-center gap-2 w-full sm:w-auto" id="date-filter-container">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 whitespace-nowrap" id="filter-date-label">Dal:</span>
            <input type="date" id="event-date-filter" class="w-full sm:w-auto rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
            <button type="button" onclick="clearDateFilter()" class="text-xs font-bold text-slate-400 hover:text-slate-600" title="Azzera data">✕</button>
          </div>

          <!-- Search Bar -->
          <div class="relative w-full sm:w-64">
            <span class="absolute inset-y-0 left-3.5 flex items-center text-slate-400 select-none pointer-events-none text-sm">🔍</span>
            <input type="text" id="event-search-input" oninput="renderEvents()" placeholder="Cerca eventi..." class="w-full rounded-xl border border-slate-200 bg-white py-2 pl-9 pr-4 text-xs text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
          </div>
        </div>

        <div class="border-t border-slate-100 pt-5">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Filtri completi</p>
          <div class="mt-3 space-y-3">
            <% { "ambito" => ["Ambito", "ambiti"], "area" => ["Aree della salute", "aree"], "paradigma" => ["Paradigmi", "paradigmi"] }.each do |filter_key, (label, taxonomy_key)| %>
              <% options = @event_filter_taxonomy.fetch(taxonomy_key, {}) %>
              <label class="block">
                <span class="mb-1.5 block text-xs font-semibold text-slate-700"><%= label %></span>
                <select id="event-<%= filter_key %>-select" onchange="switchEventClassification('<%= filter_key %>', this.value)" class="w-full appearance-none rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
                  <option value="">Tutti</option>
                  <% options.each do |key, value| %>
                    <% option_label = value.is_a?(Hash) ? value["label"] : value %>
                    <option value="<%= key %>"><%= option_label %></option>
                  <% end %>
                </select>
              </label>
            <% end %>

            <label class="block">
              <span class="mb-1.5 block text-xs font-semibold text-slate-700">Conduttori</span>
              <select id="event-conductor-select" onchange="switchEventClassification('conductor', this.value)" class="w-full appearance-none rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
                <option value="">Tutti</option>
                <% @events.flat_map { |event| event.fetch("teachers", []) }.reject { |teacher| teacher == "?" }.uniq.sort.each do |teacher| %>
                  <option value="<%= teacher %>"><%= teacher %></option>
                <% end %>
              </select>
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-semibold text-slate-700">Luoghi</span>
              <select id="event-place-select" onchange="switchEventClassification('place', this.value)" class="w-full appearance-none rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100">
                <option value="">Tutti</option>
                <% @events.group_by { |event| event["locationKey"] }.each do |location_key, location_events| %>
                  <% next if location_key.blank? %>
                  <option value="<%= location_key %>"><%= location_events.first["location"] %></option>
                <% end %>
              </select>
            </label>
          </div>
        </div>
      </div>
      </aside>

      <div class="min-w-0">

      <button type="button" class="mb-6 inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 lg:hidden" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="eventi-filtri-mobile-aside" aria-expanded="false">
        <span aria-hidden="true">☰</span> Filtri eventi
      </button>

      <!-- Active Filters Bar -->
      <div id="active-filters-bar" class="hidden flex-wrap items-center gap-2 mb-6 -mt-2">
        <span class="text-xs text-slate-500 font-bold uppercase tracking-wider">Filtri attivi:</span>
        <span id="filter-tag" class="inline-flex items-center gap-1.5 rounded-xl border border-violet-200 bg-violet-50 px-3 py-1.5 text-xs font-bold text-violet-700 shadow-sm">
          <span id="filter-tag-text">📍 Clusone</span>
          <button type="button" onclick="clearFilters()" class="select-none text-sm font-black text-violet-500 hover:text-violet-800 focus:outline-none">×</button>
        </span>
      </div>

      <!-- Events Grid -->
      <div id="events-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 transition-opacity duration-200">
        <!-- Cards dynamically inserted here -->
      </div>

      <!-- Empty State -->
      <div id="events-empty" class="hidden rounded-lg border border-dashed border-slate-300 bg-white py-16 text-center">
        <span class="text-3xl">📅</span>
        <p class="mt-4 font-bold text-slate-900 text-lg">Nessun evento trovato</p>
        <p class="mt-2 text-sm text-slate-500">Prova a cambiare il filtro della data o passa alla scheda degli eventi passati.</p>
      </div>

      <!-- General CTA Buttons -->
      <div class="mt-16 text-center">
        <p class="text-sm text-slate-500 mb-6">Vuoi proporre un evento o capire come integrarlo nel tuo percorso?</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://wa.me/393792891488?text=Ciao%2C%20vorrei%20saperne%20di%20pi%C3%B9%20sugli%20eventi%20PosturaCorretta%20o%20proporre%20un%27idea."
             target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-8 py-4 text-base font-semibold text-white shadow-sm transition hover:bg-blue-700 active:scale-[0.98]">
            Proponi un evento →
          </a>
          <%= link_to "Come funzionano gli eventi? →", posturacorretta_eventi_path(tab: "how"), class: "inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-8 py-4 text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.98]" %>
        </div>
      </div>

      </div>

    </div>
  </section>
  </div> <!-- Fine content-tab-calendario -->

  <!-- TAB FUNZIONAMENTO -->
  <div id="content-tab-funzionamento" class="<%= 'hidden ' unless events_tab == 'how' %>bg-slate-50" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
    <section class="mx-auto max-w-7xl px-5 py-12 lg:py-16">
      <div class="lg:grid lg:grid-cols-12 lg:gap-12">
        
        <!-- MOBILE BACKDROP -->
        <div class="fixed inset-0 z-40 hidden bg-slate-900/20 backdrop-blur-sm opacity-0 transition-opacity duration-300 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>
        
        <!-- ASIDE -->
        <aside id="eventi-mobile-aside" class="side fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] transform -translate-x-full overflow-y-auto bg-white p-6 shadow-2xl transition-transform duration-300 ease-in-out lg:static lg:z-auto lg:block lg:col-span-3 lg:w-auto lg:max-w-none lg:translate-x-0 lg:overflow-visible lg:bg-transparent lg:p-0 lg:shadow-none lg:border-r lg:border-slate-200 lg:pr-6 lg:sticky lg:top-24 lg:self-start" data-mobile-aside-target="panel" aria-hidden="true">
          <div class="mb-6 flex items-center justify-between lg:hidden">
            <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-950">Indice</span>
            <button type="button" class="rounded-md p-2 text-slate-400 hover:bg-slate-100 focus:outline-none" data-mobile-aside-target="close" data-action="mobile-aside#close">
              ✕
            </button>
          </div>
          
          <nav class="space-y-6 text-sm" aria-label="Indice Eventi" data-action="click->mobile-aside#closeFromNavigation">
            <div>
              <p class="mb-3 text-[10px] font-bold uppercase tracking-wider text-slate-900">Come funziona</p>
              <ul class="space-y-2">
                <li><a href="#partecipanti" data-events-aside-link class="block font-medium text-slate-600 transition hover:text-blue-600">Per chi partecipa</a></li>
                <li><a href="#conduttori" data-events-aside-link class="block font-medium text-slate-600 transition hover:text-blue-600">Per conduttori e professionisti</a></li>
                <li><a href="#location" data-events-aside-link class="block font-medium text-slate-600 transition hover:text-blue-600">Per location e associazioni</a></li>
              </ul>
            </div>
          </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="lg:col-span-9">
          
          <!-- Mobile toggle button -->
          <button class="button-utility mb-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-600 shadow-sm transition hover:bg-slate-50 lg:hidden" type="button" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="eventi-mobile-aside" aria-expanded="false">
            ☰ <span>Indice argomenti</span>
          </button>
          
          <div class="max-w-3xl space-y-12">
            <section class="border-b border-slate-200 pb-10">
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-700">Esperienze PosturaCorretta</p>
              <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Esperienze per conoscere il corpo e incontrare il territorio.</h1>
              <p class="mt-5 text-lg leading-8 text-slate-600">L'intento degli eventi è unire attività dedicate alla consapevolezza e alla conoscenza della fisiologia con esperienze che aiutano a scoprire di più sull'essere umano, sulla natura e sul territorio.</p>
              <p class="mt-4 text-base leading-7 text-slate-600">Una pratica corporea può affiancarsi a una camminata, un incontro divulgativo, un laboratorio, un'attività espressiva o un'esperienza in un luogo significativo. Non esiste un formato unico: ogni proposta chiarisce cosa offre e a chi si rivolge.</p>
              <p class="mt-5 text-base leading-7 text-slate-600"><%= link_to "Scopri la visione di PosturaCorretta", posturacorretta_visione_path, class: "font-semibold text-blue-700 underline decoration-blue-200 underline-offset-4 transition hover:text-blue-800 hover:decoration-blue-500" %>.</p>
            </section>

            <section id="partecipanti" class="scroll-mt-24 border-b border-slate-200 pb-12">
              <h2 class="text-3xl font-semibold tracking-tight text-slate-950">Partecipa a un evento</h2>
              <p class="mt-3 text-lg font-semibold leading-7 text-slate-800">Vivi un'esperienza, non una semplice lezione.</p>
              <p class="mt-4 text-base leading-7 text-slate-600">Gli eventi sono aperti a chi desidera esplorare il movimento, la consapevolezza del corpo e la relazione con l'ambiente attraverso attività guidate e condivise.</p>
              <p class="mt-4 text-base leading-7 text-slate-600">Ogni proposta indica con chiarezza programma, luogo, durata, modalità di partecipazione e informazioni utili per prepararsi.</p>
            </section>

            <section id="conduttori" class="scroll-mt-24 border-b border-slate-200 pb-12">
              <h2 class="text-3xl font-semibold tracking-tight text-slate-950">Conduci o proponi un'attività</h2>
              <p class="mt-3 text-lg font-semibold leading-7 text-slate-800">Metti la tua competenza al servizio di un'esperienza condivisa.</p>
              <p class="mt-4 text-base leading-7 text-slate-600">Professionisti, insegnanti e conduttori possono proporre attività coerenti con il proprio ruolo: pratica corporea, approfondimento, laboratorio, incontro divulgativo o esperienza in natura.</p>
              <p class="mt-4 text-base leading-7 text-slate-600">La proposta viene costruita chiarendo obiettivo, destinatari, confini professionali, luogo, tempi e ciò che serve per partecipare.</p>
              <a href="https://wa.me/393792891488?text=Ciao%2C%20vorrei%20proporre%20o%20condurre%20un%27attivit%C3%A0%20in%20un%20evento%20PosturaCorretta." target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">Proponi un'attività <span aria-hidden="true" class="ml-2">→</span></a>
            </section>

            <section id="location" class="scroll-mt-24 pb-2">
              <h2 class="text-3xl font-semibold tracking-tight text-slate-950">Ospita un evento nel tuo luogo</h2>
              <p class="mt-3 text-lg font-semibold leading-7 text-slate-800">Centri, associazioni e location diventano parte dell'esperienza.</p>
              <p class="mt-4 text-base leading-7 text-slate-600">Scegliamo con cura i luoghi in cui svolgere gli eventi. Prediligiamo ambienti che favoriscono la riconnessione con ritmi, spazio e relazioni.</p>
              <ul class="mt-5 space-y-3 text-base leading-7 text-slate-600">
                <li class="flex gap-3"><span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span><span><strong class="font-semibold text-slate-900">Spazi ampi e luminosi:</strong> per permettere al corpo di muoversi liberamente.</span></li>
                <li class="flex gap-3"><span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span><span><strong class="font-semibold text-slate-900">Natura e territorio:</strong> parchi, agriturismi o luoghi che aggiungono valore all'esperienza.</span></li>
                <li class="flex gap-3"><span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span><span><strong class="font-semibold text-slate-900">Accoglienza:</strong> realtà disponibili a costruire un'attività utile per le persone e per il territorio.</span></li>
              </ul>
              <a href="https://wa.me/393792891488?text=Ciao%2C%20vorrei%20proporre%20la%20mia%20location%20per%20un%20evento%20PosturaCorretta." target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center justify-center rounded-lg border border-blue-200 bg-white px-5 py-3 text-sm font-semibold text-blue-700 shadow-sm transition hover:border-blue-300 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">Proponi una location <span aria-hidden="true" class="ml-2">→</span></a>
            </section>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- MODALE DETTAGLI EVENTO -->
  <div id="event-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative flex max-h-[90vh] w-full max-w-2xl scale-95 flex-col rounded-lg border border-slate-100 bg-white p-6 opacity-0 shadow-2xl transition-all duration-300 md:p-8" id="event-modal-card">
      
      <!-- Close icon -->
      <button type="button" onclick="closeEventModal()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600 text-2xl font-bold focus:outline-none transition">
        ✕
      </button>

      <!-- Modal Content Body -->
      <div class="overflow-y-auto pr-1 flex-1 scrollbar-thin">
        <div class="flex flex-col gap-6" id="event-modal-content">
          <!-- Dynamically inserted details -->
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="mt-6 border-t border-slate-100 pt-6 flex flex-col sm:flex-row gap-3">
        <a id="event-modal-register-btn" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex flex-1 items-center justify-center rounded-xl bg-blue-600 px-6 py-3.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700 active:scale-[0.98]">
          Iscriviti ora su WhatsApp →
        </a>
        <button type="button" onclick="closeEventModal()" class="rounded-xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
          Chiudi
        </button>
      </div>

    </div>
  </div>



  <%= render "posturacorretta/footer" %>
</div>

<script>
(() => {
  const events = <%= raw @events.to_json %>;
  const places = <%= raw @places.to_json %>;
  const teachers = <%= raw @teachers.to_json %>;

  let currentMacroTab = "events"; // 'events', 'places', 'teachers'
  let currentTemporalTab = "future"; // 'future', 'past'
  let currentEventStatus = "all";
  let currentParticipation = "all";
  let selectedLocation = null; // { key, name }
  let selectedTeacher = null; // string
  const classificationFilters = { ambito: "", area: "", paradigma: "", conductor: "", place: "" };

  // Helper count logic
  const getEventCountForPlace = (key) => events.filter(e => e.locationKey === key).length;
  const getEventCountForTeacher = (name) => events.filter(e => e.teachers.includes(name)).length;

  function renderEvents() {
    const grid = document.getElementById("events-grid");
    const emptyState = document.getElementById("events-empty");
    const dateFilter = document.getElementById("event-date-filter").value;
    const query = document.getElementById("event-search-input").value.trim().toLowerCase();

    // Toggle active filters bar visibility
    const filterBar = document.getElementById("active-filters-bar");
    const filterTagText = document.getElementById("filter-tag-text");
    if ((selectedLocation || selectedTeacher) && currentMacroTab === "events") {
      filterBar.classList.remove("hidden");
      filterBar.classList.add("flex");
      if (selectedLocation) {
        filterTagText.innerHTML = `📍 Luogo: <strong>${selectedLocation.name}</strong>`;
      } else {
        filterTagText.innerHTML = `👤 Professionista: <strong>${selectedTeacher}</strong>`;
      }
    } else {
      filterBar.classList.add("hidden");
      filterBar.classList.remove("flex");
    }

    // 1. PLACES RENDERING
    if (currentMacroTab === "places") {
      const filteredPlaces = places.filter(p => {
        if (!query) return true;
        return p.name.toLowerCase().includes(query) || p.description.toLowerCase().includes(query);
      });

      if (filteredPlaces.length === 0) {
        grid.classList.add("hidden");
        emptyState.classList.remove("hidden");
      } else {
        emptyState.classList.add("hidden");
        grid.classList.remove("hidden");

        grid.innerHTML = filteredPlaces.map(p => {
          const count = getEventCountForPlace(p.key);
          return `
            <button type="button" onclick="filterByLocation('${p.key}', '${p.name}')" class="group relative aspect-[16/11] w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 text-left shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 hover:shadow-xl hover:shadow-blue-900/10 sm:aspect-[5/4] lg:aspect-[4/5] focus:outline-none focus:ring-4 focus:ring-blue-500/30">
              <img src="${p.image}" alt="${p.name}" class="absolute inset-0 h-full w-full object-cover object-center opacity-100 transition duration-500" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/35 to-transparent"></div>
              
              <!-- Event Count Badge -->
              <div class="absolute left-4 top-4 z-10 rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-sm">
                ${count} ${count === 1 ? 'Evento' : 'Eventi'}
              </div>

              <!-- Bottom Text Overlay -->
              <div class="absolute inset-x-0 bottom-0 z-10 flex flex-col p-5 md:p-6">
                <span class="text-[10px] font-black uppercase tracking-wider text-blue-300">📍 Località</span>
                <h3 class="mt-1 text-lg font-black text-white leading-snug group-hover:text-blue-200 transition">
                  ${p.name}
                </h3>
                <p class="mt-1.5 text-xs text-slate-300 line-clamp-2 leading-relaxed">
                  ${p.description}
                </p>
              </div>
            </button>
          `;
        }).join("");
      }
      return;
    }

    // 2. TEACHERS RENDERING
    if (currentMacroTab === "teachers") {
      const filteredTeachers = teachers.filter(t => {
        if (!query) return true;
        return t.name.toLowerCase().includes(query) || t.role.toLowerCase().includes(query) || t.description.toLowerCase().includes(query);
      });

      if (filteredTeachers.length === 0) {
        grid.classList.add("hidden");
        emptyState.classList.remove("hidden");
      } else {
        emptyState.classList.add("hidden");
        grid.classList.remove("hidden");

        grid.innerHTML = filteredTeachers.map(t => {
          const count = getEventCountForTeacher(t.name);
          return `
            <button type="button" onclick="filterByTeacher('${t.name}')" class="group relative aspect-[16/11] w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 text-left shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 hover:shadow-xl hover:shadow-blue-900/10 sm:aspect-[5/4] lg:aspect-[4/5] focus:outline-none focus:ring-4 focus:ring-blue-500/30">
              <img src="${t.image}" alt="${t.name}" class="absolute inset-0 h-full w-full object-cover object-center opacity-100 transition duration-500" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
              
              <!-- Event Count Badge -->
              <div class="absolute left-4 top-4 z-10 rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-sm">
                Presenza in ${count} ${count === 1 ? 'evento' : 'eventi'}
              </div>

              <!-- Bottom Text Overlay -->
              <div class="absolute inset-x-0 bottom-0 z-10 flex flex-col p-5 md:p-6">
                <span class="text-[10px] font-black uppercase tracking-wider text-blue-300">${t.role}</span>
                <h3 class="mt-1 text-lg font-black text-white leading-snug group-hover:text-blue-200 transition">
                  ${t.name}
                </h3>
                <p class="mt-1.5 text-xs text-slate-300 line-clamp-2 leading-relaxed">
                  ${t.description}
                </p>
              </div>
            </button>
          `;
        }).join("");
      }
      return;
    }

    // 3. EVENTS RENDERING
    const now = new Date();
    const todayKey = [now.getFullYear(), String(now.getMonth() + 1).padStart(2, "0"), String(now.getDate()).padStart(2, "0")].join("-");
    const filteredEvents = events.filter(e => {
      // Temporal Tab Filter
      const temporalTab = e.date >= todayKey ? "future" : "past";
      if (temporalTab !== currentTemporalTab) return false;

      const eventStatus = e.event_status || e.status || "confirmed";
      const registrationMode = e.registration_mode || "required";
      const registrationStatus = e.registration_status || "open";
      const isFull = registrationStatus === "full" || (Number.isFinite(Number(e.capacity)) && Number(e.participants_count || 0) >= Number(e.capacity));
      if (currentTemporalTab === "future" && currentEventStatus !== "all" && eventStatus !== currentEventStatus) return false;
      if (currentTemporalTab === "future" && currentParticipation !== "all") {
        if (currentParticipation === "free_access" && registrationMode !== "none") return false;
        if (currentParticipation === "open" && (registrationMode !== "required" || registrationStatus !== "open" || isFull)) return false;
        if (currentParticipation === "full" && !isFull) return false;
        if (currentParticipation === "closed" && (registrationMode !== "required" || registrationStatus !== "closed")) return false;
      }

      // Date Picker Filter
      if (dateFilter) {
        if (currentTemporalTab === "future") {
          if (e.date < dateFilter) return false;
        } else {
          if (e.date > dateFilter) return false;
        }
      }

      // Location filter
      if (selectedLocation && e.locationKey !== selectedLocation.key) return false;

      // Teacher filter
      if (selectedTeacher && !e.teachers.includes(selectedTeacher)) return false;

      // Filtri di classificazione
      if (classificationFilters.ambito && !(e.ambiti || []).includes(classificationFilters.ambito)) return false;
      if (classificationFilters.area && !(e.aree || []).includes(classificationFilters.area)) return false;
      if (classificationFilters.paradigma && !(e.paradigmi || []).includes(classificationFilters.paradigma)) return false;
      if (classificationFilters.conductor && !(e.teachers || []).includes(classificationFilters.conductor)) return false;
      if (classificationFilters.place && e.locationKey !== classificationFilters.place) return false;

      // Search Query filter
      if (query) {
        const matchesTitle = e.title.toLowerCase().includes(query);
        const matchesDesc = e.description.toLowerCase().includes(query);
        const matchesLoc = e.location.toLowerCase().includes(query);
        const matchesTeachers = e.teachers.some(t => t.toLowerCase().includes(query));
        if (!matchesTitle && !matchesDesc && !matchesLoc && !matchesTeachers) return false;
      }

      return true;
    });

    if (filteredEvents.length === 0) {
      grid.classList.add("hidden");
      emptyState.classList.remove("hidden");
    } else {
      emptyState.classList.add("hidden");
      grid.classList.remove("hidden");

      grid.innerHTML = filteredEvents.map(e => {
        const eventStatus = e.event_status || e.status || "confirmed";
        const statusLabel = { organizing: "In organizzazione", proposed: "Proposto al pubblico", confirmed: "Confermato", cancelled: "Annullato" }[eventStatus] || eventStatus;
        return `
        <button type="button" onclick="openEventModal(${e.id})" aria-label="Apri l'evento ${e.title}" class="group relative aspect-[16/11] w-full cursor-pointer overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 text-left shadow-sm transition-[transform,border-color,box-shadow] duration-500 ease-out hover:-translate-y-1.5 hover:border-blue-500 hover:shadow-xl hover:shadow-blue-900/15 active:scale-[0.985] sm:aspect-[5/4] lg:aspect-[4/5] focus:outline-none focus:ring-4 focus:ring-blue-500/30">
          <img src="${e.image}" alt="${e.title}" class="absolute inset-0 h-full w-full object-cover object-center opacity-100 transition-transform duration-700 ease-out group-hover:scale-110" loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/35 to-transparent transition-colors duration-500 group-hover:from-slate-950/95 group-hover:via-slate-950/45"></div>
          
          <!-- Top date badge overlay -->
          <div class="absolute left-4 top-4 z-10 rounded-xl bg-white/90 px-3.5 py-2 text-xs font-bold text-slate-800 shadow-sm backdrop-blur-md">
            <span class="block">${e.formattedDate}</span>
            <span class="mt-0.5 block text-[11px] font-semibold text-blue-700">Ore ${e.time}</span>
          </div>
          <span class="absolute left-4 top-[4.8rem] z-10 rounded-full bg-blue-600/90 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-white backdrop-blur-sm">${statusLabel}</span>

          <!-- Top hover helper overlay -->
          <div class="absolute right-4 top-4 z-10 flex translate-y-1 items-center gap-1.5 rounded-xl bg-white/25 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white opacity-0 backdrop-blur-md transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
            Scopri <span class="text-sm leading-none transition-transform duration-300 group-hover:translate-x-0.5">→</span>
          </div>

          <!-- Bottom Text Overlay -->
          <div class="absolute inset-x-0 bottom-0 z-10 flex translate-y-1 flex-col p-5 transition-transform duration-500 ease-out group-hover:translate-y-0 md:p-6">
            <span onclick="event.stopPropagation(); filterByLocation('${e.locationKey}', '${e.location}')" class="text-[10px] font-black uppercase tracking-wider text-blue-300 hover:text-blue-200 cursor-pointer transition select-none self-start">
              📍 ${e.location}
            </span>
            <h3 class="mt-1.5 text-lg font-black leading-snug text-white transition-colors duration-300 group-hover:text-blue-200 line-clamp-2">
              ${e.title}
            </h3>
            <p class="mt-2 text-xs text-slate-300 line-clamp-3 leading-relaxed">
              ${e.description}
            </p>
          </div>
        </button>
        `;
      }).join("");
    }
  }

  window.renderEvents = renderEvents;

  window.openEventModal = function(id) {
    const event = events.find(e => e.id === id);
    if (!event) return;
    const modal = document.getElementById("event-modal");
    const card = document.getElementById("event-modal-card");
    const content = document.getElementById("event-modal-content");
    const registerBtn = document.getElementById("event-modal-register-btn");

    content.innerHTML = `
      <div class="grid gap-6 md:grid-cols-[160px_1fr]">
        <div class="hidden aspect-[4/3] w-full cursor-pointer overflow-hidden rounded-xl bg-slate-100 shadow-sm md:block" onclick="filterByLocation('${event.locationKey}', '${event.location}')" title="Filtra per questo luogo">
          <img src="${event.image}" alt="${event.title}" class="h-full w-full object-cover hover:scale-[1.02] transition duration-300">
        </div>
        <div>
          <button type="button" onclick="event.stopPropagation(); filterByLocation('${event.locationKey}', '${event.location}')" class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-blue-700 transition hover:bg-blue-200" title="Filtra per questo luogo">
            📍 ${event.location}
          </button>
          <h2 class="mt-2.5 text-2xl font-black leading-snug text-slate-950">${event.title}</h2>
          <div class="flex items-center gap-2 mt-3 text-xs text-slate-500 font-semibold">
            <span>📅 Data e ora:</span>
            <span class="text-slate-800 font-bold">${event.formattedDate} · ore ${event.time}</span>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="border-t border-slate-100 pt-5">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Descrizione</h4>
        <p class="text-sm leading-relaxed text-slate-655">${event.description}</p>
      </div>

      <!-- Teachers -->
      <div class="border-t border-slate-100 pt-5">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">Insegnanti e Conduttori presenti</h4>
        <div class="flex flex-wrap gap-2">
          ${event.teachers.map(teacher => `
            <button type="button" onclick="event.stopPropagation(); filterByTeacher('${teacher}')" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 hover:bg-slate-200 border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition" title="Filtra eventi con questo professionista">
              👤 ${teacher}
            </button>
          `).join("")}
        </div>
      </div>

      <!-- Detailed Program -->
      <div class="border-t border-slate-100 pt-5">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Programma della giornata</h4>
        <ul class="space-y-3">
          ${event.program.map(step => {
            const parts = step.split(" — ");
            if (parts.length === 2) {
              return `
                <li class="flex items-start gap-3 text-sm">
                  <span class="font-bold text-blue-700 whitespace-nowrap bg-blue-50 rounded-lg px-2.5 py-1 text-xs mt-0.5 border border-blue-100/50">${parts[0]}</span>
                  <span class="text-slate-600 mt-1 leading-normal">${parts[1]}</span>
                </li>
              `;
            } else {
              return `
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="text-blue-700 mt-1">•</span>
                  <span class="leading-normal">${step}</span>
                </li>
              `;
            }
          }).join("")}
        </ul>
      </div>
    `;

    registerBtn.href = `https://wa.me/393792891488?text=${encodeURIComponent(event.waText)}`;

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    setTimeout(() => {
      card.classList.remove("scale-95", "opacity-0");
      card.classList.add("scale-100", "opacity-100");
    }, 10);
  };

  window.closeEventModal = function() {
    const modal = document.getElementById("event-modal");
    const card = document.getElementById("event-modal-card");

    card.classList.remove("scale-100", "opacity-100");
    card.classList.add("scale-95", "opacity-0");
    
    setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    }, 300);
  };

  window.filterByLocation = function(key, name) {
    selectedLocation = { key, name };
    selectedTeacher = null;
    closeEventModal();
    switchMacroTab("events");
  };

  window.filterByTeacher = function(name) {
    selectedTeacher = name;
    selectedLocation = null;
    closeEventModal();
    switchMacroTab("events");
  };

  window.clearFilters = function() {
    selectedLocation = null;
    selectedTeacher = null;
    renderEvents();
  };

  window.switchEventClassification = function(filter, value) {
    classificationFilters[filter] = value;
    renderEvents();
  };

  window.resetEventFilters = function() {
    currentTemporalTab = "future";
    currentEventStatus = "all";
    currentParticipation = "all";
    selectedLocation = null;
    selectedTeacher = null;
    Object.keys(classificationFilters).forEach((filter) => { classificationFilters[filter] = ""; });

    [
      ["temporal-select", "future"],
      ["event-status-select", "all"],
      ["participation-select", "all"],
      ["event-ambito-select", ""],
      ["event-area-select", ""],
      ["event-paradigma-select", ""],
      ["event-conductor-select", ""],
      ["event-place-select", ""]
    ].forEach(([id, value]) => {
      const input = document.getElementById(id);
      if (input) input.value = value;
    });

    const dateInput = document.getElementById("event-date-filter");
    const searchInput = document.getElementById("event-search-input");
    if (dateInput) dateInput.value = "";
    if (searchInput) searchInput.value = "";
    switchTemporalTab("future");
  };

  window.switchMacroTab = function(tab) {
    currentMacroTab = tab;

    const select = document.getElementById("macro-select");
    if (select && select.value !== tab) {
      select.value = tab;
    }

    const temporalContainer = document.getElementById("temporal-select-container");
    const eventStatusContainer = document.getElementById("event-status-select-container");
    const participationContainer = document.getElementById("participation-select-container");
    const dateContainer = document.getElementById("date-filter-container");
    const searchInput = document.getElementById("event-search-input");
    
    if (tab === "events") {
      temporalContainer.classList.remove("hidden");
      dateContainer.classList.remove("hidden");
      dateContainer.classList.add("flex");
      searchInput.placeholder = "Cerca eventi...";
    } else {
      temporalContainer.classList.add("hidden");
      dateContainer.classList.add("hidden");
      dateContainer.classList.remove("flex");
      if (tab === "places") {
        searchInput.placeholder = "Cerca luoghi...";
      } else {
        searchInput.placeholder = "Cerca Conduttori...";
      }
    }

    eventStatusContainer.classList.toggle("hidden", tab !== "events" || currentTemporalTab !== "future");
    participationContainer.classList.toggle("hidden", tab !== "events" || currentTemporalTab !== "future");

    const grid = document.getElementById("events-grid");
    grid.style.opacity = 0;
    setTimeout(() => {
      renderEvents();
      grid.style.opacity = 1;
    }, 150);
  };

  window.switchTemporalTab = function(tab) {
    currentTemporalTab = tab;

    const select = document.getElementById("temporal-select");
    if (select && select.value !== tab) {
      select.value = tab;
    }

    const dateLabel = document.getElementById("filter-date-label");
    const eventStatusContainer = document.getElementById("event-status-select-container");
    const participationContainer = document.getElementById("participation-select-container");
    if (tab === "future") {
      dateLabel.textContent = "Dal:";
    } else {
      dateLabel.textContent = "Fino al:";
    }
    eventStatusContainer.classList.toggle("hidden", currentMacroTab !== "events" || tab !== "future");
    participationContainer.classList.toggle("hidden", currentMacroTab !== "events" || tab !== "future");

    // Trigger render
    const grid = document.getElementById("events-grid");
    grid.style.opacity = 0;
    setTimeout(() => {
      renderEvents();
      grid.style.opacity = 1;
    }, 150);
  };

  window.switchEventStatus = function(status) {
    currentEventStatus = status;
    renderEvents();
  };

  window.switchParticipation = function(participation) {
    currentParticipation = participation;
    renderEvents();
  };

  window.clearDateFilter = function() {
    document.getElementById("event-date-filter").value = "";
    renderEvents();
  };

  function initializeEventsPage() {
    const dateFilter = document.getElementById("event-date-filter");
    const modal = document.getElementById("event-modal");
    if (!dateFilter || !modal) return;

    if (dateFilter.dataset.eventsInitialized !== "true") {
      dateFilter.addEventListener("change", renderEvents);
      dateFilter.dataset.eventsInitialized = "true";
    }

    if (modal.dataset.eventsInitialized !== "true") {
      modal.addEventListener("click", function(e) {
        if (e.target === this) {
          closeEventModal();
        }
      });
      modal.dataset.eventsInitialized = "true";
    }

    renderEvents();
  }

  document.addEventListener("DOMContentLoaded", initializeEventsPage);
  document.addEventListener("turbo:load", initializeEventsPage);
})();
</script>
