<%
  is_home = request.path == posturacorretta_path
  is_contents = request.path.start_with?(posturacorretta_contenuti_path)
  explore_active = !is_home
%>

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto grid h-16 max-w-screen-xl grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 px-4 sm:px-6 lg:px-8">
    <%= link_to posturacorretta_path, class: "flex shrink-0 items-center", aria: { label: "PosturaCorretta home" } do %>
      <img src="https://ik.imagekit.io/posturacorretta/logo_pc_scontornato.png?updatedAt=1747975596766" alt="PosturaCorretta" class="hidden h-7 w-auto sm:block">
      <img src="https://ik.imagekit.io/posturacorretta/Sassi-icona-cerchio-bianco.png?updatedAt=1785386494945" alt="" class="size-9 rounded-full bg-blue-600 object-cover sm:hidden">
    <% end %>

    <nav class="flex min-w-0 items-center justify-center gap-2 sm:gap-4" aria-label="Navigazione principale PosturaCorretta">
      <%= link_to "Home", posturacorretta_path, aria: { current: ("page" if is_home) }, class: "border-b-2 px-1 py-2 text-xs font-bold transition sm:text-sm #{is_home ? 'border-blue-600 text-slate-950' : 'border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950'}" %>
      <details class="group relative [&_summary::-webkit-details-marker]:hidden" data-close-on-outside>
        <summary class="flex cursor-pointer list-none items-center gap-1 border-b-2 px-1 py-2 text-xs font-bold transition sm:text-sm <%= explore_active ? 'border-blue-600 text-slate-950' : 'border-transparent text-slate-600 hover:border-blue-500 hover:text-slate-950' %>" aria-label="Apri Esplora">Esplora <span class="text-[9px] transition group-open:rotate-180">▼</span></summary>
        <div class="absolute left-1/2 z-[80] mt-2 max-h-[calc(100vh-5rem)] w-64 -translate-x-1/2 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 shadow-xl" aria-label="Esplora PosturaCorretta">
          <%= link_to "Contenuti", posturacorretta_contenuti_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold #{is_contents && params[:categoria] != 'corsi' ? 'bg-blue-50 text-blue-700' : 'text-slate-700 hover:bg-blue-50'}" %>
          <div class="my-1 border-t border-slate-100"></div>
          <%= link_to "I tre progetti", posturacorretta_three_projects_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <%= link_to "Eventi", posturacorretta_eventi_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <%= link_to "Insegnanti", posturacorretta_insegnanti_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <%= link_to "Luoghi PosturaCorretta", posturacorretta_percorsi_sul_territorio_path(tab: "places"), class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <%= link_to "Accademia", posturacorretta_accademia_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <%= link_to "Metodiche", posturacorretta_metodiche_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <%= link_to "Libri", posturacorretta_libri_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <%= link_to "Collabora", posturacorretta_collabora_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50" %>
          <% if Current.user&.superadmin_user? %>
            <div class="my-2 border-t border-slate-200"></div>
            <p class="px-3 pb-1 pt-0.5 text-[10px] font-black uppercase tracking-[.14em] text-amber-700">Strumenti interni</p>
            <%= link_to "Area corsi", posturacorretta_student_dashboard_path, class: "block rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-100" %>
            <%= link_to "Dashboard insegnante", posturacorretta_seme_teacher_dashboard_path, class: "mt-1 block rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-100" %>
            <%= link_to "Visione e progetto · Bozza", posturacorretta_guida_path(sezione: "progetto"), class: "mt-1 block rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-100" %>
          <% end %>
        </div>
      </details>
    </nav>

    <div class="shrink-0"><%= render "posturacorretta/account_nav" %></div>
  </div>
</header>
