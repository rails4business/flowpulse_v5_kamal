<%
  is_home = request.path == posturacorretta_path && params[:sezione].blank? && params[:capitolo].blank?
  is_guida = request.path == posturacorretta_guida_path
  is_accademia = current_page?(posturacorretta_accademia_path) rescue false
  is_percorso = [posturacorretta_percorso_path, posturacorretta_percorsi_sul_territorio_path].include?(request.path) rescue false
   is_eventi = current_page?(posturacorretta_eventi_path) rescue false
   is_contenuti = current_page?(posturacorretta_contenuti_path) rescue false
  is_metodiche = request.path.start_with?(posturacorretta_metodiche_path) rescue false
  is_collabora = request.path.start_with?(posturacorretta_collabora_path) rescue false
  is_libri = request.path == posturacorretta_libri_path rescue false
  
%>

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex h-16 max-w-screen-xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="<%= posturacorretta_path %>" class="flex shrink-0 animate-fade-in items-center gap-3" aria-label="PosturaCorretta home">
      <img
        src="https://ik.imagekit.io/posturacorretta/logo_pc_scontornato.png?updatedAt=1747975596766"
        alt="PosturaCorretta"
        class="hidden h-7 w-auto sm:block"
        onerror="this.style.display='none';this.nextElementSibling.classList.remove('hidden');">
      <img src="https://ik.imagekit.io/posturacorretta/Sassi-icona-cerchio-bianco.png?updatedAt=1785386494945" alt="" class="size-9 rounded-full bg-blue-600 object-cover sm:hidden">
    </a>

    <!-- Desktop Inline Nav Links -->
    <nav class="hidden items-center gap-3 xl:flex xl:gap-5" aria-label="Navigazione principale PosturaCorretta">
      <a href="<%= posturacorretta_path %>"
         class="border-b-2 px-0.5 py-1 text-sm font-semibold transition <%= is_home ? "border-blue-600 text-gray-950" : "border-transparent text-gray-600 hover:border-blue-500 hover:text-gray-950" %>">
        Home
      </a>
      <a href="<%= posturacorretta_guida_path(sezione: 'primo_mese') %>"
         class="border-b-2 px-0.5 py-1 text-sm font-semibold transition <%= is_guida ? "border-blue-600 text-gray-950" : "border-transparent text-gray-600 hover:border-blue-500 hover:text-gray-950" %>">
        Guida
      </a>
      <a href="<%= posturacorretta_percorso_path %>"
         class="border-b-2 px-0.5 py-1 text-sm font-semibold transition <%= is_percorso ? "border-blue-600 text-gray-950" : "border-transparent text-gray-600 hover:border-blue-500 hover:text-gray-950" %>">
        Il tuo percorso
      </a>
      <a href="<%= posturacorretta_eventi_path %>"
         class="border-b-2 px-0.5 py-1 text-sm font-semibold transition <%= is_eventi ? "border-blue-600 text-gray-950" : "border-transparent text-gray-600 hover:border-blue-500 hover:text-gray-950" %>">
        Eventi
      </a>
      <details class="group relative [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center gap-1 border-b-2 border-transparent px-0.5 py-1 text-sm font-semibold text-gray-600 transition hover:border-blue-500 hover:text-gray-950 group-open:border-blue-600 group-open:text-gray-950">
          Esplora
          <span class="text-[10px] transition-transform group-open:rotate-180">▼</span>
        </summary>
        <div class="absolute right-0 z-50 mt-3 w-56 overflow-hidden rounded-xl border border-slate-200 bg-white py-1 shadow-lg">
          <a href="<%= posturacorretta_contenuti_path %>" class="block px-4 py-2.5 text-sm font-semibold <%= is_contenuti ? "bg-blue-50 text-blue-700" : "text-slate-700 hover:bg-slate-50 hover:text-blue-700" %>">Contenuti</a>
          <a href="<%= posturacorretta_percorsi_sul_territorio_path(tab: 'people') %>" class="block px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:text-blue-700">Professionisti</a>
          <a href="<%= posturacorretta_percorsi_sul_territorio_path(tab: 'places') %>" class="block px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:text-blue-700">Centri e luoghi</a>
          <a href="<%= posturacorretta_accademia_path %>" class="block px-4 py-2.5 text-sm font-semibold <%= is_accademia ? "bg-blue-50 text-blue-700" : "text-slate-700 hover:bg-slate-50 hover:text-blue-700" %>">Accademia</a>
          <a href="<%= posturacorretta_metodiche_path %>" class="block px-4 py-2.5 text-sm font-semibold <%= is_metodiche ? "bg-blue-50 text-blue-700" : "text-slate-700 hover:bg-slate-50 hover:text-blue-700" %>">Metodiche</a>
          <% if Current.user&.superadmin_user? %><a href="<%= posturacorretta_guida_path(sezione: 'progetto') %>" class="block bg-amber-50 px-4 py-2.5 text-sm font-semibold text-amber-800 hover:bg-amber-100">Visione e progetto · Bozza</a><% end %>
          <div class="my-1 border-t border-slate-100"></div>
          <a href="<%= posturacorretta_libri_path %>" class="block px-4 py-2.5 text-sm font-semibold <%= is_libri ? "bg-blue-50 text-blue-700" : "text-slate-700 hover:bg-slate-50 hover:text-blue-700" %>">Libri</a>
          <a href="<%= posturacorretta_collabora_path %>" class="block px-4 py-2.5 text-sm font-semibold <%= is_collabora ? "bg-blue-50 text-blue-700" : "text-slate-700 hover:bg-slate-50 hover:text-blue-700" %>">Collabora</a>
        </div>
      </details>
    </nav>

    <div class="hidden items-center xl:flex">
      <%= render "posturacorretta/account_nav" %>
    </div>

    <nav class="flex items-center gap-1 xl:hidden" aria-label="Navigazione mobile PosturaCorretta">
      <a href="<%= posturacorretta_guida_path(sezione: 'primo_mese') %>" class="rounded-lg px-2 py-2 text-xs font-bold <%= is_guida ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50' %>">Guida</a>
      <a href="<%= posturacorretta_percorso_path %>" class="rounded-lg p-2 <%= is_percorso ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50' %>" aria-label="Il tuo percorso"><%= render "posturacorretta/nav_icon", name: "path", classes: "size-5" %></a>
      <a href="<%= posturacorretta_eventi_path %>" class="rounded-lg p-2 <%= is_eventi ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50' %>" aria-label="Eventi"><%= render "posturacorretta/nav_icon", name: "events", classes: "size-5" %></a>
      <details class="group relative [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-bold text-slate-700 shadow-sm" aria-label="Apri Esplora">Esplora <span class="text-[9px] transition group-open:rotate-180">▼</span></summary>
        <div class="absolute right-0 z-[80] mt-2 w-64 overflow-hidden rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
          <%= link_to "Contenuti", posturacorretta_contenuti_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
          <%= link_to "Professionisti", posturacorretta_percorsi_sul_territorio_path(tab: "people"), class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
          <%= link_to "Centri e luoghi", posturacorretta_percorsi_sul_territorio_path(tab: "places"), class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
          <%= link_to "Accademia", posturacorretta_accademia_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
          <%= link_to "Metodiche", posturacorretta_metodiche_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
          <% if Current.user&.superadmin_user? %><%= link_to "Visione e progetto · Bozza", posturacorretta_guida_path(sezione: "progetto"), class: "block rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-100" %><% end %>
          <%= link_to "Libri", posturacorretta_libri_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold #{is_libri ? 'bg-blue-50 text-blue-700' : 'text-slate-700 hover:bg-blue-50 hover:text-blue-700'}" %>
          <%= link_to "Collabora", posturacorretta_collabora_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
          <div class="my-1 border-t border-slate-100"></div>
          <% if authenticated? %>
            <%= link_to "Calendario", posturacorretta_impegno_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700" %>
            <%= link_to "Profilo", profile_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <% else %>
            <div class="grid grid-cols-2 gap-2 p-1"><%= link_to "Accedi", new_session_path, class: "rounded-lg border border-slate-200 px-3 py-2 text-center text-sm font-bold text-slate-700" %><%= link_to "Registrati", new_user_path, class: "rounded-lg bg-blue-600 px-3 py-2 text-center text-sm font-bold text-white" %></div>
          <% end %>
        </div>
      </details>
    </nav>
  </div>

</header>
