<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<div class="bg-white antialiased">
  <!-- Hero Section -->
  <div class="relative bg-emerald-900 py-24 sm:py-32 overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute inset-0 opacity-10">
      <svg class="absolute h-full w-full" preserveAspectRatio="xMidYMid slice" fill="none" viewBox="0 0 1463 360">
        <path class="text-white" fill="currentColor" d="M-82.673 72l1761.849 472.086-134.327 501.315-1761.85-472.086z" />
        <path class="text-emerald-300" fill="currentColor" d="M-217.088 544.086L1544.761 72l134.327 501.316-1761.849 472.086z" />
      </svg>
    </div>
    
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-base font-semibold leading-7 text-emerald-300 uppercase tracking-widest">Rete Clinica ed Educativa</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-6xl">Collabora come Professionista</h1>
        <p class="mt-6 text-lg leading-8 text-emerald-100">
          Questa proposta è rivolta ai professionisti del benessere, della salute e del movimento che desiderano collaborare con PosturaCorretta, integrando le proprie competenze in un sistema strutturato e orientato alla chiarezza per il cliente.
        </p>
      </div>
    </div>
  </div>

  <!-- Le 4 Modalità -->
  <div class="py-24 sm:py-32 bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Quattro modalità per unirti a noi</h2>
        <p class="mt-4 text-lg leading-8 text-gray-600">Scegli il percorso più adatto in base ai tuoi obiettivi e al livello di coinvolgimento desiderato.</p>
      </div>

      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 sm:mt-20 lg:mx-auto lg:max-w-none lg:grid-cols-2 lg:gap-12">
        
        <!-- Modalità 1 -->
        <div class="relative rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200 transition hover:shadow-md">
          <div class="flex items-center gap-4 mb-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-lg font-bold text-emerald-700">1</span>
            <h3 class="text-xl font-bold text-gray-900">Aderire al Percorso Integrato (Linee Guida)</h3>
          </div>
          <p class="text-gray-600 mb-4">Entra a far parte della rete di professionisti raccomandati da PosturaCorretta, impegnandoti a:</p>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex gap-x-3"><span class="text-emerald-500">✓</span> Rispettare i protocolli e le 5 aree della salute.</li>
            <li class="flex gap-x-3"><span class="text-emerald-500">✓</span> Lavorare con un approccio condiviso, in cui la persona è al centro del processo di recupero e consapevolezza.</li>
            <li class="flex gap-x-3"><span class="text-emerald-500">✓</span> Coordinarsi con la piattaforma (es. apertura, monitoraggio e chiusura del percorso) per un'esperienza coerente e misurabile.</li>
          </ul>
        </div>

        <!-- Modalità 2 -->
        <div class="relative rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200 transition hover:shadow-md">
          <div class="flex items-center gap-4 mb-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-100 text-lg font-bold text-blue-700">2</span>
            <h3 class="text-xl font-bold text-gray-900">Diventare Insegnanti dell'Accademia</h3>
          </div>
          <p class="text-gray-600 mb-4">Per i professionisti che amano la formazione o vogliono portare i concetti dell'Accademia nei propri studi.</p>
          <p class="text-sm text-gray-600">
            L'Accademia fornisce gli strumenti educativi di base (l'alfabetizzazione motoria e posturale) affinché il cliente diventi autonomo e consapevole prima, durante o dopo i trattamenti specifici.
          </p>
        </div>

        <!-- Modalità 3 -->
        <div class="relative rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200 transition hover:shadow-md">
          <div class="flex items-center gap-4 mb-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-100 text-lg font-bold text-red-700">3</span>
            <h3 class="text-xl font-bold text-gray-900">Creatori di Contenuti Video</h3>
          </div>
          <p class="text-gray-600 mb-4">Per chi desidera visibilità tramite i nostri canali digitali (come YouTube), è possibile collaborare attivamente:</p>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex gap-x-3"><span class="text-red-500">✓</span> <strong>Presentare un problema:</strong> Creare video mirati legati alla propria attività o specializzazione per aiutare il pubblico e farsi conoscere.</li>
          </ul>
        </div>

        <!-- Modalità 4 -->
        <div class="relative rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200 transition hover:shadow-md">
          <div class="flex items-center gap-4 mb-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-100 text-lg font-bold text-amber-700">4</span>
            <h3 class="text-xl font-bold text-gray-900">Promotori di una Metodica o Professione</h3>
          </div>
          <p class="text-gray-600 mb-4">Per chi vuole espandere la rete fisica, le relazioni sul territorio e promuovere l'identità della propria disciplina:</p>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex gap-x-3"><span class="text-amber-500">✓</span> <strong>Far conoscere la Metodica:</strong> Promuovere attivamente la propria professione.</li>
            <li class="flex gap-x-3"><span class="text-amber-500">✓</span> <strong>Diventare il Riferimento:</strong> Assumere il ruolo di ponte ufficiale tra PosturaCorretta e la Metodica.</li>
            <li class="flex gap-x-3"><span class="text-amber-500">✓</span> <strong>Coinvolgimento:</strong> Organizzare eventi per far crescere il network.</li>
          </ul>
        </div>

      </div>
    </div>
  </div>

  <!-- Il Concetto Chiave -->
  <div class="py-24 sm:py-32 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Differenza tra Professionisti e Insegnanti</h2>
        <p class="mt-4 text-lg text-gray-600">Per far funzionare bene la rete, è fondamentale comprendere la sinergia e i ruoli tra chi insegna (gli Insegnanti) e chi opera come Professionista specializzato.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
        
        <!-- Gli Insegnanti -->
        <div class="rounded-3xl bg-blue-50 p-10 lg:p-12 border border-blue-100 flex flex-col justify-center">
          <div class="mb-6 flex items-center justify-center h-16 w-16 rounded-2xl bg-blue-600 text-white shadow-lg mx-auto lg:mx-0">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="mb-4 text-center text-2xl font-bold text-gray-900 lg:text-left">Gli Insegnanti educano (creano Amatori)</h3>
          <p class="text-gray-700 leading-relaxed text-center lg:text-left">
            Pensiamo alla cultura giapponese: esiste un protocollo di <strong>Shiatsu</strong> che non nasce come terapia, ma come strumento per educare le persone e trasmettere la pratica di base all'interno delle famiglie e nella società. Serve come recupero nello sport, per sostenere i più deboli (come gli anziani) o alleviare le fatiche quotidiane.
            <br><br>
            Il ruolo dell'insegnante non è quello di curare, ma di <strong>insegnare ed educare affinché le persone stesse diventino "amatori"</strong> e conoscitrici del proprio corpo. Si colma così un vuoto enorme: a scuola non c'è spazio per questa educazione, nella sanità si arriva troppo tardi con la "cura", e nel mondo del benessere tutto viene spesso ridotto a una singola tecnica isolata. L'insegnante prepara il terreno con la consapevolezza.
          </p>
        </div>

        <!-- I Professionisti -->
        <div class="rounded-3xl bg-emerald-50 p-10 lg:p-12 border border-emerald-100 flex flex-col justify-center">
          <div class="mb-6 flex items-center justify-center h-16 w-16 rounded-2xl bg-emerald-600 text-white shadow-lg mx-auto lg:mx-0">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="mb-4 text-center text-2xl font-bold text-gray-900 lg:text-left">I Professionisti creano i Percorsi</h3>
          <p class="text-gray-700 leading-relaxed text-center lg:text-left">
            I professionisti della salute (fisioterapisti, osteopati, medici, ecc.) hanno invece un compito diverso: <strong>creare un vero e proprio percorso della salute</strong> per il paziente, non limitarsi alla singola tecnica.
            <br><br>
            Avendo di fronte un cliente già educato e "preparato" dall'insegnante, il professionista può concentrarsi interamente sull'erogazione di prestazioni specifiche e profonde. Ottimizza tempi ed efficacia del trattamento, strutturando un percorso riabilitativo o terapeutico senza doversi fermare all'educazione di base.
          </p>
        </div>

      </div>

      <!-- Il Professionista come Insegnante -->
      <div class="mt-16 bg-slate-50 border border-slate-200 rounded-3xl p-8 lg:p-10 shadow-sm max-w-4xl mx-auto">
        <h3 class="mb-3 text-xl font-bold text-slate-900">Un Professionista può essere Insegnante?</h3>
        <p class="text-slate-700 leading-relaxed">
          Certo, ed è altamente consigliato. Spesso chi lavora nella salute è come <em>"il calzolaio con le scarpe rotte"</em>: cura gli altri ma trascura sé stesso.
          <br>
          Diventare insegnanti (ovvero apprendere i protocolli di igiene posturale per l'educazione) costringe il professionista a praticare prima di tutto su di sé. È un modo eccellente per mantenersi in salute e comprendere a fondo cosa si andrà a chiedere ai propri pazienti, connettendo la propria eccellenza terapeutica a una base corporea salda e coerente.
        </p>
      </div>
      <!-- Modello di Contributo e Servizi -->
      <div class="mt-16 bg-white border border-gray-200 rounded-3xl overflow-hidden shadow-sm max-w-5xl mx-auto">
        <div class="p-8 lg:p-10 border-b border-gray-100 bg-gray-50/50">
          <h3 class="mb-2 text-2xl font-bold text-gray-900">Quanto costa entrare nella rete?</h3>
          <p class="text-gray-600">Abbiamo strutturato un modello flessibile che lascia la libertà al professionista di scegliere come contribuire al progetto.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-gray-100">
          <!-- Contributo Libero -->
          <div class="p-8 lg:p-10 hover:bg-gray-50/50 transition">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
            </div>
            <h4 class="mb-3 text-lg font-bold text-gray-900">Adesione alla Rete</h4>
            <p class="text-gray-600 text-sm leading-relaxed">
              L'ingresso nella rete è strutturato su un <strong>contributo basato sul valore percepito</strong>. Sei libero di scegliere se non pagare nulla, se versare una quota annuale fissa, o se fare un'offerta libera in base a quanto ritieni che l'appartenenza al network stia aiutando la tua attività e i tuoi pazienti.
            </p>
          </div>

          <!-- Servizi Base -->
          <div class="p-8 lg:p-10 hover:bg-gray-50/50 transition">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-blue-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 13.5V10.5m0 0V7.5m0 3h3M12 13.5V10.5m0 0V7.5m0 3h3m2.25 4.5v-6a2.25 2.25 0 00-2.25-2.25H4.5A2.25 2.25 0 002.25 7.5v6A2.25 2.25 0 004.5 15.75h15A2.25 2.25 0 0021.75 13.5zm-18 6A2.25 2.25 0 006 21.75h12A2.25 2.25 0 0020.25 19.5v-1.5H3.75v1.5z" />
              </svg>
            </div>
            <h4 class="mb-3 text-lg font-bold text-gray-900">Servizi Premium e Strumenti</h4>
            <p class="text-gray-600 text-sm leading-relaxed">
              Mentre l'adesione e il supporto della rete seguono la logica del contributo libero, i servizi fisici e tecnici hanno costi strutturati. Ad esempio, la <strong>produzione video professionale</strong>, la gestione del marketing mirato o l'uso avanzato di specifiche aree della piattaforma prevedono un listino trasparente legato al lavoro tecnico necessario.
            </p>
          </div>
        </div>
      </div>
      <!-- Contattaci -->
      <div class="mt-24 text-center">
        <h3 class="text-2xl font-bold tracking-tight text-gray-900">Vuoi collaborare con la nostra rete?</h3>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
          Siamo a disposizione per spiegarti nel dettaglio le modalità di adesione e trovare insieme il ruolo più adatto per valorizzare la tua professione all'interno di PosturaCorretta.
        </p>
        <div class="mt-8 flex justify-center gap-4">
          <a href="https://wa.me/393792891488?text=Ciao%2C%20vorrei%20avere%20informazioni%20su%20come%20collaborare%20come%20Professionista%20nella%20rete%20PosturaCorretta." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 transition">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.015c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            Contattaci su WhatsApp
          </a>
          <a href="tel:+393792891488" class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600 transition">
            Chiama (+39 379 2891488)
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render "posturacorretta/footer" %>
