<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<%
  postura_creators = {
    "markpostura" => { name: "Mark Postura", initials: "MP", role: "Fisioterapista", color: "bg-blue-100 text-blue-700" },
    "belleri" => { name: "Marco Belleri", initials: "MB", role: "Osteopata bio-olistico", color: "bg-violet-100 text-violet-700" },
    "damiata" => { name: "Giovanni Damiata", initials: "GD", role: "Medico M.G. · Fitoterapia europea", color: "bg-emerald-100 text-emerald-700" },
    "frapporti" => { name: "Giovanni Frapporti", initials: "GF", role: "Chinesiologo", color: "bg-amber-100 text-amber-700" }
  }

  postura_youtube_url = "https://www.youtube.com/channel/UC7LdGdDNfe_LUUqii42T4qA"

  blog_color_classes = {
    "rose" => { soft: "bg-rose-50", border: "border-rose-200", text: "text-rose-700", badge: "bg-rose-100 text-rose-800", hover: "group-hover:text-rose-700" },
    "emerald" => { soft: "bg-emerald-50", border: "border-emerald-200", text: "text-emerald-700", badge: "bg-emerald-100 text-emerald-800", hover: "group-hover:text-emerald-700" },
    "amber" => { soft: "bg-amber-50", border: "border-amber-200", text: "text-amber-700", badge: "bg-amber-100 text-amber-800", hover: "group-hover:text-amber-700" },
    "blue" => { soft: "bg-blue-50", border: "border-blue-200", text: "text-blue-700", badge: "bg-blue-100 text-blue-800", hover: "group-hover:text-blue-700" },
    "green" => { soft: "bg-green-50", border: "border-green-200", text: "text-green-700", badge: "bg-green-100 text-green-800", hover: "group-hover:text-green-700" },
    "violet" => { soft: "bg-violet-50", border: "border-violet-200", text: "text-violet-700", badge: "bg-violet-100 text-violet-800", hover: "group-hover:text-violet-700" }
  }

  blog_category_order = %w[tutti dolore prevenzione performance benessere attivita fisiologia giardino]
  blog_tab_active_classes = {
    "tutti" => "bg-blue-600 text-white shadow-sm",
    "dolore" => "bg-rose-600 text-white shadow-sm",
    "prevenzione" => "bg-orange-500 text-white shadow-sm",
    "performance" => "bg-amber-400 text-slate-950 shadow-sm",
    "benessere" => "bg-emerald-600 text-white shadow-sm",
    "attivita" => "bg-cyan-600 text-white shadow-sm",
    "fisiologia" => "bg-blue-600 text-white shadow-sm",
    "giardino" => "bg-violet-600 text-white shadow-sm"
  }
%>

<div id="top" class="bg-white text-slate-900 antialiased">
  <section class="border-t border-slate-200/70 px-4 py-10 md:px-6 md:py-16 min-h-[calc(100vh-4rem)]">
    <div class="mx-auto max-w-6xl" data-controller="mobile-aside" data-action="keydown@window->mobile-aside#keydown">
      <div class="relative mb-8 flex min-h-[3rem] flex-col gap-4 sm:flex-row sm:items-center">
        <div id="header-controls" class="flex w-full min-w-0 flex-1 flex-col gap-4 sm:flex-row sm:items-center">
          <div class="inline-flex justify-self-start rounded-full bg-slate-100 p-1 shadow-inner shrink-0">
            <button type="button" onclick="switchMacroTab('contenuti')" id="macro-tab-contenuti" class="macro-tab rounded-full px-6 py-2.5 text-sm font-bold shadow bg-white text-slate-900 transition">Contenuti</button>
            <button type="button" onclick="switchMacroTab('corsi')" id="macro-tab-corsi" class="macro-tab rounded-full px-6 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-900 transition">Corsi</button>
          </div>

          <label class="relative block w-full sm:w-56 sm:focus-within:w-72">
            <span class="sr-only">Cerca nei contenuti</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="pointer-events-none absolute left-3 top-1/2 z-20 h-5 w-5 -translate-y-1/2 text-slate-400">
              <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
              <path d="m20 20-3.5-3.5" stroke-width="2" stroke-linecap="round"></path>
            </svg>
            <input id="blog-search" type="search" placeholder="Cerca un video..." class="w-full rounded-full border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-4 text-sm text-slate-900 shadow-sm outline-none transition-all duration-300 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/30">
          </label>
        </div>

        <div class="flex shrink-0 items-center gap-2 sm:ml-auto">
          <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 lg:hidden" data-mobile-aside-target="toggle" data-action="mobile-aside#open" aria-controls="contenuti-mobile-filtri" aria-expanded="false">
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" class="size-4"><path d="M3 5h14M5.5 10h9M8 15h4" stroke-linecap="round" stroke-width="1.8"/></svg>
            Filtri
          </button>
          <span id="content-visible-count" class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-500 whitespace-nowrap" aria-live="polite">
            <%= @catalog.fetch(:tutti)[:articles].size %> video
          </span>
        </div>
      </div>

      <div class="fixed inset-0 z-40 hidden bg-slate-900/20 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden" data-mobile-aside-target="backdrop" data-action="click->mobile-aside#close"></div>

      <div class="grid gap-7 lg:grid-cols-[15rem_minmax(0,1fr)]">
        <%= render "posturacorretta/content_filter_aside" %>
        <div class="min-w-0">
      <% (blog_category_order + ["corsi"]).each_with_index do |key, category_index| %>
        <% category = @catalog.fetch(key.to_sym, nil) %>
        <% next unless category %>
        <% colors = blog_color_classes.fetch(category[:color] || "slate", blog_color_classes["blue"]) %>
        <section id="blog-section-<%= key %>" class="blog-section pt-6 md:pt-8 <%= 'hidden' unless category_index.zero? %>" data-category="<%= key %>" data-video-count="<%= category[:articles].size %>" data-count-singular="<%= key == 'corsi' ? 'corso' : 'video' %>" data-count-plural="<%= key == 'corsi' ? 'corsi' : 'video' %>">
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" id="article-list-<%= key %>">
            <% category[:articles].each do |article| %>
              <% creator = postura_creators.fetch(article[:author]) do
                   { name: article[:author].presence || "PosturaCorretta", initials: "PC", role: "Autore", color: "bg-slate-100 text-slate-700" }
                 end %>
              <% is_video = article[:format] == "video" %>
              <% is_course = article[:item_type] == "course" %>
              <% external_article = article[:url].present? %>
              <% article_href = external_article ? article[:url] : posturacorretta_articolo_path(article[:slug]) %>
              <% article_area = article[:area].presence || ({ "dolore" => "cura", "prevenzione" => "prevenzione", "performance" => "movimento", "attivita" => "movimento", "fisiologia" => "fisiologia", "benessere" => "benessere", "giardino" => "territorio" }[key] || key) %>
              <% article_paradigm = article[:paradigm].presence || "fisiologico" %>
              <% article_people = Array(article[:professionals].presence || article[:author]).join(" ") %>
              <% article_places = Array(article[:places]).join(" ") %>
              <% article_methodologies = Array(article[:methodologies]).join(" ") %>
              <% article_channel = article[:channel].presence || "posturacorretta" %>
              <% article_platform = article[:platform].presence || (is_video ? "youtube" : "sito") %>
              <% article_zones = Array(article[:zones]).join(" ") %>
              <% article_level = article[:level].presence || (is_course ? "intermediate" : (is_video ? "base" : "intermediate")) %>
              <a href="<%= article_href %>" <%= 'target="_blank" rel="noopener noreferrer"'.html_safe if external_article %> class="blog-article group flex min-h-64 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md" data-subcategory="<%= article[:subcategory] %>" data-ambito="<%= key %>" data-area="<%= article_area %>" data-paradigma="<%= article_paradigm %>" data-professionals="<%= article_people %>" data-places="<%= article_places %>" data-methodologies="<%= article_methodologies %>" data-channel="<%= article_channel %>" data-platform="<%= article_platform %>" data-zones="<%= article_zones %>" data-level="<%= article_level %>" data-search="<%= [article[:title], article[:excerpt], article[:subcategory], creator[:name], article[:format]].join(' ').downcase %>">
                <% if is_video %>
                  <div class="aspect-video w-full overflow-hidden bg-slate-100 relative">
                    <img src="https://img.youtube.com/vi/<%= article[:slug] %>/mqdefault.jpg" alt="" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy">
                    <div class="absolute inset-0 flex items-center justify-center bg-slate-900/10 opacity-0 transition-opacity group-hover:opacity-100">
                      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-red-600 shadow-sm backdrop-blur-sm">
                        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6 ml-0.5"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"></path></svg>
                      </span>
                    </div>
                  </div>
                <% end %>
                <div class="flex flex-1 flex-col p-5 md:p-6">
                  <div class="flex items-center justify-between gap-3">
                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider <%= is_course ? 'bg-blue-50 text-blue-700' : (is_video ? 'bg-red-50 text-red-700' : 'bg-blue-50 text-blue-700') %>">
                      <% if is_course %>
                        <%= render "posturacorretta/nav_icon", name: "academy", classes: "size-3.5 shrink-0" %>
                        Corso
                      <% elsif is_video %>
                        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path d="M5.5 4.8a1 1 0 0 1 1.52-.85l7.2 4.7a1 1 0 0 1 0 1.7l-7.2 4.7A1 1 0 0 1 5.5 14.2V4.8Z"></path></svg>
                        Video
                      <% else %>
                        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path d="M4 2.75A1.75 1.75 0 0 1 5.75 1h5.19c.47 0 .91.19 1.24.51l3.3 3.31c.33.33.52.77.52 1.24v11.19A1.75 1.75 0 0 1 14.25 19h-8.5A1.75 1.75 0 0 1 4 17.25V2.75Zm3 5.5c-.41 0-.75.34-.75.75s.34.75.75.75h6A.75.75 0 0 0 13 8.25H7Zm0 3.5c-.41 0-.75.34-.75.75s.34.75.75.75h6a.75.75 0 0 0 0-1.5H7Z"></path></svg>
                        Post
                      <% end %>
                    </span>
                    <span class="truncate text-[10px] font-black uppercase tracking-wider <%= colors[:text] %>"><%= article[:subcategory] %></span>
                  </div>
                  <h3 class="mt-4 text-lg font-black leading-snug text-slate-900 transition <%= colors[:hover] %>"><%= article[:title] %></h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-500"><%= article[:excerpt] %></p>
                </div>
                <div class="mt-auto flex items-center justify-between border-t border-slate-100 p-5 md:px-6 md:pb-6 md:pt-4">
                  <div class="flex min-w-0 items-center gap-2.5">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[10px] font-black <%= creator[:color] %>"><%= creator[:initials] %></span>
                    <div class="min-w-0">
                      <p class="truncate text-xs font-bold text-slate-700"><%= creator[:name] %></p>
                      <p class="text-[10px] text-slate-400"><%= article[:time] %><%= is_course ? "" : (is_video ? " di visione" : " di lettura") %></p>
                    </div>
                  </div>
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition group-hover:bg-slate-900 group-hover:text-white"><%= is_video ? '↗' : '→' %></span>
                </div>
              </a>
            <% end %>
          </div>

          <div class="blog-empty mt-5 hidden rounded-2xl border border-dashed border-slate-300 bg-white py-12 text-center">
            <p class="font-black text-slate-900">Nessun articolo trovato</p>
            <p class="mt-2 text-sm text-slate-500">Prova con un'altra parola o sottocategoria.</p>
          </div>
        </section>
      <% end %>

      <section class="mt-12 rounded-2xl border border-blue-200 bg-blue-50 p-6 md:flex md:items-center md:justify-between md:gap-8 md:p-8" aria-labelledby="professionals-content-title">
        <div class="max-w-2xl">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-blue-700">Per professionisti e creator</p>
          <h2 id="professionals-content-title" class="mt-2 text-2xl font-black tracking-tight text-slate-950">Porta le tue competenze nei contenuti</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">Puoi proporre un approfondimento, un problema da spiegare, un'esperienza o materiali utili per le Linee guida e l'educazione alla salute.</p>
        </div>
        <a href="<%= posturacorretta_collabora_professionisti_guida_path('contenuti-video') %>" class="mt-5 inline-flex w-full shrink-0 items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 sm:w-auto md:mt-0">
          Diventa un creator <span aria-hidden="true" class="ml-2">&rarr;</span>
        </a>
      </section>

      <section class="mt-12 border-t border-slate-200 pt-10 md:mt-16 md:pt-12" aria-labelledby="creators-title">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-blue-700">Professionisti e autori</p>
          <h2 id="creators-title" class="mt-2 text-2xl font-black text-slate-950 md:text-3xl">Creator PosturaCorretta</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600">Le persone che contribuiscono ai post, ai video e agli approfondimenti del progetto.</p>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <% postura_creators.each_value do |creator| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="flex h-11 w-11 items-center justify-center rounded-full text-xs font-black <%= creator[:color] %>"><%= creator[:initials] %></span>
              <h3 class="mt-4 text-sm font-black text-slate-900"><%= creator[:name] %></h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-500"><%= creator[:role] %></p>
            </article>
          <% end %>
        </div>
      </section>

      <section class="mt-10 border-t border-slate-200 pt-10 md:mt-12 md:pt-12" aria-labelledby="social-title">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Video, aggiornamenti e community</p>
          <h2 id="social-title" class="mt-2 text-2xl font-black text-slate-950 md:text-3xl">Continua a seguirci</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600">Scegli il canale più adatto al modo in cui preferisci seguire PosturaCorretta.</p>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <a href="<%= postura_youtube_url %>" target="_blank" rel="noopener noreferrer" class="group flex min-h-64 flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-red-200 hover:shadow-lg md:p-8">
            <div class="flex items-center justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6"><path d="M18.6 5.2a2.25 2.25 0 0 0-1.58-1.6C15.62 3.2 10 3.2 10 3.2s-5.62 0-7.02.4A2.25 2.25 0 0 0 1.4 5.2 23.5 23.5 0 0 0 1 10a23.5 23.5 0 0 0 .4 4.8 2.25 2.25 0 0 0 1.58 1.6c1.4.4 7.02.4 7.02.4s5.62 0 7.02-.4a2.25 2.25 0 0 0 1.58-1.6A23.5 23.5 0 0 0 19 10a23.5 23.5 0 0 0-.4-4.8ZM8.2 13V7l5.2 3-5.2 3Z"></path></svg>
              </span>
              <span class="text-xs font-bold uppercase tracking-[0.16em] text-red-600">Video e ricerca</span>
            </div>
            <h3 class="mt-6 text-2xl font-black tracking-tight text-slate-950">YouTube</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">Approfondimenti, esercizi, eventi e costruzione pubblica del progetto.</p>
            <div class="mt-auto flex items-center justify-between border-t border-slate-100 pt-5 text-sm font-bold text-red-600">
              <span>Vai al canale</span>
              <span class="transition group-hover:translate-x-1">↗</span>
            </div>
          </a>

          <a href="https://www.instagram.com/posturacorretta" target="_blank" rel="noopener noreferrer" class="group flex min-h-64 flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-pink-200 hover:shadow-lg md:p-8">
            <div class="flex items-center justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-pink-50 text-pink-600">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-6 w-6"><rect x="3" y="3" width="18" height="18" rx="5" stroke-width="2"></rect><circle cx="12" cy="12" r="4" stroke-width="2"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
              </span>
              <span class="text-xs font-bold uppercase tracking-[0.16em] text-pink-600">Community ed eventi</span>
            </div>
            <h3 class="mt-6 text-2xl font-black tracking-tight text-slate-950">Instagram</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">Dietro le quinte, caroselli, eventi e aggiornamenti quotidiani.</p>
            <div class="mt-auto flex items-center justify-between border-t border-slate-100 pt-5 text-sm font-bold text-pink-600">
              <span>Segui la pagina</span>
              <span class="transition group-hover:translate-x-1">↗</span>
            </div>
          </a>
        </div>
      </section>

      <% if Current.user&.superadmin_user? %>
        <section class="mt-12 rounded-3xl border border-blue-200 bg-blue-50 p-6 md:p-8" aria-label="Area Amministratore">
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-100 text-blue-700">
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"></path></svg>
            </span>
            <div>
              <h3 class="text-sm font-black uppercase tracking-wider text-blue-900">Area Superadmin · Gestione Contenuti</h3>
              <p class="mt-2 text-sm leading-relaxed text-blue-800">
                La pagina Contenuti è alimentata dal file <code>config/data/posturacorretta/contenuti/catalog.yml</code>.<br>
                Per scaricare automaticamente gli ultimi video pubblici da YouTube e inserirli nel catalogo, apri il terminale ed esegui il comando:
              </p>
              <code class="mt-3 block w-fit rounded-lg bg-blue-900/10 px-4 py-2 text-sm font-bold text-blue-900">rails youtube:sync</code>
              <p class="mt-3 text-xs text-blue-700">Per importare interi storici del canale o video privati, gestisci il file YAML manualmente o usa yt-dlp.</p>
              <%= link_to "Gestisci tassonomia e filtri →", admin_content_taxonomy_path, class: "mt-4 inline-flex text-sm font-semibold text-blue-800 hover:text-blue-950" %>
            </div>
          </div>
        </section>
      <% end %>

        </div>
      </div>
    </div>
  </section>

  <%= render "posturacorretta/footer" %>
</div>

<script>
  let activeBlogCategory = "tutti";

  window.switchBlogCategory = function(key) {
    const selectedSection = document.getElementById(`blog-section-${key}`);
    if (!selectedSection) return;

    document.querySelectorAll(".blog-section").forEach(section => section.classList.add("hidden"));
    selectedSection.classList.remove("hidden");
    activeBlogCategory = key;

    // Evidenzia Contenuti se è pubblica
    if (key !== "corsi") {
      const btnContenuti = document.getElementById("macro-tab-contenuti");
      const btnCorsi = document.getElementById("macro-tab-corsi");
      if(btnContenuti && btnCorsi) {
        btnContenuti.className = "macro-tab rounded-full px-6 py-2.5 text-sm font-bold shadow bg-white text-slate-900 transition";
        btnCorsi.className = "macro-tab rounded-full px-6 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-900 transition";
      }
    }

    const url = new URL(window.location);
    url.searchParams.set("categoria", key);
    history.replaceState({}, "", url);

    // Reset e applica filtri di ricerca
    document.getElementById("blog-search").value = "";
    applyBlogFilters();
  };

  window.filterContentOptions = function(input) {
    const query = input.value.trim().toLowerCase();
    const group = input.closest("[data-content-filter-group]");
    if (!group) return;
    const options = group.querySelector("[data-content-filter-options]");
    if (options?.dataset.searchFirst === "true") options.classList.toggle("hidden", query.length === 0);
    group.querySelectorAll("[data-content-filter-option]").forEach(option => {
      option.classList.toggle("hidden", query.length > 0 && !option.dataset.contentFilterOption.includes(query));
    });
  };

  function applyBlogFilters() {
    const section = document.getElementById(`blog-section-${activeBlogCategory}`);
    if (!section) return;

    const query = document.getElementById("blog-search").value.trim().toLowerCase();
    const params = new URLSearchParams(window.location.search);
    const selectedAreas = (params.get("area") || "").split(",").filter(Boolean);
    const selectedParadigms = (params.get("paradigma") || "").split(",").filter(Boolean);
    const selectedProfessionals = (params.get("professionista") || "").split(",").filter(Boolean);
    const selectedPlaces = (params.get("luogo") || "").split(",").filter(Boolean);
    const selectedMethodologies = (params.get("metodica") || "").split(",").filter(Boolean);
    const selectedChannels = (params.get("canale") || "").split(",").filter(Boolean);
    const selectedPlatforms = (params.get("piattaforma") || "").split(",").filter(Boolean);
    const selectedAmbiti = (params.get("ambito") || "").split(",").filter(Boolean);
    const selectedZones = (params.get("zona") || "").split(",").filter(Boolean);
    const selectedLevels = (params.get("livello") || "").split(",").filter(Boolean);
    let visible = 0;

    const sections = selectedAmbiti.length && activeBlogCategory !== "corsi"
      ? [...document.querySelectorAll(".blog-section")].filter(candidate => selectedAmbiti.includes(candidate.dataset.category))
      : [section];
    document.querySelectorAll(".blog-section").forEach(candidate => candidate.classList.toggle("hidden", !sections.includes(candidate)));

    sections.forEach(currentSection => {
    currentSection.querySelectorAll(".blog-article").forEach(article => {
      const matchesSearch = !query || article.dataset.search.includes(query);
      const matchesArea = !selectedAreas.length || selectedAreas.includes(article.dataset.area);
      const matchesParadigm = !selectedParadigms.length || selectedParadigms.includes(article.dataset.paradigma);
      const matchesProfessional = !selectedProfessionals.length || selectedProfessionals.some(key => article.dataset.professionals.split(" ").includes(key));
      const matchesPlace = !selectedPlaces.length || selectedPlaces.some(key => article.dataset.places.split(" ").includes(key));
      const matchesMethodology = !selectedMethodologies.length || selectedMethodologies.some(key => article.dataset.methodologies.split(" ").includes(key));
      const matchesChannel = !selectedChannels.length || selectedChannels.includes(article.dataset.channel);
      const matchesPlatform = !selectedPlatforms.length || selectedPlatforms.includes(article.dataset.platform);
      const matchesZone = !selectedZones.length || selectedZones.some(key => article.dataset.zones.split(" ").includes(key));
      const matchesLevel = !selectedLevels.length || selectedLevels.includes(article.dataset.level);
      const matches = matchesSearch && matchesArea && matchesParadigm && matchesProfessional && matchesPlace && matchesMethodology && matchesChannel && matchesPlatform && matchesZone && matchesLevel;
      article.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    });

    const emptyState = currentSection.querySelector(".blog-empty");
    if (emptyState) emptyState.classList.toggle("hidden", currentSection.querySelectorAll(".blog-article:not(.hidden)").length > 0);
    });

    const countLabel = document.getElementById("content-visible-count");
    if(countLabel) {
      countLabel.textContent = `${visible} ${visible === 1 ? section.dataset.countSingular : section.dataset.countPlural}`;
    }

  }

  window.switchMacroTab = function(tab) {
    const btnContenuti = document.getElementById("macro-tab-contenuti");
    const btnCorsi = document.getElementById("macro-tab-corsi");

    if (tab === 'contenuti') {
      btnContenuti.className = "macro-tab rounded-full px-6 py-2.5 text-sm font-bold shadow bg-white text-slate-900 transition";
      btnCorsi.className = "macro-tab rounded-full px-6 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-900 transition";
      const category = new URLSearchParams(window.location.search).get("categoria") || "tutti";
      window.switchBlogCategory(category === "corsi" ? "tutti" : category);
    } else {
      btnCorsi.className = "macro-tab rounded-full px-6 py-2.5 text-sm font-bold shadow bg-white text-slate-900 transition";
      btnContenuti.className = "macro-tab rounded-full px-6 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-900 transition";
      window.switchBlogCategory("corsi");
    }
  };

  function initializeContentCatalog() {
    const search = document.getElementById("blog-search");
    if (!search || search.dataset.catalogReady === "true") return;
    search.dataset.catalogReady = "true";
    search.addEventListener("input", applyBlogFilters);
    const params = new URLSearchParams(window.location.search);
    const requestedCategory = params.get("categoria") || params.get("subtab") || "tutti";

    if (requestedCategory === "corsi") {
      switchMacroTab("corsi");
    } else {
      switchMacroTab("contenuti");
      window.switchBlogCategory(requestedCategory);
    }
  }

  document.addEventListener("DOMContentLoaded", initializeContentCatalog);
  document.addEventListener("turbo:load", initializeContentCatalog);
</script>
