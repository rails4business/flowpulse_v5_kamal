<footer class="border-t border-slate-200 bg-white py-16">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-5 md:grid-cols-4">
    <div class="space-y-4">
      <%= imagekit_image_tag(
            "https://ik.imagekit.io/posturacorretta/logo_pc_scontornato.png?updatedAt=1747975596766",
            alt: "PosturaCorretta",
            widths: [168, 336],
            sizes: "168px",
            class_name: "h-7 w-auto",
            loading: "lazy",
            width: 168,
            height: 28,
            onerror: "this.style.display='none';this.nextElementSibling.classList.remove('hidden');"
          ) %>
      <span class="hidden text-base font-extrabold tracking-tight text-blue-700">PosturaCorretta</span>
      <p class="text-sm leading-6 text-slate-500">
        Educazione posturale, salute del corpo e percorsi di consapevolezza.
      </p>
      <a href="<%= posturacorretta_dash_path %>" class="group inline-flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 transition hover:border-[#008de4]/40 hover:bg-[#008de4]/5" aria-label="Pagamenti opzionali in DASH">
        <img src="https://media.dash.org/wp-content/uploads/dash-d-circle.svg" alt="" class="size-9 shrink-0" loading="lazy">
        <span>
          <span class="block text-[10px] font-bold uppercase tracking-[0.14em] text-slate-600">Pagamenti opzionali</span>
          <span class="block text-sm font-black tracking-wide text-[#0074bc] group-hover:text-[#005f9b]">DASH</span>
        </span>
      </a>
    </div>

    <div>
      <h2 class="mb-4 font-semibold text-slate-950">Percorso educativo online</h2>
      <ul class="space-y-2 text-sm text-slate-500">
        <li><a class="hover:text-blue-700" href="<%= percorso_integrato_path %>">Percorso Integrato</a></li>
        <li><a class="hover:text-blue-700" href="<%= posturacorretta_contenuti_path %>?subtab=benessere">Benessere Integrato</a></li>
        <li><a class="hover:text-blue-700" href="<%= posturacorretta_path %>">Postura e Fisiologia</a></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-4 font-semibold text-slate-950">Progetto</h2>
      <ul class="space-y-2 text-sm text-slate-500">
        <li><a class="hover:text-violet-750" href="<%= posturacorretta_eventi_path %>">Eventi e Community</a></li>
        <li><a class="hover:text-emerald-700" href="<%= posturacorretta_presentation_path %>" target="_blank" rel="noopener">Presentazione PosturaCorretta (PDF)</a></li>
        <li><a class="hover:text-orange-700" href="<%= posturacorretta_collabora_path %>">Collabora</a></li>
        <li><a class="hover:text-blue-700" href="<%= posturacorretta_visione_path %>">Visione</a></li>
        <% footer_changelog_scope = request.path.start_with?("/percorso-integrato") ? "percorso-integrato" : "posturacorretta" %>
        <li><%= render "shared/changelog_footer_link", brand: footer_changelog_scope, class_name: "hover:text-blue-700" %></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-4 font-semibold text-slate-950">Community</h2>
      <ul class="space-y-2 text-sm text-slate-500">
        <li><a class="hover:text-blue-700" href="https://youtube.com/@posturacorretta" target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a class="hover:text-blue-700" href="https://instagram.com/posturacorretta" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a class="hover:text-blue-700" href="/contatti">Contatti</a></li>
        <% if Current.user&.superadmin_user? %>
          <li class="pt-2 border-t border-slate-100">
            <a class="font-semibold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1.5" href="<%= admin_prototype_path(path: "quadrangolazione_instagram.html") %>" title="Strategia Instagram Ecosistema Flowpulse">
              <span>⚡ Strategy @markpostura</span>
              <span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-mono uppercase">Superadmin</span>
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <% if Current.user&.superadmin_user? %>
    <div class="mx-auto mt-12 max-w-6xl px-5">
      <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-amber-200/80 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-900">Riservato Superadmin</span>
            <span class="text-xs font-bold text-amber-950">Bozze &amp; Presentazioni Canva</span>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-amber-900">
            <a href="https://benessereintegrato.my.canva.site/postura-sito-4-ante-presentazione-servizi-centri-sito-web" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-amber-950 hover:underline">
              <span>Canva 4 Ante (Servizi &amp; Centri)</span>
              <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <span class="text-amber-300">·</span>
            <a href="https://benessereintegrato.my.canva.site/home" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-amber-950 hover:underline">
              <span>Canva Benessere Integrato Home</span>
              <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <span class="text-amber-300">·</span>
            <a href="<%= admin_prototype_path(path: "quadrangolazione_instagram.html") %>" class="inline-flex items-center gap-1 hover:text-amber-950 hover:underline">
              <span>Strategy @markpostura</span>
              <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</footer>
