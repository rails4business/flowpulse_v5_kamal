<% content_for :title, "Accademia: #{@module['title']}" %>
<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<%
  active_module_tab = params[:tab].presence_in(%w[informati pratica insegna recensioni insegnanti centri]) || "informati"
  active_practice_mode = params[:practice].presence_in(%w[autonomia gruppo individuale]) || "autonomia"
  # Prep data
  module_teachers = @academy_teachers.values.select { |t| t["active_modules"]&.include?(@module["slug"]) }
  module_centers = @academy_locations.values.select { |c| c["active_modules"]&.include?(@module["slug"]) }
  teaching_modules = @academy_modules.sort_by { |academy_module| academy_module.fetch("number", "0").to_i }
  current_module_index = teaching_modules.index { |academy_module| academy_module["slug"] == @module["slug"] } || 0
  required_teaching_modules = teaching_modules.first(current_module_index + 1)
  # Anagrafica unica PosturaCorretta per l'eventuale arricchimento delle schede.
  professionals_data = YAML.safe_load_file(Rails.root.join("config/data/posturacorretta/posturacorretta_professionisti.yml"), permitted_classes: [], aliases: false) || {}
  global_professionals = professionals_data.fetch("professionals", [])
%>

<div class="bg-slate-50 text-slate-900 min-h-screen">
  <!-- HEADER MODULO (SUPER COMPATTO) -->
  <header class="bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-50 via-white to-white border-b border-slate-200 py-6 md:py-8">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      
      <!-- BREADCRUMB -->
      <div class="mb-4 text-center md:text-left">
        <%= link_to "← Torna all'Accademia", posturacorretta_accademia_path, class: "text-[11px] font-bold uppercase tracking-wider text-slate-400 hover:text-blue-600 transition" %>
      </div>

      <div class="flex flex-col md:flex-row items-center md:items-start gap-4 md:gap-6">
        <% if @module["logo"].present? %>
          <img src="<%= @module["logo"] %>" alt="Logo <%= @module["title"] %>" class="h-12 md:h-16 w-auto object-contain drop-shadow-sm shrink-0">
        <% end %>
        
        <div class="text-center md:text-left flex-1">
          <p class="text-[10px] font-bold uppercase tracking-widest text-blue-700 mb-1">Modulo <%= @module["number"] %></p>
          <h1 class="text-2xl font-black tracking-tight sm:text-3xl text-slate-950 mb-1 leading-tight">
            <%= @module["title"] %>
          </h1>
          <p class="text-sm sm:text-base text-slate-600 leading-snug max-w-2xl mx-auto md:mx-0 mb-3">
            <%= @module["description"] %>
          </p>
          <a href="#iscriviti" class="inline-block rounded-lg bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-blue-700 transition whitespace-nowrap">
            Iscriviti al modulo
          </a>
        </div>
      </div>

    </div>
  </header>

  <main class="mx-auto max-w-4xl px-5 sm:px-8 pt-6 pb-12 md:pb-16">

    <!-- SECTION TABS -->
    <section id="module-tabs-section" class="scroll-mt-8">
      
      <!-- TABS NAV (CON BADGE NUMERICI E ICONE) -->
      <div class="flex space-x-1 overflow-x-auto border-b border-slate-200 mb-8 pb-px w-full [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        <%= link_to posturacorretta_accademia_modulo_path(@module.fetch("slug"), tab: "informati"), class: "relative z-10 px-4 py-3 text-sm font-bold border-b-2 transition-colors whitespace-nowrap #{active_module_tab == 'informati' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-700'}" do %>
          📖 Informati <span class="ml-1 rounded-full bg-blue-100 text-blue-700 px-2 py-0.5 text-xs"><%= @module.fetch("lessons", []).size %></span>
        <% end %>
        <%= link_to "🧘 Pratica", posturacorretta_accademia_modulo_path(@module.fetch("slug"), tab: "pratica"), class: "relative z-10 px-4 py-3 text-sm font-bold border-b-2 transition-colors whitespace-nowrap #{active_module_tab == 'pratica' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-700'}" %>
        <%= link_to "🎓 Insegna", posturacorretta_accademia_modulo_path(@module.fetch("slug"), tab: "insegna"), class: "relative z-10 px-4 py-3 text-sm font-bold border-b-2 transition-colors whitespace-nowrap #{active_module_tab == 'insegna' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-700'}" %>
        <%= link_to posturacorretta_accademia_modulo_path(@module.fetch("slug"), tab: "recensioni"), class: "relative z-10 px-4 py-3 text-sm font-bold border-b-2 transition-colors whitespace-nowrap #{active_module_tab == 'recensioni' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-700'}" do %>
          👤 Recensioni <span class="ml-1 rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-xs"><%= @module["participants"] || 0 %></span>
        <% end %>
        <%= link_to posturacorretta_accademia_modulo_path(@module.fetch("slug"), tab: "insegnanti"), class: "relative z-10 px-4 py-3 text-sm font-bold border-b-2 transition-colors whitespace-nowrap #{active_module_tab == 'insegnanti' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-700'}" do %>
          🧑‍🏫 Insegnanti <span class="ml-1 rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-xs"><%= module_teachers.size %></span>
        <% end %>
        <%= link_to posturacorretta_accademia_modulo_path(@module.fetch("slug"), tab: "centri"), class: "relative z-10 px-4 py-3 text-sm font-bold border-b-2 transition-colors whitespace-nowrap #{active_module_tab == 'centri' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-700'}" do %>
          📍 Centri / Location <span class="ml-1 rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-xs"><%= module_centers.size %></span>
        <% end %>
      </div>

      <!-- TAB INFORMATI (ex Programma) -->
      <div id="tab-informati" class="module-tab-content scroll-mt-24" <%= "hidden" unless active_module_tab == "informati" %>>
        <div class="space-y-4">
          <% @module.fetch("lessons", []).each do |lesson| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex items-start gap-5">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-lg font-black text-blue-700">
                <%= lesson["number"] %>
              </div>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2"><%= lesson["title"] %></h3>
                <p class="text-slate-600 leading-relaxed"><%= lesson["description"] %></p>
              </div>
            </article>
          <% end %>
        </div>
      </div>

      <!-- TAB PRATICA -->
      <div id="tab-pratica" class="module-tab-content scroll-mt-24" <%= "hidden" unless active_module_tab == "pratica" %>>
        <nav class="mb-6 flex gap-1 overflow-x-auto border-b border-slate-200" aria-label="Modalità di pratica">
          <% { "autonomia" => "Autonomia", "gruppo" => "In gruppo", "individuale" => "Individuale" }.each do |mode, label| %>
            <%= link_to posturacorretta_accademia_modulo_path(@module.fetch("slug"), tab: "pratica", practice: mode), class: "border-b-2 px-4 py-3 text-sm font-semibold whitespace-nowrap transition #{active_practice_mode == mode ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-600 hover:text-slate-800'}" do %>
              <%= label %> <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600"><%= @module.fetch("lessons", []).size %></span>
            <% end %>
          <% end %>
        </nav>

        <% if active_practice_mode == "autonomia" %>
          <article class="rounded-3xl border border-blue-200 bg-blue-50 p-8 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">Programma individuale autonomo</p>
            <h3 class="mt-2 text-2xl font-black text-blue-950">Pratica in autonomia e sostieni l’esame finale</h3>
            <p class="mt-4 max-w-2xl leading-relaxed text-blue-900/80">Segui le <strong><%= @module.fetch("lessons", []).size %> lezioni</strong> del programma, pratica con continuità e usa l’esame finale per verificare l’apprendimento esperienziale e ottenere l’attestato previsto dal modulo.</p>
            <a href="#iscriviti" class="mt-6 inline-flex rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700">Inizia il programma autonomo</a>
          </article>
        <% elsif active_practice_mode == "gruppo" %>
          <article class="rounded-3xl border border-emerald-200 bg-emerald-50 p-8 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-700">Pratica condivisa</p>
            <h3 class="mt-2 text-2xl font-black text-emerald-950">Segui il programma in gruppo</h3>
            <p class="mt-4 max-w-2xl leading-relaxed text-emerald-900/80">Le <strong><%= @module.fetch("lessons", []).size %> lezioni</strong> vengono praticate con un gruppo e un insegnante dell’Accademia: confronto, continuità e momenti di esperienza condivisa.</p>
            <a href="#iscriviti" class="mt-6 inline-flex rounded-xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-700">Cerca un gruppo</a>
          </article>
        <% else %>
          <article class="rounded-3xl border border-violet-200 bg-violet-50 p-8 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-violet-700">Pratica accompagnata</p>
            <h3 class="mt-2 text-2xl font-black text-violet-950">Segui il programma individualmente</h3>
            <p class="mt-4 max-w-2xl leading-relaxed text-violet-900/80">Le <strong><%= @module.fetch("lessons", []).size %> lezioni</strong> diventano un percorso individuale accompagnato da un professionista o da una figura competente nel contesto appropriato.</p>
            <a href="#iscriviti" class="mt-6 inline-flex rounded-xl bg-violet-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-violet-700">Trova un professionista</a>
          </article>
        <% end %>
      </div>

      <!-- TAB INSEGNA -->
      <div id="tab-insegna" class="module-tab-content scroll-mt-24" <%= "hidden" unless active_module_tab == "insegna" %>>
        <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">Percorso per insegnanti</p>
          <h3 class="mt-2 text-2xl font-black text-slate-950">Percorso di abilitazione: <%= @module["title"] %></h3>
          <p class="mt-4 max-w-3xl leading-relaxed text-slate-600">Per insegnare questo modulo completi i moduli che lo precedono, studi le <strong><%= @module.fetch("lessons", []).size %> lezioni</strong> di <%= @module["title"] %> e svolgi la pratica prevista. L'abilitazione attesta la preparazione per condurre questo specifico programma dell'Accademia.</p>

          <div class="mt-8">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Moduli richiesti</p>
            <ol class="mt-4 divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200">
              <% required_teaching_modules.each do |academy_module| %>
                <% is_current_module = academy_module["slug"] == @module["slug"] %>
                <li class="flex items-center gap-4 bg-white px-5 py-4">
                  <span class="flex size-8 shrink-0 items-center justify-center rounded-full <%= is_current_module ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-600' %> text-xs font-black"><%= academy_module["number"] %></span>
                  <span class="min-w-0 flex-1 text-sm font-semibold <%= is_current_module ? 'text-blue-900' : 'text-slate-800' %>"><%= academy_module["title"] %></span>
                  <% if is_current_module %>
                    <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">Modulo attuale</span>
                  <% else %>
                    <span class="text-xs font-medium text-slate-500">Base richiesta</span>
                  <% end %>
                </li>
              <% end %>
            </ol>
          </div>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5"><span class="text-sm font-black text-blue-700">1</span><h4 class="mt-3 font-bold text-slate-950">Pratica guidata</h4><p class="mt-2 text-sm leading-6 text-slate-600">Sperimenta il programma con continuità e prepara la conduzione di una lezione o attività educativa.</p></article>
            <article class="rounded-2xl border border-blue-200 bg-blue-50 p-5"><span class="text-sm font-black text-blue-700">2</span><h4 class="mt-3 font-bold text-blue-950">Verifica e abilitazione</h4><p class="mt-2 text-sm leading-6 text-blue-900">Dopo la verifica finale, l'Accademia può rilasciare l'abilitazione per <%= @module["title"] %>.</p></article>
          </div>
        </section>

        <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">Linee guida per gli insegnanti</p>
          <h3 class="mt-2 text-2xl font-black text-slate-950">Un approccio educativo comune</h3>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">L'insegnante applica la metodica in modo universale: l'approccio educativo è lo stesso in tutti gli ambiti. Cambia l’iter di collaborazione in base allo stato della persona e alle competenze coinvolte.</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <!-- Ambito Blu -->
            <div class="rounded-2xl bg-slate-50 p-6 border-t-4 border-blue-500">
              <h4 class="font-bold text-slate-900 mb-2 flex items-center gap-2"><span class="size-3 rounded-full bg-blue-500"></span> <strong>Ambito Blu</strong></h4>
              <p class="text-sm text-slate-600">Benessere e sport (es. fitness, calcio). L'insegnante opera in totale <strong>autonomia</strong>.</p>
            </div>
            
            <!-- Ambito Verde -->
            <div class="rounded-2xl bg-slate-50 p-6 border-t-4 border-emerald-500">
              <h4 class="font-bold text-slate-900 mb-2 flex items-center gap-2"><span class="size-3 rounded-full bg-emerald-500"></span> <strong>Ambito Verde</strong></h4>
              <p class="text-sm text-slate-600">Prevenzione. L'insegnante opera in accordo con il <strong>professionista della salute, del benessere o l'istruttore</strong> che segue la persona.</p>
            </div>

            <!-- Ambito Rosso -->
            <div class="rounded-2xl bg-slate-50 p-6 border-t-4 border-red-500">
              <h4 class="font-bold text-slate-900 mb-2 flex items-center gap-2"><span class="size-3 rounded-full bg-red-500"></span> <strong>Ambito Rosso</strong></h4>
              <p class="text-sm text-slate-600">Patologia. L'insegnante opera in affiancamento e solo previa <strong>autorizzazione medica</strong>.</p>
            </div>
          </div>
        </section>
      </div>

      <!-- TAB RECENSIONI -->
      <div id="tab-recensioni" class="module-tab-content scroll-mt-24" <%= "hidden" unless active_module_tab == "recensioni" %>>
        <div class="grid gap-6">
          <article class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="flex items-center gap-4 mb-6">
              <div class="size-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-black">MR</div>
              <div>
                <h3 class="text-lg font-bold">Matteo Romano</h3>
                <p class="text-sm text-slate-500">Insegnante</p>
              </div>
            </div>
            <p class="text-slate-700 leading-relaxed italic">
              "L'approccio di questo modulo ha cambiato il mio modo di valutare. Una mappa chiara e subito applicabile in studio."
            </p>
          </article>
        </div>
      </div>

      <!-- TAB INSEGNANTI -->
      <div id="tab-insegnanti" class="module-tab-content scroll-mt-24" <%= "hidden" unless active_module_tab == "insegnanti" %>>
        <% if module_teachers.empty? %>
          <p class="text-slate-500 italic">Nessun insegnante trovato per questo modulo.</p>
        <% else %>
          <div class="grid sm:grid-cols-2 gap-6">
            <% module_teachers.each do |teacher| %>
              <% 
                # Tenta il matching col database globale dei professionisti (per nome)
                global_prof = global_professionals.find { |p| p["name"] == teacher["name"] }
                prof_img = global_prof&.fetch("image", nil) || teacher["img"]
                prof_desc = global_prof&.fetch("description", nil) || teacher["role"]
              %>
              <article class="flex items-start gap-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <% if prof_img.present? %>
                  <img src="<%= prof_img %>" alt="<%= teacher['name'] %>" class="size-16 rounded-full object-cover shadow-sm bg-slate-100">
                <% else %>
                  <div class="flex size-16 shrink-0 items-center justify-center rounded-full bg-slate-100 text-lg font-bold text-slate-400">
                    <%= teacher["name"].first %>
                  </div>
                <% end %>
                <div>
                  <h3 class="text-lg font-bold text-slate-900"><%= teacher["name"] %></h3>
                  <p class="text-sm text-slate-500 mb-2"><%= teacher["city"] %> (<%= teacher["province"] %>)</p>
                  <p class="text-xs text-slate-600 line-clamp-2"><%= prof_desc %></p>
                </div>
              </article>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- TAB CENTRI -->
      <div id="tab-centri" class="module-tab-content scroll-mt-24" <%= "hidden" unless active_module_tab == "centri" %>>
        <% if module_centers.empty? %>
          <p class="text-slate-500 italic">Nessun centro trovato per questo modulo.</p>
        <% else %>
          <div class="grid sm:grid-cols-2 gap-6">
            <% module_centers.each do |center| %>
              <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h3 class="text-lg font-bold text-slate-900 mb-1"><%= center["name"] %></h3>
                <p class="text-sm text-slate-500 mb-4 flex items-center gap-2">
                  <span>📍 <%= center["city"] %></span>
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-600"><%= center["type"] %></span>
                </p>
              </article>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- METODICA COLLEGATA -->
    <% if @module["methodologies"].present? %>
      <section class="mt-16 rounded-3xl bg-slate-900 text-white border border-slate-800 p-8 shadow-sm">
        <h3 class="text-lg font-black mb-4">Vuoi fare il percorso salute?</h3>
        <p class="text-slate-300 text-sm leading-relaxed mb-6">
          Questo modulo forma gli insegnanti. Se sei un paziente o vuoi sperimentare i benefici su te stesso, scopri i professionisti abilitati.
        </p>
        <% @module["methodologies"].each do |meth| %>
          <%= link_to "Scopri la Metodica →", posturacorretta_metodica_path(meth), class: "inline-block text-sm font-bold text-blue-400 hover:text-blue-300" %>
        <% end %>
      </section>
    <% end %>

  </main>
</div>

<%= render "posturacorretta/footer" %>
