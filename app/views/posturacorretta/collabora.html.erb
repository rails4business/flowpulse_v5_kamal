<% content_for :landing_nav do %>
  <%= render "posturacorretta/header" %>
<% end %>

<% collabora_tab = params[:tab] == "insegnanti" ? "insegnanti" : "collabora" %>

<div class="bg-white text-slate-900 antialiased min-h-screen">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-base font-semibold leading-7 text-blue-600 uppercase tracking-widest">PosturaCorretta</h2>
      <p class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Collabora con noi</p>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        Unisciti alla nostra rete per migliorare la vita delle persone. Che tu sia un professionista della salute, un investitore o un esperto digitale, abbiamo uno spazio per te.
      </p>
    </div>

    <nav class="mx-auto mt-10 flex w-fit gap-1 border-b border-slate-200" aria-label="Modalità di collaborazione">
      <%= link_to "Collabora", posturacorretta_collabora_path, class: "border-b-2 px-4 py-2 text-sm font-semibold transition #{collabora_tab == 'collabora' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-600 hover:text-slate-800'}" %>
      <%= link_to "Diventa insegnante", posturacorretta_collabora_path(tab: "insegnanti"), class: "border-b-2 px-4 py-2 text-sm font-semibold transition #{collabora_tab == 'insegnanti' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-600 hover:text-slate-800'}" %>
    </nav>

    <% if collabora_tab == "collabora" %>
    <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-6 sm:mt-20 lg:mx-auto lg:max-w-4xl lg:grid-cols-2 lg:gap-8">

      <!-- Card Professionisti -->
      <a href="<%= posturacorretta_collabora_professionisti_path %>" class="group flex flex-col justify-between rounded-2xl bg-white p-8 shadow-xl ring-1 ring-gray-900/10 transition-all hover:-translate-y-1 hover:shadow-2xl sm:p-10">
        <div>
          <div class="flex items-center gap-x-4">
            <div class="h-12 w-12 flex items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 group-hover:text-emerald-700 transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold leading-8 text-gray-900">Professionisti</h3>
          </div>
          <p class="mt-6 text-base leading-7 text-gray-600">Per esperti della salute, del benessere e del movimento che desiderano entrare nella nostra rete clinica ed educativa.</p>
        </div>
        <div class="mt-8 flex items-center gap-x-2 text-sm font-semibold leading-6 text-emerald-600 group-hover:text-emerald-700">
          Scopri le modalità d'ingresso
          <span aria-hidden="true">&rarr;</span>
        </div>
      </a>

      <!-- Card Insegnanti -->
      <a href="<%= posturacorretta_collabora_path(tab: 'insegnanti') %>" class="group flex flex-col justify-between rounded-2xl bg-white p-8 shadow-xl ring-1 ring-gray-900/10 transition-all hover:-translate-y-1 hover:shadow-2xl sm:p-10">
        <div>
          <div class="flex items-center gap-x-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-blue-600 transition-colors group-hover:bg-blue-100 group-hover:text-blue-700">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75c-1.3 0-2.4.84-2.82 2.01A3.75 3.75 0 0 0 5.25 12.5c0 2.07 1.68 3.75 3.75 3.75h6a3.75 3.75 0 0 0 .75-7.42A3.75 3.75 0 0 0 12 6.75ZM8.25 20.25h7.5" /></svg>
            </div>
            <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-700">Accademia PosturaCorretta</p><h3 class="mt-1 text-xl font-semibold leading-8 text-gray-900">Porta l’educazione alla salute nella tua community</h3></div>
          </div>
          <p class="mt-6 text-base leading-7 text-gray-600">Accompagna persone, professionisti e metodiche attraverso l’educazione al corpo, alla fisiologia e allo stile di vita.</p>
        </div>
        <div class="mt-8 flex items-center gap-x-2 text-sm font-semibold leading-6 text-blue-600 group-hover:text-blue-700">Scopri il ruolo dell’insegnante <span aria-hidden="true">&rarr;</span></div>
      </a>

      <!-- Card Investitori (Progetti) -->
      <a href="<%= posturacorretta_progetti_path %>" class="group flex flex-col justify-between rounded-2xl bg-white p-8 shadow-xl ring-1 ring-gray-900/10 transition-all hover:-translate-y-1 hover:shadow-2xl sm:p-10">
        <div>
          <div class="flex items-center gap-x-4">
            <div class="h-12 w-12 flex items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 group-hover:bg-indigo-100 group-hover:text-indigo-700 transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.315 48.315 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold leading-8 text-gray-900">Investitori</h3>
          </div>
          <p class="mt-6 text-base leading-7 text-gray-600">Esplora i nostri progetti di ricerca e sviluppo. Sostieni economicamente la crescita della piattaforma e dei prototipi.</p>
        </div>
        <div class="mt-8 flex items-center gap-x-2 text-sm font-semibold leading-6 text-indigo-600 group-hover:text-indigo-700">
          Visualizza i progetti
          <span aria-hidden="true">&rarr;</span>
        </div>
      </a>

      <!-- Card Digital -->
      <a href="<%= posturacorretta_collabora_digital_path %>" class="group flex flex-col justify-between rounded-2xl bg-white p-8 shadow-xl ring-1 ring-gray-900/10 transition-all hover:-translate-y-1 hover:shadow-2xl sm:p-10">
        <div>
          <div class="flex items-center gap-x-4">
            <div class="h-12 w-12 flex items-center justify-center rounded-lg bg-orange-50 text-orange-600 group-hover:bg-orange-100 group-hover:text-orange-700 transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold leading-8 text-gray-900">Digital & Tech</h3>
          </div>
          <p class="mt-6 text-base leading-7 text-gray-600">Aiutaci a far crescere la piattaforma, la SEO, e la gestione operativa. Task tecnici e collaborazioni digitali.</p>
        </div>
        <div class="mt-8 flex items-center gap-x-2 text-sm font-semibold leading-6 text-orange-600 group-hover:text-orange-700">
          Vedi i task aperti
          <span aria-hidden="true">&rarr;</span>
        </div>
      </a>

      <!-- Card Sostieni -->
      <a href="#" class="group flex flex-col justify-between rounded-2xl bg-white p-8 shadow-xl ring-1 ring-gray-900/10 transition-all hover:-translate-y-1 hover:shadow-2xl sm:p-10">
        <div>
          <div class="flex items-center gap-x-4">
            <div class="h-12 w-12 flex items-center justify-center rounded-lg bg-rose-50 text-rose-600 group-hover:bg-rose-100 group-hover:text-rose-700 transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold leading-8 text-gray-900">Sostieni</h3>
          </div>
          <p class="mt-6 text-base leading-7 text-gray-600">
            Sostieni il progetto PosturaCorretta. Aiutaci a costruire una cultura della salute basata su conoscenza, esperienza e collaborazione.
          </p>
        </div>
        <div class="mt-8 flex items-center gap-x-2 text-sm font-semibold leading-6 text-rose-600 group-hover:text-rose-700">
          Fai una donazione
          <span aria-hidden="true">&rarr;</span>
        </div>
      </a>

    </div>
    <% else %>
      <section class="mx-auto mt-16 max-w-3xl rounded-3xl border border-slate-200 bg-white p-7 shadow-sm md:p-10">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">Accademia PosturaCorretta</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 md:text-4xl">Diventa insegnante dell’Accademia</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">Porta cultura di base della salute nella community: corpo, fisiologia, abitudini, ambiente e relazioni.</p>
        <div class="mt-8 space-y-6 border-t border-slate-100 pt-7 text-base leading-7 text-slate-600">
          <div><h2 class="font-semibold text-slate-950">Una formazione orizzontale</h2><p class="mt-1">L’insegnante accompagna l’educazione al corpo e allo stile di vita, rendendo più accessibili conoscenza, pratica e orientamento.</p></div>
          <div><h2 class="font-semibold text-slate-950">Un ponte tra persone, professionisti e metodiche</h2><p class="mt-1">Come un informatore farmaceutico porta al medico la conoscenza di un farmaco, l’insegnante PosturaCorretta, attraverso il proprio ruolo educativo, rende accessibili a persone e professionisti le metodiche posturali e la filosofia del progetto.</p></div>
          <div><h2 class="font-semibold text-slate-950">Conoscere l’essere umano</h2><p class="mt-1">La filosofia PosturaCorretta mette al centro della salute la conoscenza dell’essere umano e dei contesti in cui vive.</p></div>
        </div>
        <%= link_to posturacorretta_accademia_path(anchor: "collabora-accademia"), class: "mt-9 inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2" do %>Scopri come funziona l’Accademia <span aria-hidden="true" class="ml-2">→</span><% end %>
      </section>
    <% end %>
  </div>
</div>

<%= render "posturacorretta/footer" %>
