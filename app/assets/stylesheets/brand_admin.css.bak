.brand-admin-body {
  --ba-ink: #16323b;
  --ba-muted: #60747a;
  --ba-line: #cbd8d6;
  --ba-paper: #f7faf9;
  --ba-wash: #eaf1f0;
  --ba-green: #2a9d78;
  --ba-green-soft: #c4e7d9;
  --ba-blue: #1f7a8c;
  --ba-red: #b4534b;
  --ba-gold: #c98f0a;
  min-height: 100vh;
  background: var(--ba-wash);
  color: var(--ba-ink);
  font-family: "Avenir Next", "Segoe UI", system-ui, sans-serif;
}

.brand-admin-header { border-bottom: 1px solid var(--ba-line); background: rgb(247 250 249 / .96); }
.brand-admin-header__inner { display:flex; align-items:center; justify-content:space-between; gap:1rem; max-width:90rem; margin:auto; padding:1rem clamp(1rem,4vw,3rem) .75rem; }
.brand-admin-eyebrow { color:var(--ba-muted); font-size:.68rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
.brand-admin-name { color:var(--ba-ink); font-family:Georgia,serif; font-size:1.5rem; font-weight:700; text-decoration:none; }
.brand-admin-header__actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:.65rem; }
.brand-admin-support { border:1px solid #f4d58d; border-radius:999px; background:#fff8df; color:#8a6110; padding:.35rem .7rem; font-size:.72rem; font-weight:800; }
.brand-admin-site-link { border:1px solid var(--ba-line); border-radius:.65rem; background:white; color:var(--ba-ink); padding:.55rem .8rem; font-size:.8rem; font-weight:800; text-decoration:none; }
.brand-admin-nav { display:flex; gap:.25rem; max-width:90rem; margin:auto; padding:0 clamp(1rem,4vw,3rem); }
.brand-admin-nav a { border-bottom:3px solid transparent; color:var(--ba-muted); padding:.7rem .9rem; font-size:.85rem; font-weight:800; text-decoration:none; }
.brand-admin-nav a[aria-current="page"] { border-bottom-color:var(--ba-green); color:var(--ba-ink); }
.brand-admin-flash { max-width:84rem; margin:1rem auto 0; border-radius:.75rem; padding:.8rem 1rem; font-size:.875rem; font-weight:700; }
.brand-admin-flash--notice { border:1px solid #9bd5c2; background:#e8f7f1; color:#17634d; }
.brand-admin-flash--alert { border:1px solid #e4b3ae; background:#fff0ee; color:#8d3932; }
.brand-admin-shell { max-width:90rem; margin:auto; padding:1.5rem clamp(1rem,4vw,3rem) 4rem; }
.brand-admin-card { border:1px solid var(--ba-line); border-radius:1rem; background:var(--ba-paper); box-shadow:0 12px 35px rgb(22 50 59 / .06); }
.brand-admin-title { font-family:Georgia,serif; font-weight:700; letter-spacing:-.02em; }

/* Componenti con colori espliciti: non dipendono dalla scansione Tailwind
   delle classi costruite dinamicamente nei template ERB. */
.brand-admin-filter {
  display:inline-flex;
  align-items:center;
  border:1px solid var(--ba-line) !important;
  border-radius:999px;
  background-color:#fff !important;
  color:var(--ba-muted) !important;
  padding:.375rem .75rem;
  font-size:.75rem;
  font-weight:800;
  line-height:1.25;
  text-decoration:none;
}
.brand-admin-filter:hover { border-color:var(--ba-green) !important; color:var(--ba-ink) !important; }
.brand-admin-filter[aria-current="page"] {
  border-color:#17634d !important;
  background-color:#17634d !important;
  color:#fff !important;
}
.brand-admin-badge { display:inline-flex; align-items:center; border-radius:999px; padding:.25rem .625rem; font-size:.6875rem; font-weight:800; letter-spacing:.025em; }
.brand-admin-badge--status { background-color:#e4dcfa !important; color:#553c9a !important; }
.brand-admin-badge--kind { background-color:#e6eceb !important; color:#465b60 !important; }
.brand-admin-badge--request { background-color:#fff1c2 !important; color:#805b0b !important; }
.brand-admin-badge--user { background-color:#dff3ff !important; color:#145a75 !important; }
.brand-admin-badge--professional { background-color:#dff4e9 !important; color:#17634d !important; }
.brand-admin-action { display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--ba-line) !important; border-radius:.65rem; background-color:#fff !important; color:var(--ba-ink) !important; padding:.5rem .7rem; font-size:.75rem; font-weight:800; cursor:pointer; }
.brand-admin-action:hover { border-color:var(--ba-green) !important; background-color:#eef8f4 !important; }
.brand-admin-action--primary { border-color:#17634d !important; background-color:#17634d !important; color:#fff !important; }
.brand-admin-action--danger { border-color:#e4b3ae !important; color:#8d3932 !important; }

.brand-cell-map { --cell-status:#809391; }
.brand-cell-map__canvas { overflow:auto; border:1px solid var(--ba-line); border-radius:1rem; background:var(--ba-paper); }
.brand-cell-map__canvas svg { display:block; min-width:100%; }
.brand-cell-map__edge { fill:none; stroke:#9fb0ae; stroke-width:1.8; }
.brand-cell-map__bridge { fill:none; stroke:var(--ba-gold); stroke-width:2.5; stroke-dasharray:9 7; }
.brand-cell-map__node { color:#1f7a8c; text-decoration:none; }
.brand-cell-map__node[data-cell-status="active"] { color:var(--ba-green); }
.brand-cell-map__node[data-cell-status="consolidated"] { color:#14596a; }
.brand-cell-map__node[data-cell-status="cut"] { color:var(--ba-red); }
.brand-cell-map__node rect { fill:white; stroke:currentColor; stroke-width:2.5; }
.brand-cell-map__node[data-cell-status="idea"] rect { stroke-dasharray:7 5; }
.brand-cell-map__node[data-cell-status="active"] rect { fill:var(--ba-green-soft); }
.brand-cell-map__node[data-cell-status="consolidated"] rect { fill:#8cc3cf; }
.brand-cell-map__node[data-cell-status="cut"] rect { fill:#ebd3d0; stroke-dasharray:3 5; }
.brand-cell-map__node:hover rect, .brand-cell-map__node:focus rect { stroke-width:4; }
.brand-cell-map__title { fill:var(--ba-ink); font:700 14px system-ui,sans-serif; text-anchor:middle; }
.brand-cell-map__meta { fill:currentColor; font:800 10px system-ui,sans-serif; letter-spacing:.05em; text-anchor:middle; text-transform:uppercase; }

@media (max-width: 640px) {
  .brand-admin-header__inner { align-items:flex-start; }
  .brand-admin-support { display:none; }
  .brand-admin-name { font-size:1.25rem; }
}
